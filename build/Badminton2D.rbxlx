      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Bot</string>
          <string name="Source"><![CDATA[--!strict
-- AI 상대. 사람과 똑같이 Match.Input만 만들어 내기 때문에 규칙상 반칙을 하지 않는다.
-- 상대가 친 뒤 반응 시간이 지나면 셔틀의 궤적을 예측해서 그 아래로 이동하고,
-- 셔틀이 스윗 스팟 근처에 오면 스윙한다. 난이도는 반응 속도, 위치 오차, 이동 속도 등으로 조절한다.

local Config = require(script.Parent.Config)
local Shuttle = require(script.Parent.Shuttle)
local Match = require(script.Parent.Match)
local Rng = require(script.Parent.Rng)

export type Difficulty = {
	reaction: number, -- 상대가 친 뒤 움직이기 시작할 때까지의 시간
	positionError: number, -- 예측 위치 오차 (월드 단위)
	speedScale: number, -- 최대 이동 속도 비율
	smashChance: number, -- 높은 공이 올 때 점프 스매시를 시도할 확률
	dropChance: number, -- 드롭을 선택하는 기본 확률
	swingWindow: number, -- 스윗 스팟과 이 거리 안이면 스윙
	mistakeChance: number, -- 날아오는 공마다 크게 잘못 판단할 확률
	judgeOut: number, -- 아웃될 공을 알아보고 치지 않을 확률
}

local Bot = {}
Bot.__index = Bot

Bot.Difficulties = {
	Easy = {
		reaction = 0.34,
		positionError = 0.75,
		speedScale = 0.72,
		smashChance = 0.1,
		dropChance = 0.15,
		swingWindow = 0.6,
		mistakeChance = 0.16,
		judgeOut = 0.3,
	} :: Difficulty,
	Normal = {
		reaction = 0.24,
		positionError = 0.4,
		speedScale = 0.86,
		smashChance = 0.45,
		dropChance = 0.3,
		swingWindow = 0.45,
		mistakeChance = 0.07,
		judgeOut = 0.65,
	} :: Difficulty,
	Hard = {
		reaction = 0.15,
		positionError = 0.25,
		speedScale = 1,
		smashChance = 0.8,
		dropChance = 0.35,
		swingWindow = 0.3,
		mistakeChance = 0.03,
		judgeOut = 0.9,
	} :: Difficulty,
}

type Plan = {
	targetX: number,
	jumpAt: number, -- 이 시간(match.time)이 되면 점프, 점프 안 하면 math.huge
}

type BotData = {
	side: number,
	difficulty: Difficulty,
	rng: Rng.Rng,
	seenHitCount: number,
	seenPhase: string,
	planReadyAt: number,
	plan: Plan?,
	leaving: boolean,
	swung: boolean,
	serveAt: number,
	errorOffset: number,
	lastDist: number,
}

export type Bot = typeof(setmetatable({} :: BotData, Bot))

local NET_X = Config.NET_X
local PREDICT_DT = 1 / 120
local JUMP_RISE_TIME = Config.JUMP_VELOCITY / Config.PLAYER_GRAVITY
local JUMP_HEIGHT = Config.JUMP_VELOCITY * Config.JUMP_VELOCITY / (2 * Config.PLAYER_GRAVITY)
local CONTACT_Y = 1.9 -- 땅에 서서 칠 때 노리는 타점 높이

function Bot.new(side: number, difficulty: Difficulty | string, seed: number?): Bot
	local diff: Difficulty
	if typeof(difficulty) == "string" then
		diff = (Bot.Difficulties :: any)[difficulty] or Bot.Difficulties.Normal
	else
		diff = difficulty
	end
	return setmetatable(
		{
			side = side,
			difficulty = diff,
			rng = Rng.new(seed or (side * 7919 + 17)),
			seenHitCount = -1,
			seenPhase = "",
			planReadyAt = 0,
			plan = nil,
			leaving = false,
			swung = false,
			serveAt = 0,
			errorOffset = 0,
			lastDist = math.huge,
		} :: BotData,
		Bot
	)
end

-- 셔틀이 내 코트에서 높이 contactY 아래로 내려오는 지점을 예측한다.
local function predictContact(match: Match.Match, dir: number, contactY: number): (number?, number?, number?)
	local s = match.shuttle
	local body = { x = s.x, y = s.y, vx = s.vx, vy = s.vy }
	local t = 0
	local lastMineX, lastMineT, lastMineY = nil, nil, nil
	while t < 4 do
		local px = body.x
		Shuttle.step(body, PREDICT_DT)
		t += PREDICT_DT
		-- 네트에 걸리는 궤적이면 넘어오지 않는다
		if (px - NET_X) * (body.x - NET_X) < 0 and body.y <= Config.NET_HEIGHT then
			return nil, nil, nil
		end
		local mine = (body.x - NET_X) * dir < 0
		if mine and body.y > Config.HIT_ZONE_LOW + 0.05 then
			lastMineX, lastMineT, lastMineY = body.x, t, body.y
			if body.vy < 0 and body.y <= contactY then
				return body.x, t, body.y
			end
		end
		if body.y <= 0 then
			break
		end
	end
	-- 원하는 높이까지 오지 않는 낮은 공이면 바닥에 닿기 직전 지점
	return lastMineX, lastMineT, lastMineY
end

function Bot.makePlan(self: Bot, match: Match.Match)
	local me = match.players[self.side]
	local diff = self.difficulty
	local dir = me.dir
	local jumpReach = CONTACT_Y + JUMP_HEIGHT * 0.9

	-- 아웃될 공은 치지 않고 보낸다
	local s = match.shuttle
	local flight = Shuttle.simulate(s.x, s.y, s.vx, s.vy)
	if math.abs(flight.landX - NET_X) > Config.COURT_HALF_LENGTH + 0.1 and self.rng:chance(diff.judgeOut) then
		self.leaving = true
		self.plan = nil
		return
	end

	local plan: Plan? = nil
	-- 높이 뜬 공이면 점프 스매시를 노린다
	if self.rng:chance(diff.smashChance) then
		local x, t, y = predictContact(match, dir, jumpReach)
		if x and t and y and t > JUMP_RISE_TIME and y >= jumpReach - 0.3 then
			plan = { targetX = x - dir * Config.SWEET_SPOT_X, jumpAt = match.time + t - JUMP_RISE_TIME * 0.95 }
		end
	end
	if not plan then
		local x = predictContact(match, dir, CONTACT_Y)
		if x then
			plan = { targetX = x - dir * Config.SWEET_SPOT_X, jumpAt = math.huge }
		end
	end
	if plan then
		local minX, maxX = Match.bounds(self.side)
		plan.targetX = math.clamp(plan.targetX + self.errorOffset, minX, maxX)
	end
	self.plan = plan
end

local function moveToward(me: Match.Player, targetX: number, speedScale: number): number
	local dx = targetX - me.x
	if math.abs(dx) < 0.06 then
		return 0
	end
	return math.clamp(dx * 4, -1, 1) * speedScale
end

function Bot.chooseSoft(self: Bot, match: Match.Match): boolean
	local opponent = match.players[3 - self.side]
	local oppDepth = math.abs(opponent.x - NET_X)
	local chance = self.difficulty.dropChance
	if oppDepth > 4.5 then
		chance += 0.3 -- 상대가 뒤에 있으면 네트 앞으로 떨어뜨린다
	elseif oppDepth < 2.8 then
		chance -= 0.2 -- 상대가 네트 앞이면 뒤로 길게
	end
	return self.rng:chance(chance)
end

function Bot.update(self: Bot, match: Match.Match): Match.Input
	local input: Match.Input = { move = 0, jump = false, hit = false, drop = false }
	local me = match.players[self.side]
	local diff = self.difficulty
	local baseX = NET_X - me.dir * 3.4

	if match.phase ~= self.seenPhase then
		self.seenPhase = match.phase
		if match.phase == "serve" then
			self.serveAt = match.time + self.rng:range(0.7, 1.5)
		end
	end

	if match.phase == "serve" then
		if match.server == self.side then
			if match.time >= self.serveAt then
				if self.rng:chance(0.3) then
					input.drop = true
				else
					input.hit = true
				end
			end
		else
			input.move = moveToward(me, baseX, diff.speedScale)
		end
		return input
	end

	if match.phase ~= "rally" then
		input.move = moveToward(me, baseX, diff.speedScale * 0.5)
		return input
	end

	-- 새 샷이 나왔는지 확인
	if match.hitCount ~= self.seenHitCount then
		self.seenHitCount = match.hitCount
		self.plan = nil
		self.leaving = false
		self.swung = false
		self.lastDist = math.huge
		self.planReadyAt = match.time + diff.reaction * self.rng:range(0.8, 1.25)
		if self.rng:chance(diff.mistakeChance) then
			-- 가끔은 낙하 지점을 크게 잘못 읽는다
			local sign = if self.rng:chance(0.5) then 1 else -1
			self.errorOffset = sign * self.rng:range(1.1, 1.9)
		else
			self.errorOffset = self.rng:spread() * diff.positionError
		end
	end

	if match.lastHitter == self.side then
		-- 내가 친 공이 넘어가는 중: 코트 중앙으로 복귀
		input.move = moveToward(me, baseX, diff.speedScale)
		return input
	end

	if match.time < self.planReadyAt then
		-- 아직 반응 전: 하던 대로 중앙 쪽으로
		input.move = moveToward(me, baseX, diff.speedScale * 0.6)
		return input
	end

	if not self.plan and not self.leaving then
		self:makePlan(match)
	end
	if self.leaving then
		input.move = moveToward(me, baseX, diff.speedScale * 0.5)
		return input
	end
	local plan = self.plan
	if plan then
		input.move = moveToward(me, plan.targetX, diff.speedScale)
		if me.onGround and match.time >= plan.jumpAt and math.abs(me.x - plan.targetX) < 0.8 then
			input.jump = true
		end
	end

	-- 셔틀이 스윗 스팟에 가장 가까워질 때쯤 스윙
	local s = match.shuttle
	local inZone, dist = Match.zoneInfo(me.x, me.y, me.dir, s.x, s.y)
	if inZone and not self.swung and me.swingT < 0 and me.cooldown <= 0 then
		local leaving = dist > self.lastDist
		if dist <= diff.swingWindow or leaving then
			self.swung = true
			local smash = not me.onGround and s.y >= Config.SMASH_MIN_HEIGHT
			if not smash and self:chooseSoft(match) then
				input.drop = true
			else
				input.hit = true
			end
		end
	end
	self.lastDist = if inZone then dist else math.huge
	-- 헛스윙했으면 셔틀이 아직 내 쪽에 있는 동안 다시 시도할 수 있게 한다
	if self.swung and me.swingT < 0 and not me.swingHit and not inZone then
		self.swung = false
	end

	return input
end

return Bot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- 게임 전체가 공유하는 튜닝 값.
-- 월드 좌표는 대략 미터 단위이며, x는 오른쪽, y는 위쪽이 + 방향이다. 바닥은 y = 0.

local Config = {}

-- 화면에 보이는 월드 영역 (16:9)
Config.VIEW_WIDTH = 16
Config.VIEW_HEIGHT = 9
Config.VIEW_BOTTOM = -0.9 -- 화면 아래 끝의 월드 y

-- 코트
Config.NET_X = 8
Config.NET_HEIGHT = 1.55
Config.COURT_HALF_LENGTH = 6.7 -- 네트 ~ 엔드라인 (실제 규격 13.4m / 2)
Config.SHORT_SERVICE_DIST = 1.98 -- 네트 ~ 숏 서비스 라인
Config.WALL_MARGIN = 0.45 -- 선수가 움직일 수 있는 화면 끝 여백

-- 선수
Config.PLAYER_SPEED = 7
Config.GROUND_ACCEL = 70
Config.AIR_ACCEL = 35
Config.PLAYER_GRAVITY = 28
Config.JUMP_VELOCITY = 8.2
Config.PLAYER_HALF_WIDTH = 0.35

-- 스윙과 타격 판정 (선수 발 위치 기준, x는 선수가 바라보는 방향이 +)
Config.SWING_DURATION = 0.3 -- 애니메이션 길이
Config.SWING_ACTIVE = 0.18 -- 스윙 시작 후 타격이 가능한 시간
Config.SWING_COOLDOWN = 0.1
Config.HIT_ZONE_BACK = -0.55
Config.HIT_ZONE_FRONT = 1.45
Config.HIT_ZONE_LOW = 0.25
Config.HIT_ZONE_HIGH = 2.75
-- 스윗 스팟은 몸 앞쪽의 세로 선분 (허리 ~ 머리 위). 여기서 멀어질수록 샷 품질이 떨어진다.
Config.SWEET_SPOT_X = 0.6
Config.SWEET_SPOT_LOW = 1.0
Config.SWEET_SPOT_HIGH = 2.3
Config.SWEET_RADIUS = 1.4 -- 이 거리만큼 스윗 스팟에서 벗어나면 품질 0
Config.FAST_SHOT_SPEED = 12 -- 이보다 빠르게 날아오는 셔틀은 받아치기 어려워 품질이 떨어진다
Config.NET_REACH = 0.2 -- 네트 너머로 라켓이 닿는 거리

-- 셔틀콕 (중력 + 속도 제곱에 비례하는 공기 저항)
Config.GRAVITY = 12
Config.TERMINAL_VELOCITY = 9
Config.DRAG = Config.GRAVITY / (Config.TERMINAL_VELOCITY * Config.TERMINAL_VELOCITY)
Config.SHUTTLE_SUBSTEPS = 4

-- 샷
Config.SMASH_MIN_HEIGHT = 2.55 -- 이 높이 이상에서 점프 중 강타하면 스매시
Config.LOW_CONTACT_HEIGHT = 1.0 -- 이 높이 아래에서 치면 언더핸드 샷
Config.SMASH_SPEED = 33
Config.SERVE_CONTACT_HEIGHT = 1.0

-- 경기 규칙 (랠리 포인트제)
Config.POINTS_TO_WIN = 11
Config.WIN_BY = 2
Config.MAX_POINTS = 15 -- 듀스가 길어지면 이 점수에서 끝
Config.POINT_PAUSE = 1.6 -- 득점 후 다음 서브까지 대기 시간
Config.SERVE_TIMEOUT = 7 -- 서브를 안 하면 자동으로 하이 서브

-- 시뮬레이션 / 네트워크
Config.TICK = 1 / 60
Config.SNAPSHOT_RATE = 30
Config.INTERP_DELAY = 0.1
Config.MAX_LOOKBACK = 0.3 -- 온라인 지연 보정으로 과거를 되돌아보는 최대 시간
Config.REMOTES_FOLDER = "BadmintonRemotes"

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Match</string>
          <string name="Source"><![CDATA[--!strict
-- 한 경기의 전체 상태와 규칙. Roblox 인스턴스를 전혀 쓰지 않는 순수 로직이라
-- 클라이언트(AI 대전), 서버(온라인 대전), Lune 테스트에서 똑같이 돌아간다.
--
-- 진행 순서: serve(서브 대기) -> rally(랠리) -> point(득점 연출) -> serve ... -> over(경기 종료)
-- 1번 선수는 왼쪽 코트(오른쪽을 바라봄, dir = +1), 2번 선수는 오른쪽 코트(dir = -1).

local Config = require(script.Parent.Config)
local Shuttle = require(script.Parent.Shuttle)
local Shots = require(script.Parent.Shots)
local Rng = require(script.Parent.Rng)

local NET_X = Config.NET_X
local HALF = Config.COURT_HALF_LENGTH
local HISTORY_SIZE = math.ceil(Config.MAX_LOOKBACK / Config.TICK) + 4

export type Input = {
	move: number, -- -1 ~ 1 (화면 기준 왼쪽/오른쪽)
	jump: boolean, -- 누르고 있는 동안 true
	hit: boolean, -- 이번 틱에 강타 버튼을 눌렀는지
	drop: boolean, -- 이번 틱에 드롭 버튼을 눌렀는지
	lookback: number?, -- 온라인 지연 보정 (초)
}

export type Player = {
	side: number,
	dir: number,
	x: number,
	y: number,
	vx: number,
	vy: number,
	onGround: boolean,
	swingT: number, -- 스윙 시작 후 경과 시간, 스윙 중이 아니면 -1
	swingKind: string, -- "power" | "soft"
	swingStyle: number, -- 0 = 오버헤드, 1 = 언더핸드 (그리기용)
	swingHit: boolean,
	cooldown: number,
	lookback: number,
}

export type ShuttleState = {
	x: number,
	y: number,
	vx: number,
	vy: number,
	grounded: boolean,
	hitNet: boolean,
}

export type Event = {
	kind: string, -- "serveReady" | "hit" | "net" | "point" | "gameOver"
	side: number?,
	shot: string?,
	quality: number?,
	reason: string?, -- point: "in" | "out" | "net" | "fault" | "short"
	x: number?,
	y: number?,
}

export type Options = {
	pointsToWin: number?,
	winBy: number?,
	maxPoints: number?,
	seed: number?,
	firstServer: number?,
}

-- 렌더러가 필요로 하는 최소한의 상태. Match 자체도 이 모양을 만족한다.
export type PlayerView = {
	x: number,
	y: number,
	vx: number,
	dir: number,
	onGround: boolean,
	swingT: number,
	swingStyle: number,
}

export type View = {
	time: number,
	phase: string,
	server: number,
	winner: number,
	score: { number },
	shuttle: { x: number, y: number, vx: number, vy: number, grounded: boolean },
	players: { PlayerView },
}

type HistoryEntry = {
	time: number,
	active: boolean,
	hitCount: number,
	sx: number,
	sy: number,
	px: { number },
	py: { number },
}

type MatchData = {
	time: number,
	phase: string,
	phaseTimer: number,
	serveTimer: number,
	server: number,
	winner: number,
	score: { number },
	lastHitter: number,
	hitCount: number,
	lastReason: string,
	pointsToWin: number,
	winBy: number,
	maxPoints: number,
	players: { Player },
	shuttle: ShuttleState,
	rng: Rng.Rng,
	pending: { Event },
	history: { HistoryEntry },
	historyHead: number,
}

local Match = {}
Match.__index = Match

export type Match = typeof(setmetatable({} :: MatchData, Match))

local EMPTY_INPUT: Input = { move = 0, jump = false, hit = false, drop = false }

local PHASE_CODES = { serve = 1, rally = 2, point = 3, over = 4 }
local PHASE_NAMES = { "serve", "rally", "point", "over" }

local function approach(value: number, target: number, maxDelta: number): number
	if value < target then
		return math.min(value + maxDelta, target)
	end
	return math.max(value - maxDelta, target)
end

local function newPlayer(side: number): Player
	return {
		side = side,
		dir = if side == 1 then 1 else -1,
		x = 0,
		y = 0,
		vx = 0,
		vy = 0,
		onGround = true,
		swingT = -1,
		swingKind = "power",
		swingStyle = 0,
		swingHit = false,
		cooldown = 0,
		lookback = 0,
	}
end

-- 선수가 움직일 수 있는 x 범위
function Match.bounds(side: number): (number, number)
	if side == 1 then
		return Config.WALL_MARGIN, NET_X - Config.PLAYER_HALF_WIDTH
	end
	return NET_X + Config.PLAYER_HALF_WIDTH, Config.VIEW_WIDTH - Config.WALL_MARGIN
end

-- (px, py)에 서서 dir 방향을 보는 선수에게 (sx, sy)의 셔틀이 타격 범위 안인지와 스윗 스팟까지의 거리
function Match.zoneInfo(px: number, py: number, dir: number, sx: number, sy: number): (boolean, number)
	local dx = (sx - px) * dir
	local dy = sy - py
	local inZone = dx >= Config.HIT_ZONE_BACK
		and dx <= Config.HIT_ZONE_FRONT
		and dy >= Config.HIT_ZONE_LOW
		and dy <= Config.HIT_ZONE_HIGH
	local ex = dx - Config.SWEET_SPOT_X
	local ey = 0
	if dy < Config.SWEET_SPOT_LOW then
		ey = dy - Config.SWEET_SPOT_LOW
	elseif dy > Config.SWEET_SPOT_HIGH then
		ey = dy - Config.SWEET_SPOT_HIGH
	end
	return inZone, math.sqrt(ex * ex + ey * ey)
end

function Match.qualityFromDistance(dist: number): number
	return 1 - math.clamp(dist / Config.SWEET_RADIUS, 0, 1)
end

function Match.new(options: Options?): Match
	local opts: Options = options or {}
	local self = setmetatable(
		{
			time = 0,
			phase = "serve",
			phaseTimer = 0,
			serveTimer = 0,
			server = opts.firstServer or 1,
			winner = 0,
			score = { 0, 0 },
			lastHitter = 0,
			hitCount = 0,
			lastReason = "",
			pointsToWin = opts.pointsToWin or Config.POINTS_TO_WIN,
			winBy = opts.winBy or Config.WIN_BY,
			maxPoints = opts.maxPoints or Config.MAX_POINTS,
			players = { newPlayer(1), newPlayer(2) },
			shuttle = { x = 0, y = 0, vx = 0, vy = 0, grounded = false, hitNet = false },
			rng = Rng.new(opts.seed),
			pending = {},
			history = {},
			historyHead = 0,
		} :: MatchData,
		Match
	)
	self:setupServe()
	return self
end

function Match.emit(self: Match, event: Event)
	table.insert(self.pending, event)
end

function Match.holdShuttle(self: Match)
	local p = self.players[self.server]
	local s = self.shuttle
	s.x = p.x + p.dir * 0.45
	s.y = Config.SERVE_CONTACT_HEIGHT
	s.vx = 0
	s.vy = 0
	s.grounded = false
	s.hitNet = false
end

function Match.setupServe(self: Match)
	self.phase = "serve"
	self.serveTimer = 0
	self.lastHitter = 0
	self.hitCount = 0
	for _, p in self.players do
		local distance = if p.side == self.server then 2.6 else 3.3
		p.x = NET_X - p.dir * distance
		p.y = 0
		p.vx = 0
		p.vy = 0
		p.onGround = true
		p.swingT = -1
		p.swingHit = false
		p.cooldown = 0
	end
	self:holdShuttle()
	self:emit({ kind = "serveReady", side = self.server })
end

function Match.isWon(self: Match, side: number): boolean
	local mine, theirs = self.score[side], self.score[3 - side]
	return mine >= self.maxPoints or (mine >= self.pointsToWin and mine - theirs >= self.winBy)
end

function Match.updatePlayer(self: Match, p: Player, input: Input, dt: number, locked: boolean)
	local move = input.move
	if locked or move ~= move then -- move ~= move 는 NaN 검사
		move = 0
	end
	move = math.clamp(move, -1, 1)

	local accel = if p.onGround then Config.GROUND_ACCEL else Config.AIR_ACCEL
	p.vx = approach(p.vx, move * Config.PLAYER_SPEED, accel * dt)
	if not locked and input.jump and p.onGround then
		p.vy = Config.JUMP_VELOCITY
		p.onGround = false
	end
	if not p.onGround then
		p.vy -= Config.PLAYER_GRAVITY * dt
	end
	p.x += p.vx * dt
	p.y += p.vy * dt
	if p.y <= 0 then
		p.y = 0
		p.vy = 0
		p.onGround = true
	end
	local minX, maxX = Match.bounds(p.side)
	if p.x < minX or p.x > maxX then
		p.x = math.clamp(p.x, minX, maxX)
		p.vx = 0
	end

	if p.swingT >= 0 then
		p.swingT += dt
		if p.swingT >= Config.SWING_DURATION then
			p.swingT = -1
			p.cooldown = Config.SWING_COOLDOWN
		end
	elseif p.cooldown > 0 then
		p.cooldown = math.max(0, p.cooldown - dt)
	end

	if not locked and (input.hit or input.drop) and p.swingT < 0 and p.cooldown <= 0 then
		p.swingT = 0
		p.swingKind = if input.hit then "power" else "soft"
		p.swingHit = false
		p.swingStyle = if self.shuttle.y - p.y < 1.25 then 1 else 0
		local lookback = input.lookback or 0
		p.lookback = if lookback == lookback then math.clamp(lookback, 0, Config.MAX_LOOKBACK) else 0
	end
end

function Match.serve(self: Match, short: boolean)
	local p = self.players[self.server]
	local s = self.shuttle
	local kind: Shots.ShotKind = if short then "serveShort" else "serveHigh"
	s.vx, s.vy = Shots.plan(kind, s.x, s.y, p.dir, 0.85, self.rng)
	p.swingT = 0
	p.swingKind = if short then "soft" else "power"
	p.swingStyle = 1
	p.swingHit = true
	self.lastHitter = p.side
	self.hitCount = 1
	self.phase = "rally"
	self:emit({ kind = "hit", side = p.side, shot = kind, quality = 0.85, x = s.x, y = s.y })
end

function Match.historyAt(self: Match, ago: number): HistoryEntry?
	local wanted = self.time - ago
	local best: HistoryEntry? = nil
	local bestDiff = Config.TICK * 0.75
	for _, h in self.history do
		local diff = math.abs(h.time - wanted)
		if diff < bestDiff then
			best = h
			bestDiff = diff
		end
	end
	return best
end

function Match.recordHistory(self: Match)
	self.historyHead = self.historyHead % HISTORY_SIZE + 1
	local h = self.history[self.historyHead]
	if not h then
		h = { time = 0, active = false, hitCount = 0, sx = 0, sy = 0, px = { 0, 0 }, py = { 0, 0 } }
		self.history[self.historyHead] = h
	end
	local s = self.shuttle
	h.time = self.time
	h.active = self.phase == "rally" and not s.grounded
	h.hitCount = self.hitCount
	h.sx = s.x
	h.sy = s.y
	for i, p in self.players do
		h.px[i] = p.x
		h.py[i] = p.y
	end
end

function Match.tryHit(self: Match, p: Player)
	if p.swingT < 0 or p.swingT > Config.SWING_ACTIVE or p.swingHit then
		return
	end
	local s = self.shuttle
	if self.lastHitter == p.side or s.grounded then
		return -- 같은 선수가 연속으로 칠 수 없다
	end

	local quality = -1 -- 0 이상이면 맞힌 것
	local contactY = s.y
	local airborne = not p.onGround

	-- 상대 코트 깊숙이 있는 셔틀은 칠 수 없다
	if (s.x - NET_X) * p.dir <= Config.NET_REACH then
		local inZone, dist = Match.zoneInfo(p.x, p.y, p.dir, s.x, s.y)
		if inZone then
			quality = Match.qualityFromDistance(dist)
		end
	end

	-- 온라인 지연 보정: 클라이언트 화면에 보였던 과거 시점에서도 판정해서 더 좋은 쪽을 쓴다
	if p.lookback > 0 then
		local h = self:historyAt(p.lookback)
		if h and h.active and h.hitCount == self.hitCount and (h.sx - NET_X) * p.dir <= Config.NET_REACH then
			local hy = h.py[p.side]
			local inZone, dist = Match.zoneInfo(h.px[p.side], hy, p.dir, h.sx, h.sy)
			local q = Match.qualityFromDistance(dist)
			if inZone and q > quality then
				quality = q
				contactY = h.sy
				airborne = hy > 0.01
			end
		end
	end

	if quality < 0 then
		return
	end
	-- 빠르게 날아오는 셔틀(스매시 등)과 달리면서 치는 샷은 정확하게 받아치기 어렵다
	local incoming = math.sqrt(s.vx * s.vx + s.vy * s.vy)
	quality *= 1 - math.clamp((incoming - Config.FAST_SHOT_SPEED) / 18, 0, 0.6)
	quality *= 1 - 0.2 * math.min(math.abs(p.vx) / Config.PLAYER_SPEED, 1)

	local shot: Shots.ShotKind
	if p.swingKind == "power" then
		if airborne and contactY >= Config.SMASH_MIN_HEIGHT then
			shot = "smash"
		elseif contactY < Config.LOW_CONTACT_HEIGHT then
			shot = "lift"
		else
			shot = "clear"
		end
	else
		shot = if contactY < Config.LOW_CONTACT_HEIGHT then "net" else "drop"
	end

	s.vx, s.vy = Shots.plan(shot, s.x, s.y, p.dir, quality, self.rng)
	s.hitNet = false
	p.swingHit = true
	self.lastHitter = p.side
	self.hitCount += 1
	self:emit({ kind = "hit", side = p.side, shot = shot, quality = quality, x = s.x, y = s.y })
end

function Match.endRally(self: Match, landX: number)
	local s = self.shuttle
	local fromNet = math.abs(landX - NET_X)
	local inBounds = fromNet <= HALF
	local landedSide = if landX < NET_X then 1 else 2
	local loser: number
	local reason: string

	if self.hitCount == 1 and landedSide ~= self.server and inBounds and fromNet < Config.SHORT_SERVICE_DIST then
		loser, reason = self.server, "short"
	elseif not inBounds then
		loser, reason = self.lastHitter, "out"
	elseif landedSide == self.lastHitter then
		loser, reason = landedSide, if s.hitNet then "net" else "fault"
	else
		loser, reason = landedSide, "in"
	end
	if loser ~= 1 and loser ~= 2 then
		loser = landedSide
	end

	local winner = 3 - loser
	self.score[winner] += 1
	self.server = winner
	self.phase = "point"
	self.phaseTimer = Config.POINT_PAUSE
	self.lastReason = reason
	if self:isWon(winner) then
		self.winner = winner
	end
	self:emit({ kind = "point", side = winner, reason = reason, x = landX })
end

function Match.moveShuttle(self: Match, dt: number)
	local s = self.shuttle
	if s.grounded then
		return
	end
	local steps = Config.SHUTTLE_SUBSTEPS
	local h = dt / steps
	for _ = 1, steps do
		local px, py = s.x, s.y
		Shuttle.step(s, h)

		-- 네트(x = NET_X, 0 <= y <= NET_HEIGHT)에 걸리면 온 쪽으로 힘없이 떨어진다
		if px ~= s.x and (px - NET_X) * (s.x - NET_X) <= 0 then
			local a = (NET_X - px) / (s.x - px)
			local crossY = py + (s.y - py) * a
			if crossY <= Config.NET_HEIGHT and crossY >= 0 then
				local back = if px < NET_X then -1 else 1
				s.x = NET_X + back * 0.07
				s.y = crossY
				s.vx = -s.vx * 0.12
				s.vy = math.min(s.vy, 0) * 0.3
				s.hitNet = true
				self:emit({ kind = "net", x = s.x, y = s.y })
				px, py = s.x, s.y
			end
		end

		if s.y <= 0 then
			if py > 0 then
				local a = py / (py - s.y)
				s.x = px + (s.x - px) * a
			end
			s.y = 0
			s.vx = 0
			s.vy = 0
			s.grounded = true
			if self.phase == "rally" then
				self:endRally(s.x)
			end
			return
		end
	end
end

-- 고정 시간 간격(dt)으로 한 틱 진행하고, 이번 틱에 일어난 이벤트 목록을 돌려준다.
function Match.step(self: Match, dt: number, inputs: { Input }): { Event }
	self.time += dt
	local phase = self.phase

	for i, p in self.players do
		local locked = phase == "over" or (phase == "serve" and i == self.server)
		self:updatePlayer(p, inputs[i] or EMPTY_INPUT, dt, locked)
	end

	if phase == "serve" then
		local input = inputs[self.server] or EMPTY_INPUT
		self:holdShuttle()
		self.serveTimer += dt
		if input.hit or input.drop or self.serveTimer >= Config.SERVE_TIMEOUT then
			self:serve(input.drop and not input.hit)
		end
	elseif phase == "rally" then
		for _, p in self.players do
			self:tryHit(p)
		end
		self:moveShuttle(dt)
	elseif phase == "point" then
		self:moveShuttle(dt)
		self.phaseTimer -= dt
		if self.phaseTimer <= 0 then
			if self.winner ~= 0 then
				self.phase = "over"
				self:emit({ kind = "gameOver", side = self.winner })
			else
				self:setupServe()
			end
		end
	end

	self:recordHistory()
	local events = self.pending
	self.pending = {}
	return events
end

-- 네트워크 전송용 압축 표현
function Match.pack(self: Match): { number }
	local s = self.shuttle
	local a, b = self.players[1], self.players[2]
	return {
		self.time,
		PHASE_CODES[self.phase] or 1,
		self.server,
		self.score[1],
		self.score[2],
		self.winner,
		s.x,
		s.y,
		s.vx,
		s.vy,
		if s.grounded then 1 else 0,
		a.x,
		a.y,
		a.vx,
		a.swingT,
		a.swingStyle,
		if a.onGround then 1 else 0,
		b.x,
		b.y,
		b.vx,
		b.swingT,
		b.swingStyle,
		if b.onGround then 1 else 0,
	}
end

local function num(value: any, default: number): number
	if typeof(value) == "number" and value == value then
		return value
	end
	return default
end

function Match.unpack(data: { any }): View
	local function playerAt(offset: number, dir: number): PlayerView
		return {
			x = num(data[offset], 0),
			y = num(data[offset + 1], 0),
			vx = num(data[offset + 2], 0),
			dir = dir,
			swingT = num(data[offset + 3], -1),
			swingStyle = num(data[offset + 4], 0),
			onGround = num(data[offset + 5], 1) == 1,
		}
	end
	return {
		time = num(data[1], 0),
		phase = PHASE_NAMES[num(data[2], 1)] or "serve",
		server = num(data[3], 1),
		score = { num(data[4], 0), num(data[5], 0) },
		winner = num(data[6], 0),
		shuttle = {
			x = num(data[7], NET_X),
			y = num(data[8], 0),
			vx = num(data[9], 0),
			vy = num(data[10], 0),
			grounded = num(data[11], 0) == 1,
		},
		players = { playerAt(12, 1), playerAt(18, -1) },
	}
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- 두 스냅샷 사이를 보간한다 (t = 0 이면 a, 1 이면 b)
function Match.lerpView(a: View, b: View, t: number): View
	if a.phase ~= b.phase or t >= 1 then
		return b
	end
	if t <= 0 then
		return a
	end
	local players = {}
	for i, pb in b.players do
		local pa = a.players[i]
		local swingT = if t < 0.5 then pa.swingT else pb.swingT
		if pa.swingT >= 0 and pb.swingT >= pa.swingT then
			swingT = lerp(pa.swingT, pb.swingT, t)
		end
		players[i] = {
			x = lerp(pa.x, pb.x, t),
			y = lerp(pa.y, pb.y, t),
			vx = lerp(pa.vx, pb.vx, t),
			dir = pb.dir,
			onGround = pb.onGround,
			swingT = swingT,
			swingStyle = if t < 0.5 then pa.swingStyle else pb.swingStyle,
		}
	end
	local sa, sb = a.shuttle, b.shuttle
	return {
		time = lerp(a.time, b.time, t),
		phase = b.phase,
		server = b.server,
		winner = b.winner,
		score = b.score,
		shuttle = if sa.grounded ~= sb.grounded
			then sb
			else {
				x = lerp(sa.x, sb.x, t),
				y = lerp(sa.y, sb.y, t),
				vx = lerp(sa.vx, sb.vx, t),
				vy = lerp(sa.vy, sb.vy, t),
				grounded = sb.grounded,
			},
		players = players,
	}
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Rng</string>
          <string name="Source"><![CDATA[--!strict
-- 시드 고정이 가능한 작은 xorshift32 난수 생성기.
-- Roblox의 Random 대신 사용해서 테스트(Lune)에서도 같은 결과를 재현할 수 있게 한다.

local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { state: number }, Rng))

function Rng.new(seed: number?): Rng
	local s = math.floor(seed or 0x2545F491) % 4294967296
	if s == 0 then
		s = 0x2545F491
	end
	return setmetatable({ state = s }, Rng)
end

-- [0, 1) 범위의 실수
function Rng.next(self: Rng): number
	local s = self.state
	s = bit32.bxor(s, bit32.lshift(s, 13))
	s = bit32.bxor(s, bit32.rshift(s, 17))
	s = bit32.bxor(s, bit32.lshift(s, 5))
	self.state = s
	return s / 4294967296
end

function Rng.range(self: Rng, min: number, max: number): number
	return min + (max - min) * self:next()
end

-- -1 ~ 1 사이, 0 근처가 더 자주 나오는 값 (두 균등 분포의 평균)
function Rng.spread(self: Rng): number
	return self:next() + self:next() - 1
end

function Rng.chance(self: Rng, p: number): boolean
	return self:next() < p
end

return Rng
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Shots</string>
          <string name="Source"><![CDATA[--!strict
-- 샷 종류별로 목표 지점을 정하고, 셔틀콕 물리로 역산해서 발사 속도를 구한다.
-- quality(0~1)는 스윗 스팟에 얼마나 가깝게 맞혔는지이며, 낮을수록 오차가 커진다.

local Config = require(script.Parent.Config)
local Shuttle = require(script.Parent.Shuttle)
local Rng = require(script.Parent.Rng)

local Shots = {}

export type ShotKind = "clear" | "lift" | "drop" | "net" | "smash" | "serveHigh" | "serveShort"

local NET_X = Config.NET_X
local HALF = Config.COURT_HALF_LENGTH
local DEG = math.pi / 180

-- 코트 깊숙이 보내는 높은 샷. 필요한 속도가 너무 크면(멀리서 치면) 각도를 낮춰서
-- 셔틀이 화면 위로 너무 높이 뜨지 않게 한다.
local function deepArc(
	x0: number,
	y0: number,
	dir: number,
	distance: number,
	angleDeg: number,
	maxSpeed: number
): (number, number)
	local angle = angleDeg
	local speed = Shuttle.solveSpeed(x0, y0, angle * DEG, dir, distance)
	while speed > maxSpeed and angle > 26 do
		angle -= 4
		speed = Shuttle.solveSpeed(x0, y0, angle * DEG, dir, distance)
	end
	return Shuttle.launch(angle * DEG, speed, dir)
end

-- 목표 지점에 떨어지면서 네트를 margin 이상 넘는 가장 낮은 각도를 고른다.
-- 낮은 각도일수록 빠르고 공격적인 샷이 된다. 10도 간격으로 훑은 뒤 경계를 이분 탐색한다.
local function lowestClearingArc(
	x0: number,
	y0: number,
	dir: number,
	distance: number,
	fromDeg: number,
	toDeg: number,
	margin: number
): (number, number)
	local function try(deg: number): (number, boolean)
		local speed, flight = Shuttle.solveSpeed(x0, y0, deg * DEG, dir, distance)
		return speed, Shuttle.clearsNet(flight, dir, margin)
	end

	local failedDeg = fromDeg
	for deg = fromDeg, toDeg, 10 do
		local speed, ok = try(deg)
		if ok then
			if deg == fromDeg then
				return Shuttle.launch(deg * DEG, speed, dir)
			end
			local lo, hi, hiSpeed = failedDeg, deg, speed
			for _ = 1, 4 do
				local mid = (lo + hi) / 2
				local midSpeed, midOk = try(mid)
				if midOk then
					hi, hiSpeed = mid, midSpeed
				else
					lo = mid
				end
			end
			return Shuttle.launch(hi * DEG, hiSpeed, dir)
		end
		failedDeg = deg
	end
	-- 너무 멀거나 낮은 타점이라 짧게 넘길 수 없으면 높게 띄워 넘긴다
	return deepArc(x0, y0, dir, distance, 45, 36)
end

-- 품질이 낮을수록 실수(아웃, 네트)가 나올 확률이 급격히 커진다
local function blunder(rng: Rng.Rng, err: number, scale: number): boolean
	return rng:chance(err * err * scale)
end

-- dir: 샷을 보내는 방향 (+1 = 오른쪽 코트로)
function Shots.plan(
	kind: ShotKind,
	x0: number,
	y0: number,
	dir: number,
	quality: number,
	rng: Rng.Rng
): (number, number)
	local err = 1 - math.clamp(quality, 0, 1)
	local backLine = NET_X + dir * HALF

	if kind == "clear" or kind == "lift" then
		-- 품질이 낮으면 대부분 짧게(코트 중간에) 떨어지고, 가끔 길게 나가 아웃이 된다
		local targetX = backLine - dir * (rng:range(0.6, 1.6) + err * rng:range(0, 4)) + dir * rng:spread() * err * 2.2
		if blunder(rng, err, 0.6) then
			targetX = backLine + dir * rng:range(0.15, 1.3)
		end
		if kind == "lift" then
			return deepArc(x0, y0, dir, (targetX - x0) * dir, rng:range(52, 60), 36)
		end
		return deepArc(x0, y0, dir, (targetX - x0) * dir, rng:range(44, 52), 34)
	elseif kind == "serveHigh" then
		local targetX = backLine - dir * rng:range(0.5, 1.4) + dir * rng:spread() * err * 2
		return deepArc(x0, y0, dir, (targetX - x0) * dir, rng:range(52, 58), 36)
	elseif kind == "drop" then
		local targetX = NET_X + dir * (rng:range(0.9, 2.3) + math.abs(rng:spread()) * err * 2)
		local margin = 0.25 - err * 0.35 + rng:range(0, 0.1)
		if blunder(rng, err, 0.5) then
			margin = rng:range(-0.25, -0.02)
		end
		return lowestClearingArc(x0, y0, dir, (targetX - x0) * dir, -30, 75, margin)
	elseif kind == "net" then
		local targetX = NET_X + dir * (rng:range(0.45, 1.15) + err * 0.8)
		local margin = 0.12 - err * 0.25 + rng:range(0, 0.1)
		if blunder(rng, err, 0.5) then
			margin = rng:range(-0.25, -0.02)
		end
		return lowestClearingArc(x0, y0, dir, (targetX - x0) * dir, 15, 85, margin)
	elseif kind == "serveShort" then
		local targetX = NET_X + dir * (Config.SHORT_SERVICE_DIST + rng:range(0.3, 1.0))
		return lowestClearingArc(x0, y0, dir, (targetX - x0) * dir, 5, 75, rng:range(0.1, 0.2))
	else -- smash
		local speed = Config.SMASH_SPEED * (0.85 + 0.15 * (1 - err))
		local targetX = NET_X + dir * rng:range(1.6, 5.2)
		local distance = math.max((targetX - x0) * dir, 0.5)
		local angle, flight = Shuttle.solveAngle(x0, y0, speed, dir, distance, -70 * DEG, 20 * DEG)
		-- 네트에 걸리는 각도면 조금씩 들어 올린다. 그래도 낮은 타점이면 네트에 걸릴 수 있다.
		local tries = 0
		local margin = 0.06 + 0.2 * (1 - err)
		while not Shuttle.clearsNet(flight, dir, margin) and angle < 25 * DEG and tries < 20 do
			angle += 2 * DEG
			local vx, vy = Shuttle.launch(angle, speed, dir)
			flight = Shuttle.simulate(x0, y0, vx, vy)
			tries += 1
		end
		angle += rng:spread() * err * 8 * DEG
		if blunder(rng, err, 0.5) then
			angle -= rng:range(3, 7) * DEG
		end
		return Shuttle.launch(angle, speed, dir)
	end
end

return Shots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Shuttle</string>
          <string name="Source"><![CDATA[--!strict
-- 셔틀콕 물리: 중력 + 속도 제곱 공기 저항(quadratic drag).
-- 셔틀콕은 처음엔 빠르게 날아가다가 급격히 느려지고 거의 수직으로 떨어지는데,
-- 이 특징이 quadratic drag에서 자연스럽게 나온다.

local Config = require(script.Parent.Config)

local Shuttle = {}

export type Body = { x: number, y: number, vx: number, vy: number }

export type Flight = {
	landX: number, -- 바닥(y = 0)에 닿는 x
	landTime: number,
	netY: number?, -- 네트 평면(x = NET_X)을 지날 때의 높이, 지나지 않으면 nil
	apexY: number,
}

local GRAVITY = Config.GRAVITY
local DRAG = Config.DRAG
local NET_X = Config.NET_X
local SOLVER_DT = 1 / 120

-- 한 스텝 적분. drag 항은 암시적(implicit)으로 처리해 큰 속도에서도 안정적이다.
function Shuttle.step(body: Body, dt: number)
	local speed = math.sqrt(body.vx * body.vx + body.vy * body.vy)
	local f = 1 / (1 + DRAG * speed * dt)
	body.vx *= f
	body.vy = body.vy * f - GRAVITY * dt
	body.x += body.vx * dt
	body.y += body.vy * dt
end

-- 주어진 초기 상태에서 바닥에 닿을 때까지 비행을 시뮬레이션한다 (네트 충돌은 무시).
function Shuttle.simulate(x: number, y: number, vx: number, vy: number, maxTime: number?): Flight
	local limit = maxTime or 8
	local body = { x = x, y = y, vx = vx, vy = vy }
	local t = 0
	local netY: number? = nil
	local apex = y
	if y <= 0 then
		return { landX = x, landTime = 0, netY = nil, apexY = y }
	end
	while t < limit do
		local px, py = body.x, body.y
		Shuttle.step(body, SOLVER_DT)
		t += SOLVER_DT
		if body.y > apex then
			apex = body.y
		end
		if netY == nil and px ~= body.x and (px - NET_X) * (body.x - NET_X) <= 0 then
			local a = (NET_X - px) / (body.x - px)
			netY = py + (body.y - py) * a
		end
		if body.y <= 0 then
			local a = py / (py - body.y)
			return {
				landX = px + (body.x - px) * a,
				landTime = t - SOLVER_DT + SOLVER_DT * a,
				netY = netY,
				apexY = apex,
			}
		end
	end
	return { landX = body.x, landTime = t, netY = netY, apexY = apex }
end

local function launch(angle: number, speed: number, dir: number): (number, number)
	return math.cos(angle) * speed * dir, math.sin(angle) * speed
end

-- 고정된 발사 각도에서 (landX - x0) * dir == distance 가 되는 속도를 이분 탐색으로 찾는다.
function Shuttle.solveSpeed(x0: number, y0: number, angle: number, dir: number, distance: number): (number, Flight)
	local function fly(speed: number): Flight
		local vx, vy = launch(angle, speed, dir)
		return Shuttle.simulate(x0, y0, vx, vy)
	end
	-- 대부분의 샷은 24 이하의 속도라서 먼저 좁은 구간을 확인해 계산량을 줄인다
	local lo, hi = 1, 24
	local hiFlight = fly(hi)
	if (hiFlight.landX - x0) * dir < distance then
		lo, hi = 24, 80
		hiFlight = fly(hi)
		if (hiFlight.landX - x0) * dir <= distance then
			return hi, hiFlight
		end
	end
	for _ = 1, 12 do
		local mid = (lo + hi) / 2
		local flight = fly(mid)
		if (flight.landX - x0) * dir < distance then
			lo = mid
		else
			hi, hiFlight = mid, flight
		end
	end
	return hi, hiFlight
end

-- 고정된 속도에서 원하는 비거리가 나오는 각도를 찾는다 (스매시용, 각도 구간 안에서 단조 증가 가정).
function Shuttle.solveAngle(
	x0: number,
	y0: number,
	speed: number,
	dir: number,
	distance: number,
	minAngle: number,
	maxAngle: number
): (number, Flight)
	local lo, hi = minAngle, maxAngle
	for _ = 1, 16 do
		local mid = (lo + hi) / 2
		local vx, vy = launch(mid, speed, dir)
		local flight = Shuttle.simulate(x0, y0, vx, vy)
		if (flight.landX - x0) * dir < distance then
			lo = mid
		else
			hi = mid
		end
	end
	local angle = (lo + hi) / 2
	local vx, vy = launch(angle, speed, dir)
	return angle, Shuttle.simulate(x0, y0, vx, vy)
end

-- 네트를 margin 이상 여유 있게 넘어 상대 코트에 떨어지는지
function Shuttle.clearsNet(flight: Flight, dir: number, margin: number): boolean
	if (flight.landX - NET_X) * dir <= 0 then
		return false
	end
	local netY = flight.netY
	return netY == nil or netY >= Config.NET_HEIGHT + margin
end

Shuttle.launch = launch

return Shuttle
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">MatchServer</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- 온라인 1:1 매칭과 경기 진행. 서버가 Match 시뮬레이션을 직접 돌리고(서버 권위),
-- 클라이언트는 입력만 보내고 스냅샷을 받아 그린다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Match = require(Shared:WaitForChild("Match"))

local TICK = Config.TICK
local SNAPSHOT_INTERVAL = 1 / Config.SNAPSHOT_RATE
local END_DELAY = 3 -- 경기가 끝난 뒤 결과를 보여주는 시간

-- 이 게임은 GUI로만 플레이하므로 3D 캐릭터는 필요 없다
Players.CharacterAutoLoads = false
for _, p in Players:GetPlayers() do
	if p.Character then
		p.Character:Destroy()
	end
end

local remotes = Instance.new("Folder")
remotes.Name = Config.REMOTES_FOLDER
local queueRemote = Instance.new("RemoteEvent")
queueRemote.Name = "Queue"
queueRemote.Parent = remotes
local inputRemote = Instance.new("RemoteEvent")
inputRemote.Name = "Input"
inputRemote.Parent = remotes
local eventRemote = Instance.new("RemoteEvent")
eventRemote.Name = "MatchEvent"
eventRemote.Parent = remotes
local snapshotRemote = Instance.new("UnreliableRemoteEvent")
snapshotRemote.Name = "Snapshot"
snapshotRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

type Session = {
	players: { Player },
	match: Match.Match,
	inputs: { Match.Input },
	accumulator: number,
	snapshotTimer: number,
	overTime: number,
	finished: boolean,
}

local waiting: { Player } = {}
local sessions: { Session } = {}
local sessionOf: { [Player]: Session } = {}
local sideOf: { [Player]: number } = {}

local function newInput(): Match.Input
	return { move = 0, jump = false, hit = false, drop = false, lookback = 0 }
end

local function sendAll(session: Session, kind: string, payload: any)
	for _, p in session.players do
		if p.Parent then
			eventRemote:FireClient(p, kind, payload)
		end
	end
end

-- 클라이언트가 스윙을 눌렀을 때 보고 있던 화면은 (왕복 지연 + 보간 지연)만큼 과거다
local function lookbackFor(p: Player): number
	local ok, ping = pcall(function()
		return p:GetNetworkPing()
	end)
	local rtt = if ok and typeof(ping) == "number" then ping else 0.1
	return math.clamp(rtt + Config.INTERP_DELAY + SNAPSHOT_INTERVAL / 2, 0, Config.MAX_LOOKBACK)
end

local function removeWaiting(p: Player)
	local index = table.find(waiting, p)
	if index then
		table.remove(waiting, index)
	end
end

local function startSession(a: Player, b: Player)
	local session: Session = {
		players = { a, b },
		match = Match.new({ seed = math.random(1, 2 ^ 30), firstServer = math.random(1, 2) }),
		inputs = { newInput(), newInput() },
		accumulator = 0,
		snapshotTimer = 0,
		overTime = 0,
		finished = false,
	}
	table.insert(sessions, session)
	local names = { a.DisplayName, b.DisplayName }
	local userIds = { a.UserId, b.UserId }
	for side, p in session.players do
		sessionOf[p] = session
		sideOf[p] = side
		eventRemote:FireClient(p, "start", { side = side, names = names, userIds = userIds })
	end
end

local function endSession(session: Session, winner: number, reason: string)
	if session.finished then
		return
	end
	session.finished = true
	sendAll(session, "end", { winner = winner, reason = reason })
	for _, p in session.players do
		if sessionOf[p] == session then
			sessionOf[p] = nil
			sideOf[p] = nil
		end
	end
	local index = table.find(sessions, session)
	if index then
		table.remove(sessions, index)
	end
end

local function forfeit(p: Player)
	local session = sessionOf[p]
	local side = sideOf[p]
	if session and side then
		endSession(session, 3 - side, "forfeit")
	end
end

queueRemote.OnServerEvent:Connect(function(p: Player, action: any)
	if action == "join" then
		if sessionOf[p] or table.find(waiting, p) then
			return
		end
		table.insert(waiting, p)
		eventRemote:FireClient(p, "queued", { count = #waiting })
		while #waiting >= 2 do
			local a = table.remove(waiting, 1) :: Player
			local b = table.remove(waiting, 1) :: Player
			startSession(a, b)
		end
	elseif action == "leave" then
		removeWaiting(p)
	elseif action == "forfeit" then
		forfeit(p)
	end
end)

inputRemote.OnServerEvent:Connect(function(p: Player, move: any, jump: any, hit: any, drop: any)
	local session = sessionOf[p]
	local side = sideOf[p]
	if not session or not side then
		return
	end
	local input = session.inputs[side]
	input.move = if typeof(move) == "number" and move == move then math.clamp(move, -1, 1) else 0
	input.jump = jump == true
	-- 눌린 순간 입력은 다음 틱에서 처리될 때까지 유지한다
	if hit == true then
		input.hit = true
	end
	if drop == true then
		input.drop = true
	end
end)

Players.PlayerRemoving:Connect(function(p: Player)
	removeWaiting(p)
	forfeit(p)
end)

RunService.Heartbeat:Connect(function(dt: number)
	for i = #sessions, 1, -1 do
		local session = sessions[i]
		local match = session.match
		local batch: { Match.Event } = {}

		session.accumulator = math.min(session.accumulator + dt, TICK * 8)
		while session.accumulator >= TICK do
			session.accumulator -= TICK
			for side, p in session.players do
				session.inputs[side].lookback = lookbackFor(p)
			end
			for _, event in match:step(TICK, session.inputs) do
				table.insert(batch, event)
			end
			for _, input in session.inputs do
				input.hit = false
				input.drop = false
			end
		end

		if #batch > 0 then
			sendAll(session, "events", { time = match.time, events = batch })
		end

		session.snapshotTimer += dt
		if session.snapshotTimer >= SNAPSHOT_INTERVAL then
			session.snapshotTimer = math.min(session.snapshotTimer - SNAPSHOT_INTERVAL, SNAPSHOT_INTERVAL)
			local packed = match:pack()
			for _, p in session.players do
				if p.Parent then
					snapshotRemote:FireClient(p, packed)
				end
			end
		end

		if match.phase == "over" then
			session.overTime += dt
			if session.overTime >= END_DELAY then
				endSession(session, match.winner, "finished")
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="12">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="13">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[--!strict
-- 키보드, 마우스, 게임패드, 터치 입력을 모아서 Match.Input으로 만든다.
-- 강타/드롭 같은 "눌린 순간" 입력은 sample()에서 한 번만 전달되고 지워진다.

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Match = require(Shared:WaitForChild("Match"))
local Strings = require(script.Parent:WaitForChild("Strings"))

local LEFT_KEYS = { [Enum.KeyCode.A] = true, [Enum.KeyCode.Left] = true, [Enum.KeyCode.DPadLeft] = true }
local RIGHT_KEYS = { [Enum.KeyCode.D] = true, [Enum.KeyCode.Right] = true, [Enum.KeyCode.DPadRight] = true }
local JUMP_KEYS = {
	[Enum.KeyCode.W] = true,
	[Enum.KeyCode.Up] = true,
	[Enum.KeyCode.Space] = true,
	[Enum.KeyCode.ButtonA] = true,
}
local HIT_KEYS = { [Enum.KeyCode.J] = true, [Enum.KeyCode.ButtonX] = true, [Enum.KeyCode.ButtonR2] = true }
local DROP_KEYS = { [Enum.KeyCode.K] = true, [Enum.KeyCode.ButtonB] = true, [Enum.KeyCode.ButtonL2] = true }

type ControlsData = {
	enabled: boolean,
	held: { [string]: boolean },
	stickX: number,
	hitPressed: boolean,
	dropPressed: boolean,
	touchOwners: { [InputObject]: string },
	connections: { RBXScriptConnection },
	touchGui: ScreenGui?,
}

local Controls = {}
Controls.__index = Controls

export type Controls = typeof(setmetatable({} :: ControlsData, Controls))

local function actionFor(keyCode: Enum.KeyCode): string?
	if LEFT_KEYS[keyCode] then
		return "left"
	elseif RIGHT_KEYS[keyCode] then
		return "right"
	elseif JUMP_KEYS[keyCode] then
		return "jump"
	elseif HIT_KEYS[keyCode] then
		return "hit"
	elseif DROP_KEYS[keyCode] then
		return "drop"
	end
	return nil
end

function Controls.new(parent: Instance): Controls
	local self = setmetatable(
		{
			enabled = false,
			held = {},
			stickX = 0,
			hitPressed = false,
			dropPressed = false,
			touchOwners = {},
			connections = {},
			touchGui = nil,
		} :: ControlsData,
		Controls
	)

	table.insert(
		self.connections,
		UserInputService.InputBegan:Connect(function(input, processed)
			if processed then
				return -- 채팅 입력이나 버튼 클릭은 무시
			end
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				self:press("hit")
			elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
				self:press("drop")
			else
				local action = actionFor(input.KeyCode)
				if action then
					self:press(action)
				end
			end
		end)
	)
	table.insert(
		self.connections,
		UserInputService.InputEnded:Connect(function(input)
			local action = actionFor(input.KeyCode)
			if action then
				self.held[action] = false
			end
		end)
	)
	table.insert(
		self.connections,
		UserInputService.InputChanged:Connect(function(input)
			if input.KeyCode == Enum.KeyCode.Thumbstick1 then
				local x = input.Position.X
				self.stickX = if math.abs(x) > 0.3 then x else 0
			end
		end)
	)
	table.insert(
		self.connections,
		UserInputService.TouchEnded:Connect(function(touch)
			local action = self.touchOwners[touch]
			if action then
				self.touchOwners[touch] = nil
				self.held[action] = false
			end
		end)
	)

	if UserInputService.TouchEnabled then
		self:buildTouchButtons(parent)
	end
	return self
end

function Controls.press(self: Controls, action: string)
	if not self.enabled then
		return
	end
	self.held[action] = true
	if action == "hit" then
		self.hitPressed = true
	elseif action == "drop" then
		self.dropPressed = true
	end
end

function Controls.buildTouchButtons(self: Controls, parent: Instance)
	local gui = Instance.new("ScreenGui")
	gui.Name = "BadmintonTouch"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.Enabled = false
	gui.Parent = parent
	self.touchGui = gui

	local function button(action: string, text: string, anchor: Vector2, position: UDim2, size: number, color: Color3)
		local b = Instance.new("TextButton")
		b.Text = text
		b.Font = Enum.Font.GothamBlack
		b.TextScaled = true
		b.TextColor3 = Color3.new(1, 1, 1)
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0.35
		b.AutoButtonColor = false
		b.AnchorPoint = anchor
		b.Position = position
		b.Size = UDim2.fromScale(size, size)
		local aspect = Instance.new("UIAspectRatioConstraint")
		aspect.Parent = b
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = b
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0.18, 0)
		padding.PaddingRight = UDim.new(0.18, 0)
		padding.PaddingTop = UDim.new(0.18, 0)
		padding.PaddingBottom = UDim.new(0.18, 0)
		padding.Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				self.touchOwners[input] = action
				self:press(action)
			end
		end)
		b.Parent = gui
	end

	local dark = Color3.fromRGB(30, 34, 50)
	button("left", "◀", Vector2.new(0, 1), UDim2.new(0.03, 0, 0.95, 0), 0.16, dark)
	button("right", "▶", Vector2.new(0, 1), UDim2.new(0.2, 0, 0.95, 0), 0.16, dark)
	button(
		"jump",
		Strings.TouchJump,
		Vector2.new(1, 1),
		UDim2.new(0.97, 0, 0.62, 0),
		0.14,
		Color3.fromRGB(60, 120, 220)
	)
	button("hit", Strings.TouchHit, Vector2.new(1, 1), UDim2.new(0.97, 0, 0.95, 0), 0.17, Color3.fromRGB(220, 70, 70))
	button("drop", Strings.TouchDrop, Vector2.new(1, 1), UDim2.new(0.8, 0, 0.95, 0), 0.14, Color3.fromRGB(70, 170, 110))
end

function Controls.setEnabled(self: Controls, enabled: boolean)
	self.enabled = enabled
	table.clear(self.held)
	table.clear(self.touchOwners)
	self.hitPressed = false
	self.dropPressed = false
	local gui = self.touchGui
	if gui then
		gui.Enabled = enabled
	end
end

function Controls.isTouch(self: Controls): boolean
	return self.touchGui ~= nil and not UserInputService.KeyboardEnabled
end

-- mirror = true 이면 화면이 좌우 반전되어 있으므로 이동 방향도 뒤집는다
function Controls.sample(self: Controls, mirror: boolean): Match.Input
	local move = self.stickX
	if self.held.left then
		move -= 1
	end
	if self.held.right then
		move += 1
	end
	move = math.clamp(move, -1, 1)
	if mirror then
		move = -move
	end
	local input: Match.Input = {
		move = move,
		jump = self.held.jump == true,
		hit = self.hitPressed,
		drop = self.dropPressed,
	}
	self.hitPressed = false
	self.dropPressed = false
	return input
end

function Controls.destroy(self: Controls)
	for _, connection in self.connections do
		connection:Disconnect()
	end
	local gui = self.touchGui
	if gui then
		gui:Destroy()
	end
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Interface</string>
            <string name="Source"><![CDATA[--!strict
-- 메뉴, 매칭 대기, 점수판, 안내 문구, 결과 화면 등 아레나 위에 겹치는 UI.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Match = require(Shared:WaitForChild("Match"))
local Strings = require(script.Parent:WaitForChild("Strings"))

local WHITE = Color3.new(1, 1, 1)
local PANEL = Color3.fromRGB(16, 20, 38)

export type Callbacks = {
	playAi: (difficulty: string) -> (),
	playOnline: () -> (),
	cancelQueue: () -> (),
	menu: () -> (),
	rematch: () -> (),
	forfeit: () -> (),
}

type InterfaceData = {
	gui: ScreenGui,
	menu: Frame,
	queue: Frame,
	queueLabel: TextLabel,
	result: Frame,
	resultTitle: TextLabel,
	resultScore: TextLabel,
	rematchButton: TextButton,
	hud: Frame,
	names: { TextLabel },
	scores: { TextLabel },
	serveDots: { TextLabel },
	message: TextLabel,
	messageAge: number,
	hint: TextLabel,
	exitButton: TextButton,
	queueTime: number,
}

local Interface = {}
Interface.__index = Interface

export type Interface = typeof(setmetatable({} :: InterfaceData, Interface))

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(radius, 0)
	c.Parent = parent
end

local function label(parent: Instance, text: string, size: UDim2, maxText: number): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.Size = size
	l.TextScaled = true
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = WHITE
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = maxText
	limit.Parent = l
	l.Parent = parent
	return l
end

local function button(parent: Instance, text: string, color: Color3, size: UDim2, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Text = text
	b.Size = size
	b.BackgroundColor3 = color
	b.TextColor3 = WHITE
	b.Font = Enum.Font.GothamBlack
	b.TextScaled = true
	b.AutoButtonColor = true
	corner(b, 0.25)
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = 30
	limit.Parent = b
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.18, 0)
	padding.PaddingBottom = UDim.new(0.18, 0)
	padding.Parent = b
	b.Activated:Connect(onClick)
	b.Parent = parent
	return b
end

local function panel(parent: Instance, name: string, size: UDim2, aspect: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = size
	f.BackgroundColor3 = PANEL
	f.BackgroundTransparency = 0.12
	f.Visible = false
	corner(f, 0.06)
	local ratio = Instance.new("UIAspectRatioConstraint")
	ratio.AspectRatio = aspect
	ratio.Parent = f
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 196, 64)
	stroke.Thickness = 2
	stroke.Transparency = 0.4
	stroke.Parent = f
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.05, 0)
	padding.PaddingBottom = UDim.new(0.05, 0)
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.Parent = f
	local list = Instance.new("UIListLayout")
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Padding = UDim.new(0.025, 0)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = f
	f.Parent = parent
	return f
end

local function row(parent: Instance, height: number): Frame
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromScale(1, height)
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Padding = UDim.new(0.03, 0)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = f
	f.Parent = parent
	return f
end

local function order(gui: GuiObject, index: number): GuiObject
	gui.LayoutOrder = index
	return gui
end

function Interface.new(parent: Instance, callbacks: Callbacks): Interface
	local gui = Instance.new("ScreenGui")
	gui.Name = "BadmintonUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 3
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- 메인 메뉴
	local menu = panel(gui, "Menu", UDim2.fromScale(0.55, 0.85), 1.05)
	local title = order(label(menu, Strings.Title, UDim2.fromScale(1, 0.16), 64), 1) :: TextLabel
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = Color3.fromRGB(255, 214, 90)
	order(label(menu, Strings.PlayAi, UDim2.fromScale(1, 0.07), 26), 2)
	local difficulties = order(row(menu, 0.12), 3)
	local diffs = {
		{ level = "Easy", text = Strings.Easy, color = Color3.fromRGB(70, 170, 110) },
		{ level = "Normal", text = Strings.Normal, color = Color3.fromRGB(60, 120, 220) },
		{ level = "Hard", text = Strings.Hard, color = Color3.fromRGB(210, 70, 80) },
	}
	for i, d in diffs do
		local b = button(difficulties, d.text, d.color, UDim2.fromScale(0.3, 1), function()
			callbacks.playAi(d.level)
		end)
		b.LayoutOrder = i
	end
	order(
		button(
			menu,
			Strings.PlayOnline,
			Color3.fromRGB(150, 90, 220),
			UDim2.fromScale(0.96, 0.12),
			callbacks.playOnline
		),
		4
	)
	local controls = order(label(menu, Strings.Controls, UDim2.fromScale(1, 0.16), 18), 5) :: TextLabel
	controls.Font = Enum.Font.Gotham
	controls.TextColor3 = Color3.fromRGB(200, 210, 235)
	local tip = order(label(menu, Strings.Tip, UDim2.fromScale(1, 0.06), 18), 6) :: TextLabel
	tip.TextColor3 = Color3.fromRGB(255, 214, 90)

	-- 매칭 대기
	local queue = panel(gui, "Queue", UDim2.fromScale(0.4, 0.4), 1.8)
	local queueLabel = order(label(queue, Strings.Searching, UDim2.fromScale(1, 0.35), 34), 1) :: TextLabel
	order(
		button(queue, Strings.Cancel, Color3.fromRGB(90, 96, 120), UDim2.fromScale(0.5, 0.3), callbacks.cancelQueue),
		2
	)

	-- 결과
	local result = panel(gui, "Result", UDim2.fromScale(0.42, 0.5), 1.4)
	local resultTitle = order(label(result, "", UDim2.fromScale(1, 0.32), 64), 1) :: TextLabel
	resultTitle.Font = Enum.Font.GothamBlack
	local resultScore = order(label(result, "", UDim2.fromScale(1, 0.2), 36), 2) :: TextLabel
	local resultButtons = order(row(result, 0.24), 3)
	local rematchButton = button(
		resultButtons,
		Strings.Rematch,
		Color3.fromRGB(60, 120, 220),
		UDim2.fromScale(0.45, 1),
		callbacks.rematch
	)
	rematchButton.LayoutOrder = 1
	local menuButton =
		button(resultButtons, Strings.Menu, Color3.fromRGB(90, 96, 120), UDim2.fromScale(0.45, 1), callbacks.menu)
	menuButton.LayoutOrder = 2

	-- 경기 중 HUD
	local hud = Instance.new("Frame")
	hud.Name = "Hud"
	hud.BackgroundTransparency = 1
	hud.Size = UDim2.fromScale(1, 1)
	hud.Visible = false
	hud.Parent = gui

	local board = Instance.new("Frame")
	board.AnchorPoint = Vector2.new(0.5, 0)
	board.Position = UDim2.fromScale(0.5, 0.03)
	board.Size = UDim2.fromScale(0.5, 0.09)
	board.BackgroundColor3 = PANEL
	board.BackgroundTransparency = 0.25
	corner(board, 0.3)
	local boardRatio = Instance.new("UIAspectRatioConstraint")
	boardRatio.AspectRatio = 7
	boardRatio.Parent = board
	board.Parent = hud

	local names, scores, serveDots = {}, {}, {}
	for i = 1, 2 do
		local left = i == 1
		local name = label(board, "", UDim2.fromScale(0.34, 0.5), 22)
		name.AnchorPoint = Vector2.new(if left then 0 else 1, 0.5)
		name.Position = UDim2.fromScale(if left then 0.04 else 0.96, 0.5)
		name.TextXAlignment = if left then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right
		names[i] = name

		local score = label(board, "0", UDim2.fromScale(0.12, 0.8), 48)
		score.Font = Enum.Font.GothamBlack
		score.AnchorPoint = Vector2.new(0.5, 0.5)
		score.Position = UDim2.fromScale(if left then 0.43 else 0.57, 0.5)
		scores[i] = score

		local dot = label(board, "●", UDim2.fromScale(0.04, 0.35), 18)
		dot.TextColor3 = Color3.fromRGB(255, 214, 90)
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = UDim2.fromScale(if left then 0.36 else 0.64, 0.5)
		serveDots[i] = dot
	end
	local colon = label(board, ":", UDim2.fromScale(0.04, 0.7), 40)
	colon.AnchorPoint = Vector2.new(0.5, 0.5)
	colon.Position = UDim2.fromScale(0.5, 0.48)

	local message = label(hud, "", UDim2.fromScale(0.7, 0.13), 72)
	message.Font = Enum.Font.GothamBlack
	message.AnchorPoint = Vector2.new(0.5, 0.5)
	message.Position = UDim2.fromScale(0.5, 0.33)
	message.TextStrokeTransparency = 0.2
	message.TextTransparency = 1

	local hint = label(hud, "", UDim2.fromScale(0.7, 0.05), 22)
	hint.AnchorPoint = Vector2.new(0.5, 0)
	hint.Position = UDim2.fromScale(0.5, 0.15)
	hint.TextStrokeTransparency = 0.3
	hint.TextColor3 = Color3.fromRGB(255, 236, 160)

	local exitButton =
		button(hud, Strings.Menu, Color3.fromRGB(90, 96, 120), UDim2.fromScale(0.1, 0.06), callbacks.forfeit)
	exitButton.AnchorPoint = Vector2.new(1, 0)
	exitButton.Position = UDim2.fromScale(0.98, 0.03)
	exitButton.BackgroundTransparency = 0.3

	gui.Parent = parent

	return setmetatable(
		{
			gui = gui,
			menu = menu,
			queue = queue,
			queueLabel = queueLabel,
			result = result,
			resultTitle = resultTitle,
			resultScore = resultScore,
			rematchButton = rematchButton,
			hud = hud,
			names = names,
			scores = scores,
			serveDots = serveDots,
			message = message,
			messageAge = math.huge,
			hint = hint,
			exitButton = exitButton,
			queueTime = 0,
		} :: InterfaceData,
		Interface
	)
end

function Interface.showOnly(self: Interface, which: string)
	self.menu.Visible = which == "menu"
	self.queue.Visible = which == "queue"
	self.result.Visible = which == "result"
	self.hud.Visible = which == "game" or which == "result"
	self.exitButton.Visible = which == "game"
	if which ~= "game" then
		self.hint.Text = ""
	end
end

function Interface.showMenu(self: Interface)
	self:showOnly("menu")
end

function Interface.showQueue(self: Interface)
	self.queueTime = 0
	self:showOnly("queue")
end

-- names/colors는 화면 왼쪽, 오른쪽 순서
function Interface.showGame(self: Interface, names: { string }, colors: { Color3 }, online: boolean)
	for i = 1, 2 do
		self.names[i].Text = names[i]
		self.names[i].TextColor3 = colors[i]:Lerp(WHITE, 0.45)
		self.scores[i].Text = "0"
	end
	self.exitButton.Text = if online then Strings.Forfeit else Strings.Menu
	self.messageAge = math.huge
	self.message.TextTransparency = 1
	self.message.TextStrokeTransparency = 1
	self:showOnly("game")
end

-- leftSide: 화면 왼쪽에 보이는 선수 번호
function Interface.setScore(self: Interface, view: Match.View, leftSide: number)
	for i = 1, 2 do
		local side = if i == 1 then leftSide else 3 - leftSide
		self.scores[i].Text = tostring(view.score[side])
		self.serveDots[i].Visible = view.server == side and view.phase ~= "over"
	end
end

function Interface.showMessage(self: Interface, text: string, color: Color3)
	self.message.Text = text
	self.message.TextColor3 = color
	self.messageAge = 0
end

function Interface.setHint(self: Interface, text: string)
	self.hint.Text = text
end

function Interface.showResult(self: Interface, won: boolean, scoreText: string, subtitle: string?, online: boolean)
	self.resultTitle.Text = if won then Strings.Win else Strings.Lose
	self.resultTitle.TextColor3 = if won then Color3.fromRGB(255, 214, 90) else Color3.fromRGB(170, 180, 210)
	self.resultScore.Text = if subtitle then subtitle .. "\n" .. scoreText else scoreText
	self.rematchButton.Text = if online then Strings.QueueAgain else Strings.Rematch
	self:showOnly("result")
end

function Interface.update(self: Interface, dt: number)
	self.messageAge += dt
	local t = self.messageAge
	if t < 1.4 then
		local pop = if t < 0.12 then 1.25 - t * 2 else 1
		self.message.Size = UDim2.fromScale(0.7 * pop, 0.13 * pop)
		local fade = math.clamp((t - 0.9) / 0.5, 0, 1)
		self.message.TextTransparency = fade
		self.message.TextStrokeTransparency = 0.2 + 0.8 * fade
	else
		self.message.TextTransparency = 1
		self.message.TextStrokeTransparency = 1
	end

	if self.queue.Visible then
		self.queueTime += dt
		self.queueLabel.Text = Strings.Searching:gsub("%.+$", "") .. string.rep(".", math.floor(self.queueTime * 2) % 4)
	end
end

return Interface
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="17">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- 클라이언트 진입점. 화면 상태를 관리한다.
--   demo   : 메뉴 뒤에서 AI끼리 경기하는 배경 화면
--   local  : 내 기기에서 AI와 대결 (시뮬레이션을 직접 돌린다)
--   queue  : 온라인 상대를 기다리는 중 (배경은 demo)
--   online : 서버가 돌리는 경기를 스냅샷으로 받아 보간해서 그린다
--   result : 경기 결과 화면

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Match = require(Shared:WaitForChild("Match"))
local Bot = require(Shared:WaitForChild("Bot"))

local Renderer = require(script.Parent:WaitForChild("Renderer"))
local Controls = require(script.Parent:WaitForChild("Controls"))
local Interface = require(script.Parent:WaitForChild("Interface"))
local Strings = require(script.Parent:WaitForChild("Strings"))

local TICK = Config.TICK
local MY_COLOR = Color3.fromRGB(70, 140, 255)
local OPPONENT_COLOR = Color3.fromRGB(240, 80, 80)
local IDLE: Match.Input = { move = 0, jump = false, hit = false, drop = false }

-- 캐릭터 없이 GUI로만 플레이하므로 기본 조작(터치 조이스틱 등)과 불필요한 코어 UI를 끈다
task.spawn(function()
	pcall(function()
		local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)
		if module and module:IsA("ModuleScript") then
			local playerModule: any = (require :: any)(module)
			playerModule:GetControls():Disable()
		end
	end)
end)
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

type Remotes = {
	queue: RemoteEvent,
	input: RemoteEvent,
	matchEvent: RemoteEvent,
	snapshot: UnreliableRemoteEvent,
}

type TimedEvent = { time: number, event: Match.Event }

local renderer = Renderer.new(playerGui)
local controls = Controls.new(playerGui)
local interface: Interface.Interface

local mode = "demo"
local difficulty = "Normal"
local lastGameOnline = false

-- 로컬 시뮬레이션 (demo, local)
local match = Match.new()
local bots: { [number]: Bot.Bot } = {}
local accumulator = 0
local previousView = Match.unpack(match:pack())
local currentView = previousView

-- 온라인
local remotes: Remotes? = nil
local onlineSide = 1
local snapshots: { Match.View } = {}
local clockOffset: number? = nil
local pendingEvents: { TimedEvent } = {}
local lastSentMove, lastSentJump = 0, false

local function resetLocalMatch(newBots: { [number]: Bot.Bot })
	match = Match.new({ seed = math.random(1, 2 ^ 30) })
	bots = newBots
	accumulator = 0
	previousView = Match.unpack(match:pack())
	currentView = previousView
end

local function startDemo()
	mode = "demo"
	controls:setEnabled(false)
	resetLocalMatch({
		[1] = Bot.new(1, "Hard", math.random(1, 10000)),
		[2] = Bot.new(2, "Normal", math.random(1, 10000)),
	})
	renderer:setPlayers({ { name = "", color = MY_COLOR }, { name = "", color = OPPONENT_COLOR } }, false)
end

local function showMenu()
	startDemo()
	interface:showMenu()
end

local function scoreText(view: Match.View, mySide: number): string
	return string.format("%d : %d", view.score[mySide], view.score[3 - mySide])
end

-- 점수 문구, 이펙트 등 이벤트 공통 처리
local function presentEvent(event: Match.Event, mySide: number)
	renderer:handleEvent(event)
	if event.kind == "point" then
		local won = event.side == mySide
		local texts: { [string]: string } = if won then Strings.PointWon else Strings.PointLost
		interface:showMessage(
			texts[event.reason or "in"] or "",
			if won then Color3.fromRGB(120, 255, 160) else Color3.fromRGB(255, 120, 120)
		)
	end
end

local function updateHint(view: Match.View, mySide: number)
	if view.phase == "serve" and view.server == mySide then
		interface:setHint(if controls:isTouch() then Strings.ServeHintTouch else Strings.ServeHint)
	else
		interface:setHint("")
	end
end

-- AI 대결 -------------------------------------------------------------------

local function startLocal(level: string)
	difficulty = level
	lastGameOnline = false
	mode = "local"
	resetLocalMatch({ [2] = Bot.new(2, level, math.random(1, 10000)) })
	local label = (Strings :: any)[level] or level
	local names = { player.DisplayName, "AI (" .. label .. ")" }
	renderer:setPlayers({
		{ name = names[1], userId = player.UserId, color = MY_COLOR },
		{ name = names[2], color = OPPONENT_COLOR },
	}, false)
	interface:showGame(names, { MY_COLOR, OPPONENT_COLOR }, false)
	controls:setEnabled(true)
end

local function stepLocal(dt: number): Match.View
	accumulator += dt
	local steps = 0
	while accumulator >= TICK do
		accumulator -= TICK
		steps += 1
		if steps > 6 then
			accumulator = 0 -- 너무 밀렸으면 따라잡기를 포기한다
			break
		end
		local inputs = {}
		for side = 1, 2 do
			local bot = bots[side]
			if bot then
				inputs[side] = bot:update(match)
			elseif mode == "local" then
				inputs[side] = controls:sample(false)
			else
				inputs[side] = IDLE
			end
		end
		previousView = currentView
		local events = match:step(TICK, inputs)
		currentView = Match.unpack(match:pack())
		for _, event in events do
			if mode == "demo" or mode == "queue" then
				renderer:handleEvent(event)
			else
				presentEvent(event, 1)
				if event.kind == "gameOver" and mode == "local" then
					mode = "result"
					controls:setEnabled(false)
					interface:showResult(event.side == 1, scoreText(currentView, 1), nil, false)
				end
			end
		end
	end
	if (mode == "demo" or mode == "queue") and match.phase == "over" then
		local waiting = mode == "queue"
		startDemo()
		if waiting then
			mode = "queue"
		end
	end
	return Match.lerpView(previousView, currentView, accumulator / TICK)
end

-- 온라인 대결 ---------------------------------------------------------------

local function playOnline()
	local net = remotes
	if net then
		-- 응답(start)은 빨라도 다음 프레임에 오므로 먼저 보내도 된다
		net.queue:FireServer("join")
		lastGameOnline = true
		if mode ~= "demo" and mode ~= "queue" then
			startDemo()
		end
		mode = "queue"
		interface:showQueue()
	end
end

local function cancelQueue()
	local net = remotes
	if net then
		net.queue:FireServer("leave")
	end
	showMenu()
end

local function pushSnapshot(data: { any })
	local view = Match.unpack(data)
	local offset = view.time - os.clock()
	local current = clockOffset
	if current == nil or math.abs(offset - current) > 0.5 then
		clockOffset = offset
	elseif offset > current then
		clockOffset = current + (offset - current) * 0.3 -- 가장 빨리 도착한 스냅샷 쪽으로 빠르게
	else
		clockOffset = current + (offset - current) * 0.02
	end
	local last = snapshots[#snapshots]
	if last and view.time <= last.time then
		return -- 순서가 뒤바뀐 스냅샷은 버린다
	end
	table.insert(snapshots, view)
	while #snapshots > 40 do
		table.remove(snapshots, 1)
	end
end

local function onlineRenderTime(): number?
	local offset = clockOffset
	if offset then
		return os.clock() + offset - Config.INTERP_DELAY
	end
	return nil
end

local function sampleOnline(renderTime: number): Match.View?
	while #snapshots >= 3 and snapshots[2].time <= renderTime do
		table.remove(snapshots, 1)
	end
	local a, b = snapshots[1], snapshots[2]
	if not a then
		return nil
	end
	if not b or renderTime <= a.time then
		return a
	end
	return Match.lerpView(a, b, math.min((renderTime - a.time) / (b.time - a.time), 1))
end

local function sendInput()
	local input = controls:sample(renderer.mirror)
	local changed = input.hit or input.drop or input.move ~= lastSentMove or input.jump ~= lastSentJump
	local net = remotes
	if net and changed then
		net.input:FireServer(input.move, input.jump, input.hit, input.drop)
		lastSentMove, lastSentJump = input.move, input.jump
	end
end

local function startOnline(payload: any)
	if mode ~= "queue" then
		-- 대기를 취소한 직후에 매칭된 경우: 서버의 경기를 바로 끝낸다
		local net = remotes
		if net then
			net.queue:FireServer("forfeit")
		end
		return
	end
	onlineSide = if payload.side == 2 then 2 else 1
	local names = { tostring(payload.names[1]), tostring(payload.names[2]) }
	local userIds = { tonumber(payload.userIds[1]), tonumber(payload.userIds[2]) }
	local infos = {}
	for side = 1, 2 do
		infos[side] = {
			name = names[side],
			userId = userIds[side],
			color = if side == onlineSide then MY_COLOR else OPPONENT_COLOR,
		}
	end
	renderer:setPlayers(infos, onlineSide == 2)
	interface:showGame({ names[onlineSide], names[3 - onlineSide] }, { MY_COLOR, OPPONENT_COLOR }, true)
	table.clear(snapshots)
	table.clear(pendingEvents)
	clockOffset = nil
	lastSentMove, lastSentJump = 0, false
	mode = "online"
	controls:setEnabled(true)
end

local function finishOnline(won: boolean, subtitle: string?)
	local view = snapshots[#snapshots]
	mode = "result"
	controls:setEnabled(false)
	interface:showResult(won, if view then scoreText(view, onlineSide) else "", subtitle, true)
end

local function onMatchEvent(kind: string, payload: any)
	if kind == "start" then
		startOnline(payload)
	elseif kind == "events" and mode == "online" then
		for _, event in payload.events do
			table.insert(pendingEvents, { time = payload.time, event = event })
		end
	elseif kind == "end" and (mode == "online" or (mode == "result" and lastGameOnline)) then
		if payload.reason == "forfeit" and mode == "online" then
			finishOnline(payload.winner == onlineSide, Strings.OpponentLeft)
		end
	end
end

local function forfeit()
	if mode == "online" then
		local net = remotes
		if net then
			net.queue:FireServer("forfeit")
		end
	end
	showMenu()
end

local function rematch()
	if lastGameOnline then
		playOnline()
	else
		startLocal(difficulty)
	end
end

interface = Interface.new(playerGui, {
	playAi = startLocal,
	playOnline = playOnline,
	cancelQueue = cancelQueue,
	menu = function()
		if mode == "queue" then
			cancelQueue()
		else
			showMenu()
		end
	end,
	rematch = rematch,
	forfeit = forfeit,
})

-- 서버가 만든 리모트를 기다린다 (서버 스크립트가 없으면 AI 대결만 가능)
task.spawn(function()
	local folder = ReplicatedStorage:WaitForChild(Config.REMOTES_FOLDER, 30)
	if not folder then
		warn("[Badminton] 서버 리모트를 찾지 못해 온라인 대결을 사용할 수 없습니다.")
		return
	end
	local net: Remotes = {
		queue = folder:WaitForChild("Queue") :: RemoteEvent,
		input = folder:WaitForChild("Input") :: RemoteEvent,
		matchEvent = folder:WaitForChild("MatchEvent") :: RemoteEvent,
		snapshot = folder:WaitForChild("Snapshot") :: UnreliableRemoteEvent,
	}
	net.matchEvent.OnClientEvent:Connect(onMatchEvent)
	net.snapshot.OnClientEvent:Connect(function(data: any)
		if (mode == "online" or mode == "result") and typeof(data) == "table" then
			pushSnapshot(data)
		end
	end)
	remotes = net
end)

-- 매 프레임 ------------------------------------------------------------------

RunService.RenderStepped:Connect(function(frameDt: number)
	local dt = math.min(frameDt, 0.1)
	if mode == "online" or (mode == "result" and lastGameOnline) then
		if mode == "online" then
			sendInput()
		end
		local renderTime = onlineRenderTime()
		if renderTime then
			-- 이벤트도 화면에 보이는 시점에 맞춰 늦게 보여준다
			while pendingEvents[1] and pendingEvents[1].time <= renderTime do
				local timed = table.remove(pendingEvents, 1) :: TimedEvent
				presentEvent(timed.event, onlineSide)
				if timed.event.kind == "gameOver" and mode == "online" then
					finishOnline(timed.event.side == onlineSide, nil)
				end
			end
			local view = sampleOnline(renderTime)
			if view then
				renderer:draw(view, dt)
				interface:setScore(view, onlineSide)
				if mode == "online" then
					updateHint(view, onlineSide)
				end
			end
		end
	else
		local view = stepLocal(dt)
		renderer:draw(view, dt)
		if mode == "local" or mode == "result" then
			interface:setScore(view, 1)
		end
		if mode == "local" then
			updateHint(view, 1)
		end
	end
	interface:update(dt)
end)

showMenu()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Renderer</string>
            <string name="Source"><![CDATA[--!strict
-- 경기 화면(체육관, 코트, 네트, 선수, 셔틀콕, 효과)을 ScreenGui 프레임으로 그린다.
-- 월드 좌표 1단위는 화면에서 가로·세로 같은 픽셀 수가 되도록 16:9 아레나 안에 배치한다.
-- mirror = true 이면 좌우를 뒤집어서 그린다 (온라인에서 2번 선수도 자기가 왼쪽에 보이도록).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Match = require(Shared:WaitForChild("Match"))
local Strings = require(script.Parent:WaitForChild("Strings"))

local VIEW_W = Config.VIEW_WIDTH
local VIEW_H = Config.VIEW_HEIGHT
local VIEW_BOTTOM = Config.VIEW_BOTTOM
local VIEW_TOP = VIEW_BOTTOM + VIEW_H
local NET_X = Config.NET_X
local HALF = Config.COURT_HALF_LENGTH

local SKIN = Color3.fromRGB(255, 214, 170)
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

export type PlayerInfo = {
	name: string,
	userId: number?,
	color: Color3,
}

type PlayerParts = {
	group: Frame,
	shadow: Frame,
	legs: { Frame },
	body: Frame,
	head: ImageLabel,
	eyes: { Frame },
	racket: Frame,
	nameTag: TextLabel,
	runPhase: number,
}

type Effect = {
	kind: string,
	age: number,
	life: number,
	x: number,
	y: number,
	gui: GuiObject,
	stroke: UIStroke?,
}

type RendererData = {
	gui: ScreenGui,
	root: Frame,
	arena: Frame,
	world: Frame,
	mirror: boolean,
	players: { PlayerParts },
	shuttle: Frame,
	shuttleShadow: Frame,
	offscreen: TextLabel,
	trail: { Frame },
	trailPoints: { Vector2 },
	shuttleAngle: number,
	effects: { Effect },
	shake: number,
	thumbnailRequest: number,
}

local Renderer = {}
Renderer.__index = Renderer

export type Renderer = typeof(setmetatable({} :: RendererData, Renderer))

-- 화면 기준 월드 좌표 -> 아레나 안의 Scale 좌표
local function toScale(x: number, y: number): UDim2
	return UDim2.fromScale(x / VIEW_W, 1 - (y - VIEW_BOTTOM) / VIEW_H)
end

local function sizeOf(w: number, h: number): UDim2
	return UDim2.fromScale(w / VIEW_W, h / VIEW_H)
end

local function newFrame(parent: Instance, color: Color3, transparency: number?, zIndex: number?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = color
	f.BackgroundTransparency = transparency or 0
	f.BorderSizePixel = 0
	f.ZIndex = zIndex or 1
	f.Parent = parent
	return f
end

local function rounded(gui: GuiObject, radius: UDim?): GuiObject
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or UDim.new(0.5, 0)
	corner.Parent = gui
	return gui
end

-- 월드 직사각형 (왼쪽 위 모서리 left, top과 너비, 높이)
local function placeRect(f: GuiObject, left: number, top: number, w: number, h: number)
	f.AnchorPoint = Vector2.new(0, 0)
	f.Position = toScale(left, top)
	f.Size = sizeOf(w, h)
end

-- (px, py)에서 angle(도, 반시계 방향) 쪽으로 length만큼 뻗은 막대로 배치한다
local function placeBar(f: GuiObject, px: number, py: number, angle: number, length: number, thickness: number)
	local rad = math.rad(angle)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = toScale(px + math.cos(rad) * length / 2, py + math.sin(rad) * length / 2)
	f.Size = sizeOf(length, thickness)
	f.Rotation = -angle
end

local function newText(parent: Instance, text: string, zIndex: number, maxSize: number?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0.4
	label.ZIndex = zIndex
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = maxSize or 40
	limit.Parent = label
	label.Parent = parent
	return label
end

local function easeOut(t: number): number
	local u = 1 - math.clamp(t, 0, 1)
	return 1 - u * u * u
end

-- 바라보는 방향이 오른쪽일 때의 라켓 각도 (도)
local function racketAngle(swingT: number, style: number, ready: boolean): number
	if swingT < 0 then
		return if ready then -125 else 65
	end
	local e = easeOut(swingT / Config.SWING_DURATION)
	if style == 0 then
		return 165 - 215 * e -- 오버헤드: 머리 뒤에서 앞 아래로
	end
	return -140 + 200 * e -- 언더핸드: 뒤 아래에서 앞 위로
end

local function buildBackground(world: Frame)
	-- 체육관 벽
	local wall = newFrame(world, Color3.fromRGB(38, 52, 92), 0, 1)
	placeRect(wall, 0, VIEW_TOP, VIEW_W, VIEW_H)
	local wallGradient = Instance.new("UIGradient")
	wallGradient.Rotation = 90
	wallGradient.Color = ColorSequence.new(Color3.fromRGB(22, 28, 54), Color3.fromRGB(58, 78, 128))
	wallGradient.Parent = wall

	-- 천장 조명
	for i = 1, 5 do
		local light = newFrame(world, Color3.fromRGB(255, 248, 220), 0.15, 2)
		rounded(light, UDim.new(0.3, 0))
		placeRect(light, i * VIEW_W / 6 - 0.6, VIEW_TOP - 0.15, 1.2, 0.14)
		local glow = newFrame(world, Color3.fromRGB(255, 248, 220), 0.9, 2)
		rounded(glow)
		placeRect(glow, i * VIEW_W / 6 - 1.2, VIEW_TOP - 0.05, 2.4, 0.5)
	end

	-- 벽의 큰 글씨
	local title = newText(world, Strings.Subtitle, 2, 120)
	title.Position = toScale(VIEW_W / 2, 5.6)
	title.Size = sizeOf(10, 1.3)
	title.TextTransparency = 0.88
	title.TextStrokeTransparency = 1

	-- 광고판 띠
	local board = newFrame(world, Color3.fromRGB(26, 34, 66), 0, 2)
	placeRect(board, 0, 1.05, VIEW_W, 0.75)
	local boardLine = newFrame(world, Color3.fromRGB(255, 196, 64), 0, 2)
	placeRect(boardLine, 0, 1.08, VIEW_W, 0.05)

	-- 나무 바닥
	local floor = newFrame(world, Color3.fromRGB(190, 132, 78), 0, 3)
	placeRect(floor, 0, 0.3, VIEW_W, 0.3 - VIEW_BOTTOM)
	local floorGradient = Instance.new("UIGradient")
	floorGradient.Rotation = 90
	floorGradient.Color = ColorSequence.new(Color3.fromRGB(214, 156, 98), Color3.fromRGB(120, 76, 40))
	floorGradient.Parent = floor

	-- 코트 (초록색 면 + 흰 라인). 바닥 위쪽 0.3 두께는 원근감을 위한 코트 윗면
	local court = newFrame(world, Color3.fromRGB(40, 132, 86), 0, 4)
	placeRect(court, NET_X - HALF - 0.4, 0.3, HALF * 2 + 0.8, 0.5)
	local courtGradient = Instance.new("UIGradient")
	courtGradient.Rotation = 90
	courtGradient.Color = ColorSequence.new(Color3.fromRGB(52, 156, 104), Color3.fromRGB(30, 100, 66))
	courtGradient.Parent = court
	local lines = { -HALF, -Config.SHORT_SERVICE_DIST, Config.SHORT_SERVICE_DIST, HALF }
	for _, offset in lines do
		local line = newFrame(world, WHITE, 0.05, 5)
		placeRect(line, NET_X + offset - 0.04, 0.3, 0.08, 0.3)
	end
	local edge = newFrame(world, WHITE, 0.6, 5)
	placeRect(edge, NET_X - HALF - 0.4, 0.02, HALF * 2 + 0.8, 0.04)
end

local function buildNet(world: Frame)
	local post = newFrame(world, Color3.fromRGB(70, 70, 80), 0, 9)
	placeRect(post, NET_X - 0.045, Config.NET_HEIGHT + 0.06, 0.09, Config.NET_HEIGHT + 0.06)
	local mesh = newFrame(world, Color3.fromRGB(235, 240, 255), 0.55, 9)
	placeRect(mesh, NET_X - 0.11, Config.NET_HEIGHT, 0.22, 0.76)
	local stripes = Instance.new("UIGradient")
	stripes.Rotation = 90
	stripes.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.5, 0.6),
		NumberSequenceKeypoint.new(1, 0.3),
	})
	stripes.Parent = mesh
	local tape = newFrame(world, WHITE, 0, 10)
	placeRect(tape, NET_X - 0.13, Config.NET_HEIGHT + 0.03, 0.26, 0.07)
end

local function buildPlayer(world: Frame, zBase: number): PlayerParts
	local group = Instance.new("Frame")
	group.Name = "Player"
	group.BackgroundTransparency = 1
	group.Size = UDim2.fromScale(1, 1)
	group.ZIndex = zBase
	group.Parent = world

	local shadow = rounded(newFrame(group, BLACK, 0.65, zBase)) :: Frame
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)

	local legs = {}
	for i = 1, 2 do
		local leg = rounded(newFrame(group, Color3.fromRGB(40, 44, 60), 0, zBase + 1), UDim.new(0.4, 0)) :: Frame
		legs[i] = leg
	end

	local body = rounded(newFrame(group, WHITE, 0, zBase + 2), UDim.new(0.3, 0)) :: Frame
	body.AnchorPoint = Vector2.new(0.5, 1)
	local stripe = newFrame(body, WHITE, 0.25, zBase + 3)
	stripe.Size = UDim2.fromScale(1, 0.14)
	stripe.Position = UDim2.fromScale(0, 0.35)

	local head = Instance.new("ImageLabel")
	head.BackgroundColor3 = SKIN
	head.BorderSizePixel = 0
	head.ZIndex = zBase + 4
	head.AnchorPoint = Vector2.new(0.5, 0.5)
	head.ScaleType = Enum.ScaleType.Crop
	rounded(head)
	head.Parent = group

	local eyes = {}
	for i = 1, 2 do
		local eye = rounded(newFrame(head, Color3.fromRGB(30, 30, 40), 0, zBase + 5)) :: Frame
		eye.AnchorPoint = Vector2.new(0.5, 0.5)
		eye.Size = UDim2.fromScale(0.13, 0.2)
		eyes[i] = eye
	end

	-- 팔 + 라켓. 컨테이너의 +x 방향이 라켓이 뻗는 방향이다.
	local racket = Instance.new("Frame")
	racket.BackgroundTransparency = 1
	racket.ZIndex = zBase + 6
	racket.Parent = group
	local arm = rounded(newFrame(racket, SKIN, 0, zBase + 6), UDim.new(0.5, 0)) :: Frame
	arm.AnchorPoint = Vector2.new(0, 0.5)
	arm.Position = UDim2.fromScale(0, 0.5)
	arm.Size = UDim2.fromScale(0.34, 0.36)
	local handle = newFrame(racket, Color3.fromRGB(40, 40, 48), 0, zBase + 6)
	handle.AnchorPoint = Vector2.new(0, 0.5)
	handle.Position = UDim2.fromScale(0.3, 0.5)
	handle.Size = UDim2.fromScale(0.34, 0.16)
	local frameRing = rounded(newFrame(racket, WHITE, 0.6, zBase + 7)) :: Frame
	frameRing.AnchorPoint = Vector2.new(0, 0.5)
	frameRing.Position = UDim2.fromScale(0.6, 0.5)
	frameRing.Size = UDim2.fromScale(0.4, 1)
	local ringStroke = Instance.new("UIStroke")
	ringStroke.Thickness = 2.5
	ringStroke.Color = Color3.fromRGB(230, 60, 70)
	ringStroke.Parent = frameRing

	local nameTag = newText(group, "", zBase + 8, 22)
	nameTag.Font = Enum.Font.GothamBold

	return {
		group = group,
		shadow = shadow,
		legs = legs,
		body = body,
		head = head,
		eyes = eyes,
		racket = racket,
		nameTag = nameTag,
		runPhase = 0,
	}
end

function Renderer.new(parent: Instance): Renderer
	local gui = Instance.new("ScreenGui")
	gui.Name = "BadmintonArena"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 1

	local root = newFrame(gui, Color3.fromRGB(10, 12, 24), 0, 1)
	root.Size = UDim2.fromScale(1, 1)

	local arena = Instance.new("Frame")
	arena.Name = "Arena"
	arena.BackgroundTransparency = 1
	arena.AnchorPoint = Vector2.new(0.5, 0.5)
	arena.Position = UDim2.fromScale(0.5, 0.5)
	arena.Size = UDim2.fromScale(1, 1)
	arena.ClipsDescendants = true
	arena.ZIndex = 1
	arena.Parent = root
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = VIEW_W / VIEW_H
	aspect.Parent = arena

	-- 화면 흔들림은 world를 움직여서 표현한다
	local world = Instance.new("Frame")
	world.Name = "World"
	world.BackgroundTransparency = 1
	world.Size = UDim2.fromScale(1, 1)
	world.Parent = arena

	buildBackground(world)
	buildNet(world)

	local shuttleShadow = rounded(newFrame(world, BLACK, 0.6, 6)) :: Frame
	shuttleShadow.AnchorPoint = Vector2.new(0.5, 0.5)

	local players = { buildPlayer(world, 20), buildPlayer(world, 40) }

	local trail = {}
	for i = 1, 8 do
		local dot = rounded(newFrame(world, WHITE, 1, 60)) :: Frame
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		trail[i] = dot
	end

	-- 셔틀콕: 컨테이너의 +x 방향이 코르크(머리) 쪽
	local shuttle = Instance.new("Frame")
	shuttle.Name = "Shuttle"
	shuttle.BackgroundTransparency = 1
	shuttle.ZIndex = 61
	shuttle.Parent = world
	local skirtShapes = { { 0, 0.36, 1 }, { 0.3, 0.3, 0.78 }, { 0.55, 0.15, 0.55 } }
	for _, shape in skirtShapes do
		local feather = newFrame(shuttle, WHITE, 0.08, 61)
		feather.AnchorPoint = Vector2.new(0, 0.5)
		feather.Position = UDim2.fromScale(shape[1], 0.5)
		feather.Size = UDim2.fromScale(shape[2], shape[3])
		rounded(feather, UDim.new(0.2, 0))
	end
	local cork = rounded(newFrame(shuttle, Color3.fromRGB(250, 236, 205), 0, 62)) :: Frame
	cork.AnchorPoint = Vector2.new(0, 0.5)
	cork.Position = UDim2.fromScale(0.62, 0.5)
	cork.Size = UDim2.fromScale(0.38, 0.62)
	local corkStroke = Instance.new("UIStroke")
	corkStroke.Thickness = 1
	corkStroke.Color = Color3.fromRGB(150, 110, 70)
	corkStroke.Parent = cork

	local offscreen = newText(world, "▲", 70, 30)
	offscreen.TextColor3 = Color3.fromRGB(255, 230, 120)
	offscreen.Size = sizeOf(0.5, 0.4)
	offscreen.Visible = false

	gui.Parent = parent

	local self = setmetatable(
		{
			gui = gui,
			root = root,
			arena = arena,
			world = world,
			mirror = false,
			players = players,
			shuttle = shuttle,
			shuttleShadow = shuttleShadow,
			offscreen = offscreen,
			trail = trail,
			trailPoints = {},
			shuttleAngle = -90,
			effects = {},
			shake = 0,
			thumbnailRequest = 0,
		} :: RendererData,
		Renderer
	)
	return self
end

-- 월드 x -> 화면 기준 x (mirror 반영)
function Renderer.screenX(self: Renderer, x: number): number
	return if self.mirror then VIEW_W - x else x
end

function Renderer.setPlayers(self: Renderer, infos: { PlayerInfo }, mirror: boolean)
	self.mirror = mirror
	self.thumbnailRequest += 1
	local request = self.thumbnailRequest
	for i, parts in self.players do
		local info = infos[i]
		parts.body.BackgroundColor3 = info.color
		parts.nameTag.Text = info.name
		parts.nameTag.TextColor3 = info.color:Lerp(WHITE, 0.55)
		parts.head.Image = ""
		for _, eye in parts.eyes do
			eye.Visible = true
		end
		local userId = info.userId
		if userId and userId > 0 then
			task.spawn(function()
				local ok, content = pcall(function()
					return Players:GetUserThumbnailAsync(
						userId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size100x100
					)
				end)
				if ok and request == self.thumbnailRequest then
					parts.head.Image = content
					for _, eye in parts.eyes do
						eye.Visible = false
					end
				end
			end)
		end
	end
	self:reset()
end

function Renderer.reset(self: Renderer)
	for _, effect in self.effects do
		effect.gui:Destroy()
	end
	table.clear(self.effects)
	table.clear(self.trailPoints)
	self.shake = 0
end

function Renderer.drawPlayer(self: Renderer, parts: PlayerParts, p: Match.PlayerView, ready: boolean, dt: number)
	local x = self:screenX(p.x)
	local y = p.y
	local dir = if self.mirror then -p.dir else p.dir
	local vx = if self.mirror then -p.vx else p.vx
	local speedRatio = math.min(math.abs(vx) / Config.PLAYER_SPEED, 1)

	local lift = math.min(y / 2.5, 0.6)
	parts.shadow.Position = toScale(x, 0.12)
	parts.shadow.Size = sizeOf(0.95 * (1 - lift), 0.16 * (1 - lift))
	parts.shadow.BackgroundTransparency = 0.6 + lift * 0.5

	-- 다리: 달릴 때 앞뒤로 흔들고, 공중에서는 접는다
	local hipY = y + 0.58
	local legLength = 0.6
	if p.onGround then
		parts.runPhase += math.abs(vx) * dt * 2.4
		local swing = math.sin(parts.runPhase) * 30 * speedRatio
		placeBar(parts.legs[1], x - 0.1, hipY, -90 + swing, legLength, 0.17)
		placeBar(parts.legs[2], x + 0.1, hipY, -90 - swing, legLength, 0.17)
	else
		placeBar(parts.legs[1], x - 0.1, hipY, -90 - 30 * dir, legLength * 0.85, 0.17)
		placeBar(parts.legs[2], x + 0.1, hipY, -90 + 15 * dir, legLength * 0.9, 0.17)
	end

	parts.body.Position = toScale(x, y + 0.46)
	parts.body.Size = sizeOf(0.64, 0.8)
	parts.body.Rotation = vx / Config.PLAYER_SPEED * 7

	local bob = if p.onGround then math.abs(math.sin(parts.runPhase)) * 0.05 * speedRatio else 0
	parts.head.Position = toScale(x + dir * 0.03, y + 1.56 + bob)
	parts.head.Size = sizeOf(0.6, 0.6)
	parts.eyes[1].Position = UDim2.fromScale(0.5 + dir * 0.12, 0.45)
	parts.eyes[2].Position = UDim2.fromScale(0.5 + dir * 0.34, 0.45)

	local angle = racketAngle(p.swingT, p.swingStyle, ready)
	if dir < 0 then
		angle = 180 - angle
	end
	placeBar(parts.racket, x + dir * 0.12, y + 1.1, angle, 1.25, 0.36)

	parts.nameTag.Position = toScale(x, y + 2.65)
	parts.nameTag.Size = sizeOf(3, 0.36)
end

local function shortestAngle(from: number, to: number): number
	return (to - from + 180) % 360 - 180
end

function Renderer.drawShuttle(self: Renderer, view: Match.View, dt: number)
	local s = view.shuttle
	local x = self:screenX(s.x)
	local vx = if self.mirror then -s.vx else s.vx
	local speed = math.sqrt(vx * vx + s.vy * s.vy)

	local target = self.shuttleAngle
	if s.grounded then
		target = if self.shuttleAngle > -90 and self.shuttleAngle < 90 then 15 else 165
	elseif speed > 0.5 then
		target = math.deg(math.atan2(s.vy, vx))
	elseif view.phase == "serve" then
		target = -90
	end
	local alpha = math.min(dt * 25, 1)
	self.shuttleAngle += shortestAngle(self.shuttleAngle, target) * alpha
	local drawY = if s.grounded then 0.12 else s.y
	local rad = math.rad(self.shuttleAngle)
	placeBar(self.shuttle, x - math.cos(rad) * 0.23, drawY - math.sin(rad) * 0.23, self.shuttleAngle, 0.46, 0.27)

	local height = math.clamp(s.y / 8, 0, 1)
	self.shuttleShadow.Position = toScale(x, 0.14)
	self.shuttleShadow.Size = sizeOf(0.36 * (1 - height * 0.5), 0.08)
	self.shuttleShadow.BackgroundTransparency = 0.45 + height * 0.45

	-- 빠른 샷에는 잔상을 남긴다
	table.insert(self.trailPoints, 1, Vector2.new(x, drawY))
	if #self.trailPoints > #self.trail then
		table.remove(self.trailPoints)
	end
	local fast = speed > 13 and not s.grounded
	for i, dot in self.trail do
		local point = self.trailPoints[i + 1]
		if fast and point then
			dot.Position = toScale(point.X, point.Y)
			local size = 0.14 * (1 - i / (#self.trail + 2))
			dot.Size = sizeOf(size, size)
			dot.BackgroundTransparency = 0.35 + i * 0.08
		else
			dot.BackgroundTransparency = 1
		end
	end

	local above = s.y > VIEW_TOP - 0.2
	self.offscreen.Visible = above
	if above then
		self.offscreen.Position = toScale(x, VIEW_TOP - 0.3)
	end
end

function Renderer.draw(self: Renderer, view: Match.View, dt: number)
	for i, parts in self.players do
		local p = view.players[i]
		if p then
			local ready = view.phase == "serve" and view.server == i
			self:drawPlayer(parts, p, ready, dt)
		end
	end
	self:drawShuttle(view, dt)
	self:updateEffects(dt)
end

function Renderer.addEffect(
	self: Renderer,
	kind: string,
	x: number,
	y: number,
	gui: GuiObject,
	life: number,
	stroke: UIStroke?
)
	table.insert(self.effects, { kind = kind, age = 0, life = life, x = x, y = y, gui = gui, stroke = stroke })
end

function Renderer.ring(self: Renderer, x: number, y: number, color: Color3)
	local ring = rounded(newFrame(self.world, color, 1, 80)) :: Frame
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 3
	stroke.Parent = ring
	self:addEffect("ring", self:screenX(x), y, ring, 0.3, stroke)
end

function Renderer.popup(self: Renderer, x: number, y: number, text: string, color: Color3)
	local label = newText(self.world, text, 85, 36)
	label.TextColor3 = color
	label.Size = sizeOf(3, 0.6)
	self:addEffect("popup", self:screenX(x), y, label, 0.9)
end

function Renderer.landingMark(self: Renderer, x: number, good: boolean)
	local color = if good then Color3.fromRGB(110, 255, 150) else Color3.fromRGB(255, 90, 90)
	local mark = rounded(newFrame(self.world, color, 0.2, 7)) :: Frame
	mark.AnchorPoint = Vector2.new(0.5, 0.5)
	self:addEffect("mark", self:screenX(x), 0.14, mark, Config.POINT_PAUSE)
end

-- 경기 이벤트에 맞는 효과를 보여준다
function Renderer.handleEvent(self: Renderer, event: Match.Event)
	local x, y = event.x or NET_X, event.y or 1
	if event.kind == "hit" then
		local smash = event.shot == "smash"
		self:ring(x, y, if smash then Color3.fromRGB(255, 200, 80) else WHITE)
		if smash then
			self.shake = 0.18
			self:popup(x, y + 0.9, Strings.Smash, Color3.fromRGB(255, 210, 90))
		elseif (event.quality or 0) > 0.93 then
			self:popup(x, y + 0.9, Strings.Perfect, Color3.fromRGB(140, 230, 255))
		end
	elseif event.kind == "net" then
		self:ring(x, y, Color3.fromRGB(255, 120, 120))
		self.shake = math.max(self.shake, 0.08)
	elseif event.kind == "point" then
		local inBounds = math.abs(x - NET_X) <= HALF
		self:landingMark(x, inBounds)
	end
end

function Renderer.updateEffects(self: Renderer, dt: number)
	for i = #self.effects, 1, -1 do
		local effect = self.effects[i]
		effect.age += dt
		local t = effect.age / effect.life
		if t >= 1 then
			effect.gui:Destroy()
			table.remove(self.effects, i)
		elseif effect.kind == "ring" then
			local size = 0.3 + 1.1 * easeOut(t)
			effect.gui.Position = toScale(effect.x, effect.y)
			effect.gui.Size = sizeOf(size, size)
			local stroke = effect.stroke
			if stroke then
				stroke.Transparency = t
			end
		elseif effect.kind == "popup" then
			local label = effect.gui :: TextLabel
			label.Position = toScale(effect.x, effect.y + 0.8 * easeOut(t))
			label.TextTransparency = math.max(0, t * 2 - 1)
			label.TextStrokeTransparency = 0.4 + 0.6 * math.max(0, t * 2 - 1)
		elseif effect.kind == "mark" then
			local pulse = 0.5 + 0.12 * math.sin(effect.age * 10)
			effect.gui.Position = toScale(effect.x, effect.y)
			effect.gui.Size = sizeOf(pulse, pulse * 0.3)
			effect.gui.BackgroundTransparency = 0.2 + 0.8 * t * t
		end
	end

	if self.shake > 0 then
		self.shake = math.max(0, self.shake - dt)
		local amount = self.shake * 0.04
		self.world.Position = UDim2.fromScale((math.random() - 0.5) * amount, (math.random() - 0.5) * amount)
	else
		self.world.Position = UDim2.fromScale(0, 0)
	end
end

function Renderer.destroy(self: Renderer)
	self.gui:Destroy()
end

return Renderer
]]></string>
