-- The circuit with this id, or the default one.
function TrackData.get(id: string?): any
	return TrackData.Tracks[id or ""] or TrackData.Tracks[TrackData.Default]
end

return TrackData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">TrackLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Where everything around the road goes: kerbs, the verge / run-off / gravel
-- bands beside the road, barriers, the pit lane, garages and paddock,
-- grandstands, the bridge, marshal posts and (on a circuit with hills) the
-- embankments the raised road stands on.
-- Pure Luau (no requires, no Roblox APIs) so it is tested and plotted
-- headlessly; the server's builders only turn these numbers into parts.

local TrackLayout = {}

type Sample = {
	i: number,
	s: number,
	pos: vector,
	fwd: vector,
	right: vector,
	up: vector,
	width: number,
	bank: number,
	curv: number,
	segment: number,
}
type Track = {
	samples: { Sample },
	n: number,
	length: number,
	spacing: number,
	freeLengths: { number },
}

local UP = vector.create(0, 1, 0)

TrackLayout.RoadThickness = 1.0
TrackLayout.KerbWidth = 3.2
TrackLayout.KerbHeight = 0.1
TrackLayout.Turf = 6 -- artificial-turf verge beside the white line
TrackLayout.RunOff = 28 -- painted asphalt run-off outside tight corners
TrackLayout.GravelFrom = 9 -- gravel trap outside the hairpin
TrackLayout.GravelTo = 34
TrackLayout.LawnY = -0.1 -- top of the lawn (everything else sits at 0)
TrackLayout.PitWallLateral = 7 -- beyond the main straight's left edge
TrackLayout.PitLaneWidth = 20
TrackLayout.GarageDepth = 22
TrackLayout.PaddockDepth = 80
TrackLayout.PaddockClear = 44 -- studs from any road edge to the paddock floor
TrackLayout.FacilityMargin = 120

local function wrap(i: number, n: number): number
	return ((i - 1) % n) + 1
end
TrackLayout.wrap = wrap

-- Sample counts in this file are tuned for 6-stud samples. Circuits with
-- hills use finer samples (a smoother road surface), so every window scales
-- to keep its length in studs.
local function steps(track: Track, n: number): number
	return math.max(1, math.floor(n * 6 / track.spacing + 0.5))
end
TrackLayout.steps = steps

local function flat(v: vector): vector
	return vector.create(v.x, 0, v.z)
end

-- unit vector pointing away from the road on one side (-1 left, 1 right)
local function outward(smp: Sample, side: number): vector
	return vector.normalize(flat(smp.right)) * side
end
TrackLayout.outward = outward

----------------------------------------------------------------------------
-- Spatial grid of samples (x/z buckets) for nearest-sample queries
----------------------------------------------------------------------------
local CELL = 32

export type Grid = { cells: { [number]: { number } }, track: Track }

local function cellKey(cx: number, cz: number): number
	return (cx + 2048) * 4096 + (cz + 2048)
end

function TrackLayout.grid(track: Track): Grid
	local cells: { [number]: { number } } = {}
	for i, smp in track.samples do
		local k = cellKey(math.floor(smp.pos.x / CELL), math.floor(smp.pos.z / CELL))
		local list = cells[k]
		if not list then
			list = {}
			cells[k] = list
		end
		table.insert(list, i)
	end
	return { cells = cells, track = track }
end

-- Nearest sample in the ground plane within `radius` (or nil), optionally
-- ignoring samples within `skip` indices of `around`.
function TrackLayout.nearest(grid: Grid, x: number, z: number, radius: number, around: number?, skip: number?): (number?, number)
	local track = grid.track
	local r = math.ceil(radius / CELL)
	local cx, cz = math.floor(x / CELL), math.floor(z / CELL)
	local best, bestD = nil, radius * radius
	for dx = -r, r do
		for dz = -r, r do
			local list = grid.cells[cellKey(cx + dx, cz + dz)]
			if list then
				for _, i in list do
					local ok = true
					if around and skip then
						local sep = math.abs(i - around)
						sep = math.min(sep, track.n - sep)
						ok = sep > skip
					end
					if ok then
						local p = track.samples[i].pos
						local d = (p.x - x) ^ 2 + (p.z - z) ^ 2
						if d < bestD then
							best, bestD = i, d
						end
					end
				end
			end
		end
	end
	return best, math.sqrt(bestD)
end

-- Is p clear of every road (except samples near `around`) by `margin`?
local function clearOfRoads(grid: Grid, p: vector, margin: number, around: number?, skip: number?): boolean
	local i, d = TrackLayout.nearest(grid, p.x, p.z, 160, around, skip)
	if not i then
		return true
	end
	return d > grid.track.samples[i].width / 2 + margin
end
TrackLayout.clearOfRoads = clearOfRoads

-- Curvature smoothed over a few samples (sample noise would make kerbs flicker).
function TrackLayout.smoothCurv(track: Track, i: number, half: number): number
	local sum = 0
	for j = -half, half do
		sum += track.samples[wrap(i + j, track.n)].curv
	end
	return sum / (2 * half + 1)
end

----------------------------------------------------------------------------
-- Kerbs: inside of every corner tighter than 160, outside of those tighter
-- than 95, starting a little before and ending a little after the corner.
----------------------------------------------------------------------------
function TrackLayout.kerbs(track: Track): { { left: boolean, right: boolean } }
	local n = track.n
	local raw: { { left: boolean, right: boolean } } = table.create(n)
	for i = 1, n do
		local c = TrackLayout.smoothCurv(track, i, steps(track, 2))
		local inside = math.abs(c) > 1 / 160
		local outside = math.abs(c) > 1 / 95
		-- right-hander (c > 0): inside is the right edge
		local right = (c > 0 and inside) or (c < 0 and outside)
		local left = (c < 0 and inside) or (c > 0 and outside)
		raw[i] = { left = left, right = right }
	end
	local out: { { left: boolean, right: boolean } } = table.create(n)
	local reach = steps(track, 2)
	for i = 1, n do
		local l, r = false, false
		for j = -reach, reach do
			local k = raw[wrap(i + j, n)]
			l = l or k.left
			r = r or k.right
		end
		out[i] = { left = l, right = r }
	end
	return out
end

----------------------------------------------------------------------------
-- Bands beside the road, per sample and side (distances beyond the edge):
--   kerb    0 .. kerb        red/white kerb (where there is one)
--   runoff  kerb .. runoff   painted asphalt run-off (outside tight corners)
--   gravel  gravelFrom .. gravelTo (outside the hairpin)
--   turf    .. Turf          artificial turf verge everywhere else
-- Ends taper smoothly between samples and never reach another part of the
-- circuit.
----------------------------------------------------------------------------
export type Bands = { kerb: number, runoff: number, gravelFrom: number, gravelTo: number, turf: number, clear: number }
export type Zones = { { left: Bands, right: Bands } }

local function movingAverage(values: { number }, half: number): { number }
	local n = #values
	local out = table.create(n, 0)
	for i = 1, n do
		local sum = 0
		for j = -half, half do
			sum += values[wrap(i + j, n)]
		end
		out[i] = sum / (2 * half + 1)
	end
	return out
end

local function dilate(values: { boolean }, half: number): { number }
	local n = #values
	local out = table.create(n, 0)
	for i = 1, n do
		for j = -half, half do
			if values[wrap(i + j, n)] then
				out[i] = 1
				break
			end
		end
	end
	return out
end

-- How far out from the edge (up to `maxD`) the ground is clear of other roads.
local function clearance(grid: Grid, smp: Sample, side: number, maxD: number): number
	local half = smp.width / 2
	local dir = outward(smp, side)
	local base = flat(smp.pos) + dir * half
	local d = 2
	while d <= maxD do
		if not clearOfRoads(grid, base + dir * d, 6, smp.i, steps(grid.track, 25)) then
			return math.max(d - 6, 0)
		end
		d += 2
	end
	return maxD
end

-- Samples of a road that passes under another (a figure of eight), within
-- `reach` samples of the crossing: it runs between retaining walls there, so
-- it gets no run-off or gravel (TrackLayout.crossings has the details).
local function underCrossing(track: Track, grid: Grid, reach: number): { [number]: boolean }
	local n = track.n
	local out: { [number]: boolean } = {}
	for i = 1, n do
		local a = track.samples[i]
		local j, d = TrackLayout.nearest(grid, a.pos.x, a.pos.z, a.width, i, steps(track, 30))
		if j then
			local b = track.samples[j]
			if d < math.min(a.width, b.width) / 2 and a.pos.y > b.pos.y + 6 then
				for k = -reach, reach do
					out[wrap(j + k, n)] = true
				end
			end
		end
	end
	return out
end

function TrackLayout.zones(track: Track, grid: Grid): Zones
	local n = track.n
	local kerbs = TrackLayout.kerbs(track)
	local out: Zones = table.create(n)
	local perSide: { [number]: { runoff: { number }, gravel: { number } } } = {}
	local walled = underCrossing(track, grid, steps(track, 13))
	for _, side in { -1, 1 } do
		local tight, hairpin = table.create(n, false), table.create(n, false)
		for i = 1, n do
			local c = TrackLayout.smoothCurv(track, i, steps(track, 4))
			local isOutside = (c > 0 and side < 0) or (c < 0 and side > 0)
			tight[i] = isOutside and math.abs(c) > 1 / 110
			hairpin[i] = isOutside and math.abs(c) > 1 / 50
		end
		perSide[side] = {
			runoff = movingAverage(dilate(tight, steps(track, 5)), steps(track, 3)),
			gravel = movingAverage(dilate(hairpin, steps(track, 4)), steps(track, 3)),
		}
		for i in walled do
			perSide[side].runoff[i] = 0
			perSide[side].gravel[i] = 0
		end
	end
	for i = 1, n do
		local smp = track.samples[i]
		local entry = {} :: any
		for _, side in { -1, 1 } do
			local k = kerbs[i]
			local kw = if (side < 0 and k.left) or (side > 0 and k.right) then TrackLayout.KerbWidth else 0
			local maxD = TrackLayout.GravelTo + 2
			local clear = clearance(grid, smp, side, maxD)
			local runoff = math.max(kw, TrackLayout.RunOff * perSide[side].runoff[i])
			local g = perSide[side].gravel[i]
			local gravelFrom, gravelTo = 0, 0
			if g > 0.01 then
				gravelFrom = TrackLayout.GravelFrom
				gravelTo = TrackLayout.GravelFrom + (TrackLayout.GravelTo - TrackLayout.GravelFrom) * g
				runoff = math.min(runoff, gravelFrom)
			end
			runoff = math.min(runoff, clear)
			gravelTo = math.min(gravelTo, clear)
			if gravelTo <= gravelFrom + 1 then
				gravelFrom, gravelTo = 0, 0
			end
			local turf = math.min(TrackLayout.Turf, clear)
			local bands: Bands = { kerb = kw, runoff = runoff, gravelFrom = gravelFrom, gravelTo = gravelTo, turf = turf, clear = clear }
			if side < 0 then
				entry.left = bands
			else
				entry.right = bands
			end
		end
		out[i] = entry
	end
	return out
end

-- Outer end of the prepared surface on one side (where a barrier may stand).
function TrackLayout.bandEnd(b: Bands): number
	return math.max(b.kerb, b.runoff, b.gravelTo, b.turf)
end

----------------------------------------------------------------------------
-- Barriers: polylines of points on the ground.
----------------------------------------------------------------------------
export type Barrier = { kind: "tyres" | "wall", points: { vector } }

local function chainPoints(raw: { { i: number, p: vector } }, maxGap: number, minCount: number): { { vector } }
	table.sort(raw, function(a, b)
		return a.i < b.i
	end)
	local lines: { { vector } } = {}
	local cur: { vector } = {}
	local last: vector? = nil
	for _, e in raw do
		if last and vector.magnitude(e.p - last) > maxGap then
			if #cur >= minCount then
				table.insert(lines, cur)
			end
			cur = {}
		end
		table.insert(cur, e.p)
		last = e.p
	end
	if #cur >= minCount then
		table.insert(lines, cur)
	end
	return lines
end

function TrackLayout.barriers(track: Track, grid: Grid, zones: Zones): { Barrier }
	local n = track.n
	local out: { Barrier } = {}
	local ground = TrackLayout.ground(track, grid, zones)
	local function onGround(lines: { { vector } }): { { vector } }
		for _, line in lines do
			for k, p in line do
				line[k] = vector.create(p.x, TrackLayout.groundY(ground, p.x, p.z), p.z)
			end
		end
		return lines
	end

	-- (a) concrete walls down the middle of narrow gaps between two parts of the
	-- circuit (not where one crosses the other: the trench walls do that job)
	local gap: { { i: number, p: vector } } = {}
	for i = 1, n do
		local a = track.samples[i]
		local j, d = TrackLayout.nearest(grid, a.pos.x, a.pos.z, 140, i, steps(track, 30))
		if j and (TrackLayout.nearCrossing(ground, i, steps(track, 15)) or TrackLayout.nearCrossing(ground, j, steps(track, 15))) then
			j = nil
		end
		if j then
			local b = track.samples[j]
			local clear = d - a.width / 2 - b.width / 2
			if clear > 16 and clear < 80 and i < j then
				local m = (a.pos + b.pos) / 2
				table.insert(gap, { i = i, p = vector.create(m.x, 0, m.z) })
			end
		end
	end
	for _, line in onGround(chainPoints(gap, 14, 4)) do
		table.insert(out, { kind = "wall", points = line })
	end

	-- (b) tyre walls just beyond the run-off/gravel outside tight corners
	local tyres: { { i: number, p: vector } } = {}
	for i = 1, n do
		local smp = track.samples[i]
		for _, side in { -1, 1 } do
			local b = if side < 0 then zones[i].left else zones[i].right
			local ending = math.max(b.runoff, b.gravelTo)
			if ending > TrackLayout.RunOff * 0.6 and not TrackLayout.nearCrossing(ground, i, steps(track, 3)) then
				local p = flat(smp.pos) + outward(smp, side) * (smp.width / 2 + ending + 3)
				if clearOfRoads(grid, p, 12, i, steps(track, 20)) then
					table.insert(tyres, { i = i * 2 + (if side < 0 then 0 else 1), p = p })
				end
			end
		end
	end
	for _, line in onGround(chainPoints(tyres, 14, 4)) do
		table.insert(out, { kind = "tyres", points = line })
	end
	return out
end

----------------------------------------------------------------------------
-- Pit lane, garages and paddock along the main straight, on the outside of
-- the lap: its left side (-Z) on a clockwise circuit, its right side (+Z)
-- on an anticlockwise one (pitSide)
----------------------------------------------------------------------------
export type Rect = { minX: number, maxX: number, minZ: number, maxZ: number }
export type Paddock = {
	wall: { vector }, -- pit wall polyline
	pitLane: Rect,
	garages: Rect,
	plaza: Rect,
	straightZ: number,
	halfWidth: number,
	side: number, -- -1 left of the main straight (-Z), +1 right
}

-- `leftFrame`: as if the pits were on the left whatever pitSide says (the
-- builder draws them there and mirrors the result).
local paddockCache: { [any]: { [boolean]: Paddock } } = setmetatable({}, { __mode = "k" }) :: any
local function buildPaddock(track: Track, leftFrame: boolean?): Paddock
	-- the main straight runs along +X at z = 0 through the start line
	local minX, maxX = math.huge, -math.huge
	local halfW = 0
	for _, smp in track.samples do
		if math.abs(smp.fwd.x) > 0.999 and math.abs(smp.pos.z) < 1 then
			minX = math.min(minX, smp.pos.x)
			maxX = math.max(maxX, smp.pos.x)
			halfW = math.max(halfW, smp.width / 2)
		end
	end
	local x0, x1 = minX + 12, maxX - 30
	local wallZ = -(halfW + TrackLayout.PitWallLateral)
	local wall: { vector } = {}
	local x = x0
	while x <= x1 do
		table.insert(wall, vector.create(x, 0, wallZ))
		x += 12
	end
	local laneTop = wallZ - 1
	local lane = { minX = x0, maxX = x1, minZ = laneTop - TrackLayout.PitLaneWidth, maxZ = laneTop }
	local garages = { minX = x0 + 10, maxX = x1 - 10, minZ = lane.minZ - TrackLayout.GarageDepth, maxZ = lane.minZ }
	local plaza = { minX = x0 - 10, maxX = x1 + 10, minZ = garages.minZ - TrackLayout.PaddockDepth, maxZ = garages.minZ }
	local side = TrackLayout.pitSide(track)
	-- a compact circuit can bring another road near the back of the paddock:
	-- make it shallower, then shorten it from either end, until it keeps
	-- PaddockClear from every road
	local function blocked(x: number): boolean
		for z = plaza.minZ, plaza.maxZ, 5 do
			local zz = if side > 0 then -z else z
			for _, smp in track.samples do
				local dx, dz = smp.pos.x - x, smp.pos.z - zz
				local r = smp.width / 2 + TrackLayout.PaddockClear
				if dx * dx + dz * dz < r * r then
					return true
				end
			end
		end
		return false
	end
	local function anyBlocked(): boolean
		for x = plaza.minX, plaza.maxX, 5 do
			if blocked(x) then
				return true
			end
		end
		return false
	end
	-- (shallower first: the podium and the spawn sit near its front)
	while plaza.maxZ - plaza.minZ > 40 and anyBlocked() do
		plaza.minZ += 8
	end
	while plaza.maxX - plaza.minX > 200 and (blocked(plaza.minX) or blocked(plaza.minX + 5)) do
		plaza.minX += 10
	end
	while plaza.maxX - plaza.minX > 200 and (blocked(plaza.maxX) or blocked(plaza.maxX - 5)) do
		plaza.maxX -= 10
	end
	local P = { wall = wall, pitLane = lane, garages = garages, plaza = plaza, straightZ = 0, halfWidth = halfW, side = -1 }
	if side > 0 and not leftFrame then
		-- mirrored across the main straight (z -> -z)
		local function flip(r: Rect): Rect
			return { minX = r.minX, maxX = r.maxX, minZ = -r.maxZ, maxZ = -r.minZ }
		end
		for k, p in wall do
			wall[k] = vector.create(p.x, p.y, -p.z)
		end
		P.pitLane, P.garages, P.plaza, P.side = flip(lane), flip(garages), flip(plaza), 1
	end
	return P
end

function TrackLayout.paddock(track: Track, leftFrame: boolean?): Paddock
	local byFrame = paddockCache[track]
	if not byFrame then
		byFrame = {}
		paddockCache[track] = byFrame
	end
	local key = leftFrame == true
	local P = byFrame[key]
	if not P then
		P = buildPaddock(track, leftFrame)
		byFrame[key] = P
	end
	return P
end

-- Which side of the main straight the pits are on: -1 left (a clockwise
-- lap, or a figure of eight), +1 right (an anticlockwise lap, whose infield
-- is on the left).
function TrackLayout.pitSide(track: Track): number
	local turn = 0
	for _, smp in track.samples do
		turn += smp.curv * track.spacing
	end
	return if turn < -math.pi then 1 else -1
end

----------------------------------------------------------------------------
-- Grandstands, bridge, marshal posts
----------------------------------------------------------------------------
export type Stand = { center: vector, facing: vector, length: number, depth: number, name: string }

local function segmentMiddle(track: Track, segment: number): number?
	local first, last = nil, nil
	for i, smp in track.samples do
		if smp.segment == segment then
			first = first or i
			last = i
		end
	end
	if not first or not last then
		return nil
	end
	return (first + last) // 2
end
TrackLayout.segmentMiddle = segmentMiddle

-- Corners: runs of consecutive arcs that share a name (a long corner drawn as
-- several arcs, like Luffield) count as one corner; unnamed arcs stand alone.
-- `mid` is the middle sample of the whole corner, `angle` its total turn.
export type Corner = { name: string?, angle: number, first: number, last: number, mid: number }

function TrackLayout.corners(track: Track, segments: { any }): { Corner }
	local out: { Corner } = {}
	local cur: Corner? = nil
	for k, seg in segments do
		if seg.kind == "A" then
			if cur and seg.name ~= nil and cur.name == seg.name and cur.last == k - 1 then
				cur.angle += seg.angle
				cur.last = k
			else
				cur = { name = seg.name, angle = seg.angle, first = k, last = k, mid = 0 }
				table.insert(out, cur :: Corner)
			end
		else
			cur = nil
		end
	end
	local kept: { Corner } = {}
	for _, c in out do
		local first, last = nil, nil
		for i, smp in track.samples do
			if smp.segment >= c.first and smp.segment <= c.last then
				first = first or i
				last = i
			end
		end
		if first and last then
			c.mid = (first + last) // 2
			table.insert(kept, c)
		end
	end
	return kept
end

-- Grandstand facing the road at sample i on `side`, set back past the bands.
local function standAt(track: Track, zones: Zones, i: number, side: number, setback: number, length: number, name: string): Stand
	local smp = track.samples[i]
	local b = if side < 0 then zones[i].left else zones[i].right
	local dir = outward(smp, side)
	local d = smp.width / 2 + TrackLayout.bandEnd(b) + setback
	return { center = flat(smp.pos) + dir * d, facing = -dir, length = length, depth = 28, name = name }
end

function TrackLayout.stands(track: Track, grid: Grid, zones: Zones, segments: { any }): { Stand }
	local P = TrackLayout.paddock(track)
	local ground = TrackLayout.ground(track, grid, zones)
	-- clear of every road? Then the highest ground under the footprint.
	local function fit(st: Stand): number?
		local along = vector.cross(st.facing, UP)
		local top = 0
		for _, u in { -0.5, 0, 0.5 } do
			for _, v in { 0, 1 } do
				local p = st.center + along * (u * st.length) - st.facing * (v * st.depth)
				if not clearOfRoads(grid, p, 10) then
					return nil
				end
				top = math.max(top, TrackLayout.groundY(ground, p.x, p.z))
			end
		end
		return top
	end
	local kept: { Stand } = {}
	-- main grandstand: across the main straight from the pits, facing them, on
	-- the level; shorter (and slid along) where the infield is cramped
	local full = math.min(P.pitLane.maxX - P.pitLane.minX - 40, 280)
	local mainX = (P.pitLane.minX + P.pitLane.maxX) / 2
	local placed = false
	for _, len in { full, 200, 140 } do
		if placed or len > full then
			continue
		end
		local slack = (full - len) / 2
		for _, dx in { 0, -slack, slack, -slack / 2, slack / 2 } do
			local st: Stand = {
				center = vector.create(mainX + dx, 0, -P.side * (P.halfWidth + 14 + 14)),
				facing = vector.create(0, 0, P.side),
				length = len,
				depth = 28,
				name = "Main",
			}
			local top = fit(st)
			if top and top <= 0.3 then
				table.insert(kept, st)
				placed = true
				break
			end
		end
	end
	-- outside the slowest corners: on the level, or up on a concrete plinth
	-- where the ground there is an embankment (a circuit with hills)
	for _, c in TrackLayout.corners(track, segments) do
		if math.abs(c.angle) >= 90 then
			local side = if c.angle > 0 then -1 else 1
			local st = standAt(track, zones, c.mid, side, 22, 100, c.name or "Corner")
			local top = fit(st)
			if top then
				if top > 0.3 then
					st.center = vector.create(st.center.x, top, st.center.z)
				end
				table.insert(kept, st)
			end
		end
	end
	return kept
end

-- Sample index for the sponsor bridge: over the straight called `name` if
-- given, else over the longest fixed-length straight (not the first one).
function TrackLayout.bridge(track: Track, segments: { any }, name: string?): number?
	if name then
		for k, seg in segments do
			if seg.kind == "S" and seg.name == name then
				return segmentMiddle(track, k)
			end
		end
	end
	local best, bestLen = nil, 0
	for k, seg in segments do
		if seg.kind == "S" and type(seg.length) == "number" and seg.length > bestLen and k ~= 1 then
			best, bestLen = k, seg.length
		end
	end
	return if best then segmentMiddle(track, best) else nil
end

export type Post = { pos: vector, facing: vector }

-- A marshal post on the inside of every corner of 60 degrees or more.
function TrackLayout.marshals(track: Track, grid: Grid, zones: Zones, segments: { any }): { Post }
	local out: { Post } = {}
	for _, c in TrackLayout.corners(track, segments) do
		if math.abs(c.angle) >= 60 then
			local i = c.mid
			local smp = track.samples[i]
			local side = if c.angle > 0 then 1 else -1 -- inside of the corner
			local b = if side < 0 then zones[i].left else zones[i].right
			local dir = outward(smp, side)
			local p = flat(smp.pos) + dir * (smp.width / 2 + TrackLayout.bandEnd(b) + 8)
			if clearOfRoads(grid, p, 8, i, steps(track, 15)) then
				local y = TrackLayout.groundY(TrackLayout.ground(track, grid, zones), p.x, p.z)
				table.insert(out, { pos = vector.create(p.x, y, p.z), facing = -dir })
			end
		end
	end
	return out
end

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------
local function lcg(seed: number): () -> number
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	return function(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
end
TrackLayout.random = lcg

-- Bounding box of the circuit plus a margin.
function TrackLayout.bounds(track: Track, margin: number): Rect
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, smp in track.samples do
		minX = math.min(minX, smp.pos.x)
		maxX = math.max(maxX, smp.pos.x)
		minZ = math.min(minZ, smp.pos.z)
		maxZ = math.max(maxZ, smp.pos.z)
	end
	return { minX = minX - margin, maxX = maxX + margin, minZ = minZ - margin, maxZ = maxZ + margin }
end

-- The walled facility: circuit plus margin, stretched to include the paddock.
function TrackLayout.facility(track: Track): Rect
	-- room for the embankments of a raised circuit inside the fence
	local maxY = 0
	for _, smp in track.samples do
		maxY = math.max(maxY, smp.pos.y)
	end
	local margin = math.max(TrackLayout.FacilityMargin, maxY * TrackLayout.EmbankRun + TrackLayout.GravelTo + 24)
	local b = TrackLayout.bounds(track, margin)
	local P = TrackLayout.paddock(track)
	b.minZ = math.min(b.minZ, P.plaza.minZ - 10)
	b.maxZ = math.max(b.maxZ, P.plaza.maxZ + 10)
	-- round to 10 studs so the lawn stripes line up
	b.minX = math.floor(b.minX / 10) * 10
	b.minZ = math.floor(b.minZ / 10) * 10
	b.maxX = math.ceil(b.maxX / 10) * 10
	b.maxZ = math.ceil(b.maxZ / 10) * 10
	return b
end

-- Open ground inside the facility, away from everything that gets built:
-- points every `step` studs that are at least `minClear` studs from the
-- nearest road edge (well past kerbs, run-off, barriers and corner boards),
-- off the paddock and clear of the grandstands. Most open first; `clear` is
-- the distance to the nearest road edge (capped at 400), or to the fence or
-- a grandstand plus 26 if one of those is nearer. For lakes and trees.
export type Spot = { pos: vector, clear: number }
function TrackLayout.openGround(track: Track, grid: Grid, zones: Zones, segments: { any }, step: number, minClear: number): { Spot }
	local f = TrackLayout.facility(track)
	local P = TrackLayout.paddock(track)
	local stands = TrackLayout.stands(track, grid, zones, segments)
	local out: { Spot } = {}
	for x = f.minX + 30, f.maxX - 30, step do
		for z = f.minZ + 30, f.maxZ - 30, step do
			-- the pits and the paddock beside the main straight
			local near = if P.side < 0 then P.pitLane.maxZ else P.pitLane.minZ
			if P.side * z > P.side * near - 10 and x > P.plaza.minX - 30 and x < P.plaza.maxX + 30 then
				continue
			end
			local i, d = TrackLayout.nearest(grid, x, z, 400)
			local clear = if i then d - track.samples[i].width / 2 else 400
			-- the perimeter fence and the grandstands count as obstacles too,
			-- with a smaller margin than the road (EDGE_SLACK closer), so a
			-- lake sized by `clear` stays inside the fence and off the stands
			local EDGE_SLACK = 26
			local edge = math.min(x - f.minX, f.maxX - x, z - f.minZ, f.maxZ - z)
			clear = math.min(clear, edge + EDGE_SLACK)
			if clear < minClear then
				continue
			end
			local free = true
			for _, st in stands do
				local dx, dz = x - st.center.x, z - st.center.z
				local gap = math.sqrt(dx * dx + dz * dz) - (st.length / 2 + st.depth)
				if gap < 25 then
					free = false
					break
				end
				clear = math.min(clear, gap + EDGE_SLACK)
			end
			if free and clear >= minClear then
				table.insert(out, { pos = vector.create(x, 0, z), clear = clear })
			end
		end
	end
	table.sort(out, function(a, b)
		return a.clear > b.clear
	end)
	return out
end

----------------------------------------------------------------------------
-- Ground under a circuit with hills (TrackData `y` values): grassy
-- embankments fall away from the outer edge of the bands at 1 in EmbankRun
-- down to the lawn, or until they meet another embankment (the higher one
-- wins, so two slopes meet in a valley) or another road. Flat circuits have
-- none and everything stays at y = 0.
----------------------------------------------------------------------------
TrackLayout.EmbankRun = 2.5 -- horizontal studs per stud of drop (about 22 degrees)

-- outer edge of the prepared surface (road + bands) on one side of a sample
export type Edge = { top: vector, dir: vector, foot: number }
export type Ground = {
	raised: boolean,
	track: Track,
	grid: Grid,
	zones: Zones,
	edges: { { left: Edge, right: Edge } },
	reach: number,
}
-- one strip of embankment: from the band edge (`top`) down to the `toe`;
-- `pocket` when it stopped above the lawn because its neighbours converge
-- (inside a tight corner): the ground beyond is filled by `pockets`
export type Skirt = { top: vector, toe: vector, pocket: boolean? }

local groundCache: { [any]: Ground } = setmetatable({}, { __mode = "k" }) :: any

function TrackLayout.ground(track: Track, grid: Grid, zones: Zones): Ground
	local cached = groundCache[track]
	if cached then
		return cached
	end
	local edges = table.create(track.n)
	local maxTop, maxFoot = 0, 0
	for i, smp in track.samples do
		local e = {} :: any
		for _, side in { -1, 1 } do
			local b = if side < 0 then zones[i].left else zones[i].right
			local dir = outward(smp, side)
			local top = smp.pos + smp.right * (side * smp.width / 2) + dir * TrackLayout.bandEnd(b)
			local foot = vector.magnitude(flat(top - smp.pos))
			maxTop = math.max(maxTop, top.y)
			maxFoot = math.max(maxFoot, foot)
			local edge: Edge = { top = top, dir = dir, foot = foot }
			if side < 0 then
				e.left = edge
			else
				e.right = edge
			end
		end
		edges[i] = e
	end
	local g: Ground = {
		raised = maxTop > 0.3,
		track = track,
		grid = grid,
		zones = zones,
		edges = edges,
		reach = maxTop * TrackLayout.EmbankRun + maxFoot + 4,
	}
	groundCache[track] = g
	return g
end

-- Height of the ground (road, bands or embankment) at x, z; 0 on the lawn.
-- Samples within `skip` of `around` are left out, and so are those within
-- `skip2` of `around2`.
local function rawGroundY(g: Ground, x: number, z: number, around: number?, skip: number?, around2: number?, skip2: number?): number
	if not g.raised then
		return 0
	end
	local track = g.track
	local n = track.n
	local run = TrackLayout.EmbankRun
	local r = math.ceil(g.reach / CELL)
	local cx, cz = math.floor(x / CELL), math.floor(z / CELL)
	local best = 0
	for dx = -r, r do
		for dz = -r, r do
			local list = g.grid.cells[cellKey(cx + dx, cz + dz)]
			if list then
				for _, j in list do
					if around and skip then
						local sep = math.abs(j - around)
						if math.min(sep, n - sep) <= skip then
							continue
						end
					end
					if around2 and skip2 then
						local sep = math.abs(j - around2)
						if math.min(sep, n - sep) <= skip2 then
							continue
						end
					end
					local smp = track.samples[j]
					local ox, oz = x - smp.pos.x, z - smp.pos.z
					local e = if ox * smp.right.x + oz * smp.right.z >= 0 then g.edges[j].right else g.edges[j].left
					if e.top.y <= best then
						continue
					end
					local d = math.sqrt(ox * ox + oz * oz)
					local h = e.top.y - math.max(0, d - e.foot) / run
					if h > best then
						best = h
					end
				end
			end
		end
	end
	return best
end

----------------------------------------------------------------------------
-- Crossings (a figure of eight): where one part of the circuit passes over
-- another on a bridge. The upper road's `deck` samples are the bridge span
-- (everything of theirs that would stand over the lower road's prepared
-- surface: no embankment under it, a girder and parapets instead); the lower
-- road runs through a trench of concrete retaining walls (`walls`, along its
-- band edges) for as long as the ground beside it is higher than its edge.
----------------------------------------------------------------------------
TrackLayout.CrossingClear = 6 -- a road this much lower where two overlap passes under
TrackLayout.TrenchWall = 2 -- retaining wall thickness
TrackLayout.TrenchKerb = 2.5 -- the walls stand this high above the ground behind them
TrackLayout.GirderDepth = 2.2 -- bridge girder under the deck road
TrackLayout.ParapetHeight = 2.6

-- p: foot of the wall's road-side face (on the band edge, at y 0); dir: out from the road
export type Wall = { i: number, side: number, p: vector, dir: vector, top: number, bottom: number }
export type Crossing = {
	over: number, -- upper-road sample at the crossing point
	under: number, -- lower-road sample under it
	deck: { number }, -- upper-road samples on the bridge, in lap order
	deckSet: { [number]: boolean },
	trenchSet: { [number]: boolean }, -- lower-road samples with a wall on either side
	walls: { Wall },
}

-- The lower-road sample (within `range` of `centre`) whose prepared surface,
-- widened by `extra` studs, q is on; also the lateral offset.
local function onRoadNear(g: Ground, q: vector, centre: number, range: number, extra: number): (number?, number)
	local track = g.track
	local n = track.n
	local best, bestD = nil, math.huge
	for k = centre - range, centre + range do
		local j = wrap(k, n)
		local p = track.samples[j].pos
		local d = (q.x - p.x) ^ 2 + (q.z - p.z) ^ 2
		if d < bestD then
			best, bestD = j, d
		end
	end
	if not best then
		return nil, 0
	end
	local smp = track.samples[best]
	local ox, oz = q.x - smp.pos.x, q.z - smp.pos.z
	local fl = math.sqrt(smp.fwd.x ^ 2 + smp.fwd.z ^ 2)
	local along = (ox * smp.fwd.x + oz * smp.fwd.z) / fl
	if math.abs(along) > track.spacing * 0.75 then
		return nil, 0
	end
	local rl = math.sqrt(smp.right.x ^ 2 + smp.right.z ^ 2)
	local lateral = (ox * smp.right.x + oz * smp.right.z) / rl
	local e = if lateral >= 0 then g.edges[best].right else g.edges[best].left
	if math.abs(lateral) <= e.foot + extra then
		return best, lateral
	end
	return nil, 0
end

local crossingCache: { [any]: { Crossing } } = setmetatable({}, { __mode = "k" }) :: any

function TrackLayout.crossings(g: Ground): { Crossing }
	local cached = crossingCache[g]
	if cached then
		return cached
	end
	local track = g.track
	local n = track.n
	local samples = track.samples
	-- upper-road samples standing over another road's centre line
	local hits: { { i: number, j: number, d: number } } = {}
	for i = 1, n do
		local a = samples[i]
		local j, d = TrackLayout.nearest(g.grid, a.pos.x, a.pos.z, a.width, i, steps(track, 30))
		if j then
			local b = samples[j]
			if d < math.min(a.width, b.width) / 2 and a.pos.y > b.pos.y + TrackLayout.CrossingClear then
				table.insert(hits, { i = i, j = j, d = d })
			end
		end
	end
	-- one crossing per run of such samples: the closest pair
	local out: { Crossing } = {}
	local k = 1
	while k <= #hits do
		local best = hits[k]
		local m = k + 1
		while m <= #hits and hits[m].i - hits[m - 1].i <= 2 do
			if hits[m].d < best.d then
				best = hits[m]
			end
			m += 1
		end
		k = m
		local over, under = best.i, best.j
		-- the bridge span: upper-road samples whose prepared surface reaches the
		-- lower road's (plus room for its walls)
		local function overlaps(s: number): boolean
			local smp = samples[s]
			local el, er = g.edges[s].left, g.edges[s].right
			local dir = outward(smp, 1)
			local t = -el.foot
			while true do
				local q = flat(smp.pos) + dir * t
				if onRoadNear(g, q, under, steps(track, 60), TrackLayout.TrenchWall + 1) then
					return true
				end
				if t >= er.foot then
					return false
				end
				t = math.min(t + 2, er.foot)
			end
		end
		local deck = { over }
		for _, step in { -1, 1 } do
			local s = over + step
			while math.abs(s - over) < steps(track, 40) and overlaps(wrap(s, n)) do
				if step < 0 then
					table.insert(deck, 1, wrap(s, n))
				else
					table.insert(deck, wrap(s, n))
				end
				s += step
			end
		end
		local deckSet: { [number]: boolean } = {}
		for _, s in deck do
			deckSet[s] = true
		end
		-- the deck road's underside over point q (or nil if q is not under it)
		local function deckUnder(q: vector): number?
			local low: number? = nil
			for _, s in deck do
				local smp = samples[s]
				local ox, oz = q.x - smp.pos.x, q.z - smp.pos.z
				local fl = math.sqrt(smp.fwd.x ^ 2 + smp.fwd.z ^ 2)
				local along = (ox * smp.fwd.x + oz * smp.fwd.z) / fl
				local rl = math.sqrt(smp.right.x ^ 2 + smp.right.z ^ 2)
				local lateral = (ox * smp.right.x + oz * smp.right.z) / rl
				local e = if lateral >= 0 then g.edges[s].right else g.edges[s].left
				if math.abs(along) <= track.spacing * 0.75 and math.abs(lateral) <= e.foot + 1.5 then
					local y = smp.pos.y - TrackLayout.RoadThickness - TrackLayout.GirderDepth
					low = if low then math.min(low, y) else y
				end
			end
			return low
		end
		-- retaining walls: out along the lower road while the ground beside it
		-- (the upper road's embankment, everything but the lower road itself)
		-- stands above its edge
		local walls: { Wall } = {}
		local trenchSet: { [number]: boolean } = {}
		for _, step in { -1, 1 } do
			local quiet = 0
			local s = if step < 0 then under else under + 1
			while math.abs(s - under) < steps(track, 50) and quiet < steps(track, 3) do
				local idx = wrap(s, n)
				local smp = samples[idx]
				local any = false
				for _, side in { -1, 1 } do
					local e = if side < 0 then g.edges[idx].left else g.edges[idx].right
					local p = flat(smp.pos) + e.dir * e.foot
					local mid = p + e.dir * (TrackLayout.TrenchWall / 2)
					local beside = rawGroundY(g, mid.x, mid.z, idx, steps(track, 60))
					if beside > e.top.y + 0.5 then
						local top = beside + TrackLayout.TrenchKerb
						local cap = deckUnder(mid)
						if cap then
							top = math.min(top, cap)
						end
						table.insert(walls, { i = idx, side = side, p = p, dir = e.dir, top = top, bottom = e.top.y - 1 })
						any = true
					end
				end
				if any then
					trenchSet[idx] = true
					quiet = 0
				else
					quiet += 1
				end
				s += step
			end
		end
		table.insert(out, { over = over, under = under, deck = deck, deckSet = deckSet, trenchSet = trenchSet, walls = walls })
	end
	crossingCache[g] = out
	return out
end

-- Is sample i on (or within `margin` samples of) a bridge span or a trench?
function TrackLayout.nearCrossing(g: Ground, i: number, margin: number): boolean
	local n = g.track.n
	for _, c in TrackLayout.crossings(g) do
		for k = -margin, margin do
			local j = wrap(i + k, n)
			if c.deckSet[j] or c.trenchSet[j] then
				return true
			end
		end
	end
	return false
end

-- Height of the ground (road, bands or embankment) at x, z; 0 on the lawn.
-- Samples within `skip` of `around` are left out. Inside a trench (on the
-- lower road's prepared surface at a crossing) the upper road and its
-- embankment are left out: there the ground is the lower road.
function TrackLayout.groundY(g: Ground, x: number, z: number, around: number?, skip: number?): number
	if not g.raised then
		return 0
	end
	local q = vector.create(x, 0, z)
	for _, c in TrackLayout.crossings(g) do
		if onRoadNear(g, q, c.under, steps(g.track, 50), 0.5) then
			return rawGroundY(g, x, z, around, skip, c.over, steps(g.track, 45))
		end
	end
	return rawGroundY(g, x, z, around, skip)
end

-- Embankment strips per sample and side (nil where the edge is at ground
-- level). Each runs straight out from the band edge and stops at the lawn,
-- where it meets a neighbouring strip (inside a corner), or at another road's
-- bands (ramping down to their edge height if it is still above it). Strips
-- of two parts of the circuit simply cross where their slopes meet: the
-- higher one is what shows, and no gap is left between them.
function TrackLayout.skirts(g: Ground): { { left: Skirt?, right: Skirt? } }
	local track = g.track
	local n = track.n
	local run = TrackLayout.EmbankRun
	local out = table.create(n)
	for i = 1, n do
		local entry = {} :: any
		if g.raised then
			for _, side in { -1, 1 } do
				local e = if side < 0 then g.edges[i].left else g.edges[i].right
				local h0 = e.top.y
				if h0 < 0.3 then
					continue
				end
				local maxT = h0 * run
				local base = flat(e.top)
				-- on the inside of a corner the strips converge: stop where this
				-- one meets a neighbour's, so they never cross
				local near = steps(track, 3)
				for k = -near, near do
					if k ~= 0 then
						local j = wrap(i + k, n)
						local ej = if side < 0 then g.edges[j].left else g.edges[j].right
						local bj = flat(ej.top)
						local det = e.dir.x * (-ej.dir.z) - e.dir.z * (-ej.dir.x)
						if math.abs(det) > 1e-6 then
							local rx, rz = bj.x - base.x, bj.z - base.z
							local tt = (rx * (-ej.dir.z) - rz * (-ej.dir.x)) / det
							local ss = (e.dir.x * rz - e.dir.z * rx) / det
							if tt > 0 and ss > 0 then
								maxT = math.min(maxT, tt)
							end
						end
					end
				end
				local converged = maxT < h0 * run - 1e-6
				local byRoad = false
				local toeT, toeY = maxT, h0 - maxT / run
				-- the other road whose prepared surface q is on (or nil), and its edge height there
				local function otherRoad(q: vector): number?
					local j, d = TrackLayout.nearest(g.grid, q.x, q.z, 80, i, steps(track, 4))
					if not j then
						return nil
					end
					local smp = track.samples[j]
					local ox, oz = q.x - smp.pos.x, q.z - smp.pos.z
					-- on that sample's cross-section (not just near it: inside a
					-- corner the same road's earlier samples are near too)
					local fl = math.sqrt(smp.fwd.x ^ 2 + smp.fwd.z ^ 2)
					local along = (ox * smp.fwd.x + oz * smp.fwd.z) / fl
					if math.abs(along) > track.spacing * 0.75 then
						return nil
					end
					local ej = if ox * smp.right.x + oz * smp.right.z >= 0 then g.edges[j].right else g.edges[j].left
					return if d < ej.foot then ej.top.y else nil
				end
				-- on a bridge: no strip from an edge that stands over the road
				-- passing underneath (the walls there are TrackLayout.crossings')
				local below = otherRoad(base)
				if below and below < h0 - TrackLayout.CrossingClear then
					continue
				end
				local step = 2
				local t = 0
				while t < maxT do
					local tn = math.min(t + step, maxT)
					local q = base + e.dir * tn
					-- reached another road's bands: end the strip at their edge
					if otherRoad(q) then
						local lo, hi = t, tn
						for _ = 1, 8 do
							local mid = (lo + hi) / 2
							if otherRoad(base + e.dir * mid) then
								hi = mid
							else
								lo = mid
							end
						end
						-- ramp down to their edge if still above it; if already
						-- below, stop there (their own strip covers this one)
						toeT = hi
						toeY = math.min(otherRoad(base + e.dir * hi) or 0, h0 - hi / run)
						-- never steeper than 45 degrees: a very short strip to a
						-- lower road stays level and leaves a kerb-like step
						toeY = math.max(toeY, h0 - hi * 0.8)
						byRoad = true
						break
					end
					t = tn
				end
				-- even a strip that meets another road's bands at once is kept
				-- (down to zero length): its neighbours' strips need its top to
				-- close the thin gap between the two bands
				do
					local toe = base + e.dir * toeT
					local skirt: Skirt = {
						top = e.top,
						toe = vector.create(toe.x, toeY, toe.z),
						pocket = converged and not byRoad and toeY > 0.3,
					}
					if side < 0 then
						entry.left = skirt
					else
						entry.right = skirt
					end
				end
			end
		end
		out[i] = entry
	end
	return out
end

-- The ground inside a tight corner, where the strips from the inner band
-- edge converge and stop above the lawn (`pocket` strips). Left as they
-- are, the space beyond them, between the long strips either side of the
-- corner, would be a hole down to the lawn, and the stopped strips cross
-- each other at different heights. So each run of pocket strips is replaced
-- by a fan: triangles from every pair of band-edge points to one hub (where
-- the strips converge, at the height their slopes reach there on average),
-- two triangles from the hub along the long strips either side, and one
-- across the mouth between those strips' toes. `skip[i]` (per side) marks the
-- strip pairs (i, i + 1) the fan replaces. A run whose fan would fold over
-- itself has its strips carried on down to the lawn instead (they cross).
export type Pockets = { tris: { { vector } }, skipLeft: { [number]: boolean }, skipRight: { [number]: boolean } }
function TrackLayout.pockets(g: Ground, skirts: { { left: Skirt?, right: Skirt? } }): Pockets
	local n = g.track.n
	local run = TrackLayout.EmbankRun
	local result: Pockets = { tris = {}, skipLeft = {}, skipRight = {} }
	for _, side in { -1, 1 } do
		local skip = if side < 0 then result.skipLeft else result.skipRight
		local function get(i: number): Skirt?
			local e = skirts[wrap(i, n)]
			return if side < 0 then e.left else e.right
		end
		-- walk the lap from just after a sample that is not in a pocket, so
		-- no run is split by the wrap-around
		local start = nil
		for k = 1, n do
			local s = get(k)
			if not (s and s.pocket) then
				start = k
				break
			end
		end
		if not start then
			continue
		end
		local k = 0
		while k < n do
			local i = start + 1 + k
			local s = get(i)
			if not (s and s.pocket) then
				k += 1
				continue
			end
			local len = 1
			while k + len < n do
				local nb = get(i + len)
				if not (nb and nb.pocket) then
					break
				end
				len += 1
			end
			k += len
			local a, b = i, i + len - 1
			local first, last = get(a - 1), get(b + 1)
			if not (first and last) then
				continue
			end
			-- the outline, walked once round: band edge, out along the last long
			-- strip, across the mouth, back along the first
			local outline: { vector } = {}
			for j = a - 1, b + 1 do
				table.insert(outline, (get(j) :: Skirt).top)
			end
			-- the two long strips may cross before their toes: then the mouth
			-- closes at the crossing (at the higher strip's height there)
			local p1, d1 = first.top, first.toe - first.top
			local p2, d2 = last.top, last.toe - last.top
			local den = d1.x * d2.z - d1.z * d2.x
			local crossAt: vector? = nil
			if math.abs(den) > 1e-6 then
				local rx, rz = p2.x - p1.x, p2.z - p1.z
				local s1 = (rx * d2.z - rz * d2.x) / den
				local s2 = (rx * d1.z - rz * d1.x) / den
				if s1 > 0 and s1 < 1 and s2 > 0 and s2 < 1 then
					local q = p1 + d1 * s1
					crossAt = vector.create(q.x, math.max(q.y, p2.y + d2.y * s2), q.z)
				end
			end
			if crossAt then
				table.insert(outline, crossAt)
			else
				table.insert(outline, last.toe)
				table.insert(outline, first.toe)
			end
			-- hub: where the stopped strips end, on average; if the fan from
			-- there would fold (the outline is not star-shaped around it), try
			-- points between it and the middle of the outline / the band edge
			local tx, tz = 0, 0
			for j = a, b do
				local t = (get(j) :: Skirt).toe
				tx += t.x
				tz += t.z
			end
			tx /= len
			tz /= len
			local ox, oz, ex, ez = 0, 0, 0, 0
			for _, q in outline do
				ox += q.x / #outline
				oz += q.z / #outline
			end
			for j = a, b do
				local top = (get(j) :: Skirt).top
				ex += top.x / len
				ez += top.z / len
			end
			local candidates = { { tx, tz }, { ox, oz } }
			for _, f in { 0.25, 0.5, 0.75 } do
				table.insert(candidates, { tx + (ox - tx) * f, tz + (oz - tz) * f })
			end
			for _, f in { 0.25, 0.5 } do
				table.insert(candidates, { tx + (ex - tx) * f, tz + (ez - tz) * f })
			end
			local tris: { { vector } } = {}
			local folds = true
			for _, cand in candidates do
				local hx, hz = cand[1], cand[2]
				local hy, cnt, lowest = 0, 0, math.huge
				for j = a - 1, b + 1 do
					local top = (get(j) :: Skirt).top
					hy += top.y - math.sqrt((top.x - hx) ^ 2 + (top.z - hz) ^ 2) / run
					cnt += 1
					lowest = math.min(lowest, top.y)
				end
				local hub = vector.create(hx, math.clamp(hy / cnt, 0, lowest), hz)
				tris = {}
				folds = false
				local sign = 0
				for j = 1, #outline do
					local p, q = outline[j], outline[j % #outline + 1]
					local cross = (q.x - p.x) * (hub.z - p.z) - (q.z - p.z) * (hub.x - p.x)
					if math.abs(cross) > 1e-3 then
						local sg = if cross > 0 then 1 else -1
						if sign == 0 then
							sign = sg
						elseif sg ~= sign then
							folds = true
							break
						end
						table.insert(tris, { p, q, hub })
					end
				end
				if not folds then
					break
				end
			end
			if folds then
				-- no hub works (an S-bend's strips fan out at the mouth): let
				-- the run's strips go on down to the lawn instead, crossing
				-- each other (a crease in the grass rather than a hole)
				for j = a, b do
					local k = get(j) :: Skirt
					local fl = vector.create(k.toe.x - k.top.x, 0, k.toe.z - k.top.z)
					if vector.magnitude(fl) > 1e-6 then
						local toe = k.top + vector.normalize(fl) * (k.top.y * run)
						k.toe = vector.create(toe.x, 0, toe.z)
						k.pocket = false
					end
				end
				continue
			end
			for _, t in tris do
				table.insert(result.tris, t)
			end
			for j = a - 1, b do
				skip[wrap(j, n)] = true
			end
		end
	end
	return result
end

----------------------------------------------------------------------------
-- Road surface pieces. Between two samples the road is a quad whose two
-- cross-sections are straight lines. Where the road climbs through a corner
-- (or the banking winds on) those lines are at different angles and heights,
-- so the quad is twisted, and built from two triangles it has a fold along
-- the diagonal (up to ~0.6 studs on Hillside): the karts rattled over one
-- every sample. A twisted quad is split into a grid of smaller pieces whose
-- corners lie on the smooth (bilinear) surface through its four corners,
-- until every fold is under RoadFold. Flat circuits keep two triangles per
-- quad. (The other half of the rattle was the facets of a sloped or banked
-- corner: circuits with hills use 5-stud samples instead of 6.)
----------------------------------------------------------------------------
TrackLayout.RoadFold = 0.05 -- studs
TrackLayout.RoadSplitAcross = 4 -- most strips across the road
TrackLayout.RoadSplitAlong = 6 -- most rows along it

local function quadCorners(track: Track, i: number): (vector, vector, vector, vector)
	local a = track.samples[i]
	local b = track.samples[wrap(i + 1, track.n)]
	local ha, hb = a.width / 2, b.width / 2
	return a.pos - a.right * ha, a.pos + a.right * ha, b.pos - b.right * hb, b.pos + b.right * hb
end

-- The triangles of road quad i..i+1 split `across` x `along` (neighbouring
-- quads share the straight cross-section between them, so no cracks).
function TrackLayout.roadTriangles(track: Track, i: number, across: number, along: number): { { vector } }
	local l0, r0, l1, r1 = quadCorners(track, i)
	local function at(u: number, v: number): vector
		local a = l0 + (r0 - l0) * u
		local b = l1 + (r1 - l1) * u
		return a + (b - a) * v
	end
	local out: { { vector } } = {}
	for p = 0, across - 1 do
		for q = 0, along - 1 do
			local p00, p10 = at(p / across, q / along), at((p + 1) / across, q / along)
			local p01, p11 = at(p / across, (q + 1) / along), at((p + 1) / across, (q + 1) / along)
			table.insert(out, { p00, p10, p11 })
			table.insert(out, { p00, p11, p01 })
		end
	end
	return out
end

-- The biggest fold among pieces from roadTriangles: how far each piece's
-- fourth corner is off the plane of its first triangle.
function TrackLayout.roadFold(tris: { { vector } }): number
	local worst = 0
	for k = 1, #tris, 2 do
		local a, b, c, d = tris[k][1], tris[k][2], tris[k][3], tris[k + 1][3]
		local nrm = vector.cross(b - a, c - a)
		if vector.magnitude(nrm) > 1e-9 then
			worst = math.max(worst, math.abs(vector.dot(d - a, vector.normalize(nrm))))
		end
	end
	return worst
end

-- How the road quad i..i+1 is split: strips across, rows along (the fewest
-- pieces that leave no fold over RoadFold, within the limits).
function TrackLayout.roadSplit(track: Track, i: number): (number, number)
	local fold = TrackLayout.roadFold(TrackLayout.roadTriangles(track, i, 1, 1))
	if fold <= TrackLayout.RoadFold then
		return 1, 1
	end
	local need = math.ceil(fold / TrackLayout.RoadFold - 1e-9)
	local across = math.min(need, TrackLayout.RoadSplitAcross)
	local along = math.min(math.ceil(need / across), TrackLayout.RoadSplitAlong)
	-- the estimate assumes one normal for the whole quad; check the pieces
	while TrackLayout.roadFold(TrackLayout.roadTriangles(track, i, across, along)) > TrackLayout.RoadFold do
		if along < TrackLayout.RoadSplitAlong then
			along += 1
		elseif across < TrackLayout.RoadSplitAcross then
			across += 1
		else
			break
		end
	end
	return across, along
end

-- Grid slot pose on the track (position on the road surface, forward, up).
function TrackLayout.gridSlot(track: Track, slotIndex: number, cfg: { GridFirstRowBack: number, GridRowSpacing: number, GridLateral: number, GridStagger: number }): (vector, vector, vector)
	local k = slotIndex - 1
	local row = k // 2
	local leftSide = k % 2 == 0
	local back = cfg.GridFirstRowBack + row * cfg.GridRowSpacing + (if leftSide then 0 else cfg.GridStagger)
	local lateral = if leftSide then -cfg.GridLateral else cfg.GridLateral
	local steps = back / track.spacing
	local i0 = math.floor(steps)
	local f = steps - i0
	local a = track.samples[wrap(1 - i0, track.n)]
	local b = track.samples[wrap(1 - i0 - 1, track.n)]
	local pos = a.pos + (b.pos - a.pos) * f
	local right = vector.normalize(a.right + (b.right - a.right) * f)
	local fwd = vector.normalize(a.fwd + (b.fwd - a.fwd) * f)
	local up = vector.cross(right, fwd)
	return pos + right * lateral, fwd, up
end

TrackLayout.UP = UP
return TrackLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">TrackLimits</string>
          <string name="Source"><![CDATA[--!strict
-- Track limits: a kart has left the track when all four tyres are entirely
-- beyond the edge of the road and its kerb (kerbs count as track, the turf,
-- run-off and gravel beyond do not). Pure Luau; TrackMath and the track's
-- zones (TrackLayout.zones) are passed in.
--
-- A Tracker turns the per-frame yes/no into violations: one per excursion,
-- counted once the kart has been fully out for MinTime while moving (a spin
-- that ends in the grass at walking pace is not one), and re-armed after it
-- has been back on track for ReArm seconds.

local TrackLimits = {}

type Sample = { pos: vector, fwd: vector, right: vector, width: number }
type Track = { samples: { Sample }, n: number, spacing: number }
type Bands = { kerb: number }
type Zones = { { left: Bands, right: Bands } }
type TrackMath = { nearest: (any, vector, number?, number?, number?) -> (number, number, number) }

export type Wheel = { pos: vector, half: number }

export type Tracker = {
	outTime: number,
	inTime: number,
	peak: number,
	counted: boolean,
	idx: number?, -- where on the lap the kart was last frame (search hint)
}

TrackLimits.MinTime = 0.2 -- seconds fully out before it counts
TrackLimits.MinSpeed = 8 -- studs/s: slower excursions (spins, crawling back) do not count
TrackLimits.ReArm = 0.4 -- seconds back on track before the next excursion can count
TrackLimits.Tolerance = 0.25 -- studs of grace beyond the kerb
TrackLimits.SearchReach = 40 -- studs beyond the edge still followed frame to frame (further: search the lap)

function TrackLimits.newTracker(): Tracker
	return { outTime = 0, inTime = 0, peak = 0, counted = false, idx = nil }
end

-- The sample nearest the kart, followed frame to frame in the tracker. The
-- race's own position can't be used as the hint: it holds still while a cut
-- or a jump is being checked, and from a stale hint every tyre looked far
-- off the road. If the kart is not near the windowed answer (a reset, a
-- respawn, or level with it but on another part of the circuit) the whole
-- lap is searched.
function TrackLimits.locate(tm: TrackMath, track: any, tr: Tracker, pos: vector): number
	local t = track :: Track
	local idx = tr.idx
	if idx then
		local found = tm.nearest(t, pos, idx, 10, 45)
		local smp = t.samples[found]
		local rel = pos - smp.pos
		local near = math.abs(vector.dot(rel, smp.fwd)) <= 2 * t.spacing
			and math.abs(vector.dot(rel, smp.right)) <= smp.width / 2 + TrackLimits.SearchReach
		if near then
			tr.idx = found
			return found
		end
	end
	local found = tm.nearest(t, pos)
	tr.idx = found
	return found
end

-- Is every tyre wholly beyond the road edge + kerb? `hint` is a nearby
-- sample index (the racer's last one) to keep the search short.
function TrackLimits.allOut(tm: TrackMath, track: any, zones: any, hint: number?, wheels: { Wheel }): boolean
	local t = track :: Track
	local z = zones :: Zones
	if #wheels == 0 then
		return false
	end
	for _, w in wheels do
		local idx, lateral = tm.nearest(t, w.pos, hint, 8, 16)
		local smp = t.samples[idx]
		local bands = if lateral < 0 then z[idx].left else z[idx].right
		local limit = smp.width / 2 + bands.kerb + TrackLimits.Tolerance
		-- the tyre's inner edge must be past the limit
		if math.abs(lateral) - w.half <= limit then
			return false
		end
	end
	return true
end

-- Feed one frame. Returns true when this excursion becomes a violation.
function TrackLimits.step(tr: Tracker, out: boolean, speed: number, dt: number): boolean
	if out then
		tr.inTime = 0
		tr.outTime += dt
		tr.peak = math.max(tr.peak, speed)
		if not tr.counted and tr.outTime >= TrackLimits.MinTime and tr.peak >= TrackLimits.MinSpeed then
			tr.counted = true
			return true
		end
	else
		tr.inTime += dt
		if tr.inTime >= TrackLimits.ReArm then
			tr.outTime = 0
			tr.peak = 0
			tr.counted = false
		end
	end
	return false
end

return TrackLimits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">TrackMath</string>
          <string name="Source"><![CDATA[--!strict
-- Pure track maths shared by server, client and tests. No Roblox APIs, only the
-- built-in `vector` library, so the same code runs in the Luau CLI.
--
-- A track is described like a real circuit drawing: straights and constant-radius
-- arcs. Two straights are marked "free"; their lengths are solved so the lap
-- closes exactly. The dense path is lightly smoothed (gives clothoid-like corner
-- entries), then resampled at a fixed spacing. Each sample carries a banked
-- frame (fwd, right, up), the road width and signed curvature.
--
-- Headings: 0 = +X. Positive angles turn right (towards +Z), matching
-- right = cross(fwd, up). Bank in degrees: positive tilts the road down towards
-- its right edge (what a right-hand corner wants).

local TrackMath = {}

export type Sample = {
	i: number, -- 1-based index
	s: number, -- arc length from the start line
	pos: vector, -- centre of the road surface
	fwd: vector,
	right: vector,
	up: vector,
	width: number,
	bank: number, -- degrees
	curv: number, -- signed curvature in the ground plane (1/studs), + = turning right
	segment: number, -- index of the layout segment this sample came from
}

export type Track = {
	samples: { Sample },
	n: number,
	length: number,
	spacing: number,
	freeLengths: { number },
}

export type Segment = {
	kind: "S" | "A",
	length: (number | "free")?, -- straights
	radius: number?, -- arcs
	angle: number?, -- arcs, degrees, + = right
	bank: number?, -- arcs, degrees (sign is applied from the turn direction)
	width: number?, -- road width from this segment on
	y: number?, -- road height at the end of this segment
	name: string?,
}

export type Spec = {
	Segments: { Segment },
	Spacing: number,
	StartY: number?,
	Smoothing: number?, -- studs, half-window of the path smoothing
	BankSmoothing: number?,
}

local UP = vector.create(0, 1, 0)

local function wrap(i: number, n: number): number
	return ((i - 1) % n) + 1
end
TrackMath.wrap = wrap

local function dirOf(theta: number): vector
	return vector.create(math.cos(theta), 0, math.sin(theta))
end

-- Walks the layout with the given free lengths. Calls `emit(pos2d, segIndex,
-- localT)` every `step` studs when `emit` is given. Returns the end position
-- (x, z) and the heading.
local function walk(spec: Spec, free: { number }, step: number?, emit: ((number, number, number, number) -> ())?): (number, number, number)
	local x, z, theta = 0, 0, 0
	local f = 0
	for k, seg in spec.Segments do
		if seg.kind == "S" then
			local len: number
			if seg.length == "free" then
				f += 1
				len = free[f] or 0
			else
				len = seg.length :: number
			end
			local d = dirOf(theta)
			if emit and step then
				local count = math.max(1, math.floor(len / step + 0.5))
				for j = 0, count - 1 do
					local t = j / count
					emit(x + d.x * len * t, z + d.z * len * t, k, t)
				end
			end
			x += d.x * len
			z += d.z * len
		else
			local r = seg.radius :: number
			local ang = math.rad(seg.angle :: number)
			local sgn = if ang >= 0 then 1 else -1
			-- centre is to the right for right turns, to the left for left turns
			local rightDir = dirOf(theta + math.pi / 2)
			local cx, cz = x + rightDir.x * r * sgn, z + rightDir.z * r * sgn
			local a0 = math.atan2(z - cz, x - cx)
			if emit and step then
				local len = r * math.abs(ang)
				local count = math.max(1, math.floor(len / step + 0.5))
				for j = 0, count - 1 do
					local t = j / count
					local a = a0 + ang * t
					emit(cx + math.cos(a) * r, cz + math.sin(a) * r, k, t)
				end
			end
			local a1 = a0 + ang
			x, z = cx + math.cos(a1) * r, cz + math.sin(a1) * r
			theta += ang
		end
	end
	return x, z, theta
end

-- Solves the two free straight lengths so the lap closes.
local function solveFree(spec: Spec): { number }
	local dirs: { vector } = {}
	local theta = 0
	for _, seg in spec.Segments do
		if seg.kind == "S" then
			if seg.length == "free" then
				table.insert(dirs, dirOf(theta))
			end
		else
			theta += math.rad(seg.angle :: number)
		end
	end
	assert(#dirs == 2, "the layout needs exactly two free straights")
	-- clockwise +360, anticlockwise -360; a figure of eight (one road
	-- crossing the other on a bridge) turns 0 degrees
	assert(
		math.abs(math.abs(theta) - 2 * math.pi) < 1e-6 or math.abs(theta) < 1e-6,
		string.format("corners must add up to +-360 degrees, or 0 for a figure of eight (got %.2f)", math.deg(theta))
	)
	local ex, ez = walk(spec, { 0, 0 })
	-- L1*d1 + L2*d2 = -E
	local a, b, c, d = dirs[1].x, dirs[2].x, dirs[1].z, dirs[2].z
	local det = a * d - b * c
	assert(math.abs(det) > 1e-6, "free straights must not be parallel")
	local l1 = (-ex * d + b * ez) / det
	local l2 = (-a * ez + c * ex) / det
	return { l1, l2 }
end

local function smoothClosed(values: { number }, half: number): { number }
	local n = #values
	if half < 1 then
		return values
	end
	local out = table.create(n, 0)
	local sum = 0
	for j = -half, half do
		sum += values[wrap(1 + j, n)]
	end
	local w = 2 * half + 1
	for i = 1, n do
		out[i] = sum / w
		sum += values[wrap(i + half + 1, n)] - values[wrap(i - half, n)]
	end
	return out
end

function TrackMath.build(spec: Spec): Track
	local free = solveFree(spec)

	-- 1. Dense path, one point per stud
	local xs: { number }, zs: { number }, segs: { number }, ts: { number } = {}, {}, {}, {}
	walk(spec, free, 1, function(x, z, k, t)
		table.insert(xs, x)
		table.insert(zs, z)
		table.insert(segs, k)
		table.insert(ts, t)
	end)
	local dn = #xs

	-- per-point height, bank and width from the segment settings
	local ys, banks, widths = table.create(dn, 0), table.create(dn, 0), table.create(dn, 0)
	local segStartY: { number } = {}
	local segWidth: { number } = {}
	local y = spec.StartY or 0
	local width = spec.Segments[1].width or 34
	for k, seg in spec.Segments do
		segStartY[k] = y
		y = seg.y or y
		width = seg.width or width
		segWidth[k] = width
	end
	for j = 1, dn do
		local k = segs[j]
		local seg = spec.Segments[k]
		local y0 = segStartY[k]
		local y1 = seg.y or y0
		ys[j] = y0 + (y1 - y0) * ts[j]
		widths[j] = segWidth[k]
		if seg.kind == "A" then
			local sgn = if (seg.angle :: number) >= 0 then 1 else -1
			banks[j] = (seg.bank or 0) * sgn
		else
			banks[j] = 0
		end
	end

	-- 2. Smooth (closed loop). Small window for x/z, larger for the rest.
	local half = math.floor(spec.Smoothing or 12)
	xs = smoothClosed(smoothClosed(xs, half), half)
	zs = smoothClosed(smoothClosed(zs, half), half)
	ys = smoothClosed(smoothClosed(ys, 30), 30)
	banks = smoothClosed(smoothClosed(banks, math.floor(spec.BankSmoothing or 25)), math.floor(spec.BankSmoothing or 25))
	widths = smoothClosed(widths, 20)

	local cum = { 0 }
	for j = 2, dn + 1 do
		local a, b = j - 1, wrap(j, dn)
		cum[j] = cum[j - 1] + math.sqrt((xs[b] - xs[a]) ^ 2 + (ys[b] - ys[a]) ^ 2 + (zs[b] - zs[a]) ^ 2)
	end
	local total = cum[dn + 1]

	-- 3. Resample at a uniform spacing that divides the lap exactly
	local n = math.max(8, math.floor(total / spec.Spacing + 0.5))
	local ds = total / n
	local samples: { Sample } = {}
	local k = 1
	for i = 1, n do
		local s = (i - 1) * ds
		while cum[k + 1] < s do
			k += 1
		end
		local seg = cum[k + 1] - cum[k]
		local f = if seg > 0 then (s - cum[k]) / seg else 0
		local a, b = k, wrap(k + 1, dn)
		local function lerp(arr: { number }): number
			return arr[a] + (arr[b] - arr[a]) * f
		end
		samples[i] = {
			i = i,
			s = s,
			pos = vector.create(lerp(xs), lerp(ys), lerp(zs)),
			fwd = vector.zero,
			right = vector.zero,
			up = UP,
			width = lerp(widths),
			bank = lerp(banks),
			curv = 0,
			segment = segs[a],
		}
	end

	-- 4. Frames and curvature
	for i = 1, n do
		local prev = samples[wrap(i - 1, n)].pos
		local nxt = samples[wrap(i + 1, n)].pos
		samples[i].fwd = vector.normalize(nxt - prev)
	end
	for i = 1, n do
		local smp = samples[i]
		local flatRight = vector.normalize(vector.cross(smp.fwd, UP))
		local flatUp = vector.cross(flatRight, smp.fwd)
		local b = math.rad(smp.bank)
		smp.up = flatUp * math.cos(b) + flatRight * math.sin(b)
		smp.right = flatRight * math.cos(b) - flatUp * math.sin(b)
		local f0 = samples[wrap(i - 1, n)].fwd
		local f1 = samples[wrap(i + 1, n)].fwd
		local h0 = math.atan2(f0.z, f0.x)
		local h1 = math.atan2(f1.z, f1.x)
		local dh = (h1 - h0 + math.pi) % (2 * math.pi) - math.pi
		smp.curv = dh / (2 * ds)
	end

	return { samples = samples, n = n, length = total, spacing = ds, freeLengths = free }
end

-- Left and right road edges of a sample, optionally pushed outwards.
function TrackMath.edges(smp: Sample, extra: number?): (vector, vector)
	local h = smp.width / 2 + (extra or 0)
	return smp.pos - smp.right * h, smp.pos + smp.right * h
end

-- Nearest sample to `pos`, searching `back` samples behind and `ahead` samples in
-- front of `hint`. Without a hint the whole lap is searched.
-- Returns the sample index, lateral offset (studs, + = right) and arc position.
function TrackMath.nearest(track: Track, pos: vector, hint: number?, back: number?, ahead: number?): (number, number, number)
	local n = track.n
	local samples = track.samples
	local lo, hi = 1, n
	if hint ~= nil then
		lo, hi = hint - (back or n), hint + (ahead or n)
		if hi - lo + 1 > n then
			lo, hi = 1, n
		end
	end
	local best, bestD = 1, math.huge
	for j = lo, hi do
		local idx = wrap(j, n)
		local dv = pos - samples[idx].pos
		local d = vector.dot(dv, dv)
		if d < bestD then
			best, bestD = idx, d
		end
	end
	local smp = samples[best]
	local along = vector.dot(pos - smp.pos, smp.fwd)
	local lateral = vector.dot(pos - smp.pos, smp.right)
	local s = (smp.s + math.clamp(along, -track.spacing, track.spacing)) % track.length
	return best, lateral, s
end

-- Signed distance from b to a along the lap, in (-length/2, length/2].
function TrackMath.arcDelta(track: Track, a: number, b: number): number
	local d = (a - b) % track.length
	if d > track.length / 2 then
		d -= track.length
	end
	return d
end

-- Pose for a kart standing on sample i, shifted sideways (+ = right) and back
-- along the road. Returns position (centre of road surface) and frame vectors.
function TrackMath.slot(track: Track, i: number, lateral: number, back: number): (vector, vector, vector)
	local n = track.n
	local steps = back / track.spacing
	local i0 = math.floor(steps)
	local f = steps - i0
	local a = track.samples[wrap(i - i0, n)]
	local b = track.samples[wrap(i - i0 - 1, n)]
	local pos = a.pos + (b.pos - a.pos) * f
	local right = vector.normalize(a.right + (b.right - a.right) * f)
	local fwd = vector.normalize(a.fwd + (b.fwd - a.fwd) * f)
	local up = vector.cross(right, fwd)
	return pos + right * lateral, fwd, up
end

return TrackMath
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Server entry point: finds out what this server is for (Session: a public
-- lobby, or a reserved practice / race / room server), builds the circuits,
-- then runs the race loop in that mode and the lobby's menu requests.
-- The first circuit (the one asked for, else the default) is built first and
-- goes live straight away; the others are built right after into
-- ServerStorage, ready to be voted in. A published lobby only shows one
-- circuit behind the menu, so it builds just that one.

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TrackMath = require(Shared:WaitForChild("TrackMath"))
local TrackData = require(Shared:WaitForChild("TrackData"))
local TrackLayout = require(Shared:WaitForChild("TrackLayout"))

local TrackBuilder = require(script:WaitForChild("TrackBuilder"))
local Scenery = require(script:WaitForChild("Scenery"))
local RaceManager = require(script:WaitForChild("RaceManager"))
local Stats = require(script:WaitForChild("Stats"))
local Session = require(script:WaitForChild("Session"))
local Lobby = require(script:WaitForChild("Lobby"))
local Rooms = require(script:WaitForChild("Rooms"))

-- Remotes
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local raceEvent = Instance.new("RemoteEvent")
raceEvent.Name = "RaceEvent"
raceEvent.Parent = remotes
local request = Instance.new("RemoteEvent")
request.Name = "Request"
request.Parent = remotes
remotes.Parent = ReplicatedStorage

-- Collision groups: karts hit the world and each other; walking players and
-- seated drivers pass through karts (nobody gets run over in the paddock).
for _, name in { "Karts", "Drivers", "Players" } do
	PhysicsService:RegisterCollisionGroup(name)
end
PhysicsService:CollisionGroupSetCollidable("Karts", "Players", false)
PhysicsService:CollisionGroupSetCollidable("Karts", "Drivers", false)
-- karts bump each other through their bumpers (KartPhysics), computed by each
-- driver's client; Roblox's own kart-on-kart collisions launch karts online
PhysicsService:CollisionGroupSetCollidable("Karts", "Karts", false)
for _, other in { "Default", "Players", "Drivers" } do
	PhysicsService:CollisionGroupSetCollidable("Drivers", other, false)
end

-- Purpose-built circuits made of parts (no terrain; hills are part-built
-- embankments). The live one is
-- built straight into workspace (pits first, so the spawn exists early);
-- the others into a folder that is parented when it is voted in.
local function buildCircuit(spec: any, live: boolean): RaceManager.Circuit
	local started = os.clock()
	local track = TrackMath.build(spec)
	local grid = TrackLayout.grid(track)
	local zones = TrackLayout.zones(track, grid)
	local world = Instance.new("Folder")
	world.Name = if live then "Circuit" else spec.Id
	world:SetAttribute("TrackId", spec.Id)
	if live then
		world.Parent = workspace
	end
	Scenery.begin(spec)
	Scenery.pits(track, spec, world)
	local trackFolder = TrackBuilder.build(track, zones, world)
	TrackBuilder.ground(track, trackFolder)
	TrackBuilder.embankments(track, TrackLayout.ground(track, grid, zones), trackFolder)
	TrackBuilder.crossings(track, TrackLayout.ground(track, grid, zones), trackFolder)
	Scenery.gantry(track, spec, trackFolder)
	Scenery.stands(track, grid, zones, spec, world)
	Scenery.bridge(track, spec, world)
	Scenery.barriers(track, grid, zones, world)
	Scenery.marshals(track, grid, zones, spec, world)
	Scenery.cornerBoards(track, grid, zones, spec, world)
	local pools = Scenery.water(track, grid, zones, spec, trackFolder)
	Scenery.trees(track, grid, zones, spec, pools, world)
	Scenery.trackLights(track, grid, zones, spec, world)
	Scenery.perimeter(track, world, spec)
	print(string.format("[A1KartRacing] %s built: %d samples, %.0f studs, %.1f s", spec.Name, track.n, track.length, os.clock() - started))
	return { id = spec.Id, spec = spec, track = track, zones = zones, folder = world }
end

-- a reserved server waits here until it knows what it is for
local role = Session.resolve()
workspace:SetAttribute("ServerMode", role.mode)
local studio = Session.studio()
local firstId = role.track or TrackData.Default
if role.mode == "lobby" and not studio then
	-- a different circuit behind the menu now and then
	firstId = TrackData.Order[math.random(1, #TrackData.Order)]
end

workspace.Terrain:Clear()
local first = buildCircuit(TrackData.get(firstId), true)
Scenery.lighting(first.spec)
-- each circuit brings its own weather
RaceManager.onTrackChanged = function(c)
	Scenery.lighting(c.spec)
end
workspace:SetAttribute("TrackReady", true)

Stats.init(function(name, t)
	raceEvent:FireAllClients("Record", { name = name, time = t })
end, first.id)
Stats.loadRecords(TrackData.Order)

Session.notify = function(p: Player, kind: string, data: { [string]: any })
	raceEvent:FireClient(p, kind, data)
end
Session.beforeLeave = Stats.saveNow
Session.switchHere = function(r: Session.Role)
	-- Studio: the menu sends everyone; this server becomes that
	if r.mode ~= "lobby" then
		Lobby.closed()
	end
	RaceManager.setMode(r)
end
Session.init()
RaceManager.onKick = function(p: Player, message: string)
	local code = workspace:GetAttribute("RoomCode") :: string?
	if code and not studio then
		task.spawn(Rooms.ban, code, p.UserId)
	end
	Session.kick(p, message)
end
RaceManager.start(first, remotes, role)
Lobby.init(remotes, RaceManager.mode)
if role.mode == "room" and role.code and not studio then
	Rooms.keep(role.code)
end

-- every player's ping, so other clients know how late their kart arrives
task.spawn(function()
	local Players = game:GetService("Players")
	while true do
		for _, p in Players:GetPlayers() do
			p:SetAttribute("Ping", math.floor(p:GetNetworkPing() * 1000 + 0.5) / 1000)
		end
		task.wait(2)
	end
end)

-- the other circuits, after the first player can already drive
if role.mode == "lobby" and not studio then
	return
end
task.defer(function()
	for _, id in TrackData.Order do
		if id ~= first.id then
			RaceManager.addCircuit(buildCircuit(TrackData.get(id), false))
			task.wait()
		end
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[--!strict
-- Small helpers for building geometry from code.

local Build = {}

export type Props = { [string]: any }

-- Creates an anchored part with sensible defaults, then applies `props`.
function Build.part(parent: Instance, props: Props, className: string?): BasePart
	local p = Instance.new((className or "Part") :: any) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

-- Purely visual part: no collision, not hit by raycasts, no shadow cost.
function Build.decor(parent: Instance, props: Props, className: string?): BasePart
	local p = Build.part(parent, props, className)
	p.CanCollide = false
	p.CanQuery = false
	return p
end

-- A thin slab lying on a surface between two points (used for painted lines).
function Build.strip(parent: Instance, a: Vector3, b: Vector3, up: Vector3, width: number, props: Props): BasePart
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local look = (b - a).Unit
	local right = look:Cross(up).Unit
	local realUp = right:Cross(look)
	local p = Build.decor(parent, props)
	p.Size = Vector3.new(width, 0.05, len + 0.05)
	p.CFrame = CFrame.fromMatrix(mid + realUp * 0.03, right, realUp, -look)
	p.CastShadow = false
	return p
end

-- Fills triangle (a, b, c) with two wedge parts whose top faces lie exactly in
-- the triangle's plane; the slab extends `thickness` below it.
-- `upHint` says which side of the triangle is "up".
function Build.triangle(parent: Instance, a: Vector3, b: Vector3, c: Vector3, thickness: number, upHint: Vector3, props: Props): (WedgePart?, WedgePart?)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	-- make bc the longest edge (the hypotenuse of both right-angle wedges)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local normal = ac:Cross(ab)
	if normal.Magnitude < 1e-6 then
		return nil, nil
	end
	local right = normal.Unit
	local upv = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(upv))
	if height < 1e-3 then
		return nil, nil
	end
	local n = if right:Dot(upHint) >= 0 then right else -right
	local shift = -n * (thickness / 2)

	local w1 = Instance.new("WedgePart")
	w1.Size = Vector3.new(thickness, height, math.abs(ab:Dot(back)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2 + shift, right, upv, back)
	local w2 = Instance.new("WedgePart")
	w2.Size = Vector3.new(thickness, height, math.abs(ac:Dot(back)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2 + shift, -right, upv, -back)
	for _, w in { w1, w2 } do
		w.Anchored = true
		w.TopSurface = Enum.SurfaceType.Smooth
		w.BottomSurface = Enum.SurfaceType.Smooth
		w.CanTouch = false
		for k, v in props do
			(w :: any)[k] = v
		end
		w.Parent = parent
	end
	return w1, w2
end

-- The shared modules use Luau's built-in `vector`; in Roblox that is the very
-- same native value as Vector3 (the VM supports x/y/z and X/Y/Z on it), so
-- these are free casts that only keep the type checker informed.
function Build.v3(v: vector): Vector3
	return (v :: any) :: Vector3
end

function Build.vec(v: Vector3): vector
	return (v :: any) :: vector
end

function Build.folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">KartFactory</string>
          <string name="Source"><![CDATA[--!strict
-- Builds a kart model and seats a player in it.
--
-- Only the invisible chassis core has mass; the hitbox and every visual part
-- are massless and welded to it, and the seated character is made massless
-- too, so the physics the client computes (KartPhysics) sees exactly the
-- body it was tested with. Wheels and the steering wheel are drawn by each
-- client (KartVisuals) because they move every frame.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local KartFactory = {}

KartFactory.Colors = {
	Color3.fromRGB(214, 36, 36),
	Color3.fromRGB(28, 98, 214),
	Color3.fromRGB(255, 186, 0),
	Color3.fromRGB(30, 170, 80),
	Color3.fromRGB(240, 110, 20),
	Color3.fromRGB(140, 60, 200),
	Color3.fromRGB(20, 190, 200),
	Color3.fromRGB(235, 70, 150),
	Color3.fromRGB(240, 240, 240),
	Color3.fromRGB(40, 40, 46),
	Color3.fromRGB(150, 200, 40),
	Color3.fromRGB(120, 80, 50),
}

local cfg = Config.Kart

-- Local coordinates used below: x right, h height above the ground, f forward.
-- The chassis core's centre is at h = RideHeight, f = 0.
local RH = cfg.RideHeight
local function at(x: number, h: number, f: number): CFrame
	return CFrame.new(x, h - RH, -f)
end
local function pt(x: number, h: number, f: number): Vector3
	return Vector3.new(x, h - RH, -f)
end

local function visual(model: Model, chassis: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, className: string?): BasePart
	local p = Instance.new((className or "Part") :: any) :: BasePart
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CFrame = chassis.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = chassis
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
	return p
end

-- Cylinder between two local points; `overlap` extends both ends (tubes use
-- it so joints meet without gaps, discs pass 0).
local function cylinderBetween(model: Model, chassis: BasePart, name: string, a: Vector3, b: Vector3, diameter: number, overlap: number, color: Color3, material: Enum.Material?): BasePart
	local dir = b - a
	local up = if math.abs(dir.Unit.Y) > 0.98 then Vector3.new(0, 0, 1) else Vector3.new(0, 1, 0)
	local offset = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.rad(90), 0)
	local p = visual(model, chassis, name, Vector3.new(dir.Magnitude + overlap, diameter, diameter), offset, color, material or Enum.Material.Metal)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Round tube between two local points.
local function tube(model: Model, chassis: BasePart, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?): BasePart
	return cylinderBetween(model, chassis, name, a, b, diameter, diameter * 0.5, color, material)
end

-- Disc (short cylinder) whose axis points along local `axis`.
local function disc(model: Model, chassis: BasePart, name: string, center: Vector3, axis: Vector3, radius: number, thickness: number, color: Color3, material: Enum.Material?): BasePart
	return cylinderBetween(model, chassis, name, center - axis.Unit * (thickness / 2), center + axis.Unit * (thickness / 2), radius * 2, 0, color, material)
end

local function surfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3, ppm: number)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppm
	gui.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextColor3 = color
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = text
	t.Parent = gui
end

-- Ellipsoid: a block with a sphere mesh, which Roblox stretches to the
-- part's size (round shapes without uploading meshes).
local function ellipsoid(model: Model, chassis: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = visual(model, chassis, name, size, offset, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Frame whose Z axis runs from a to b and whose X axis is the kart's right
-- (width), Y the thickness. Used for panels and stretched ellipsoids.
local function between(a: Vector3, b: Vector3): (CFrame, number)
	local look = (b - a).Unit
	local right = Vector3.xAxis - look * Vector3.xAxis:Dot(look)
	if right.Magnitude < 1e-3 then
		right = Vector3.zAxis
	end
	right = right.Unit
	return CFrame.fromMatrix((a + b) / 2, right, right:Cross(look)), (b - a).Magnitude
end

local function slab(model: Model, chassis: BasePart, name: string, a: Vector3, b: Vector3, width: number, thick: number, color: Color3, material: Enum.Material?): BasePart
	local cf, len = between(a, b)
	return visual(model, chassis, name, Vector3.new(width, thick, len), cf, color, material)
end

local function ellipsoidBetween(model: Model, chassis: BasePart, name: string, a: Vector3, b: Vector3, width: number, thick: number, color: Color3, material: Enum.Material?): BasePart
	local cf, len = between(a, b)
	return ellipsoid(model, chassis, name, Vector3.new(width, thick, len), cf, color, material)
end

-- The face of a part (placed at `offset` in the kart) that points most along `dir`.
local function faceToward(offset: CFrame, dir: Vector3): Enum.NormalId
	local best, bestDot = Enum.NormalId.Front, -math.huge
	type Face = { id: Enum.NormalId, n: Vector3 }
	local faces: { Face } = {
		{ id = Enum.NormalId.Right, n = offset.RightVector },
		{ id = Enum.NormalId.Left, n = -offset.RightVector },
		{ id = Enum.NormalId.Top, n = offset.UpVector },
		{ id = Enum.NormalId.Bottom, n = -offset.UpVector },
		{ id = Enum.NormalId.Back, n = -offset.LookVector },
		{ id = Enum.NormalId.Front, n = offset.LookVector },
	}
	for _, f in faces do
		local d = f.n:Dot(dir)
		if d > bestDot then
			best, bestDot = f.id, d
		end
	end
	return best
end

-- A number panel: black plate with white digits, the digits on the face
-- that points along `dir` (kart-local).
local function numberPanel(model: Model, chassis: BasePart, name: string, size: Vector3, offset: CFrame, dir: Vector3, number: number)
	local plate = visual(model, chassis, name, size, offset, Color3.fromRGB(16, 16, 18))
	surfaceText(plate, faceToward(offset, dir), tostring(number), Color3.fromRGB(245, 245, 245), 60)
end

-- Bodywork modelled on a modern rental kart (the Sodi RT8 / SR5 kind):
-- one continuous black plastic bumper wraps round the whole kart, outside
-- all four wheels, so wheels never touch. Inside it: a tall hollow nose with
-- the number on top, flat side pods, guards over the rear wheels, a bucket
-- seat with a padded roll bar behind it, a translucent fuel tank between the
-- driver's knees and a 4-stroke engine on the right with its silencer
-- behind. The bumper ring is the same rounded rectangle the physics uses
-- for kart-to-kart contact (Config.Kart.Bumper). Wheels and the steering
-- wheel are drawn by each client (KartVisuals) because they move.
local function bodywork(model: Model, chassis: BasePart, number: number, color: Color3)
	local FRAME = Color3.fromRGB(72, 74, 80)
	local ALU = Color3.fromRGB(160, 164, 172)
	local BLACK = Color3.fromRGB(24, 24, 28)
	local PLASTIC = Color3.fromRGB(30, 31, 35)
	local DARK = Color3.fromRGB(46, 48, 54)
	local WHITE = Color3.fromRGB(242, 242, 242)
	local tubeD = 0.12
	local railH = 0.24

	----------------------------------------------------------------------
	-- Frame (powder-coated), mostly hidden under the plastic
	----------------------------------------------------------------------
	for _, s in { -1, 1 } do
		tube(model, chassis, "Rail", pt(s * 0.5, railH, 2.7), pt(s * 0.72, railH, 1.55), tubeD, FRAME)
		tube(model, chassis, "Rail", pt(s * 0.72, railH, 1.55), pt(s * 1.02, railH, 0.15), tubeD, FRAME)
		tube(model, chassis, "Rail", pt(s * 1.02, railH, 0.15), pt(s * 1.08, railH, -1.25), tubeD, FRAME)
		tube(model, chassis, "Rail", pt(s * 1.08, railH, -1.25), pt(s * 0.85, railH, -2.1), tubeD, FRAME)
		-- spindle carriers, kingpin, stub axle, steering arm and track rod
		tube(model, chassis, "CBracket", pt(s * 0.5, railH, 2.25), pt(s * 1.58, 0.36, 2.2), tubeD, FRAME)
		tube(model, chassis, "CBracket", pt(s * 0.55, railH, 2.45), pt(s * 1.58, 0.88, 2.22), tubeD * 0.9, FRAME)
		tube(model, chassis, "Kingpin", pt(s * 1.64, 0.3, 2.24), pt(s * 1.64, 0.94, 2.18), 0.15, BLACK)
		tube(model, chassis, "StubAxle", pt(s * 1.64, 0.62, 2.2), pt(s * 1.86, 0.62, 2.2), 0.12, ALU)
		tube(model, chassis, "SteeringArm", pt(s * 1.62, 0.5, 2.2), pt(s * 1.45, 0.46, 1.92), 0.08, ALU)
		tube(model, chassis, "TrackRod", pt(s * 0.12, 0.36, 2.0), pt(s * 1.45, 0.46, 1.92), 0.07, ALU)
		ellipsoid(model, chassis, "RodEnd", Vector3.one * 0.13, at(s * 1.45, 0.46, 1.92), BLACK)
		-- outriggers carrying the bumper ring
		tube(model, chassis, "BumperMount", pt(s * 0.75, railH, 1.4), pt(s * 2.95, 0.3, 1.32), tubeD, FRAME)
		tube(model, chassis, "BumperMount", pt(s * 1.05, railH, -0.6), pt(s * 2.95, 0.3, -0.62), tubeD, FRAME)
		tube(model, chassis, "BumperMount", pt(s * 0.5, railH, 2.7), pt(s * 1.2, 0.3, 3.4), tubeD, FRAME)
		tube(model, chassis, "BumperMount", pt(s * 0.85, railH, -2.1), pt(s * 1.4, 0.3, -2.65), tubeD, FRAME)
		-- rear bearing carriers and hubs
		visual(model, chassis, "BearingCarrier", Vector3.new(0.26, 0.6, 0.48), at(s * 1.1, 0.68, -1.6), ALU, Enum.Material.Metal)
		tube(model, chassis, "Upright", pt(s * 1.1, railH, -1.25), pt(s * 1.1, 0.5, -1.55), tubeD, FRAME)
		disc(model, chassis, "RearHub", pt(s * 1.62, 0.7, -1.6), Vector3.xAxis, 0.22, 0.32, ALU, Enum.Material.Metal)
	end
	for _, f in { 2.7, 2.25 } do
		tube(model, chassis, "Cross", pt(-0.5, railH, f), pt(0.5, railH, f), tubeD, FRAME)
	end
	tube(model, chassis, "Cross", pt(-1.04, railH, -0.3), pt(1.04, railH, -0.3), tubeD, FRAME)
	tube(model, chassis, "Cross", pt(-0.85, railH, -2.1), pt(0.85, railH, -2.1), tubeD, FRAME)
	-- rear axle, brake disc and caliper on the left, sprocket on the right
	tube(model, chassis, "RearAxle", pt(-1.9, 0.7, -1.6), pt(1.9, 0.7, -1.6), 0.18, ALU)
	disc(model, chassis, "BrakeDisc", pt(-0.5, 0.7, -1.6), Vector3.xAxis, 0.38, 0.09, Color3.fromRGB(90, 92, 98), Enum.Material.Metal)
	visual(model, chassis, "Caliper", Vector3.new(0.3, 0.3, 0.38), at(-0.5, 1.02, -1.52), Color3.fromRGB(200, 40, 30), Enum.Material.Metal)
	disc(model, chassis, "Sprocket", pt(0.92, 0.7, -1.6), Vector3.xAxis, 0.3, 0.05, BLACK, Enum.Material.Metal)
	-- floor tray and pedals (rubber-capped)
	visual(model, chassis, "FloorTray", Vector3.new(1.45, 0.05, 2.75), at(0, 0.19, 1.15), DARK, Enum.Material.Metal)
	for _, s in { -1, 1 } do
		visual(model, chassis, "Pedal", Vector3.new(0.28, 0.42, 0.07), at(s * 0.28, 0.46, 2.38) * CFrame.Angles(math.rad(-22), 0, 0), BLACK, Enum.Material.Rubber)
	end

	----------------------------------------------------------------------
	-- The bumper ring: one chunky plastic wall round the whole kart,
	-- following the rounded rectangle in Config.Kart.Bumper (outer face)
	----------------------------------------------------------------------
	local bm = cfg.Bumper
	local thick = 0.38
	local wallLo, wallHi = 0.14, 0.8
	do
		local inset = thick / 2
		local W, F, R = bm.HalfWidth - inset, bm.Front - inset, bm.Rear - inset
		local c = math.max(bm.Corner - inset, 0.05)
		-- centre line of the wall as a closed polyline (x, f)
		local pts: { Vector2 } = {}
		local function corner(cx: number, cf: number, a0: number)
			for k = 0, 3 do
				local a = a0 + (k / 3) * math.pi / 2
				table.insert(pts, Vector2.new(cx + math.cos(a) * c, cf + math.sin(a) * c))
			end
		end
		corner(W - c, F - c, 0)
		corner(-(W - c), F - c, math.pi / 2)
		corner(-(W - c), -R + c, math.pi)
		corner(W - c, -R + c, 3 * math.pi / 2)
		local midH = (wallLo + wallHi) / 2
		for i, a in pts do
			local b = pts[i % #pts + 1]
			local pa, pb = pt(a.X, midH, a.Y), pt(b.X, midH, b.Y)
			local len = (pb - pa).Magnitude
			if len > 0.02 then
				local cf = CFrame.lookAt((pa + pb) / 2, pb)
				visual(model, chassis, "BumperWall", Vector3.new(thick, wallHi - wallLo, len), cf, PLASTIC)
				-- rounded top lip and a slightly wider foot
				tube(model, chassis, "BumperLip", pt(a.X, wallHi, a.Y), pt(b.X, wallHi, b.Y), thick + 0.04, PLASTIC, Enum.Material.SmoothPlastic)
				visual(model, chassis, "BumperFoot", Vector3.new(thick + 0.08, 0.1, len), cf * CFrame.new(0, wallLo - midH + 0.05, 0), BLACK)
			end
			-- round joint
			cylinderBetween(model, chassis, "BumperJoint", pt(a.X, wallLo, a.Y), pt(a.X, wallHi, a.Y), thick, 0, PLASTIC, Enum.Material.SmoothPlastic)
		end
	end
	local outerX = bm.HalfWidth
	-- taller guards over the outside of the rear wheels
	for _, s in { -1, 1 } do
		local x = s * (outerX - thick / 2)
		visual(model, chassis, "RearGuard", Vector3.new(thick, 0.36, 2.2), at(x, wallHi + 0.2, -1.62), PLASTIC)
		tube(model, chassis, "RearGuardLip", pt(x, wallHi + 0.38, -2.7), pt(x, wallHi + 0.38, -0.54), thick + 0.04, PLASTIC, Enum.Material.SmoothPlastic)
		for _, f in { -2.72, -0.52 } do
			ellipsoid(model, chassis, "RearGuardEnd", Vector3.new(thick + 0.04, 0.74, 0.5), at(x, wallHi + 0.2, f), PLASTIC)
		end
		-- colour stripe along the guard
		visual(model, chassis, "GuardStripe", Vector3.new(0.03, 0.16, 2.0), at(s * (outerX + 0.005), wallHi + 0.18, -1.62), color)
	end
	-- colour stripes along the outside of the ring, and a white pinstripe
	for _, s in { -1, 1 } do
		visual(model, chassis, "RingStripe", Vector3.new(0.03, 0.12, 3.0), at(s * (outerX + 0.005), 0.5, 1.0), color)
		visual(model, chassis, "RingPinstripe", Vector3.new(0.03, 0.04, 3.0), at(s * (outerX + 0.005), 0.62, 1.0), WHITE)
	end
	visual(model, chassis, "FrontStripe", Vector3.new(4.2, 0.12, 0.03), at(0, 0.5, bm.Front + 0.005), color)

	----------------------------------------------------------------------
	-- Front deck between the bumper and the front wheels, hollow nose
	----------------------------------------------------------------------
	local deckF0, deckF1 = 2.95, bm.Front - thick
	local deck = visual(model, chassis, "FrontDeck", Vector3.new(2 * (outerX - thick) - 0.1, 0.12, deckF1 - deckF0), at(0, 0.66, (deckF0 + deckF1) / 2), PLASTIC)
	surfaceText(deck, Enum.NormalId.Top, "A1", Color3.fromRGB(150, 152, 160), 30)
	local noseLow, noseHigh = pt(0, 0.7, 3.45), pt(0, 1.46, 1.86)
	local noseCF, noseLen = between(noseLow, noseHigh)
	visual(model, chassis, "NoseTop", Vector3.new(1.5, 0.12, noseLen), noseCF, PLASTIC)
	-- rounded leading edge of the nose
	tube(model, chassis, "NoseEdge", pt(-0.75, 0.7, 3.45), pt(0.75, 0.7, 3.45), 0.24, PLASTIC, Enum.Material.SmoothPlastic)
	-- side walls (open underneath and at the back for the driver's legs)
	for _, s in { -1, 1 } do
		visual(model, chassis, "NoseSide", Vector3.new(0.08, 0.72, 1.6), at(s * 0.73, 0.68 + 0.36, 2.66), PLASTIC, nil, "WedgePart")
		-- colour flash along the top edge of each side
		local a, b = pt(s * 0.77, 0.78, 3.38), pt(s * 0.77, 1.4, 1.92)
		slab(model, chassis, "NoseFlash", a, b, 0.03, 0.2, color)
		slab(model, chassis, "NosePinstripe", a + Vector3.new(0, -0.16, 0), b + Vector3.new(0, -0.16, 0), 0.03, 0.05, WHITE)
	end
	-- the number on the nose, facing up and forward
	numberPanel(model, chassis, "NoseNumber", Vector3.new(0.9, 0.02, 0.72), noseCF * CFrame.new(0, 0.07, -0.05), (Vector3.yAxis - Vector3.zAxis).Unit, number)
	visual(model, chassis, "NoseNumberRing", Vector3.new(1.04, 0.015, 0.86), noseCF * CFrame.new(0, 0.065, -0.05), color)

	-- steering column (the wheel and its display are drawn by KartVisuals)
	local sw = cfg.SteeringWheel
	local tilt = math.rad(sw.Tilt)
	local hubH = sw.Height - math.sin(tilt) * 0.12
	local hubF = sw.Forward + math.cos(tilt) * 0.12
	local run = (hubH - 0.45) / math.sin(tilt)
	tube(model, chassis, "Column", pt(0, 0.45, hubF + run * math.cos(tilt)), pt(0, hubH, hubF), 0.14, FRAME)

	-- translucent fuel tank between the knees
	local tank = ellipsoid(model, chassis, "FuelTank", Vector3.new(0.6, 0.5, 1.0), at(0, 0.46, 1.1), Color3.fromRGB(236, 212, 120))
	tank.Transparency = 0.15
	disc(model, chassis, "FuelCap", pt(0, 0.72, 1.35), Vector3.yAxis, 0.1, 0.08, BLACK)

	----------------------------------------------------------------------
	-- Side pods: flat plastic between the seat and the bumper ring
	----------------------------------------------------------------------
	for _, s in { -1, 1 } do
		local x0, x1 = 1.3, outerX - thick + 0.02
		local f0, f1 = -0.78, 1.46
		local cx = s * (x0 + x1) / 2
		local top = 0.82
		visual(model, chassis, "SidePod", Vector3.new(x1 - x0, 0.12, f1 - f0), at(cx, top - 0.06, (f0 + f1) / 2), PLASTIC)
		-- inner wall down to the floor, with a rounded edge where the arm rests
		visual(model, chassis, "SidePodWall", Vector3.new(0.08, top - railH, f1 - f0), at(s * x0, (top + railH) / 2, (f0 + f1) / 2), PLASTIC)
		tube(model, chassis, "SidePodEdge", pt(s * x0, top, f0), pt(s * x0, top, f1), 0.18, PLASTIC, Enum.Material.SmoothPlastic)
		-- colour panel on top with a white pinstripe
		visual(model, chassis, "SidePodPanel", Vector3.new(x1 - x0 - 0.35, 0.02, f1 - f0 - 0.4), at(cx, top + 0.005, (f0 + f1) / 2), color)
		visual(model, chassis, "SidePodPinstripe", Vector3.new(0.05, 0.022, f1 - f0 - 0.4), at(s * (x0 + 0.24), top + 0.006, (f0 + f1) / 2), WHITE)
		numberPanel(model, chassis, "SideNumber", Vector3.new(0.7, 0.02, 0.62), at(s * (x0 + x1) / 2 + s * 0.15, top + 0.02, 0.65), Vector3.yAxis, number)
	end

	----------------------------------------------------------------------
	-- Rear: deck over the bumper behind the axle, number on the back
	----------------------------------------------------------------------
	local rearDeckF0, rearDeckF1 = -(bm.Rear - thick), -2.38
	visual(model, chassis, "RearDeck", Vector3.new(2 * (outerX - thick), 0.12, rearDeckF1 - rearDeckF0), at(0, 0.72, (rearDeckF0 + rearDeckF1) / 2), PLASTIC)
	numberPanel(model, chassis, "RearNumber", Vector3.new(0.9, 0.42, 0.03), at(0, 0.48, -bm.Rear - 0.02), Vector3.zAxis, number)
	visual(model, chassis, "RearStripe", Vector3.new(4.6, 0.12, 0.03), at(0, 0.74, -bm.Rear - 0.012), color)

	----------------------------------------------------------------------
	-- Seat and roll bar
	----------------------------------------------------------------------
	local SEAT = Color3.fromRGB(28, 30, 36)
	ellipsoid(model, chassis, "SeatPan", Vector3.new(1.3, 0.3, 1.2), at(0, 0.5, -0.6), SEAT, Enum.Material.SmoothPlastic)
	slab(model, chassis, "SeatBack", pt(0, 0.62, -1.0), pt(0, 1.92, -1.48), 1.3, 0.12, SEAT, Enum.Material.SmoothPlastic)
	ellipsoidBetween(model, chassis, "SeatTop", pt(0, 1.8, -1.43), pt(0, 2.08, -1.54), 1.3, 0.18, SEAT, Enum.Material.SmoothPlastic)
	for _, s in { -1, 1 } do
		ellipsoidBetween(model, chassis, "SeatSide", pt(s * 0.64, 0.48, -0.45), pt(s * 0.64, 1.55, -1.28), 0.12, 0.5, SEAT, Enum.Material.SmoothPlastic)
		tube(model, chassis, "SeatMount", pt(s * 0.45, 0.42, -0.25), pt(s * 1.02, railH, -0.1), 0.08, FRAME)
	end
	-- roll bar: a hoop behind the seat, braced back to the frame, padded top
	local barF, barTop = -1.78, 2.62
	for _, s in { -1, 1 } do
		tube(model, chassis, "RollBar", pt(s * 0.72, railH, barF), pt(s * 0.62, barTop - 0.15, barF), 0.13, BLACK)
		tube(model, chassis, "RollBar", pt(s * 0.62, barTop - 0.15, barF), pt(s * 0.4, barTop, barF), 0.13, BLACK)
		tube(model, chassis, "RollBarBrace", pt(s * 0.62, barTop - 0.3, barF), pt(s * 0.85, railH + 0.05, -2.32), 0.1, BLACK)
	end
	tube(model, chassis, "RollBar", pt(-0.4, barTop, barF), pt(0.4, barTop, barF), 0.13, BLACK)
	visual(model, chassis, "RollBarPad", Vector3.new(0.7, 0.62, 0.22), at(0, barTop - 0.38, barF + 0.12), Color3.fromRGB(40, 40, 46), Enum.Material.Fabric)

	----------------------------------------------------------------------
	-- 4-stroke engine on the right of the seat, silencer behind it
	----------------------------------------------------------------------
	local ENGINE = Color3.fromRGB(150, 154, 160)
	visual(model, chassis, "EngineMount", Vector3.new(0.75, 0.1, 0.95), at(1.32, 0.3, -1.05), ALU, Enum.Material.Metal)
	visual(model, chassis, "Crankcase", Vector3.new(0.72, 0.62, 0.86), at(1.36, 0.66, -1.05), ENGINE, Enum.Material.Metal)
	-- cylinder leaning towards the outside, with a black valve cover
	local cylCF = at(1.6, 1.12, -1.0) * CFrame.Angles(0, 0, math.rad(-25))
	visual(model, chassis, "Cylinder", Vector3.new(0.5, 0.5, 0.56), cylCF, Color3.fromRGB(176, 180, 188), Enum.Material.Metal)
	visual(model, chassis, "ValveCover", Vector3.new(0.52, 0.16, 0.58), cylCF * CFrame.new(0, 0.32, 0), BLACK, Enum.Material.SmoothPlastic)
	-- recoil starter facing forward, air filter on top towards the seat
	disc(model, chassis, "Starter", pt(1.36, 0.72, -0.56), Vector3.zAxis, 0.3, 0.1, Color3.fromRGB(190, 30, 30))
	disc(model, chassis, "StarterCup", pt(1.36, 0.72, -0.5), Vector3.zAxis, 0.12, 0.05, BLACK)
	local filter = visual(model, chassis, "AirFilter", Vector3.new(0.5, 0.42, 0.62), at(1.12, 1.2, -1.15), BLACK, Enum.Material.SmoothPlastic)
	surfaceText(filter, Enum.NormalId.Right, "AK 270", Color3.fromRGB(220, 220, 220), 40)
	-- chain from the clutch to the axle sprocket, under a guard
	tube(model, chassis, "Chain", pt(0.93, 0.85, -1.05), pt(0.93, 1.0, -1.6), 0.05, DARK)
	tube(model, chassis, "Chain", pt(0.93, 0.47, -1.05), pt(0.93, 0.4, -1.6), 0.05, DARK)
	visual(model, chassis, "ChainGuard", Vector3.new(0.05, 0.5, 0.75), at(0.84, 0.72, -1.32), BLACK, Enum.Material.SmoothPlastic)
	-- exhaust: header round the back to a silencer with a heat shield
	local PIPE = Color3.fromRGB(150, 140, 132)
	tube(model, chassis, "Header", pt(1.72, 1.0, -1.3), pt(1.6, 0.98, -2.0), 0.14, PIPE, Enum.Material.Metal)
	tube(model, chassis, "Silencer", pt(1.7, 1.02, -2.12), pt(0.45, 1.02, -2.12), 0.42, ALU, Enum.Material.Metal)
	visual(model, chassis, "HeatShield", Vector3.new(1.15, 0.05, 0.5), at(1.08, 1.27, -2.12), BLACK, Enum.Material.DiamondPlate)
	tube(model, chassis, "Tailpipe", pt(0.45, 1.0, -2.14), pt(0.3, 1.0, -2.22), 0.12, DARK)
end

function KartFactory.create(player: Player, number: number, cf: CFrame, color: Color3, anchored: boolean, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = "Kart_" .. player.UserId

	-- the root: a compact block that carries all the mass (sets the inertia)
	local core = cfg.CoreSize
	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(core[1], core[2], core[3])
	chassis.CFrame = cf
	chassis.Transparency = 1
	chassis.CanCollide = false
	chassis.CanQuery = false
	chassis.CanTouch = false
	chassis.Anchored = anchored
	chassis.RootPriority = 100
	chassis.CollisionGroup = "Karts"
	chassis.CustomPhysicalProperties = PhysicalProperties.new(cfg.Density, 0.12, 0.2, 1, 1)
	chassis.Parent = model
	model.PrimaryPart = chassis

	-- the collision shape: a massless box around the whole kart
	local box = cfg.BoxSize
	local hit = visual(model, chassis, "Hitbox", Vector3.new(box[1], box[2], box[3]), CFrame.new(0, cfg.BoxOffsetY, 0), Color3.new(1, 1, 1))
	hit.Transparency = 1
	hit.CanCollide = true
	hit.CollisionGroup = "Karts"
	hit.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.12, 0.2, 1, 1)

	-- forces set by the driving client every frame
	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = chassis
	local vf = Instance.new("VectorForce")
	vf.Name = "Drive"
	vf.Attachment0 = center
	vf.RelativeTo = Enum.ActuatorRelativeTo.World
	vf.ApplyAtCenterOfMass = true
	vf.Force = Vector3.zero
	vf.Parent = chassis
	local tq = Instance.new("Torque")
	tq.Name = "Spin"
	tq.Attachment0 = center
	tq.RelativeTo = Enum.ActuatorRelativeTo.World
	tq.Torque = Vector3.zero
	tq.Parent = chassis

	bodywork(model, chassis, number, color)

	-- the seat the character sits on (cannot be sat on by touching it)
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(1.4, 0.3, 1.2)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.CanQuery = false
	seat.CanTouch = false
	seat.Massless = true
	seat.Anchored = false
	seat.CFrame = chassis.CFrame * at(0, 0.82, -0.5)
	local seatWeld = Instance.new("WeldConstraint")
	seatWeld.Part0 = chassis
	seatWeld.Part1 = seat
	seatWeld.Parent = seat
	seat.Parent = model

	-- name above the kart
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(180, 36)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 5.6, 0)
	tag.MaxDistance = 140
	tag.LightInfluence = 0
	tag.Parent = chassis
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.fromScale(1, 1)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextScaled = true
	nameLabel.Text = string.format("%d  %s", number, player.DisplayName)
	nameLabel.Parent = tag

	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("Number", number)
	model:SetAttribute("Color", color)
	model.Parent = parent
	return model
end

local function setCharacterParts(character: Model, group: string, massless: boolean)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
			d.Massless = massless
		end
	end
end

KartFactory.setCharacterParts = setCharacterParts

-- Seats the player's character in the kart. Returns true when seated.
function KartFactory.seat(model: Model, player: Player): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = model:FindFirstChild("DriverSeat") :: Seat?
	if not (character and humanoid and seat) or humanoid.Health <= 0 then
		return false
	end
	if humanoid.SeatPart and humanoid.SeatPart ~= seat then
		humanoid.Sit = false
		task.wait()
	end
	setCharacterParts(character, "Drivers", true)
	seat:Sit(humanoid)
	return true
end

-- Gives physics control of an unanchored kart to its driver.
function KartFactory.handOver(model: Model, player: Player)
	local chassis = model.PrimaryPart
	if chassis and not chassis.Anchored and chassis:CanSetNetworkOwnership() then
		chassis:SetNetworkOwner(player)
	end
end

-- Moves a kart to a pose (pos on the road surface), stopped and unanchored,
-- then hands it back to the driver. Used for grid placement and resets.
function KartFactory.place(model: Model, player: Player?, pos: Vector3, fwd: Vector3, up: Vector3, anchored: boolean)
	local chassis = model.PrimaryPart
	if not chassis then
		return
	end
	chassis.Anchored = true
	local center = pos + up * (cfg.RideHeight + 0.15)
	model:PivotTo(CFrame.lookAt(center, center + fwd, up))
	chassis.AssemblyLinearVelocity = Vector3.zero
	chassis.AssemblyAngularVelocity = Vector3.zero
	if not anchored then
		chassis.Anchored = false
		if player then
			KartFactory.handOver(model, player)
		end
	end
end

-- Restores a character that leaves a kart.
function KartFactory.release(player: Player)
	local character = player.Character
	if character then
		setCharacterParts(character, "Players", false)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Sit = false
		end
	end
end

return KartFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--!strict
-- The lobby's requests (the menu on every public server): PRACTICE on a
-- track, RACE (join / leave the quick-race queue), CREATE ROOM, JOIN ROOM;
-- and LOBBY from any other server. Problems go back to the player as a
-- "MenuError" RaceEvent.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local TrackData = require(Shared:WaitForChild("TrackData"))
local Session = require(script.Parent:WaitForChild("Session"))
local SharedStore = require(script.Parent:WaitForChild("SharedStore"))
local Matchmaker = require(script.Parent:WaitForChild("Matchmaker"))
local Rooms = require(script.Parent:WaitForChild("Rooms"))

local Lobby = {}

local L = Config.Lobby
local busy: { [Player]: boolean } = {}
local getMode: () -> string = function()
	return "lobby"
end
local raceEvent: RemoteEvent

local function say(p: Player, message: string)
	raceEvent:FireClient(p, "MenuError", { message = message })
end

-- one request at a time per player (double taps, impatient clicks)
local function once(p: Player, fn: () -> ())
	if busy[p] or Session.busy(p) then
		return
	end
	busy[p] = true
	task.spawn(function()
		local ok, err = pcall(fn :: any)
		if not ok then
			warn("[Lobby]", err)
			say(p, "Something went wrong. Try again.")
		end
		busy[p] = nil
	end)
end

local function onRequest(p: Player, kind: unknown, arg: unknown)
	local mode = getMode()
	if kind == "ToLobby" then
		if mode ~= "lobby" then
			once(p, function()
				Session.toLobby(p)
			end)
		end
		return
	end
	if mode ~= "lobby" then
		return
	end
	if kind == "Practice" then
		if type(arg) ~= "string" or not TrackData.Tracks[arg] then
			return
		end
		Matchmaker.leave(p)
		once(p, function()
			local role: Session.Role = { mode = "practice", track = arg }
			local code = Session.reserve(role)
			if not code then
				say(p, "Couldn't start practice. Try again.")
				return
			end
			Session.send({ p }, role, code)
		end)
	elseif kind == "Queue" then
		if arg == false then
			Matchmaker.leave(p)
		elseif not Session.busy(p) then
			Matchmaker.join(p)
		end
	elseif kind == "CreateRoom" then
		Matchmaker.leave(p)
		once(p, function()
			local code, err = Rooms.create(p)
			if not code then
				say(p, err or "Couldn't make a room. Try again.")
			end
		end)
	elseif kind == "JoinRoom" then
		Matchmaker.leave(p)
		once(p, function()
			local err = Rooms.join(p, arg)
			if err then
				say(p, err)
			end
		end)
	end
end

-- `mode` tells which kind of server this is right now (RaceManager.mode).
function Lobby.init(remotes: Folder, mode: () -> string)
	getMode = mode
	raceEvent = remotes:WaitForChild("RaceEvent") :: RemoteEvent
	local request = remotes:WaitForChild("Request") :: RemoteEvent
	request.OnServerEvent:Connect(onRequest)
	Players.PlayerRemoving:Connect(function(p)
		busy[p] = nil
	end)

	-- shared maps: MemoryStore when published, tables in Studio
	local studio = Session.studio()
	local tickets, locks, rooms
	if studio then
		tickets = SharedStore.localMap(Session.clock)
		locks = SharedStore.localMap(Session.clock)
		rooms = SharedStore.localMap(Session.clock)
	else
		tickets = SharedStore.memory("A1Queue")
		locks = SharedStore.memory("A1Locks")
		rooms = SharedStore.memory("A1Rooms")
	end
	Matchmaker.init({
		tickets = tickets,
		locks = locks,
		reserve = function()
			return Session.reserve({ mode = "race" })
		end,
		send = function(list: { Player }, code: string)
			Session.send(list, { mode = "race" }, code)
		end,
		clock = Session.clock,
		minPlayers = if studio and L.StudioSolo then 1 else L.QueueMin,
	})
	Rooms.init({
		rooms = rooms,
		reserve = Session.reserve,
		send = Session.send,
	})
end

-- The server stopped being a lobby (Studio): nobody waits for a race here.
function Lobby.closed()
	for _, p in Players:GetPlayers() do
		Matchmaker.leave(p)
	end
end

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Matchmaker</string>
          <string name="Source"><![CDATA[--!strict
-- Quick-race matchmaking across every lobby server.
--
-- Pressing RACE puts a ticket in a shared map (key: the player's UserId;
-- value: when they started waiting and which server they are on). Every
-- lobby server with someone waiting reads the map every QueuePoll seconds:
--   * once QueueMin drivers wait, the race goes QueueWait seconds after the
--     QueueMin-th of them joined (straight away when QueueMax wait);
--   * when it is time, one server takes a short lock, reserves a race
--     server and writes its access code into the tickets of the first
--     QueueMax drivers;
--   * each lobby server sends its own drivers whose ticket has a code.
-- Tickets are renewed by their server on every pass and expire on their own
-- if that server goes away.
--
-- Waiting players see: attributes Queued, QueueCount (drivers waiting) and
-- QueueGo (this server's time when the race goes, nil until there are
-- enough drivers).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local SharedStore = require(script.Parent:WaitForChild("SharedStore"))

local Matchmaker = {}

export type Deps = {
	tickets: SharedStore.Map,
	locks: SharedStore.Map,
	reserve: () -> string?, -- a race server's access code
	send: ({ Player }, string) -> (), -- off to that server
	clock: () -> number, -- shared wall clock (seconds)
	minPlayers: number,
}

local L = Config.Lobby
local deps: Deps? = nil
local waiting: { [Player]: number } = {} -- when each started waiting (shared clock)
local polling = false
local again = false

local function key(p: Player): string
	return tostring(p.UserId)
end

local function clearAttrs(p: Player)
	p:SetAttribute("Queued", nil)
	p:SetAttribute("QueueCount", nil)
	p:SetAttribute("QueueGo", nil)
end

function Matchmaker.isWaiting(p: Player): boolean
	return waiting[p] ~= nil
end

-- One server forms the match: whoever gets the lock.
local function form(d: Deps, free: { { key: string, t: number } }, t: number): boolean
	local lock = d.locks.update("queue", function(old)
		if type(old) == "table" and old.job ~= game.JobId and type(old.at) == "number" and old.at > t - 10 then
			return nil -- another server is on it
		end
		return { job = game.JobId, at = t }
	end, 15)
	if lock == nil then
		return false
	end
	local code = d.reserve()
	local given = 0
	if code then
		local match = game.JobId .. ":" .. tostring(math.floor(t * 1000))
		for i = 1, math.min(#free, L.QueueMax) do
			local v = d.tickets.update(free[i].key, function(old)
				if type(old) == "table" and not old.code then
					old.code = code
					old.match = match
					return old
				end
				return nil
			end, L.TicketTtl)
			if v ~= nil then
				given += 1
			end
		end
	end
	d.locks.remove("queue")
	return given > 0
end

-- One pass: renew our tickets, send the matched ones, count down, form a match.
function Matchmaker.poll()
	local d = deps
	if not d or next(waiting) == nil then
		return
	end
	if polling then
		again = true
		return
	end
	polling = true
	local t = d.clock()
	for p, since in table.clone(waiting) do
		d.tickets.update(key(p), function(old)
			if type(old) == "table" and old.code then
				return nil -- already given a server: leave it be
			end
			return { job = game.JobId, t = since, name = p.DisplayName }
		end, L.TicketTtl)
	end
	local items = d.tickets.list()
	local formed = false
	if items then
		local free: { { key: string, t: number } } = {}
		local matched: { [string]: { Player } } = {}
		for _, it in items do
			local v = it.value
			if type(v) ~= "table" then
				continue
			end
			if type(v.code) == "string" then
				local p = Players:GetPlayerByUserId(tonumber(it.key) or 0)
				if p and waiting[p] then
					local list = matched[v.code] or {}
					matched[v.code] = list
					table.insert(list, p)
				end
			elseif type(v.t) == "number" then
				table.insert(free, { key = it.key, t = v.t })
			end
		end
		for code, list in matched do
			for _, p in list do
				waiting[p] = nil
				d.tickets.remove(key(p))
				clearAttrs(p)
			end
			d.send(list, code)
		end
		table.sort(free, function(a, b)
			if a.t ~= b.t then
				return a.t < b.t
			end
			return a.key < b.key
		end)
		local startAt: number? = nil
		if #free >= L.QueueMax then
			startAt = t
		elseif #free >= d.minPlayers then
			startAt = free[d.minPlayers].t + L.QueueWait
		end
		local serverNow = workspace:GetServerTimeNow()
		for p in waiting do
			p:SetAttribute("QueueCount", math.max(#free, 1))
			p:SetAttribute("QueueGo", if startAt then serverNow + math.max(startAt - t, 0) else nil)
		end
		if startAt and t >= startAt then
			formed = form(d, free, t)
		end
	end
	polling = false
	if formed or again then
		again = false
		-- our own drivers in the new match leave on this next pass
		task.defer(Matchmaker.poll)
	end
end

function Matchmaker.join(p: Player)
	local d = deps
	if not d or waiting[p] then
		return
	end
	waiting[p] = d.clock()
	p:SetAttribute("Queued", true)
	p:SetAttribute("QueueCount", 1)
	p:SetAttribute("QueueGo", nil)
	task.spawn(Matchmaker.poll)
end

function Matchmaker.leave(p: Player)
	local d = deps
	if not waiting[p] then
		return
	end
	waiting[p] = nil
	clearAttrs(p)
	if d then
		task.spawn(d.tickets.remove, key(p))
	end
end

function Matchmaker.init(d: Deps)
	deps = d
	Players.PlayerRemoving:Connect(Matchmaker.leave)
	task.spawn(function()
		while true do
			task.wait(L.QueuePoll)
			Matchmaker.poll()
		end
	end)
end

return Matchmaker
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RaceManager</string>
          <string name="Source"><![CDATA[--!strict
-- The race weekend loop. What a server does depends on its mode (Session):
--   lobby     the menu; no karts (State "Lobby")
--   practice  one player's free practice; the track changes from the HUD
--   race      a quick race: the loop below, round after round
--   room      a private room: a waiting room (State "Lobby", no karts) with
--             the players, READY / NOT READY, the host's track and length;
--             the host starts once every guest is ready (and can kick);
--             then qualifying, grid, race, podium and back to the waiting
--             room (no vote)
--
--   Practice      fewer than MinPlayers: everyone free-drives with lap timing;
--                 the track can be changed straight away from the HUD
--   Intermission  enough players: countdown while still practising; votes on
--                 the next track and race length; when everyone presses
--                 READY the countdown drops to a few seconds
--   Qualifying    one timed lap each, with ghosts (karts pass through each
--                 other, no slipstream): everyone starts together a run-up
--                 before the line; a deleted lap means the back of the grid.
--                 Over when everyone is done, or at the flag (per track
--                 time: finish the lap you are on)
--   Grid          karts placed on the grid in qualifying order (anchored);
--                 five red lights
--   Racing        lights out; laps and positions from RaceProgress
--   Results       a short podium for the top three, then the next round
--
-- Track limits (TrackLimits): all four tyres beyond the kerb. In practice and
-- qualifying the lap is struck off; in the race the first few are warnings,
-- then each one adds a time penalty to the result. Every timed lap is split
-- into sectors, coloured against the session's and the driver's best.
--
-- Every circuit is built at start-up; the one in use is workspace.Circuit,
-- the others wait in ServerStorage.Circuits. Switching moves the folders.
--
-- Clients read workspace attributes (RaceState, StateEnd, LightsStart,
-- RaceStart, Laps, Track, TrackName, Tracks, Votes_<id>, LenVotes_<length>,
-- ReadyCount, QualiClosing, Podium) and player attributes (Lap, Position,
-- WrongWay, OffCourse, Finished, Vote, LengthVote, Ready, Warnings, Penalty)
-- and get one-off messages on the RaceEvent remote.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local TrackMath = require(Shared:WaitForChild("TrackMath"))
local TrackLayout = require(Shared:WaitForChild("TrackLayout"))
local TrackLimits = require(Shared:WaitForChild("TrackLimits"))
local RaceProgress = require(Shared:WaitForChild("RaceProgress"))
local KartFactory = require(script.Parent:WaitForChild("KartFactory"))
local Stats = require(script.Parent:WaitForChild("Stats"))
local Build = require(script.Parent:WaitForChild("Build"))
local v3, vec = Build.v3, Build.vec

local RaceManager = {}
-- called after a switch to another circuit (init.server sets the weather)
RaceManager.onTrackChanged = nil :: ((any) -> ())?
-- a private room's host removed this player (init.server sends them to the
-- lobby with the message and bars them from the room)
RaceManager.onKick = nil :: ((Player, string) -> ())?

type State = "Lobby" | "Practice" | "Intermission" | "Qualifying" | "Grid" | "Racing" | "Results"
type Mode = "practice" | "quali" | "race" -- the kind of timing session
export type ServerMode = "lobby" | "practice" | "race" | "room"
export type Role = { mode: ServerMode, track: string?, code: string?, host: number? }

-- One built circuit: its TrackData entry, the sampled track, the bands
-- beside the road (for track limits) and its folder.
export type Circuit = { id: string, spec: any, track: TrackMath.Track, zones: TrackLayout.Zones, folder: Folder }

local R = Config.Race
local LENGTHS = { "Short", "Normal", "Long" }
local DEFAULT_SECTORS = { 1 / 3, 2 / 3 }

-- circuits and votes
local circuits: { [string]: Circuit } = {}
local order: { string } = {}
local current: Circuit
local storage: Folder
local track: TrackMath.Track
local zones: TrackLayout.Zones
local LAPS = 3
local votes: { [Player]: string } = {}
local lengthVotes: { [Player]: string } = {}
local ready: { [Player]: boolean } = {}
local lastTrackChange = -math.huge

-- what this server is for (setMode)
local serverMode: ServerMode = "race"
local roomCode: string? = nil
local roomHost: number? = nil -- UserId
local roomLength = "Normal"
-- the waiting room's pick: only a note until START (switching circuits sends
-- thousands of parts to every client, so it happens once, then)
local roomPick: string? = nil
local wantTrack: string? = nil -- a switch asked for a circuit still being built
local kicked: { [number]: boolean } = {} -- UserIds the room's host removed

local kartFolder: Folder
local raceEvent: RemoteEvent

local state: State = "Practice"
local stateEnd = 0
local karts: { [Player]: Model } = {}
local numbers: { [Player]: number } = {}
local lastReset: { [Player]: number } = {}
local spawnHold: { [Player]: number } = {} -- onCharacter is about to give a kart
local ghostSince: { [Model]: number } = {} -- since when a reset kart has been a ghost

-- sessions
local practice: { [Player]: RaceProgress.Race } = {}
local quali: RaceProgress.Race? = nil
local qualiClosing = false
local race: RaceProgress.Race? = nil
local racers: { Player } = {}
local raceStart = 0
local finishDeadline: number? = nil
local lastStandings = 0
local lastAttr = 0
local lastTick = 0

-- timing extras for the session in progress
type Bests = { sectors: { [number]: number }, lap: number? }
local sessionBest: Bests = { sectors = {}, lap = nil }
local bests: { [Player]: Bests } = {}
local splits: { [Player]: number } = {} -- last split time on the current lap
local limits: { [Player]: TrackLimits.Tracker } = {}
local warnings: { [Player]: number } = {}
local penalties: { [Player]: number } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Lobby: characters stand still behind the menu.
local function freeze(p: Player, on: boolean)
	local c = p.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h then
		h.WalkSpeed = if on then 0 else 16
		h.JumpHeight = if on then 0 else 7.2
	end
end

local function setState(s: State, duration: number?)
	local was = state
	state = s
	stateEnd = if duration then now() + duration else 0
	workspace:SetAttribute("RaceState", s)
	workspace:SetAttribute("StateEnd", stateEnd)
	-- qualifying is driven with ghosts (clients drop the bumpers and the tow)
	workspace:SetAttribute("Ghost", s == "Qualifying")
	if (was == "Lobby") ~= (s == "Lobby") then
		for _, p in Players:GetPlayers() do
			freeze(p, s == "Lobby")
		end
	end
end

-- Where a server rests between rounds: the menu (lobby), the waiting room
-- (private room), free practice (practice and quick-race servers).
local function idle(): State
	return if serverMode == "lobby" or serverMode == "room" then "Lobby" else "Practice"
end

-- a quick race needs MinPlayers; a private room races with whoever is there
local function minPlayers(): number
	return if serverMode == "room" then 1 else R.MinPlayers
end

local function isHost(p: Player): boolean
	return serverMode == "room" and p.UserId == roomHost
end

-- The room's host: whoever made it, or (if they left) the next player.
local function checkHost()
	if serverMode ~= "room" then
		workspace:SetAttribute("RoomHost", nil)
		workspace:SetAttribute("RoomHostName", nil)
		return
	end
	local host = if roomHost then Players:GetPlayerByUserId(roomHost) else nil
	if not host then
		host = Players:GetPlayers()[1]
		if host then
			roomHost = host.UserId
		end
	end
	workspace:SetAttribute("RoomHost", roomHost)
	workspace:SetAttribute("RoomHostName", if host then host.DisplayName else nil)
end

local function setStateEnd(t: number)
	stateEnd = t
	workspace:SetAttribute("StateEnd", stateEnd)
end

local function fire(player: Player?, kind: string, payload: { [string]: any }?)
	if player then
		raceEvent:FireClient(player, kind, payload or {})
	else
		raceEvent:FireAllClients(kind, payload or {})
	end
end

local function alive(player: Player): boolean
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
end

local function eligiblePlayers(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if alive(p) then
			table.insert(list, p)
		end
	end
	return list
end

local function numberFor(player: Player): number
	if numbers[player] then
		return numbers[player]
	end
	local used = {}
	for _, n in numbers do
		used[n] = true
	end
	local n = 1
	while used[n] do
		n += 1
	end
	numbers[player] = n
	return n
end

local function colorFor(player: Player): Color3
	local n = numberFor(player)
	return KartFactory.Colors[(n - 1) % #KartFactory.Colors + 1]
end

local function chassisOf(player: Player): BasePart?
	local k = karts[player]
	return k and k.PrimaryPart or nil
end

local function removeKart(player: Player)
	local k = karts[player]
	karts[player] = nil
	practice[player] = nil
	if k then
		KartFactory.release(player)
		k:Destroy()
	end
end

-- pose on the road for grid slot `slot`, lifted to ride height by KartFactory
local function slotPose(slot: number): (Vector3, Vector3, Vector3)
	local pos, fwd, up = TrackLayout.gridSlot(track, slot, R)
	return v3(pos), v3(fwd), v3(up)
end

local function spawnKart(player: Player, pos: Vector3, fwd: Vector3, up: Vector3, anchored: boolean): Model?
	removeKart(player)
	if not alive(player) then
		return nil
	end
	local center = pos + up * (Config.Kart.RideHeight + 0.15)
	local model = KartFactory.create(player, numberFor(player), CFrame.lookAt(center, center + fwd, up), colorFor(player), anchored, kartFolder)
	karts[player] = model
	if not KartFactory.seat(model, player) then
		model:Destroy()
		karts[player] = nil
		return nil
	end
	if not anchored then
		task.defer(KartFactory.handOver, model, player)
	end
	return model
end

-- first grid slot with no kart near it
local function freeSlot(): number
	for slot = 1, R.MaxRacers do
		local pos = slotPose(slot)
		local taken = false
		for _, k in karts do
			if k.PrimaryPart and (k.PrimaryPart.Position - pos).Magnitude < 8 then
				taken = true
				break
			end
		end
		if not taken then
			return slot
		end
	end
	return math.random(1, R.MaxRacers)
end

local function newSession(laps: number, startTime: number): RaceProgress.Race
	local s = RaceProgress.new(TrackMath, track, laps, R.OffTrackAllowance, startTime)
	s:setSectors(current.spec.Sectors or DEFAULT_SECTORS)
	return s
end

local function resetTiming()
	sessionBest = { sectors = {}, lap = nil }
	table.clear(bests)
	table.clear(splits)
	table.clear(limits)
	table.clear(warnings)
	table.clear(penalties)
	for _, p in Players:GetPlayers() do
		p:SetAttribute("Warnings", nil)
		p:SetAttribute("Penalty", nil)
	end
end

local function spawnPracticeKart(player: Player)
	local pos, fwd, up = slotPose(freeSlot())
	local model = spawnKart(player, pos, fwd, up, false)
	if model then
		practice[player] = newSession(1e9, now())
		practice[player]:addRacer(player, vec(pos), now())
		limits[player] = TrackLimits.newTracker()
		splits[player] = 0
	end
end

local function canPractice(): boolean
	return state == "Practice" or state == "Intermission"
end

----------------------------------------------------------------------------
-- Circuits, votes and ready
----------------------------------------------------------------------------
local function publishVotes(): { [string]: number }
	local counts: { [string]: number } = {}
	for p, id in votes do
		if p.Parent then
			counts[id] = (counts[id] or 0) + 1
		end
	end
	for _, id in order do
		workspace:SetAttribute("Votes_" .. id, counts[id] or 0)
	end
	local lens: { [string]: number } = {}
	for p, l in lengthVotes do
		if p.Parent then
			lens[l] = (lens[l] or 0) + 1
		end
	end
	for _, l in LENGTHS do
		workspace:SetAttribute("LenVotes_" .. l, lens[l] or 0)
	end
	local readyCount = 0
	for p, on in ready do
		if on and p.Parent then
			readyCount += 1
		end
	end
	workspace:SetAttribute("ReadyCount", readyCount)
	return counts
end

local function resetVotes()
	table.clear(votes)
	table.clear(lengthVotes)
	table.clear(ready)
	for _, p in Players:GetPlayers() do
		p:SetAttribute("Vote", nil)
		p:SetAttribute("LengthVote", nil)
		p:SetAttribute("Ready", nil)
	end
	publishVotes()
end

-- Most votes wins; a tie is drawn among the leaders; no votes keeps the track.
local function voteWinner(): string
	local counts = publishVotes()
	local best, leaders = 0, {}
	for _, id in order do
		local c = counts[id] or 0
		if c > best then
			best, leaders = c, { id }
		elseif c == best and c > 0 then
			table.insert(leaders, id)
		end
	end
	if best == 0 then
		return current.id
	end
	return leaders[math.random(1, #leaders)]
end

-- Race length: most votes; ties go to Normal if it is among them.
local function lengthWinner(): string
	local counts: { [string]: number } = {}
	for p, l in lengthVotes do
		if p.Parent then
			counts[l] = (counts[l] or 0) + 1
		end
	end
	local best, leaders = 0, {}
	for _, l in LENGTHS do
		local c = counts[l] or 0
		if c > best then
			best, leaders = c, { l }
		elseif c == best and c > 0 then
			table.insert(leaders, l)
		end
	end
	if best == 0 or table.find(leaders, "Normal") then
		return "Normal"
	end
	return leaders[math.random(1, #leaders)]
end

local function lapsFor(spec: any, length: string): number
	local opts = spec.Lengths or { spec.Laps or 3, spec.Laps or 3, spec.Laps or 3 }
	return opts[table.find(LENGTHS, length) or 2]
end

-- Everyone in the server pressed READY: start in a few seconds.
local function checkAllReady()
	if state ~= "Intermission" then
		return
	end
	local list = eligiblePlayers()
	if #list < minPlayers() then
		return
	end
	for _, p in list do
		if not ready[p] then
			return
		end
	end
	local soon = now() + R.ReadyCountdown
	if stateEnd > soon then
		setStateEnd(soon)
		fire(nil, "AllReady", {})
	end
end

-- The waiting room: every player but the host has pressed READY.
local function guestsReady(): boolean
	for _, p in Players:GetPlayers() do
		if not isHost(p) and not ready[p] then
			return false
		end
	end
	return true
end

local function lobbySpawn(c: Circuit): BasePart?
	local pits = c.folder:FindFirstChild("Pits")
	local sp = pits and pits:FindFirstChild("LobbySpawn")
	return if sp and sp:IsA("BasePart") then sp else nil
end

local function activate(c: Circuit)
	current = c
	track = c.track
	zones = c.zones
	LAPS = lapsFor(c.spec, if serverMode == "room" then roomLength else "Normal")
	c.folder.Name = "Circuit"
	c.folder.Parent = workspace
	workspace:SetAttribute("Track", c.id)
	workspace:SetAttribute("TrackName", c.spec.Name)
	roomPick = nil
	workspace:SetAttribute("RoomTrack", c.id)
	workspace:SetAttribute("Laps", LAPS)
	Stats.setTrack(c.id)
	resetTiming()
end

-- Puts circuit `id` in use. Karts are taken away (the caller decides what
-- comes next) and anyone walking around is moved to the new paddock.
local function switchTo(id: string): boolean
	local c = circuits[id]
	if not c or c == current then
		return false
	end
	for _, p in Players:GetPlayers() do
		removeKart(p)
	end
	local old = current
	old.folder.Parent = storage
	old.folder.Name = old.id
	activate(c)
	lastTrackChange = now()
	local sp = lobbySpawn(c)
	for _, p in Players:GetPlayers() do
		local ch = p.Character
		if sp and ch and ch.PrimaryPart then
			local off = Vector3.new(math.random(-5, 5), 4, math.random(-5, 5))
			ch:PivotTo(CFrame.new(sp.Position + off))
		end
		-- practice karts come back on their own once the new circuit has
		-- reached everyone's client (thousands of parts to replicate)
		spawnHold[p] = os.clock() + R.TrackLoadTime
	end
	if RaceManager.onTrackChanged then
		RaceManager.onTrackChanged(c)
	end
	fire(nil, "Track", { id = c.id, name = c.spec.Name, laps = LAPS })
	print(string.format("[A1KartRacing] track is now %s", c.spec.Name))
	return true
end

local function publishTracks()
	workspace:SetAttribute("Tracks", table.concat(order, ","))
	publishVotes()
end

----------------------------------------------------------------------------
-- Timing: sectors, laps, track limits
----------------------------------------------------------------------------
local function bestsOf(p: Player): Bests
	local b = bests[p]
	if not b then
		b = { sectors = {}, lap = nil }
		bests[p] = b
	end
	return b
end

-- purple: fastest of the session, green: the driver's best, yellow: slower
local function rate(p: Player, index: number?, t: number, invalid: boolean): string
	if invalid then
		return "invalid"
	end
	local mine = bestsOf(p)
	local myBest = if index then mine.sectors[index] else mine.lap
	local overall = if index then sessionBest.sectors[index] else sessionBest.lap
	local colour = "yellow"
	if not myBest or t <= myBest then
		colour = "green"
		if index then
			mine.sectors[index] = t
		else
			mine.lap = t
		end
	end
	if not overall or t <= overall then
		colour = "purple"
		if index then
			sessionBest.sectors[index] = t
		else
			sessionBest.lap = t
		end
	end
	return colour
end

local function sectorEvent(p: Player, index: number, split: number, invalid: boolean)
	local sectorTime = split - (splits[p] or 0)
	splits[p] = split
	fire(p, "Sector", { index = index, split = split, time = sectorTime, colour = rate(p, index, sectorTime, invalid) })
end

-- a timed lap ended: last sector, the lap itself, personal best
local function lapDone(p: Player, racer: RaceProgress.Racer, lapNo: number, lapTime: number?, invalid: boolean, final: boolean)
	local sectorCount = #((current.spec.Sectors or DEFAULT_SECTORS) :: { number }) + 1
	if lapTime then
		sectorEvent(p, sectorCount, lapTime, invalid)
	end
	splits[p] = 0
	local pb = false
	local colour = "invalid"
	if lapTime and not invalid then
		pb = Stats.recordLap(p, lapTime)
		colour = rate(p, nil, lapTime, false)
	end
	fire(p, "Lap", { lap = lapNo, time = lapTime, pb = pb, best = racer.bestLap, invalid = invalid, colour = colour, final = final })
end

local function handleEvents(player: Player, events: { RaceProgress.Event }, mode: Mode)
	for _, e in events do
		if e.kind == "start" then
			splits[player] = 0
			fire(player, "LapStart", { time = e.time, lap = 1 })
		elseif e.kind == "sector" then
			sectorEvent(player, e.index :: number, e.time :: number, e.racer.lapInvalid)
		elseif e.kind == "lap" then
			lapDone(player, e.racer, e.lap :: number, e.time, e.invalid == true, false)
			fire(player, "LapStart", { time = (e.racer.lapStart :: number), lap = e.racer.lap })
		elseif e.kind == "finish" then
			lapDone(player, e.racer, e.lap :: number, e.lapTime, e.invalid == true, true)
			if mode == "race" then
				local r = race :: RaceProgress.Race
				player:SetAttribute("Finished", true)
				player:SetAttribute("FinishTime", e.time)
				fire(nil, "Finish", { userId = player.UserId, name = player.DisplayName, position = r.finishCount, time = e.time })
				if r.finishCount == 1 then
					finishDeadline = now() + R.FinishGrace
					workspace:SetAttribute("FinishDeadline", finishDeadline)
				end
			elseif mode == "quali" then
				-- the one timed lap is in: where it puts them so far
				player:SetAttribute("QualiDone", true)
				local best = e.racer.bestLap
				local place: number? = nil
				local q = quali
				if best and q then
					local ahead = 0
					for _, id in q.order do
						local other = q.racers[id]
						if other ~= e.racer and other.bestLap and other.bestLap < best then
							ahead += 1
						end
					end
					place = ahead + 1
				end
				fire(player, "QualiDone", { best = best, place = place })
			end
		end
	end
end

-- Track limits for one driver this frame. Practice and qualifying: the lap
-- is struck off. Race: warnings, then a time penalty per excursion.
local function checkLimits(p: Player, session: RaceProgress.Race, mode: Mode, dt: number)
	local c = chassisOf(p)
	local racer = session.racers[p]
	if not (c and racer) or racer.finished or c.Anchored then
		return
	end
	local tr = limits[p]
	if not tr then
		tr = TrackLimits.newTracker()
		limits[p] = tr
	end
	local cf = c.CFrame
	local wheels: { TrackLimits.Wheel } = {}
	for _, w in Config.Kart.Wheels do
		local pos = cf.Position + cf.RightVector * w.x + cf.LookVector * w.f
		table.insert(wheels, { pos = vec(pos), half = w.width / 2 })
	end
	local hint = TrackLimits.locate(TrackMath, track, tr, vec(cf.Position))
	local out = TrackLimits.allOut(TrackMath, track, zones, hint, wheels)
	if not TrackLimits.step(tr, out, c.AssemblyLinearVelocity.Magnitude, dt) then
		return
	end
	if mode == "race" then
		local n = (warnings[p] or 0) + 1
		warnings[p] = n
		p:SetAttribute("Warnings", n)
		local added = 0
		if n > R.TrackLimitWarnings then
			added = R.TrackLimitPenalty
			penalties[p] = (penalties[p] or 0) + added
			p:SetAttribute("Penalty", penalties[p])
		end
		fire(p, "TrackLimits", { warnings = n, max = R.TrackLimitWarnings, added = added, penalty = penalties[p] or 0 })
	else
		local wasValid = not racer.lapInvalid and racer.lap >= 1
		session:invalidateLap(p)
		if wasValid then
			fire(p, "TrackLimits", { deleted = true })
		end
	end
end

----------------------------------------------------------------------------
-- Qualifying
----------------------------------------------------------------------------
local startGrid: (gridOrder: { Player }) -> ()

-- where one-lap qualifying starts: QualiRunUp studs before the line, in the
-- middle of the road (ghosts, so everyone can start from the same spot)
local function runUpPose(): (Vector3, Vector3, Vector3)
	local pos, fwd, up = TrackLayout.gridSlot(track, 1, { GridFirstRowBack = R.QualiRunUp, GridRowSpacing = 0, GridLateral = 0, GridStagger = 0 })
	return v3(pos), v3(fwd), v3(up)
end

local function qualiSlot(player: Player)
	local q = quali
	if not q then
		return
	end
	local racer = q.racers[player]
	local pos: vector?, fwd: vector?, up: vector?
	if racer then
		pos, fwd, up = q:resetPose(player)
	end
	if not (pos and fwd and up) then
		local p3, f3, u3 = runUpPose()
		pos, fwd, up = vec(p3), vec(f3), vec(u3)
	end
	local model = spawnKart(player, v3(pos :: vector), v3(fwd :: vector), v3(up :: vector), false)
	if model and not racer then
		q:addRacer(player, pos :: vector, now())
		limits[player] = TrackLimits.newTracker()
		splits[player] = 0
	end
	player:SetAttribute("InRace", model ~= nil)
end

local function startQualifying()
	local list = eligiblePlayers()
	if #list < minPlayers() then
		setState(idle())
		return
	end
	for i = #list, 2, -1 do
		local j = math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
	for _, p in Players:GetPlayers() do
		removeKart(p)
		p:SetAttribute("InRace", false)
		p:SetAttribute("Finished", nil)
		p:SetAttribute("FinishTime", nil)
		p:SetAttribute("Position", nil)
		p:SetAttribute("Lap", nil)
		p:SetAttribute("GridSlot", nil)
		p:SetAttribute("QualiDone", nil)
	end
	resetTiming()
	-- one timed lap: the session's "finish" is the end of lap 1
	quali = newSession(1, now())
	qualiClosing = false
	workspace:SetAttribute("QualiClosing", false)
	workspace:SetAttribute("Podium", false)
	local duration = current.spec.Qualifying or R.QualifyingTime
	setState("Qualifying", duration)
	local pos, fwd, up = runUpPose()
	for slot, p in list do
		if slot > R.MaxRacers then
			break
		end
		if spawnKart(p, pos, fwd, up, false) then
			(quali :: RaceProgress.Race):addRacer(p, vec(pos), now())
			limits[p] = TrackLimits.newTracker()
			splits[p] = 0
			p:SetAttribute("InRace", true)
		end
	end
	fire(nil, "Qualifying", { duration = duration })
end

-- qualifying order: clean best laps first, then everyone without one
local function qualiOrder(): { RaceProgress.Racer }
	local q = quali
	local list: { RaceProgress.Racer } = {}
	if not q then
		return list
	end
	for _, id in q.order do
		table.insert(list, q.racers[id])
	end
	table.sort(list, function(a, b)
		if (a.bestLap ~= nil) ~= (b.bestLap ~= nil) then
			return a.bestLap ~= nil
		end
		if a.bestLap and b.bestLap then
			return a.bestLap < b.bestLap
		end
		return false
	end)
	return list
end

local function qualiPayload(): { any }
	local out = {}
	local leader: number? = nil
	for i, r in qualiOrder() do
		local p = r.id :: Player
		if i == 1 then
			leader = r.bestLap
		end
		table.insert(out, {
			userId = p.UserId,
			name = p.DisplayName,
			number = numbers[p] or 0,
			color = colorFor(p),
			best = r.bestLap,
			gap = if r.bestLap and leader and i > 1 then r.bestLap - leader else nil,
			laps = #r.lapTimes,
			finished = r.finished,
		})
	end
	return out
end

local function finishQualifying()
	local gridOrder: { Player } = {}
	for _, r in qualiOrder() do
		local p = r.id :: Player
		if p.Parent then
			table.insert(gridOrder, p)
		end
	end
	fire(nil, "QualiResult", { list = qualiPayload() })
	quali = nil
	qualiClosing = false
	workspace:SetAttribute("QualiClosing", false)
	startGrid(gridOrder)
end

----------------------------------------------------------------------------
-- Grid, race, podium
----------------------------------------------------------------------------
startGrid = function(gridOrder: { Player })
	local list: { Player } = {}
	for _, p in gridOrder do
		if p.Parent and alive(p) then
			table.insert(list, p)
		end
	end
	-- anyone who missed qualifying starts at the back
	local late: { Player } = {}
	for _, p in eligiblePlayers() do
		if not table.find(list, p) then
			table.insert(late, p)
		end
	end
	for i = #late, 2, -1 do
		local j = math.random(1, i)
		late[i], late[j] = late[j], late[i]
	end
	for _, p in late do
		table.insert(list, p)
	end
	if #list < minPlayers() then
		setState(idle())
		return
	end
	for _, p in Players:GetPlayers() do
		removeKart(p)
		p:SetAttribute("InRace", false)
		p:SetAttribute("Finished", nil)
		p:SetAttribute("FinishTime", nil)
		p:SetAttribute("Position", nil)
		p:SetAttribute("Lap", nil)
	end
	resetTiming()
	racers = {}
	setState("Grid", 2 + R.CountdownTime)
	workspace:SetAttribute("Laps", LAPS)
	workspace:SetAttribute("RaceStart", nil)
	workspace:SetAttribute("LightsStart", now() + 2)
	for slot, p in list do
		if slot > R.MaxRacers then
			break
		end
		local pos, fwd, up = slotPose(slot)
		if spawnKart(p, pos, fwd, up, true) then
			table.insert(racers, p)
			p:SetAttribute("InRace", true)
			p:SetAttribute("GridSlot", slot)
			p:SetAttribute("Position", slot)
		end
	end
	if #racers < 1 then
		setState(idle())
	end
end

local function lightsOut()
	-- F1 style: a short random hold after the fifth light
	task.wait(0.3 + math.random() * 0.9)
	if state ~= "Grid" then
		return
	end
	raceStart = now()
	finishDeadline = nil
	local r = newSession(LAPS, raceStart)
	race = r
	for _, p in racers do
		local k = karts[p]
		if k and k.PrimaryPart then
			r:addRacer(p, vec(k.PrimaryPart.Position), raceStart)
			limits[p] = TrackLimits.newTracker()
			k.PrimaryPart.Anchored = false
			KartFactory.handOver(k, p)
		end
	end
	setState("Racing", R.MaxRaceTime)
	workspace:SetAttribute("RaceStart", raceStart)
	fire(nil, "Go", { time = raceStart })
end

-- Final classification: finishers by time plus penalties, then the rest by
-- distance covered, retirements last.
local function classification(): { RaceProgress.Racer }
	local r = race
	if not r then
		return {}
	end
	local list = r:standings()
	local function total(x: RaceProgress.Racer): number
		return (x.finishTime :: number) + (penalties[x.id :: Player] or 0)
	end
	table.sort(list, function(a, b)
		if a.finished ~= b.finished then
			return a.finished
		end
		if a.finished and b.finished then
			return total(a) < total(b)
		end
		if a.dnf ~= b.dnf then
			return not a.dnf
		end
		return a.progress > b.progress
	end)
	return list
end

local function standingsPayload(final: boolean): { any }
	local list = {}
	local r = race
	if not r then
		return list
	end
	local ordered: { RaceProgress.Racer } = if final then classification() else r:standings()
	local leader: RaceProgress.Racer? = nil
	for pos, racer in ordered do
		local p = racer.id :: Player
		if pos == 1 then
			leader = racer
		end
		local gap: number? = nil
		if leader and racer ~= leader and not racer.finished then
			gap = (leader.progress - racer.progress) -- studs behind the leader
		end
		table.insert(list, {
			userId = p.UserId,
			name = p.DisplayName,
			number = numbers[p] or 0,
			color = colorFor(p),
			lap = math.clamp(racer.lap, 1, LAPS),
			finished = racer.finished,
			dnf = racer.dnf,
			time = if racer.finishTime then racer.finishTime + (penalties[p] or 0) else nil,
			penalty = penalties[p],
			best = racer.bestLap,
			gap = gap,
		})
	end
	return list
end

-- The podium in the paddock (built by Scenery): its three steps.
local function podiumSteps(): { BasePart }
	local pits = current.folder:FindFirstChild("Pits")
	local podium = pits and pits:FindFirstChild("Podium")
	local steps: { BasePart } = {}
	if podium then
		for i = 1, 3 do
			local s = podium:FindFirstChild("Step" .. i)
			if s and s:IsA("BasePart") then
				steps[i] = s
			end
		end
	end
	return steps
end

-- confetti over the podium while the results are up
local function setConfetti(on: boolean)
	local pits = current.folder:FindFirstChild("Pits")
	local podium = pits and pits:FindFirstChild("Podium")
	local cannon = podium and podium:FindFirstChild("Confetti")
	if cannon then
		for _, e in cannon:GetChildren() do
			if e:IsA("ParticleEmitter") then
				e.Enabled = on
			end
		end
	end
end

local function endRace()
	local r = race
	if not r then
		setState(idle())
		return
	end
	for _, id in r.order do
		local racer = r.racers[id]
		if not racer.finished then
			racer.dnf = true
		end
	end
	local results = standingsPayload(true)
	local ordered = classification()
	local winner = ordered[1]
	if winner and winner.finished then
		Stats.addWin(winner.id :: Player)
	end
	fire(nil, "Results", { list = results })
	race = nil
	racers = {}
	-- podium: the top three finishers' karts on the steps, everyone else's away
	local steps = podiumSteps()
	local onPodium: { [Player]: boolean } = {}
	for place = 1, 3 do
		local racer = ordered[place]
		local step = steps[place]
		if racer and racer.finished and step then
			local p = racer.id :: Player
			local k = karts[p]
			if k then
				local top = step.Position + Vector3.new(0, step.Size.Y / 2, 0)
				KartFactory.place(k, nil, top, step.CFrame.LookVector, Vector3.new(0, 1, 0), true)
				onPodium[p] = true
			end
		end
	end
	for _, p in Players:GetPlayers() do
		if not onPodium[p] then
			removeKart(p)
		end
		p:SetAttribute("InRace", false)
		p:SetAttribute("WrongWay", false)
		p:SetAttribute("OffCourse", false)
	end
	workspace:SetAttribute("Podium", #steps == 3)
	setConfetti(next(onPodium) ~= nil)
	setState("Results", R.ResultsTime)
	workspace:SetAttribute("RaceStart", nil)
	workspace:SetAttribute("FinishDeadline", nil)
end

local function startIntermission()
	resetVotes()
	workspace:SetAttribute("Podium", false)
	setState("Intermission", R.IntermissionTime)
end

----------------------------------------------------------------------------
-- Per-frame update
----------------------------------------------------------------------------
-- Another kart (centre) closer than ResetClear to `pos`, ignoring `own`
-- and karts on the other level of a crossing.
local function kartNear(pos: Vector3, own: Model?): boolean
	local clear = R.ResetClear
	for _, k in karts do
		local c = k.PrimaryPart
		if k ~= own and c then
			local d = c.Position - pos
			if math.abs(d.Y) < 5 and d.X * d.X + d.Z * d.Z < clear * clear then
				return true
			end
		end
	end
	return false
end

-- A reset pose near (pos, fwd, up) that no other kart is sitting on: the
-- point itself, then beside it, then a few samples further back.
local function clearPose(own: Model, pos: vector, fwd: vector, up: vector): (vector, vector, vector)
	local idx = TrackMath.nearest(track, pos)
	local back = math.max(1, math.floor(R.ResetClear / track.spacing + 0.5))
	for step = 0, 3 do
		local smp = track.samples[TrackMath.wrap(idx - step * back, track.n)]
		local p0, f0, u0 = pos, fwd, up
		if step > 0 then
			p0, f0, u0 = smp.pos, smp.fwd, smp.up
		end
		local right = vector.normalize(vector.cross(f0, u0))
		local side = math.clamp(smp.width / 2 - 4, 0, R.ResetClear)
		for _, s in { 0, 1, -1 } do
			local p = p0 + right * (side * s)
			if (s == 0 or side > 0) and not kartNear(v3(p), own) then
				return p, f0, u0
			end
		end
	end
	return pos, fwd, up
end

-- Reset karts (Ghost attribute) stay ghosts until no kart is near them.
local function updateGhosts(t: number)
	for k in ghostSince do
		if not k.Parent then
			ghostSince[k] = nil
		end
	end
	for _, k in karts do
		local c = k.PrimaryPart
		if c and k:GetAttribute("Ghost") then
			local since = ghostSince[k] or t
			ghostSince[k] = since
			if t - since >= R.ResetGhostTime and not kartNear(c.Position, k) then
				ghostSince[k] = nil
				k:SetAttribute("Ghost", nil)
			end
		end
	end
end

local function tick()
	local t = now()
	updateGhosts(t)
	local dt = math.clamp(t - lastTick, 0, 0.2)
	lastTick = t
	local attrDue = t - lastAttr > 0.2
	if attrDue then
		lastAttr = t
	end
	if state == "Racing" and race then
		local r = race :: RaceProgress.Race
		for _, p in racers do
			local c = chassisOf(p)
			if c and r.racers[p] then
				handleEvents(p, r:update(p, vec(c.Position), vec(c.AssemblyLinearVelocity), t), "race")
				checkLimits(p, r, "race", dt)
			end
		end
		if attrDue then
			for pos, racer in r:standings() do
				local p = racer.id :: Player
				p:SetAttribute("Position", pos)
				p:SetAttribute("Lap", math.clamp(racer.lap, 1, LAPS))
				p:SetAttribute("WrongWay", racer.wrongWay and not racer.finished)
				p:SetAttribute("OffCourse", not racer.onCourse and not racer.finished)
			end
		end
		if t - lastStandings > 0.5 then
			lastStandings = t
			fire(nil, "Standings", { mode = "race", list = standingsPayload(false) })
		end
		if r:allDone() or (finishDeadline and t > finishDeadline) or t > stateEnd or #r.order == 0 then
			endRace()
		end
	elseif state == "Qualifying" and quali then
		local q = quali :: RaceProgress.Race
		for _, id in table.clone(q.order) do
			local p = id :: Player
			local c = chassisOf(p)
			if c then
				handleEvents(p, q:update(p, vec(c.Position), vec(c.AssemblyLinearVelocity), t), "quali")
				checkLimits(p, q, "quali", dt)
				if attrDue then
					local racer = q.racers[p]
					p:SetAttribute("WrongWay", racer.wrongWay)
					p:SetAttribute("OffCourse", not racer.onCourse)
				end
			end
		end
		if t - lastStandings > 0.5 then
			lastStandings = t
			local payload = qualiPayload()
			for pos, e in payload do
				local p = Players:GetPlayerByUserId(e.userId)
				if p then
					p:SetAttribute("Position", pos)
				end
			end
			fire(nil, "Standings", { mode = "quali", list = payload })
		end
	elseif canPractice() then
		for p, pr in practice do
			local c = chassisOf(p)
			if c then
				handleEvents(p, pr:update(p, vec(c.Position), vec(c.AssemblyLinearVelocity), t), "practice")
				checkLimits(p, pr, "practice", dt)
				local racer = pr.racers[p]
				if racer and attrDue then
					p:SetAttribute("WrongWay", racer.wrongWay)
					p:SetAttribute("OffCourse", not racer.onCourse)
				end
			end
		end
	end
end

local function stateLoop()
	while true do
		local t = now()
		local count = #eligiblePlayers()
		workspace:SetAttribute("PlayerCount", count)
		checkHost()
		if state == "Lobby" then
			-- the menu: nothing runs here
		elseif state == "Practice" then
			-- only a quick race goes to the vote on its own; a room waits for
			-- its host's START, a practice server never races
			if serverMode == "race" and count >= R.MinPlayers then
				startIntermission()
			end
		elseif state == "Intermission" then
			if count < minPlayers() then
				setState(idle())
			elseif t >= stateEnd then
				switchTo(voteWinner())
				LAPS = lapsFor(current.spec, lengthWinner())
				resetVotes()
				startQualifying()
			end
		elseif state == "Qualifying" then
			local q = quali
			if count < minPlayers() or not q then
				quali = nil
				setState(idle())
			elseif not qualiClosing and #q.order > 0 and q:allDone() then
				-- everyone has done their lap
				finishQualifying()
			elseif not qualiClosing and t >= stateEnd then
				-- chequered flag: finish the lap you are on
				qualiClosing = true
				q:closeSession()
				workspace:SetAttribute("QualiClosing", true)
				setStateEnd(t + math.min(R.QualiOvertime, track.length / 40))
				fire(nil, "Chequered", {})
			elseif qualiClosing and (q:allDone() or t >= stateEnd) then
				finishQualifying()
			end
		elseif state == "Grid" then
			if #racers == 0 then
				setState(idle())
			elseif t >= stateEnd then
				lightsOut()
			end
		elseif state == "Results" then
			if t >= stateEnd then
				setConfetti(false)
				for _, p in Players:GetPlayers() do
					removeKart(p)
				end
				if serverMode == "race" and count >= R.MinPlayers then
					startIntermission()
				else
					-- a room goes back to its waiting room (everyone NOT READY
					-- again); a lone racer practises
					resetVotes()
					workspace:SetAttribute("Podium", false)
					setState(idle())
				end
				resetTiming()
				if canPractice() then
					for _, p in Players:GetPlayers() do
						if alive(p) then
							spawnPracticeKart(p)
						end
					end
				end
			end
		end
		-- practice: everyone who is alive and not driving gets a kart
		if canPractice() then
			for _, p in Players:GetPlayers() do
				local held = spawnHold[p] and os.clock() < spawnHold[p]
				if not held and not karts[p] and alive(p) and p:GetAttribute("WantsKart") ~= false then
					spawnPracticeKart(p)
				end
			end
		elseif state == "Qualifying" and not qualiClosing then
			-- late arrivals and respawned drivers join the session
			for _, p in Players:GetPlayers() do
				local held = spawnHold[p] and os.clock() < spawnHold[p]
				if not held and not karts[p] and alive(p) then
					qualiSlot(p)
				end
			end
		end
		task.wait(0.25)
	end
end

----------------------------------------------------------------------------
-- Requests from clients
----------------------------------------------------------------------------
local function onRequest(player: Player, kind: unknown, arg: unknown)
	if kind == "Vote" then
		-- practice: change the track now; intermission: a vote for the next race
		if type(arg) ~= "string" or not circuits[arg] then
			return
		end
		if state == "Practice" then
			if arg ~= current.id and now() - lastTrackChange > R.TrackChangeCooldown then
				switchTo(arg)
			end
		elseif state == "Lobby" and serverMode == "room" then
			-- the waiting room: only the host picks; the circuit itself is
			-- swapped in when they press START
			if isHost(player) then
				roomPick = arg
				workspace:SetAttribute("RoomTrack", arg)
				LAPS = lapsFor(circuits[arg].spec, roomLength)
				workspace:SetAttribute("Laps", LAPS)
			end
		elseif state == "Intermission" then
			votes[player] = arg
			player:SetAttribute("Vote", arg)
			publishVotes()
		end
	elseif kind == "Length" then
		if type(arg) ~= "string" or not table.find(LENGTHS, arg) then
			return
		end
		if state == "Intermission" then
			lengthVotes[player] = arg
			player:SetAttribute("LengthVote", arg)
			publishVotes()
		elseif state == "Lobby" and isHost(player) then
			roomLength = arg
			LAPS = lapsFor(circuits[roomPick or current.id].spec, arg)
			workspace:SetAttribute("RoomLength", arg)
			workspace:SetAttribute("Laps", LAPS)
		end
	elseif kind == "Start" then
		-- the room's host starts the race on the track and length they
		-- picked, once every guest is ready
		if state == "Lobby" and isHost(player) and guestsReady() then
			local pick = roomPick
			if pick and pick ~= current.id then
				switchTo(pick)
			end
			LAPS = lapsFor(current.spec, roomLength)
			workspace:SetAttribute("Laps", LAPS)
			resetVotes()
			startQualifying()
		end
	elseif kind == "Ready" then
		if state == "Intermission" then
			ready[player] = arg == true
			player:SetAttribute("Ready", arg == true)
			publishVotes()
			checkAllReady()
		elseif state == "Lobby" and serverMode == "room" and not isHost(player) then
			ready[player] = arg == true
			player:SetAttribute("Ready", arg == true)
			publishVotes()
		end
	elseif kind == "Kick" then
		-- the room's host removes a player (who cannot come back to this room)
		local target = if type(arg) == "number" then Players:GetPlayerByUserId(arg) else nil
		if serverMode == "room" and isHost(player) and target and target ~= player then
			kicked[target.UserId] = true
			ready[target] = nil
			target:SetAttribute("Ready", nil)
			publishVotes()
			local f = RaceManager.onKick
			if f then
				f(target, "The host removed you from the room")
			end
		end
	elseif kind == "Setting" then
		if type(arg) == "table" then
			local a = arg :: any
			Stats.setSetting(player, a.key, a.value)
		end
	elseif kind == "Reset" then
		local t = now()
		if lastReset[player] and t - lastReset[player] < R.ResetCooldown then
			return
		end
		local k = karts[player]
		if not k or state == "Grid" or state == "Results" then
			return
		end
		lastReset[player] = t
		local pos: vector?, fwd: vector?, up: vector?
		if state == "Racing" and race and race.racers[player] and not race.racers[player].finished then
			pos, fwd, up = race:resetPose(player)
		elseif state == "Qualifying" and quali and quali.racers[player] then
			pos, fwd, up = quali:resetPose(player)
		elseif practice[player] then
			pos, fwd, up = practice[player]:resetPose(player)
		end
		if not (pos and fwd and up) then
			local c = k.PrimaryPart
			if not c then
				return
			end
			local idx = TrackMath.nearest(track, vec(c.Position))
			local smp = track.samples[idx]
			pos, fwd, up = smp.pos, smp.fwd, smp.up
		end
		if pos and fwd and up then
			pos, fwd, up = clearPose(k, pos, fwd, up)
			KartFactory.place(k, player, v3(pos), v3(fwd), v3(up), false)
			if kartNear(v3(pos), k) then
				k:SetAttribute("Ghost", true)
				ghostSince[k] = nil
			end
		end
		fire(player, "Reset", {})
	elseif kind == "Kart" then
		-- toggle: leave the kart to walk around, or ask for one again (practice only)
		if not canPractice() then
			return
		end
		if karts[player] then
			player:SetAttribute("WantsKart", false)
			removeKart(player)
		else
			player:SetAttribute("WantsKart", true)
			if alive(player) then
				spawnPracticeKart(player)
			end
		end
	end
end

----------------------------------------------------------------------------
-- Players and characters
----------------------------------------------------------------------------
local function onCharacter(player: Player, character: Model)
	spawnHold[player] = os.clock() + 1.5
	KartFactory.setCharacterParts(character, "Players", false)
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			local seated = karts[player] and true or false
			d.CollisionGroup = if seated then "Drivers" else "Players"
			d.Massless = seated
		end
	end)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		removeKart(player)
	end)
	freeze(player, state == "Lobby")
	task.wait(0.5)
	if player.Parent == nil or player.Character ~= character then
		return
	end
	-- back into the session after a respawn
	if state == "Racing" and race and race.racers[player] and not race.racers[player].finished then
		local pos, fwd, up = race:resetPose(player)
		if pos and fwd and up then
			spawnKart(player, v3(pos), v3(fwd), v3(up), false)
		end
	elseif state == "Qualifying" and not qualiClosing then
		qualiSlot(player)
	elseif canPractice() and player:GetAttribute("WantsKart") ~= false then
		spawnPracticeKart(player)
	end
end

local function onPlayer(player: Player)
	if serverMode == "room" and kicked[player.UserId] then
		local f = RaceManager.onKick
		if f then
			task.defer(f, player, "You were removed from this room")
		end
	end
	numberFor(player)
	player.CharacterAdded:Connect(function(c)
		onCharacter(player, c)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

local function onLeave(player: Player)
	removeKart(player)
	if race then
		race:removeRacer(player)
	end
	if quali then
		quali:removeRacer(player)
	end
	local i = table.find(racers, player)
	if i then
		table.remove(racers, i)
	end
	numbers[player] = nil
	lastReset[player] = nil
	spawnHold[player] = nil
	votes[player] = nil
	lengthVotes[player] = nil
	ready[player] = nil
	limits[player] = nil
	bests[player] = nil
	splits[player] = nil
	publishVotes()
	task.defer(checkAllReady)
end

-- A circuit built after start-up (it waits in ServerStorage until voted in).
function RaceManager.addCircuit(c: Circuit)
	if circuits[c.id] then
		return
	end
	circuits[c.id] = c
	table.insert(order, c.id)
	if c ~= current then
		c.folder.Name = c.id
		c.folder.Parent = storage
	end
	publishTracks()
	if wantTrack == c.id then
		wantTrack = nil
		if state == "Practice" or state == "Lobby" then
			switchTo(c.id)
		end
	end
end

-- What this server is for now. Called once at start-up; in Studio (no
-- teleports) again whenever the menu sends everyone somewhere else.
function RaceManager.setMode(role: Role)
	local m: ServerMode = role.mode
	serverMode = m :: ServerMode
	quali, race = nil, nil
	racers = {}
	qualiClosing = false
	finishDeadline = nil
	table.clear(practice)
	for _, p in Players:GetPlayers() do
		removeKart(p)
		for _, a in { "InRace", "Finished", "FinishTime", "Position", "Lap", "GridSlot", "WrongWay", "OffCourse", "QualiDone", "WantsKart" } do
			p:SetAttribute(a, nil)
		end
		spawnHold[p] = os.clock() + 1
		freeze(p, m == "lobby" or m == "room")
	end
	resetVotes()
	resetTiming()
	setConfetti(false)
	for _, a in { "QualiClosing", "FinishDeadline", "RaceStart", "LightsStart" } do
		workspace:SetAttribute(a, nil)
	end
	workspace:SetAttribute("Podium", false)
	if roomCode ~= (if m == "room" then role.code else nil) then
		table.clear(kicked)
	end
	roomCode = if m == "room" then role.code else nil
	roomHost = if m == "room" then role.host else nil
	roomLength = "Normal"
	workspace:SetAttribute("ServerMode", m)
	workspace:SetAttribute("RoomCode", roomCode)
	workspace:SetAttribute("RoomLength", if m == "room" then roomLength else nil)
	checkHost()
	workspace:SetAttribute("MinPlayers", minPlayers())
	wantTrack = nil
	local want = role.track
	if want and want ~= current.id then
		if circuits[want] then
			switchTo(want)
		else
			wantTrack = want
		end
	end
	LAPS = lapsFor(current.spec, roomLength)
	workspace:SetAttribute("Laps", LAPS)
	setState(idle())
	print(string.format("[A1KartRacing] server mode: %s%s", m, if roomCode then " " .. roomCode else ""))
end

function RaceManager.mode(): ServerMode
	return serverMode
end

-- `first` is the circuit already in workspace; `role` what this server is for.
function RaceManager.start(first: Circuit, remotes: Folder, role: Role?)
	local existing = ServerStorage:FindFirstChild("Circuits")
	if existing and existing:IsA("Folder") then
		storage = existing
	else
		local f = Instance.new("Folder")
		f.Name = "Circuits"
		f.Parent = ServerStorage
		storage = f
	end
	circuits[first.id] = first
	table.insert(order, first.id)
	activate(first)
	publishTracks()
	kartFolder = Instance.new("Folder")
	kartFolder.Name = "Karts"
	kartFolder.Parent = workspace
	raceEvent = remotes:WaitForChild("RaceEvent") :: RemoteEvent
	local request = remotes:WaitForChild("Request") :: RemoteEvent
	request.OnServerEvent:Connect(onRequest)

	RaceManager.setMode(role or { mode = "race" })

	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(onLeave)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	lastTick = now()
	RunService.Heartbeat:Connect(tick)
	task.spawn(stateLoop)
end

return RaceManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Rooms</string>
          <string name="Source"><![CDATA[--!strict
-- Private rooms: CREATE ROOM reserves a server and gives it a short number
-- code (Config.Lobby.RoomDigits); friends type the code to join. The code
-- lives in a shared map (code -> the server's access code and the host);
-- the room's own server renews it while it is open and frees it when it
-- closes. In the room the host picks the track and length and starts the
-- race (RaceManager, mode "room").

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local SharedStore = require(script.Parent:WaitForChild("SharedStore"))
local Session = require(script.Parent:WaitForChild("Session"))

local Rooms = {}

export type Deps = {
	rooms: SharedStore.Map,
	reserve: (Session.Role) -> string?,
	send: ({ Player }, Session.Role, string?) -> boolean,
}

local L = Config.Lobby
local deps: Deps? = nil

function Rooms.init(d: Deps)
	deps = d
end

-- Digits only, exactly RoomDigits of them (nil otherwise).
function Rooms.cleanCode(code: unknown): string?
	if type(code) ~= "string" and type(code) ~= "number" then
		return nil
	end
	local digits = string.gsub(tostring(code), "%D", "")
	return if #digits == L.RoomDigits then digits else nil
end

-- A new room with `player` as host. Returns the code, or nil and a message.
function Rooms.create(player: Player): (string?, string?)
	local d = deps
	if not d then
		return nil, "Rooms are not ready yet"
	end
	for _ = 1, 12 do
		local code = string.format("%0" .. L.RoomDigits .. "d", math.random(0, 10 ^ L.RoomDigits - 1))
		-- claim the code before reserving, so two rooms never share one
		local claimed = d.rooms.update(code, function(old)
			if old ~= nil then
				return nil
			end
			return { host = player.UserId, claiming = true }
		end, 120)
		if claimed ~= nil then
			local role: Session.Role = { mode = "room", code = code, host = player.UserId }
			local access = d.reserve(role)
			if not access then
				d.rooms.remove(code)
				return nil, "Couldn't make a room. Try again."
			end
			d.rooms.set(code, { access = access, host = player.UserId, name = player.DisplayName }, L.RoomTtl)
			d.send({ player }, role, access)
			return code, nil
		end
	end
	return nil, "Couldn't make a room. Try again."
end

-- Into the room with this code. Returns nil, or a message to show.
function Rooms.join(player: Player, raw: unknown): string?
	local d = deps
	if not d then
		return "Rooms are not ready yet"
	end
	local code = Rooms.cleanCode(raw)
	if not code then
		return string.format("Enter the %d-digit room code", L.RoomDigits)
	end
	local v = d.rooms.get(code)
	if type(v) ~= "table" or type(v.access) ~= "string" then
		return "No room with that code"
	end
	if type(v.banned) == "table" and table.find(v.banned, player.UserId) then
		return "You were removed from this room"
	end
	d.send({ player }, { mode = "room", code = code, host = v.host }, v.access)
	return nil
end

-- In the room's own server: the host removed this player; the code no
-- longer lets them in (the room server also sends them away if they come).
function Rooms.ban(code: string, userId: number)
	local d = deps
	if not d then
		return
	end
	d.rooms.update(code, function(old)
		if type(old) ~= "table" then
			return nil
		end
		local list = if type(old.banned) == "table" then old.banned else {}
		if not table.find(list, userId) then
			table.insert(list, userId)
		end
		old.banned = list
		return old
	end, L.RoomTtl)
end

-- In the room's own server: keep the code while the room is open.
function Rooms.keep(code: string)
	local d = deps
	if not d then
		return
	end
	local function renew()
		d.rooms.update(code, function(old)
			return if type(old) == "table" then old else nil
		end, L.RoomTtl)
	end
	task.spawn(function()
		while true do
			task.wait(L.RoomRefresh)
			renew()
		end
	end)
	game:BindToClose(function()
		d.rooms.remove(code)
	end)
end

return Rooms
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[--!strict
-- The circuit facility around the track: lighting, start gantry with start
-- lights, pit wall, garages and race control, paddock with spawn, grandstands,
-- the sponsor bridge, barriers with catch fences, marshal posts, floodlight
-- towers, the perimeter wall and the car park outside it.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TrackMath = require(Shared:WaitForChild("TrackMath"))
local TrackLayout = require(Shared:WaitForChild("TrackLayout"))
local Config = require(Shared:WaitForChild("Config"))
local Build = require(script.Parent:WaitForChild("Build"))

local Scenery = {}
local v3 = Build.v3

local DARK = Color3.fromRGB(30, 32, 36)
local CONCRETE = Color3.fromRGB(198, 198, 194)
local WHITE = Color3.fromRGB(240, 240, 240)
local ACCENT = Color3.fromRGB(255, 196, 0)
local RED = Color3.fromRGB(200, 34, 38)
local BLUE = Color3.fromRGB(28, 70, 160)
local FENCE = Color3.fromRGB(70, 74, 80)
local FONT = Enum.Font.GothamBlack

-- fictional sponsors only (TRACK = the circuit's own name)
local SPONSORS = { "A1 KART RACING", "GRIPLINE TYRES", "VOLT ENERGY", "SUNSET FUELS", "TRACK", "NORTHPEAK", "KESTREL OIL", "ORBIT TELECOM" }
local sponsorIndex = 0
local trackName = "A1 KART RACING"
local function nextSponsor(): string
	sponsorIndex += 1
	local s = SPONSORS[(sponsorIndex - 1) % #SPONSORS + 1]
	return if s == "TRACK" then trackName else s
end

-- Call before building a circuit's scenery.
function Scenery.begin(spec: any)
	sponsorIndex = 0
	trackName = string.upper(spec.Name)
end

local function label(parent: BasePart, face: Enum.NormalId, text: string, color: Color3, bg: Color3, ppm: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppm or 20
	gui.LightInfluence = 0.6
	gui.Parent = parent
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg
	t.BackgroundTransparency = 0
	t.TextColor3 = color
	t.Font = FONT
	t.TextScaled = true
	t.Text = text
	t.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.14, 0)
	pad.PaddingBottom = UDim.new(0.14, 0)
	pad.PaddingLeft = UDim.new(0.02, 0)
	pad.PaddingRight = UDim.new(0.02, 0)
	pad.Parent = t
end

-- Which face of a part whose CFrame looks along a->b points towards `target`.
local function faceTowards(cf: CFrame, target: Vector3): Enum.NormalId
	return if cf.RightVector:Dot(target - cf.Position) > 0 then Enum.NormalId.Right else Enum.NormalId.Left
end

-- Weather per circuit (TrackData `Sky`): "Sunny" (default), "Cloudy",
-- "Sunset" (low warm sun) or "Night" (dark sky; the circuit's own lamps
-- light the track, see Scenery.trackLights).
type Sky = { clock: number, brightness: number, exposure: number, density: number, haze: number, glare: number, color: Color3, decay: Color3, saturation: number, contrast: number, clouds: number, ambient: Color3, outdoor: Color3, tint: Color3?, lift: number? }
local DAY_AMBIENT = Color3.new(0.25, 0.25, 0.28)
local DAY_OUTDOOR = Color3.new(0.55, 0.55, 0.6)
local SKIES: { [string]: Sky } = {
	Sunny = {
		clock = 14.6, brightness = 2.8, exposure = 0.1,
		density = 0.22, haze = 0.6, glare = 0.15,
		color = Color3.fromRGB(205, 218, 232), decay = Color3.fromRGB(120, 138, 160),
		saturation = 0.1, contrast = 0.06, clouds = 0,
		ambient = DAY_AMBIENT, outdoor = DAY_OUTDOOR,
	},
	-- a bright English summer afternoon under broken cloud (the user found
	-- the darker first version hard to read on a phone)
	Cloudy = {
		clock = 15.2, brightness = 2.6, exposure = 0.2,
		density = 0.26, haze = 0.9, glare = 0.05,
		color = Color3.fromRGB(210, 216, 226), decay = Color3.fromRGB(150, 158, 172),
		saturation = 0, contrast = 0.05, clouds = 0.5,
		ambient = Color3.new(0.3, 0.3, 0.33), outdoor = Color3.new(0.62, 0.62, 0.67),
	},
	-- late afternoon: low golden sun and long shadows through the trees
	Sunset = {
		clock = 17.7, brightness = 2.2, exposure = 0.15,
		density = 0.3, haze = 1.6, glare = 0.4,
		color = Color3.fromRGB(240, 196, 150), decay = Color3.fromRGB(180, 120, 90),
		saturation = 0.15, contrast = 0.08, clouds = 0.25,
		ambient = Color3.fromRGB(70, 58, 52), outdoor = Color3.fromRGB(150, 120, 100),
		tint = Color3.fromRGB(255, 240, 225),
	},
	-- after dark, but a floodlit circuit: a dark blue sky and a road that is
	-- easy to read even on a phone screen (the first, darker version was
	-- not: little ambient light and a thick dark haze hid the far road)
	Night = {
		clock = 21.3, brightness = 1, exposure = 0.6,
		density = 0.22, haze = 0.3, glare = 0,
		color = Color3.fromRGB(84, 96, 132), decay = Color3.fromRGB(52, 60, 92),
		saturation = 0.05, contrast = 0.06, clouds = 0,
		ambient = Color3.fromRGB(105, 110, 130), outdoor = Color3.fromRGB(125, 132, 160),
		lift = 0.04,
	},
}

function Scenery.lighting(spec: any?)
	local sk = SKIES[spec and spec.Sky or "Sunny"] or SKIES.Sunny
	Lighting.ClockTime = sk.clock
	Lighting.Brightness = sk.brightness
	Lighting.ExposureCompensation = sk.exposure
	Lighting.Ambient = sk.ambient
	Lighting.OutdoorAmbient = sk.outdoor
	for _, c in Lighting:GetChildren() do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") or c:IsA("Sky") then
			c:Destroy()
		end
	end
	local atmo = Instance.new("Atmosphere")
	atmo.Density = sk.density
	atmo.Offset = 0.15
	atmo.Color = sk.color
	atmo.Decay = sk.decay
	atmo.Glare = sk.glare
	atmo.Haze = sk.haze
	atmo.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.3
	bloom.Size = 20
	bloom.Threshold = 1.5
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = sk.saturation
	cc.Contrast = sk.contrast
	cc.TintColor = sk.tint or Color3.new(1, 1, 1)
	cc.Brightness = sk.lift or 0
	cc.Parent = Lighting
	local old = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if sk.clouds > 0 then
		local clouds = old or Instance.new("Clouds")
		clouds.Cover = sk.clouds
		clouds.Density = 0.5
		clouds.Color = Color3.fromRGB(236, 238, 242)
		clouds.Parent = workspace.Terrain
	elseif old then
		old:Destroy()
	end
end

-- A wall along a polyline with an optional catch fence and sponsor boards
-- on the side facing `trackSide(mid)`.
local function wallLine(folder: Instance, pts: { Vector3 }, height: number, thick: number, color: Color3, material: Enum.Material, fence: number, boardsToward: ((Vector3) -> Vector3?)?, stripes: boolean?)
	for k = 1, #pts - 1 do
		local a, c = pts[k], pts[k + 1]
		local mid = (a + c) / 2
		local len = (c - a).Magnitude + 0.4
		if len < 0.5 then
			continue
		end
		local cf = CFrame.lookAt(mid + Vector3.new(0, height / 2 + TrackLayout.LawnY, 0), mid + Vector3.new(0, height / 2 + TrackLayout.LawnY, 0) + (c - a))
		local w = Build.part(folder, {
			Name = "Wall",
			Size = Vector3.new(thick, height, len),
			CFrame = cf,
			Color = if stripes then (if k % 2 == 0 then RED else WHITE) else color,
			Material = material,
			CustomPhysicalProperties = PhysicalProperties.new(2, 0.15, if stripes then 0.4 else 0.25, 1, 1),
		})
		if boardsToward and k % 4 == 2 and len > 6 then
			local target = boardsToward(mid)
			if target then
				label(w, faceTowards(cf, target), nextSponsor(), WHITE, if k % 8 == 2 then BLUE else RED, 10)
			end
		end
		if fence > 0 then
			local top = height + TrackLayout.LawnY
			Build.decor(folder, {
				Name = "Fence",
				Size = Vector3.new(0.12, fence, len),
				CFrame = CFrame.lookAt(mid + Vector3.new(0, top + fence / 2, 0), mid + Vector3.new(0, top + fence / 2, 0) + (c - a)),
				Color = FENCE,
				Material = Enum.Material.DiamondPlate,
				Transparency = 0.6,
				CastShadow = false,
			})
			if k % 2 == 1 then
				Build.decor(folder, {
					Name = "Post",
					Size = Vector3.new(0.35, fence + 0.4, 0.35),
					CFrame = CFrame.new(a + Vector3.new(0, top + fence / 2, 0)),
					Color = DARK,
					Material = Enum.Material.Metal,
				})
			end
		end
	end
end

-- Start gantry over the line, with five red start lights facing the grid.
function Scenery.gantry(track: TrackMath.Track, spec: any, parent: Instance): Model
	local s = track.samples[1]
	local model = Instance.new("Model")
	model.Name = "Gantry"
	local half = s.width / 2 + 3
	local height = 15
	for _, side in { -1, 1 } do
		local base = s.pos + s.right * (side * half)
		Build.part(model, {
			Name = "Pillar",
			Size = Vector3.new(1.6, height + 1, 1.6),
			CFrame = CFrame.fromMatrix(v3(base + s.up * (height / 2)), v3(s.right), v3(s.up), v3(-s.fwd)),
			Color = DARK,
			Material = Enum.Material.Metal,
		})
	end
	local beamPos = s.pos + s.up * height
	local beam = Build.part(model, {
		Name = "Beam",
		Size = Vector3.new(half * 2 + 1.6, 2.4, 1.4),
		CFrame = CFrame.fromMatrix(v3(beamPos), v3(s.right), v3(s.up), v3(-s.fwd)),
		Color = DARK,
		Material = Enum.Material.Metal,
	})
	label(beam, Enum.NormalId.Back, string.upper(spec.Name), WHITE, DARK)
	label(beam, Enum.NormalId.Front, "A1 KART RACING", ACCENT, DARK)
	local lights = Build.folder(model, "Lights")
	for k = 1, 5 do
		local lateral = (k - 3) * 3
		local center = beamPos + s.right * lateral - s.up * 2.6 - s.fwd * 0.2
		Build.part(model, {
			Name = "Pod",
			Size = Vector3.new(2.4, 2.6, 1.2),
			CFrame = CFrame.fromMatrix(v3(center), v3(s.right), v3(s.up), v3(-s.fwd)),
			Color = Color3.fromRGB(12, 12, 14),
			Material = Enum.Material.SmoothPlastic,
		})
		local lamp = Build.decor(lights, {
			Name = "Light" .. k,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 1.7, 1.7),
			CFrame = CFrame.fromMatrix(v3(center - s.fwd * 0.65), v3(-s.fwd), v3(s.up), v3(-s.right)),
			Color = Color3.fromRGB(40, 8, 8),
			Material = Enum.Material.SmoothPlastic,
		})
		lamp:SetAttribute("Index", k)
	end
	model.Parent = parent
	return model
end

-- The podium in the paddock: three steps facing +Z (towards the garages),
-- a backdrop, a camera mark for the podium view and a confetti cannon.
-- RaceManager puts the top three karts on Step1..3 after a race and turns
-- the confetti on (the ParticleEmitters in Confetti) while the results are up.
-- `mirrored`: the caller mirrors it across z afterwards (pits on the right),
-- so second and third swap sides here to stay on the winner's right and left.
-- `camDist`: how far in front of the steps the camera mark goes (30).
function Scenery.podium(parent: Instance, x: number, z: number, mirrored: boolean?, camDist: number?): Folder
	local folder = Build.folder(parent, "Podium")
	local base = 0.6
	Build.part(folder, {
		Name = "Plinth",
		Size = Vector3.new(36, base, 16),
		CFrame = CFrame.new(x, base / 2, z),
		Color = DARK,
		Material = Enum.Material.SmoothPlastic,
	})
	-- second on the winner's right (left as you look at it), third on the left
	type StepSpec = { place: number, dx: number, h: number, color: Color3 }
	local specs: { StepSpec } = {
		{ place = 1, dx = 0, h = 3.2, color = ACCENT },
		{ place = 2, dx = -11, h = 2.2, color = Color3.fromRGB(200, 204, 212) },
		{ place = 3, dx = 11, h = 1.4, color = Color3.fromRGB(196, 120, 60) },
	}
	for _, sp in specs do
		local pos = Vector3.new(x + (if mirrored then -sp.dx else sp.dx), base + sp.h / 2, z)
		local step = Build.part(folder, {
			Name = "Step" .. sp.place,
			Size = Vector3.new(10.5, sp.h, 9.5),
			CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)),
			Color = sp.color,
			Material = Enum.Material.SmoothPlastic,
		})
		-- the front (LookVector) face carries the number
		label(step, Enum.NormalId.Front, tostring(sp.place), WHITE, sp.color, 6)
	end
	-- backdrop with the circuit name
	local back = Build.part(folder, {
		Name = "Backdrop",
		Size = Vector3.new(40, 15, 1),
		CFrame = CFrame.new(x, 7.5, z - 7),
		Color = DARK,
		Material = Enum.Material.SmoothPlastic,
	})
	label(back, Enum.NormalId.Back, trackName .. "  -  A1 KART RACING", ACCENT, DARK, 6)
	-- chequered strip along the top of the backdrop
	for i = 0, 15 do
		for row = 0, 1 do
			Build.decor(folder, {
				Name = "Chequer",
				Size = Vector3.new(2.5, 1.2, 0.2),
				CFrame = CFrame.new(x - 18.75 + i * 2.5, 13.9 - row * 1.2, z - 6.4),
				Color = if (i + row) % 2 == 0 then WHITE else DARK,
				Material = Enum.Material.SmoothPlastic,
			})
		end
	end
	for _, dx in { -21, 21 } do
		Build.part(folder, {
			Name = "Pillar",
			Size = Vector3.new(2, 17, 2),
			CFrame = CFrame.new(x + dx, 8.5, z - 7),
			Color = RED,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	-- where the podium camera sits, looking at the steps
	local camPos = Vector3.new(x, 9, z + (camDist or 30))
	Build.decor(folder, {
		Name = "Camera",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.lookAt(camPos, Vector3.new(x, 4.5, z)),
		Transparency = 1,
		CastShadow = false,
	})
	-- confetti from above the steps
	local cannon = Build.decor(folder, {
		Name = "Confetti",
		Size = Vector3.new(30, 1, 6),
		CFrame = CFrame.new(x, 17, z - 2),
		Transparency = 1,
		CastShadow = false,
	})
	-- one emitter per colour (a colour sequence would fade every piece)
	for _, color in { ACCENT, RED, BLUE, WHITE } do
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Emitter"
		emitter.Enabled = false
		emitter.Rate = 20
		emitter.Lifetime = NumberRange.new(3, 4.5)
		emitter.Speed = NumberRange.new(4, 9)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Acceleration = Vector3.new(0, -6, 0)
		emitter.Drag = 1.2
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-200, 200)
		emitter.Size = NumberSequence.new(0.25)
		emitter.Color = ColorSequence.new(color)
		emitter.LightInfluence = 0.3
		emitter.Parent = cannon
	end
	return folder
end

-- Mirrors every part under `root` across the plane z = 0. The rotation is
-- M R Nx (M: the world mirror, Nx: a mirror of the part's own X axis), a
-- proper rotation, so blocks and wedges keep their shapes and signs still
-- read the right way round.
local function mirrorZ(root: Instance)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			local cf = d.CFrame
			local p, r, u, b = cf.Position, cf.RightVector, cf.UpVector, -cf.LookVector
			d.CFrame = CFrame.fromMatrix(
				Vector3.new(p.X, p.Y, -p.Z),
				Vector3.new(-r.X, -r.Y, r.Z),
				Vector3.new(u.X, u.Y, -u.Z),
				Vector3.new(b.X, b.Y, -b.Z)
			)
		end
	end
end

-- Pit wall, garages with race control, and the paddock with the spawn. Drawn
-- on the left of the main straight, then mirrored if the pits go on the
-- right (TrackLayout.pitSide).
function Scenery.pits(track: TrackMath.Track, spec: any, parent: Instance): SpawnLocation
	local P = TrackLayout.paddock(track, true)
	local folder = Build.folder(parent, "Pits")

	-- pit wall (concrete, fence on top, boards facing the main straight)
	local wallPts: { Vector3 } = {}
	for _, p in P.wall do
		table.insert(wallPts, v3(p))
	end
	wallLine(folder, wallPts, 3.4, 1.6, CONCRETE, Enum.Material.Concrete, 6, function(mid)
		return mid + Vector3.new(0, 0, 10)
	end)

	-- garages: a long low building, one open bay per team
	local g = P.garages
	local h1 = 12
	local depth = g.maxZ - g.minZ
	local cx = (g.minX + g.maxX) / 2
	local frontZ = g.maxZ
	Build.part(folder, { -- back wall
		Name = "GarageBack",
		Size = Vector3.new(g.maxX - g.minX, h1, 1),
		CFrame = CFrame.new(cx, h1 / 2, g.minZ + 0.5),
		Color = CONCRETE,
		Material = Enum.Material.Concrete,
	})
	Build.part(folder, { -- ground-floor ceiling / first floor
		Name = "GarageRoof",
		Size = Vector3.new(g.maxX - g.minX + 2, 1, depth + 2),
		CFrame = CFrame.new(cx, h1 + 0.5, (g.minZ + g.maxZ) / 2),
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
	local bays = math.max(1, math.floor((g.maxX - g.minX) / 28))
	local bayW = (g.maxX - g.minX) / bays
	local teamColors = { RED, BLUE, ACCENT, Color3.fromRGB(30, 160, 80), Color3.fromRGB(240, 110, 20), Color3.fromRGB(130, 60, 190), Color3.fromRGB(20, 180, 190), Color3.fromRGB(230, 70, 150) }
	for b = 0, bays do
		local x = g.minX + b * bayW
		Build.part(folder, {
			Name = "Pier",
			Size = Vector3.new(2, h1, depth),
			CFrame = CFrame.new(x, h1 / 2, (g.minZ + g.maxZ) / 2),
			Color = WHITE,
			Material = Enum.Material.SmoothPlastic,
		})
		if b < bays then
			local bx = x + bayW / 2
			Build.decor(folder, { -- dark interior
				Name = "Interior",
				Size = Vector3.new(bayW - 2, h1 - 2, 0.4),
				CFrame = CFrame.new(bx, (h1 - 2) / 2, g.minZ + 1.4),
				Color = Color3.fromRGB(46, 48, 54),
				Material = Enum.Material.SmoothPlastic,
			})
			local header = Build.decor(folder, {
				Name = "Header",
				Size = Vector3.new(bayW - 2, 2.2, 0.4),
				CFrame = CFrame.new(bx, h1 - 1.2, frontZ - 0.2),
				Color = teamColors[b % #teamColors + 1],
				Material = Enum.Material.SmoothPlastic,
			})
			label(header :: BasePart, Enum.NormalId.Back, "TEAM " .. (b + 1), WHITE, teamColors[b % #teamColors + 1], 12)
		end
	end
	-- hospitality level: glass front, set back
	Build.part(folder, {
		Name = "Upper",
		Size = Vector3.new(g.maxX - g.minX - 6, 7, depth - 6),
		CFrame = CFrame.new(cx, h1 + 4.5, (g.minZ + g.maxZ) / 2 - 3),
		Color = CONCRETE,
		Material = Enum.Material.Concrete,
	})
	Build.decor(folder, {
		Name = "Glass",
		Size = Vector3.new(g.maxX - g.minX - 6, 5.5, 0.3),
		CFrame = CFrame.new(cx, h1 + 4.6, g.maxZ - 5.9),
		Color = Color3.fromRGB(120, 170, 210),
		Material = Enum.Material.Glass,
		Transparency = 0.35,
	})
	local sign = Build.decor(folder, {
		Name = "Sign",
		Size = Vector3.new(math.min(140, g.maxX - g.minX - 20), 6, 0.6),
		CFrame = CFrame.new(cx, h1 + 11.5, g.maxZ - 6),
		Color = DARK,
		Material = Enum.Material.SmoothPlastic,
	})
	label(sign :: BasePart, Enum.NormalId.Back, string.upper(spec.Name), ACCENT, DARK, 8)

	-- race control tower at the pit exit end
	local tx = g.maxX + 12
	Build.part(folder, {
		Name = "Tower",
		Size = Vector3.new(14, 26, 14),
		CFrame = CFrame.new(tx, 13, g.minZ + depth / 2),
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
	Build.part(folder, {
		Name = "ControlRoom",
		Size = Vector3.new(18, 7, 18),
		CFrame = CFrame.new(tx, 29.5, g.minZ + depth / 2),
		Color = Color3.fromRGB(110, 160, 205),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
	})
	Build.part(folder, {
		Name = "TowerRoof",
		Size = Vector3.new(20, 1, 20),
		CFrame = CFrame.new(tx, 33.5, g.minZ + depth / 2),
		Color = DARK,
		Material = Enum.Material.Metal,
	})
	local towerSign = Build.decor(folder, {
		Name = "TowerSign",
		Size = Vector3.new(14, 4, 0.4),
		CFrame = CFrame.new(tx, 22, g.minZ + depth / 2 + 7.2),
		Color = RED,
		Material = Enum.Material.SmoothPlastic,
	})
	label(towerSign :: BasePart, Enum.NormalId.Back, "RACE CONTROL", WHITE, RED, 12)

	-- a sweeping wing-shaped roof over the whole pit building, overhanging
	-- the pit lane (TrackData PitStyle = "Wing")
	if spec.PitStyle == "Wing" then
		local lane = P.pitLane
		-- section through the roof, back (paddock side) to front (over the lane)
		local section = {
			Vector2.new(g.minZ - 6, h1 + 9),
			Vector2.new(g.minZ + 4, h1 + 14.5),
			Vector2.new(g.minZ + 14, h1 + 17),
			Vector2.new(g.maxZ, h1 + 17.6),
			Vector2.new(lane.minZ + 8, h1 + 16.6),
			Vector2.new(lane.maxZ - 3, h1 + 13.2),
		}
		-- from just past the first bay to the race control tower
		local x0, x1 = g.minX - 6, g.maxX + 1
		local len = x1 - x0
		local rcx = (x0 + x1) / 2
		for k = 1, #section - 1 do
			local a, b = section[k], section[k + 1]
			local mid = (a + b) / 2
			local d = b - a
			local cf = CFrame.lookAt(Vector3.new(rcx, mid.Y, mid.X), Vector3.new(rcx, mid.Y + d.Y, mid.X + d.X))
			Build.part(folder, {
				Name = "WingRoof",
				Size = Vector3.new(len, 0.8, d.Magnitude + 0.3),
				CFrame = cf,
				Color = Color3.fromRGB(236, 238, 240),
				Material = Enum.Material.SmoothPlastic,
			})
		end
		-- a dark leading edge over the lane; the back rests on slim columns
		-- (the front is cantilevered off the garage piers)
		local front = section[#section]
		Build.decor(folder, {
			Name = "WingEdge",
			Size = Vector3.new(len, 1.2, 0.5),
			CFrame = CFrame.new(rcx, front.Y - 0.2, front.X + 0.2),
			Color = DARK,
			Material = Enum.Material.Metal,
		})
		local cols = math.max(2, math.floor(len / 36))
		for c = 0, cols do
			local x = x0 + 6 + (len - 12) * c / cols
			Build.part(folder, {
				Name = "WingColumn",
				Size = Vector3.new(0.9, h1 + 10, 0.9),
				CFrame = CFrame.new(x, (h1 + 10) / 2, g.minZ - 3),
				Color = Color3.fromRGB(200, 202, 206),
				Material = Enum.Material.Metal,
			})
		end
		local nameBoard = Build.decor(folder, {
			Name = "WingSign",
			Size = Vector3.new(math.min(160, len - 40), 3.4, 0.4),
			CFrame = CFrame.new(rcx, section[4].Y + 2.4, g.maxZ - 2),
			Color = DARK,
			Material = Enum.Material.SmoothPlastic,
		})
		label(nameBoard :: BasePart, Enum.NormalId.Back, string.upper(spec.Name) .. "  -  THE WING", WHITE, DARK, 8)
	end

	-- paddock: podium, spawn and how-to-play board
	local plaza = P.plaza
	-- (a shallow paddock: the podium goes to the back, the camera stays in front of the garages)
	local plazaDepth = plaza.maxZ - plaza.minZ
	local podZ = math.max(10, math.min(24, plazaDepth - 32))
	Scenery.podium(folder, (plaza.minX + plaza.maxX) / 2 + 70, plaza.minZ + podZ, TrackLayout.pitSide(track) > 0, math.min(30, plazaDepth - podZ - 2))
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new((plaza.minX + plaza.maxX) / 2 - 20, 0.1, (plaza.minZ + plaza.maxZ) / 2)
	spawn.Color = ACCENT
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = folder
	local board = Build.part(folder, {
		Name = "InfoBoard",
		Size = Vector3.new(26, 14, 1),
		CFrame = CFrame.new((plaza.minX + plaza.maxX) / 2 + 12, 8, plaza.minZ + 14),
		Color = DARK,
		Material = Enum.Material.SmoothPlastic,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0.3
	gui.Parent = board
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundColor3 = DARK
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.RichText = true
	text.Text = table.concat({
		'<font color="#FFC400">HOW TO RACE</font>',
		"W / S   throttle and brake (hold S to reverse)",
		"A / D   steer",
		"R   back on track",
		"Mouse wheel / C   camera, zoom in for cockpit",
		"Right-drag   rotate camera     V   reset view",
		"Gamepad: RT / LT / left stick",
		"M   track, race length and READY before each race",
		"Practice until 2+ drivers are here, then qualifying sets the grid.",
		string.format("All 4 wheels past the kerb: %d warnings, then +%d s each.", Config.Race.TrackLimitWarnings, Config.Race.TrackLimitPenalty),
	}, "\n")
	text.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.06, 0)
	pad.PaddingBottom = UDim.new(0.06, 0)
	pad.Parent = text
	if TrackLayout.pitSide(track) > 0 then
		mirrorZ(folder)
	end
	return spawn
end

-- Tiered grandstand. `center` is the middle of the front edge; it rises away
-- from the track (opposite `facing`).
local function grandstand(folder: Instance, st: TrackLayout.Stand)
	local facing = v3(st.facing)
	local along = facing:Cross(Vector3.new(0, 1, 0))
	local base = v3(st.center)
	local tiers = 7
	local rowDepth = st.depth / tiers
	local seatColors = { BLUE, WHITE, RED }
	-- right-handed frame whose LookVector is `facing` (towards the track)
	local function frame(offsetBack: number, y: number): CFrame
		local p = base - facing * offsetBack + Vector3.new(0, y, 0)
		return CFrame.fromMatrix(p, along, Vector3.new(0, 1, 0), -facing)
	end
	-- up on a hillside: a concrete plinth from the lawn to the stand's floor
	if base.Y > 0.3 then
		local h = base.Y + TrackLayout.LawnY + 1
		Build.part(folder, {
			Name = "Plinth",
			Size = Vector3.new(st.length + 2, h, st.depth + 3),
			CFrame = frame(st.depth / 2 + 1, TrackLayout.LawnY - h / 2),
			Color = CONCRETE,
			Material = Enum.Material.Concrete,
		})
	end
	Build.part(folder, {
		Name = "FrontWall",
		Size = Vector3.new(st.length, 2, 1),
		CFrame = frame(0.5, 1 + TrackLayout.LawnY),
		Color = CONCRETE,
		Material = Enum.Material.Concrete,
	})
	for t = 0, tiers - 1 do
		local h = 1.6 * (t + 1) + 1
		Build.part(folder, {
			Name = "Tier",
			Size = Vector3.new(st.length, h, rowDepth),
			CFrame = frame(1 + rowDepth * (t + 0.5), h / 2 + TrackLayout.LawnY),
			Color = CONCRETE,
			Material = Enum.Material.Concrete,
		})
		Build.decor(folder, {
			Name = "Seats",
			Size = Vector3.new(st.length - 1, 0.6, rowDepth * 0.35),
			CFrame = frame(1 + rowDepth * (t + 0.3), h + 0.3 + TrackLayout.LawnY),
			Color = seatColors[t % #seatColors + 1],
			Material = Enum.Material.SmoothPlastic,
		})
	end
	-- roof on columns at the back
	local backOff = 1 + st.depth
	local roofY = 1.6 * tiers + 12
	local cols = math.max(2, math.floor(st.length / 30) + 1)
	for c = 0, cols - 1 do
		local u = -st.length / 2 + st.length * c / (cols - 1)
		local p = base - facing * backOff + along * u
		Build.part(folder, {
			Name = "Column",
			Size = Vector3.new(1.2, roofY, 1.2),
			CFrame = CFrame.new(p + Vector3.new(0, roofY / 2, 0)),
			Color = DARK,
			Material = Enum.Material.Metal,
		})
	end
	Build.part(folder, {
		Name = "Roof",
		Size = Vector3.new(st.length + 4, 0.8, st.depth + 6),
		CFrame = frame(1 + st.depth / 2, roofY) * CFrame.Angles(math.rad(-5), 0, 0),
		Color = WHITE,
		Material = Enum.Material.Metal,
	})
	local fascia = Build.decor(folder, {
		Name = "Fascia",
		Size = Vector3.new(st.length + 4, 3, 0.5),
		CFrame = frame(-1.6, roofY + 1.2),
		Color = DARK,
		Material = Enum.Material.SmoothPlastic,
	})
	-- the Front face (LookVector side) looks at the track
	label(fascia :: BasePart, Enum.NormalId.Front, nextSponsor() .. "  -  " .. st.name:upper(), ACCENT, DARK, 8)
end

-- Corner name boards (TrackData CornerBoards = true): one at the entry of
-- every named corner, outside the turn and set back behind the bands,
-- turned towards the drivers coming up to it.
function Scenery.cornerBoards(track: TrackMath.Track, grid: TrackLayout.Grid, zones: TrackLayout.Zones, spec: any, parent: Instance)
	if not spec.CornerBoards then
		return
	end
	local folder = Build.folder(parent, "CornerBoards")
	local last: string? = nil
	for _, c in TrackLayout.corners(track, spec.Segments) do
		local name = c.name
		if not name or name == last or string.find(name, "Straight") then
			last = name
			continue
		end
		last = name
		-- entry sample of the corner
		local first = c.mid
		for i, smp in track.samples do
			if smp.segment == c.first then
				first = i
				break
			end
		end
		local smp = track.samples[first]
		local side = if c.angle > 0 then -1 else 1 -- outside of the turn
		local b = if side < 0 then zones[first].left else zones[first].right
		local dir = TrackLayout.outward(smp, side)
		local base = vector.create(smp.pos.x, 0, smp.pos.z) + dir * (smp.width / 2 + TrackLayout.bandEnd(b) + 14)
		if not TrackLayout.clearOfRoads(grid, base, 10, first, 12) then
			continue
		end
		base = vector.create(base.x, TrackLayout.groundY(TrackLayout.ground(track, grid, zones), base.x, base.z), base.z)
		-- face a point on the road some way before the corner
		local before = track.samples[TrackMath.wrap(first - 12, track.n)].pos
		local p = v3(base)
		local toward = Vector3.new(before.x, p.Y, before.z) - p
		local cf = CFrame.lookAt(p + Vector3.new(0, 5, 0), p + Vector3.new(0, 5, 0) + toward.Unit)
		for _, x in { -5.5, 5.5 } do
			Build.part(folder, {
				Name = "BoardPost",
				Size = Vector3.new(0.5, 7, 0.5),
				CFrame = cf * CFrame.new(x, -1.5, 0.3),
				Color = DARK,
				Material = Enum.Material.Metal,
			})
		end
		local board = Build.part(folder, {
			Name = "CornerBoard",
			Size = Vector3.new(13, 3.2, 0.4),
			CFrame = cf * CFrame.new(0, 0.6, 0),
			Color = Color3.fromRGB(18, 92, 60),
			Material = Enum.Material.SmoothPlastic,
		})
		-- the Front face (LookVector side) faces the drivers
		label(board, Enum.NormalId.Front, string.upper(name), WHITE, Color3.fromRGB(18, 92, 60), 14)
	end
end

function Scenery.stands(track: TrackMath.Track, grid: TrackLayout.Grid, zones: TrackLayout.Zones, spec: any, parent: Instance)
	local folder = Build.folder(parent, "Grandstands")
	for _, st in TrackLayout.stands(track, grid, zones, spec.Segments) do
		grandstand(Build.folder(folder, st.name), st)
	end
end

-- Sponsor bridge over the longest straight (driven under).
function Scenery.bridge(track: TrackMath.Track, spec: any, parent: Instance)
	local i = TrackLayout.bridge(track, spec.Segments, spec.Bridge)
	if not i then
		return
	end
	local s = track.samples[i]
	local folder = Build.folder(parent, "Bridge")
	local half = s.width / 2 + 7
	local deckY = 16
	-- level frame even where the road is banked or on a slope
	local right = Vector3.new(s.right.x, 0, s.right.z).Unit
	local back = right:Cross(Vector3.new(0, 1, 0))
	local floor = s.pos.y + TrackLayout.LawnY - 1 -- towers sunk a little into the bank
	local top = s.pos.y + deckY
	for _, side in { -1, 1 } do
		local p = Vector3.new(s.pos.x, 0, s.pos.z) + right * (side * half)
		local h = top + 4 - floor
		Build.part(folder, {
			Name = "Tower",
			Size = Vector3.new(4, h, 6),
			CFrame = CFrame.fromMatrix(p + Vector3.new(0, floor + h / 2, 0), right, Vector3.new(0, 1, 0), back),
			Color = CONCRETE,
			Material = Enum.Material.Concrete,
		})
	end
	local deck = Build.part(folder, {
		Name = "Deck",
		Size = Vector3.new(half * 2 + 4, 4, 5),
		CFrame = CFrame.fromMatrix(v3(s.pos) + Vector3.new(0, deckY + 2, 0), right, Vector3.new(0, 1, 0), back),
		Color = DARK,
		Material = Enum.Material.SmoothPlastic,
	})
	-- Back faces drivers approaching (towards -fwd), Front faces the other way
	label(deck, Enum.NormalId.Back, "GRIPLINE TYRES", WHITE, RED, 10)
	label(deck, Enum.NormalId.Front, "VOLT ENERGY", ACCENT, DARK, 10)
	Build.decor(folder, {
		Name = "Rail",
		Size = Vector3.new(half * 2 + 4, 1.4, 0.2),
		CFrame = CFrame.fromMatrix(v3(s.pos) + Vector3.new(0, deckY + 4.7, 0), right, Vector3.new(0, 1, 0), back),
		Color = FENCE,
		Material = Enum.Material.DiamondPlate,
		Transparency = 0.4,
	})
end

-- Tyre walls (red/white with a catch fence) and concrete walls in the gaps.
function Scenery.barriers(track: TrackMath.Track, grid: TrackLayout.Grid, zones: TrackLayout.Zones, parent: Instance)
	local folder = Build.folder(parent, "Barriers")
	local function towardTrack(mid: Vector3): Vector3?
		local i = TrackLayout.nearest(grid, mid.X, mid.Z, 200)
		return if i then v3(track.samples[i].pos) else nil
	end
	for _, bar in TrackLayout.barriers(track, grid, zones) do
		local pts: { Vector3 } = {}
		for _, p in bar.points do
			table.insert(pts, v3(p))
		end
		if bar.kind == "tyres" then
			wallLine(folder, pts, 2.6, 2.2, WHITE, Enum.Material.Rubber, 7, towardTrack, true)
		else
			wallLine(folder, pts, 3.2, 1.4, CONCRETE, Enum.Material.Concrete, 5, nil)
		end
	end
end

-- Marshal posts: small booths with a flag on the inside of the big corners.
function Scenery.marshals(track: TrackMath.Track, grid: TrackLayout.Grid, zones: TrackLayout.Zones, spec: any, parent: Instance)
	local folder = Build.folder(parent, "Marshals")
	for _, post in TrackLayout.marshals(track, grid, zones, spec.Segments) do
		local p = v3(post.pos)
		local f = v3(post.facing)
		local cf = CFrame.lookAt(p + Vector3.new(0, 1.6, 0), p + Vector3.new(0, 1.6, 0) + f)
		Build.part(folder, {
			Name = "Booth",
			Size = Vector3.new(3, 3.2, 2.6),
			CFrame = cf,
			Color = WHITE,
			Material = Enum.Material.SmoothPlastic,
		})
		Build.decor(folder, {
			Name = "BoothRoof",
			Size = Vector3.new(3.6, 0.4, 3.2),
			CFrame = cf + Vector3.new(0, 1.8, 0),
			Color = Color3.fromRGB(240, 110, 20),
			Material = Enum.Material.SmoothPlastic,
		})
		local pole = p + f:Cross(Vector3.new(0, 1, 0)) * 2
		Build.decor(folder, {
			Name = "FlagPole",
			Size = Vector3.new(0.2, 6, 0.2),
			CFrame = CFrame.new(pole + Vector3.new(0, 3, 0)),
			Color = DARK,
			Material = Enum.Material.Metal,
		})
		Build.decor(folder, {
			Name = "Flag",
			Size = Vector3.new(0.05, 1.2, 1.8),
			CFrame = CFrame.lookAt(pole + Vector3.new(0, 5.3, 0), pole + Vector3.new(0, 5.3, 0) + f:Cross(Vector3.new(0, 1, 0))) * CFrame.new(0, 0, -0.9),
			Color = Color3.fromRGB(255, 214, 0),
			Material = Enum.Material.Fabric,
		})
	end
end

-- A lake in the most open part of the facility (TrackData `Lake`): a big
-- round pool with one or two smaller lobes for a natural outline, a sandy
-- shore round each. The water is drivable but slows a kart to a crawl, so it
-- goes in the Track folder (the wheels' rays see it). Returns the circles so
-- trees can keep off them.
export type Circle = { x: number, z: number, r: number }
function Scenery.water(track: TrackMath.Track, grid: TrackLayout.Grid, zones: TrackLayout.Zones, spec: any, trackFolder: Instance): { Circle }
	local pools: { Circle } = {}
	if not spec.Lake then
		return pools
	end
	local spots = TrackLayout.openGround(track, grid, zones, spec.Segments, 10, 70)
	local main = spots[1]
	if not main then
		return pools
	end
	local r = math.min(main.clear - 40, 150)
	if r < 30 then
		return pools
	end
	table.insert(pools, { x = main.pos.x, z = main.pos.z, r = r })
	-- lobes: open spots that overlap the main pool by about half their size
	for _, sp in spots do
		if #pools >= 3 then
			break
		end
		local lr = math.min(sp.clear - 40, r * 0.65)
		if lr >= 25 then
			local d = math.sqrt((sp.pos.x - main.pos.x) ^ 2 + (sp.pos.z - main.pos.z) ^ 2)
			local overlaps = d > r * 0.6 and d < r + lr * 0.5
			local apart = true
			for k = 2, #pools do
				local o = pools[k]
				if math.sqrt((sp.pos.x - o.x) ^ 2 + (sp.pos.z - o.z) ^ 2) < o.r + lr * 0.3 then
					apart = false
				end
			end
			if overlaps and apart then
				table.insert(pools, { x = sp.pos.x, z = sp.pos.z, r = lr })
			end
		end
	end
	local folder = Build.folder(trackFolder, "Lake")
	for _, c in pools do
		-- a flat disc: a cylinder lying with its axis vertical
		local up = CFrame.Angles(0, 0, math.rad(90))
		local shore = Build.part(folder, {
			Name = "Shore",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, c.r * 2 + 8, c.r * 2 + 8),
			CFrame = CFrame.new(c.x, TrackLayout.LawnY - 0.03, c.z) * up,
			Color = Color3.fromRGB(214, 196, 150),
			Material = Enum.Material.Sand,
		})
		shore:SetAttribute("Surface", "Gravel")
		local water = Build.part(folder, {
			Name = "Water",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, c.r * 2, c.r * 2),
			CFrame = CFrame.new(c.x, TrackLayout.LawnY - 0.01, c.z) * up,
			Color = Color3.fromRGB(38, 104, 148),
			Material = Enum.Material.Glass,
			Reflectance = 0.2,
			Transparency = 0.1,
			CastShadow = false,
		})
		water:SetAttribute("Surface", "Water")
	end
	return pools
end

-- Pine trees on the open ground (TrackData `Trees`), well away from the
-- road, the lake, the paddock and the grandstands.
function Scenery.trees(track: TrackMath.Track, grid: TrackLayout.Grid, zones: TrackLayout.Zones, spec: any, pools: { Circle }, parent: Instance)
	if not spec.Trees then
		return
	end
	local folder = Build.folder(parent, "Trees")
	local rand = TrackLayout.random(track.n * 7919 + 17)
	local placed: { vector } = {}
	local spots = TrackLayout.openGround(track, grid, zones, spec.Segments, 10, 50)
	local ground = TrackLayout.ground(track, grid, zones)
	for _, sp in spots do
		if #placed >= 80 then
			break
		end
		local p = sp.pos + vector.create((rand() - 0.5) * 10, 0, (rand() - 0.5) * 10)
		local ok = true
		for _, q in placed do
			if vector.magnitude(p - q) < 30 + rand() * 12 then
				ok = false
				break
			end
		end
		for _, c in pools do
			if math.sqrt((p.x - c.x) ^ 2 + (p.z - c.z) ^ 2) < c.r + 18 then
				ok = false
			end
		end
		if ok then
			table.insert(placed, p)
			local k = 0.8 + rand() * 0.6
			-- on the lawn or up an embankment, sunk a little so no root floats
			local gy = TrackLayout.groundY(ground, p.x, p.z)
			local base = v3(vector.create(p.x, if gy > 0 then gy - 0.4 else 0, p.z))
			Build.part(folder, {
				Name = "Trunk",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(9 * k, 1.4 * k, 1.4 * k),
				CFrame = CFrame.new(base + Vector3.new(0, 4.5 * k, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(92, 62, 40),
				Material = Enum.Material.Wood,
			})
			for layer = 1, 3 do
				local w = (10 - layer * 2.4) * k
				local h = (9 - layer * 1.4) * k
				local leaves = Build.decor(folder, {
					Name = "Needles",
					Size = Vector3.new(w, h, w),
					CFrame = CFrame.new(base + Vector3.new(0, (5 + layer * 4.2) * k, 0)) * CFrame.Angles(0, rand() * 6.28, 0),
					Color = if layer == 2 then Color3.fromRGB(40, 92, 52) else Color3.fromRGB(32, 78, 44),
					Material = Enum.Material.Grass,
				})
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = leaves
			end
		end
	end
end

-- Lamp posts along the track for night races (TrackData `TrackLights`):
-- one every ~55 studs, beyond the kerbs and run-off on the side with room,
-- each with a downward spot light.
function Scenery.trackLights(track: TrackMath.Track, grid: TrackLayout.Grid, zones: TrackLayout.Zones, spec: any, parent: Instance)
	if not spec.TrackLights then
		return
	end
	local folder = Build.folder(parent, "TrackLights")
	-- close enough (and wide enough) that the pools of light overlap and
	-- reach across the road
	local every = math.max(1, math.floor(55 / track.spacing + 0.5))
	local flip = 1
	for i = 1, track.n, every do
		local smp = track.samples[i]
		-- prefer the outside of a corner, else alternate sides
		local curv = TrackLayout.smoothCurv(track, i, 4)
		local first = if math.abs(curv) > 1 / 400 then (if curv > 0 then -1 else 1) else flip
		flip = -flip
		for _, side in { first, -first } do
			local b = if side < 0 then zones[i].left else zones[i].right
			local out = TrackLayout.outward(smp, side)
			local base = vector.create(smp.pos.x, 0, smp.pos.z) + out * (smp.width / 2 + TrackLayout.bandEnd(b) + 9)
			if TrackLayout.clearOfRoads(grid, base, 20, i, 20) then
				local gy = TrackLayout.groundY(TrackLayout.ground(track, grid, zones), base.x, base.z)
				local p = v3(vector.create(base.x, gy, base.z))
				local toward = v3(-out)
				local height = 14
				Build.part(folder, {
					Name = "LampPost",
					Size = Vector3.new(0.6, height, 0.6),
					CFrame = CFrame.new(p + Vector3.new(0, height / 2, 0)),
					Color = Color3.fromRGB(70, 74, 80),
					Material = Enum.Material.Metal,
				})
				local armMid = p + toward * 2.4 + Vector3.new(0, height - 0.3, 0)
				Build.decor(folder, {
					Name = "LampArm",
					Size = Vector3.new(0.35, 0.35, 5),
					CFrame = CFrame.lookAt(armMid, armMid + toward),
					Color = Color3.fromRGB(70, 74, 80),
					Material = Enum.Material.Metal,
				})
				local headPos = p + toward * 4.6 + Vector3.new(0, height - 0.6, 0)
				local head = Build.decor(folder, {
					Name = "Lamp",
					Size = Vector3.new(1.6, 0.4, 1),
					CFrame = CFrame.lookAt(headPos, headPos + toward),
					Color = Color3.fromRGB(255, 240, 210),
					Material = Enum.Material.Neon,
					CastShadow = false,
				})
				local light = Instance.new("SpotLight")
				light.Face = Enum.NormalId.Bottom
				light.Angle = 150
				light.Range = 60
				light.Brightness = 4
				light.Color = Color3.fromRGB(255, 238, 205)
				light.Shadows = false
				light.Parent = head
				break
			end
		end
	end
end

-- Perimeter wall around the facility, floodlight towers, and the car park
-- that stretches to the horizon outside it. At night the towers are lit.
function Scenery.perimeter(track: TrackMath.Track, parent: Instance, spec: any?)
	local f = TrackLayout.facility(track)
	local folder = Build.folder(parent, "Perimeter")
	local corners = {
		Vector3.new(f.minX, 0, f.minZ),
		Vector3.new(f.maxX, 0, f.minZ),
		Vector3.new(f.maxX, 0, f.maxZ),
		Vector3.new(f.minX, 0, f.maxZ),
	}
	local center = Vector3.new((f.minX + f.maxX) / 2, 0, (f.minZ + f.maxZ) / 2)
	for k = 1, 4 do
		local a, b = corners[k], corners[k % 4 + 1]
		local pts: { Vector3 } = {}
		local len = (b - a).Magnitude
		local segs = math.ceil(len / 24)
		for s = 0, segs do
			table.insert(pts, a + (b - a) * (s / segs))
		end
		-- sponsor boards on the inner face
		wallLine(folder, pts, 4, 1.6, CONCRETE, Enum.Material.Concrete, 8, function()
			return center
		end)
	end
	-- floodlight towers just inside the corners and along the long sides
	local towers = {
		Vector3.new(f.minX + 14, 0, f.minZ + 14),
		Vector3.new(f.maxX - 14, 0, f.minZ + 14),
		Vector3.new(f.maxX - 14, 0, f.maxZ - 14),
		Vector3.new(f.minX + 14, 0, f.maxZ - 14),
		Vector3.new((f.minX + f.maxX) / 2, 0, f.maxZ - 14),
		Vector3.new(f.minX + 14, 0, (f.minZ + f.maxZ) / 2),
		Vector3.new(f.maxX - 14, 0, (f.minZ + f.maxZ) / 2),
	}
	for _, p in towers do
		Build.part(folder, {
			Name = "LightPole",
			Size = Vector3.new(1.6, 46, 1.6),
			CFrame = CFrame.new(p + Vector3.new(0, 23, 0)),
			Color = Color3.fromRGB(150, 152, 158),
			Material = Enum.Material.Metal,
		})
		local head = CFrame.lookAt(p + Vector3.new(0, 47, 0), center + Vector3.new(0, 47, 0)) * CFrame.Angles(math.rad(-25), 0, 0)
		Build.decor(folder, {
			Name = "LightHead",
			Size = Vector3.new(8, 4, 1),
			CFrame = head,
			Color = DARK,
			Material = Enum.Material.Metal,
		})
		local night = spec ~= nil and spec.Sky == "Night"
		local lamps = Build.decor(folder, {
			Name = "Lamps",
			Size = Vector3.new(7, 3, 0.2),
			CFrame = head * CFrame.new(0, 0, -0.6),
			Color = Color3.fromRGB(255, 250, 230),
			Material = Enum.Material.Neon,
			Transparency = if night then 0 else 0.3,
		})
		if night then
			local light = Instance.new("SpotLight")
			light.Face = Enum.NormalId.Front
			light.Angle = 80
			light.Range = 60
			light.Brightness = 4
			light.Color = Color3.fromRGB(255, 246, 225)
			light.Shadows = false
			light.Parent = lamps
		end
	end
	-- car park outside the walls (asphalt tiles, Part size limit is 2048)
	local outer = 900
	local tiles = {
		{ f.minX - outer, f.maxX + outer, f.maxZ, f.maxZ + outer },
		{ f.minX - outer, f.maxX + outer, f.minZ - outer, f.minZ },
		{ f.minX - outer, f.minX, f.minZ, f.maxZ },
		{ f.maxX, f.maxX + outer, f.minZ, f.maxZ },
	}
	for _, t in tiles do
		local x0, x1, z0, z1 = t[1], t[2], t[3], t[4]
		local nx = math.ceil((x1 - x0) / 2000)
		local nz = math.ceil((z1 - z0) / 2000)
		for ix = 0, nx - 1 do
			for iz = 0, nz - 1 do
				local ax0 = x0 + (x1 - x0) * ix / nx
				local ax1 = x0 + (x1 - x0) * (ix + 1) / nx
				local az0 = z0 + (z1 - z0) * iz / nz
				local az1 = z0 + (z1 - z0) * (iz + 1) / nz
				Build.part(folder, {
					Name = "CarPark",
					Size = Vector3.new(ax1 - ax0, 1, az1 - az0),
					CFrame = CFrame.new((ax0 + ax1) / 2, -0.6, (az0 + az1) / 2),
					Color = Color3.fromRGB(96, 98, 104),
					Material = Enum.Material.Asphalt,
					CastShadow = false,
				})
			end
		end
	end
	-- parking bay lines in the car park near the paddock side
	for k = 0, 40 do
		local x = f.minX + 20 + k * 12
		if x > f.maxX - 20 then
			break
		end
		Build.strip(folder, Vector3.new(x, -0.09, f.minZ - 30), Vector3.new(x, -0.09, f.minZ - 12), Vector3.new(0, 1, 0), 0.4, { Color = WHITE, Material = Enum.Material.SmoothPlastic })
	end
end

return Scenery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source"><![CDATA[--!strict
-- What kind of server this is, and moving players between servers.
--
-- Every public server is a lobby. PRACTICE, RACE and PRIVATE ROOM reserve a
-- server of the same place (TeleportService:ReserveServerAsync), note what it
-- is for in a MemoryStore hash map under its PrivateServerId, and teleport the
-- players there with the same table as their teleport data. The reserved
-- server reads its role from that map when it starts (or from the first
-- player's teleport data if the map cannot be read). LOBBY sends a player to
-- any public server, which is a lobby.
--
-- Studio cannot teleport: there the one server switches to the new role in
-- place (Session.switchHere, set by init.server), with everyone in it.

local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local TrackData = require(Shared:WaitForChild("TrackData"))

local Session = {}

export type Mode = "lobby" | "practice" | "race" | "room"
export type Role = { mode: Mode, track: string?, code: string?, host: number? }

local L = Config.Lobby
local MODES: { [string]: boolean } = { lobby = true, practice = true, race = true, room = true }

-- set by init.server
Session.switchHere = nil :: ((Role) -> ())? -- Studio: become `role` in place
Session.beforeLeave = nil :: ((Player) -> ())? -- save the player's data before a teleport
Session.notify = nil :: ((Player, string, { [string]: any }) -> ())? -- a RaceEvent to one client

local pending: { [Player]: boolean } = {} -- teleport under way

-- A role from teleport data or the map (nil if it is not one).
function Session.clean(t: unknown): Role?
	if type(t) ~= "table" then
		return nil
	end
	local d = t :: any
	if type(d.mode) ~= "string" or not MODES[d.mode] then
		return nil
	end
	local role: Role = { mode = d.mode :: Mode }
	if type(d.track) == "string" and TrackData.Tracks[d.track] then
		role.track = d.track
	end
	if type(d.code) == "string" and #d.code <= 12 and string.match(d.code, "^%d+$") then
		role.code = d.code
	end
	if type(d.host) == "number" then
		role.host = d.host
	end
	return role
end

function Session.studio(): boolean
	return RunService:IsStudio()
end

-- A server made by ReserveServerAsync (not a public one, not a VIP server).
function Session.reserved(): boolean
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
end

-- Seconds on a clock every server agrees on (UTC wall time).
function Session.clock(): number
	return DateTime.now().UnixTimestampMillis / 1000
end

local serversMap: MemoryStoreHashMap? = nil
local function servers(): MemoryStoreHashMap?
	if not serversMap then
		local ok, m = pcall(function()
			return MemoryStoreService:GetHashMap("A1Servers")
		end)
		if ok then
			serversMap = m
		end
	end
	return serversMap
end

-- This server's role. A reserved server reads it from the map, or waits for
-- the first player and reads their teleport data.
function Session.resolve(): Role
	if not Session.reserved() then
		return { mode = "lobby" }
	end
	local map = servers()
	if map then
		for _ = 1, 3 do
			local ok, v = pcall(function()
				return (map :: MemoryStoreHashMap):GetAsync(game.PrivateServerId)
			end)
			if ok then
				local role = Session.clean(v)
				if role then
					return role
				end
				break -- read fine, nothing there
			end
			task.wait(1)
		end
	end
	local first = Players:GetPlayers()[1]
	if not first then
		first = Players.PlayerAdded:Wait()
	end
	local ok, join = pcall(function()
		return first:GetJoinData()
	end)
	local role = if ok and join then Session.clean(join.TeleportData) else nil
	return role or { mode = "race" }
end

-- A new reserved server that will be `role`. Returns its access code (nil
-- if it could not be made). Studio has no reserved servers.
function Session.reserve(role: Role): string?
	if Session.studio() then
		return "studio"
	end
	local ok, code, id = pcall(function()
		return TeleportService:ReserveServerAsync(game.PlaceId)
	end)
	if not ok or type(code) ~= "string" then
		warn("[Session] could not reserve a server:", code)
		return nil
	end
	local map = servers()
	if map and type(id) == "string" then
		local saved, err = pcall(function()
			(map :: MemoryStoreHashMap):SetAsync(id, role, L.ServerTtl)
		end)
		if not saved then
			warn("[Session] could not note the server's role (teleport data will do):", err)
		end
	end
	return code
end

local function tell(p: Player, kind: string, data: { [string]: any })
	local f = Session.notify
	if f then
		f(p, kind, data)
	end
end

-- The loading screen's line for where the players are going.
function Session.label(role: Role): string
	if role.mode == "practice" then
		local spec = TrackData.Tracks[role.track or ""]
		return "Practice  -  " .. (if spec then spec.Name else "Loading")
	elseif role.mode == "race" then
		return "Quick race  -  joining the other drivers"
	elseif role.mode == "room" then
		return "Private room " .. (role.code or "")
	end
	return "Back to the lobby"
end

function Session.busy(p: Player): boolean
	return pending[p] == true
end

-- Sends players to the reserved server with access code `code` (or, with no
-- code, to a public server: the lobby). Their clients show the loading
-- screen first; `notice` is shown to them when they get there. Returns false
-- if nobody could be sent.
function Session.send(players: { Player }, role: Role, code: string?, notice: string?): boolean
	local list: { Player } = {}
	for _, p in players do
		if p.Parent and not pending[p] then
			table.insert(list, p)
		end
	end
	if #list == 0 then
		return false
	end
	local info = { mode = role.mode, track = role.track, code = role.code, label = Session.label(role) }
	if Session.studio() then
		-- one server: everyone in it goes along
		for _, p in Players:GetPlayers() do
			tell(p, "Teleport", info)
		end
		task.delay(L.TeleportDelay, function()
			local f = Session.switchHere
			if f then
				f(role)
			end
		end)
		return true
	end
	for _, p in list do
		pending[p] = true
		tell(p, "Teleport", info)
	end
	task.spawn(function()
		-- the next server loads the player's data: save it first
		local save = Session.beforeLeave
		if save then
			for _, p in list do
				pcall(save, p)
			end
		end
		task.wait(L.TeleportDelay)
		local still: { Player } = {}
		for _, p in list do
			if p.Parent then
				table.insert(still, p)
			end
		end
		if #still == 0 then
			return
		end
		local opts = Instance.new("TeleportOptions")
		if code then
			opts.ReservedServerAccessCode = code
		end
		opts:SetTeleportData({ mode = role.mode, track = role.track, code = role.code, host = role.host, label = info.label, notice = notice })
		local ok, err = pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, still, opts)
		end)
		if not ok then
			warn("[Session] teleport failed:", err)
			for _, p in still do
				pending[p] = nil
				tell(p, "TeleportFailed", { message = "Couldn't move you to the next server. Try again." })
			end
		end
	end)
	return true
end

-- Back to a lobby (any public server).
function Session.toLobby(player: Player)
	Session.send({ player }, { mode = "lobby" }, nil)
end

-- A private room's host removed this player: off to a lobby, where they see
-- `message`. Studio has only this server, so there it is Player:Kick.
function Session.kick(player: Player, message: string)
	if Session.studio() then
		player:Kick(message)
		return
	end
	pending[player] = nil -- (even mid-teleport: this one wins)
	Session.send({ player }, { mode = "lobby" }, nil, message)
end

function Session.init()
	TeleportService.TeleportInitFailed:Connect(function(player: Player, _result: any, message: string)
		if pending[player] then
			pending[player] = nil
			warn("[Session] teleport failed for", player.Name, message)
			tell(player, "TeleportFailed", { message = "Couldn't move you to the next server. Try again." })
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		pending[p] = nil
	end)
end

return Session
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">SharedStore</string>
          <string name="Source"><![CDATA[--!strict
-- Small key/value maps shared by every server of the game (MemoryStore), or
-- plain tables in Studio, where one server is all there is. Every call is
-- protected: a failed MemoryStore request returns nil/false and the caller
-- tries again on its next pass.

local MemoryStoreService = game:GetService("MemoryStoreService")

local SharedStore = {}

export type Item = { key: string, value: any }
export type Map = {
	get: (key: string) -> any,
	set: (key: string, value: any, ttl: number) -> boolean,
	-- atomic read-modify-write: `fn` returns the new value, or nil to leave it
	-- alone. Returns the value written (nil if none was).
	update: (key: string, fn: (any) -> any, ttl: number) -> any,
	remove: (key: string) -> boolean,
	-- everything in the map (nil if it could not be read)
	list: () -> { Item }?,
}

local function warnOnce(map: string, err: any)
	warn(string.format("[SharedStore] %s: %s", map, tostring(err)))
end

-- A MemoryStore sorted map (it can be listed; keys are short strings).
function SharedStore.memory(name: string): Map
	local m: MemoryStoreSortedMap? = nil
	local function sm(): MemoryStoreSortedMap?
		if not m then
			local ok, v = pcall(function()
				return MemoryStoreService:GetSortedMap(name)
			end)
			if ok then
				m = v
			else
				warnOnce(name, v)
			end
		end
		return m
	end
	local map: Map = {
		get = function(key)
			local s = sm()
			if not s then
				return nil
			end
			local ok, v = pcall(function()
				return (s :: MemoryStoreSortedMap):GetAsync(key)
			end)
			return if ok then v else nil
		end,
		set = function(key, value, ttl)
			local s = sm()
			if not s then
				return false
			end
			local ok = pcall(function()
				(s :: MemoryStoreSortedMap):SetAsync(key, value, ttl)
			end)
			return ok
		end,
		update = function(key, fn, ttl)
			local s = sm()
			if not s then
				return nil
			end
			local ok, v = pcall(function()
				return (s :: MemoryStoreSortedMap):UpdateAsync(key, function(old)
					return fn(old)
				end, ttl)
			end)
			if not ok then
				warnOnce(name, v)
			end
			return if ok then v else nil
		end,
		remove = function(key)
			local s = sm()
			if not s then
				return false
			end
			local ok = pcall(function()
				(s :: MemoryStoreSortedMap):RemoveAsync(key)
			end)
			return ok
		end,
		list = function()
			local s = sm()
			if not s then
				return nil
			end
			local ok, items = pcall(function()
				return (s :: MemoryStoreSortedMap):GetRangeAsync(Enum.SortDirection.Ascending, 200)
			end)
			if not ok or type(items) ~= "table" then
				return nil
			end
			local out: { Item } = {}
			for _, it in items :: { any } do
				if type(it) == "table" and type(it.key) == "string" then
					table.insert(out, { key = it.key, value = it.value })
				end
			end
			return out
		end,
	}
	return map
end

-- The same in a table, with expiry on `clock`.
function SharedStore.localMap(clock: () -> number): Map
	local data: { [string]: { value: any, expires: number } } = {}
	local function live(key: string): any
		local e = data[key]
		if not e then
			return nil
		end
		if e.expires <= clock() then
			data[key] = nil
			return nil
		end
		return e.value
	end
	local function copy(v: any): any
		return if type(v) == "table" then table.clone(v) else v
	end
	local map: Map = {
		get = function(key)
			return copy(live(key))
		end,
		set = function(key, value, ttl)
			data[key] = { value = copy(value), expires = clock() + ttl }
			return true
		end,
		update = function(key, fn, ttl)
			local v = fn(copy(live(key)))
			if v ~= nil then
				data[key] = { value = copy(v), expires = clock() + ttl }
			end
			return v
		end,
		remove = function(key)
			data[key] = nil
			return true
		end,
		list = function()
			local keys = {}
			for k in data do
				if live(k) ~= nil then
					table.insert(keys, k)
				end
			end
			table.sort(keys)
			local out: { Item } = {}
			for _, k in keys do
				table.insert(out, { key = k, value = copy(data[k].value) })
			end
			return out
		end,
	}
	return map
end

return SharedStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Stats</string>
          <string name="Source"><![CDATA[--!strict
-- Wins and personal best laps (leaderstats + DataStore), and the track record.
-- Best laps and records are kept per circuit; the leaderboard and the HUD
-- show the ones for the circuit in use (Stats.setTrack).
-- DataStores fail in Studio unless "Enable Studio Access to API Services" is
-- on; everything still works for the session, it just is not saved.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Stats = {}

type Data = { wins: number, bests: { [string]: number }, settings: { [string]: any }, dirty: boolean }
type Record = { time: number?, name: string?, loaded: boolean }

local store: DataStore? = nil
local available = true
local data: { [Player]: Data } = {}
local records: { [string]: Record } = {}
local trackId = "Tampines"
local onRecord: ((name: string, time: number) -> ())? = nil

local STORE_NAME = "ApexKarting_v1" -- the game's first name; kept so saved bests survive the rename to A1 Kart Racing
-- the first circuit keeps the keys it had before there were several
local LEGACY_TRACK = "Tampines"

local function recordKey(id: string): string
	return if id == LEGACY_TRACK then "track_record" else "track_record_" .. id
end

local function tryStore(): DataStore?
	if not available then
		return nil
	end
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		return result
	end
	available = false
	warn("[Stats] DataStore unavailable, progress will not be saved:", result)
	return nil
end

function Stats.formatTime(t: number?): string
	if not t then
		return "--"
	end
	local m = math.floor(t / 60)
	local s = t - m * 60
	if m > 0 then
		return string.format("%d:%06.3f", m, s)
	end
	return string.format("%.3f", s)
end

local function recordOf(id: string): Record
	local r = records[id]
	if not r then
		r = { time = nil, name = nil, loaded = false }
		records[id] = r
	end
	return r
end

-- every circuit's record (Record_<id>, RecordBy_<id>: the lobby's cards
-- and RECORDS) and the one in use (TrackRecord, TrackRecordHolder: the HUD)
local function publishRecordOf(id: string)
	local r = recordOf(id)
	workspace:SetAttribute("Record_" .. id, r.time)
	workspace:SetAttribute("RecordBy_" .. id, r.name)
	if id == trackId then
		workspace:SetAttribute("TrackRecord", r.time)
		workspace:SetAttribute("TrackRecordHolder", r.name)
	end
end

local function publishRecord()
	publishRecordOf(trackId)
end

local function loadRecord(id: string)
	local r = recordOf(id)
	if r.loaded then
		return
	end
	r.loaded = true
	task.spawn(function()
		local ds = tryStore()
		if not ds then
			return
		end
		local ok, rec = pcall(function()
			return ds:GetAsync(recordKey(id))
		end)
		if ok and type(rec) == "table" then
			local t = tonumber(rec.time)
			-- a faster lap may already have been set this session
			if t and (not r.time or t < r.time) then
				r.time = t
				r.name = rec.name
			end
			publishRecordOf(id)
		end
	end)
end

local function showBest(player: Player)
	local d = data[player]
	local best = d and d.bests[trackId] or nil
	player:SetAttribute("PersonalBest", best)
	-- every circuit's best for the lobby (Best_<id>)
	if d then
		for id, t in d.bests do
			player:SetAttribute("Best_" .. id, t)
		end
	end
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Best Lap")
	if v and v:IsA("StringValue") then
		v.Value = Stats.formatTime(best)
	end
end

local function makeLeaderstats(player: Player, d: Data)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Value = d.wins
	wins.Parent = ls
	local best = Instance.new("StringValue")
	best.Name = "Best Lap"
	best.Value = Stats.formatTime(d.bests[trackId])
	best.Parent = ls
	ls.Parent = player
end

-- A setting value checked against Config.Settings (nil if not allowed).
local function cleanSetting(key: unknown, value: unknown): any
	if type(key) ~= "string" then
		return nil
	end
	local item = Config.Settings.Items[key]
	if not item then
		return nil
	end
	if type(item.default) == "boolean" then
		return if type(value) == "boolean" then value else nil
	elseif item.options then
		return if type(value) == "string" and table.find(item.options, value) then value else nil
	elseif type(value) == "number" and value == value then
		local v = math.clamp(value, item.min, item.max)
		return math.floor((v - item.min) / item.step + 0.5) * item.step + item.min
	end
	return nil
end

-- Player attributes S_<key> carry the settings to the client.
local function publishSettings(player: Player, d: Data)
	for key, item in Config.Settings.Items do
		local v = d.settings[key]
		if v == nil then
			v = item.default
		end
		player:SetAttribute("S_" .. key, v)
	end
end

local function load(player: Player)
	local d: Data = { wins = 0, bests = {}, settings = {}, dirty = false }
	local ds = tryStore()
	if ds then
		local ok, saved = pcall(function()
			return ds:GetAsync("p_" .. player.UserId)
		end)
		if ok and type(saved) == "table" then
			d.wins = tonumber(saved.wins) or 0
			if type(saved.bests) == "table" then
				for id, t in saved.bests do
					if type(id) == "string" and tonumber(t) then
						d.bests[id] = tonumber(t) :: number
					end
				end
			end
			-- saves from before there were several circuits
			if not d.bests[LEGACY_TRACK] and tonumber(saved.best) then
				d.bests[LEGACY_TRACK] = tonumber(saved.best) :: number
			end
			if type(saved.settings) == "table" then
				for key, value in saved.settings do
					local v = cleanSetting(key, value)
					if v ~= nil then
						d.settings[key :: string] = v
					end
				end
			end
		elseif not ok then
			warn("[Stats] load failed for", player.Name, saved)
		end
	end
	data[player] = d
	makeLeaderstats(player, d)
	showBest(player)
	publishSettings(player, d)
end

local function save(player: Player)
	local d = data[player]
	local ds = tryStore()
	if not (d and ds) then
		return
	end
	local ok, err = pcall(function()
		ds:SetAsync("p_" .. player.UserId, { wins = d.wins, best = d.bests[LEGACY_TRACK], bests = d.bests, settings = d.settings })
	end)
	if not ok then
		warn("[Stats] save failed for", player.Name, err)
	end
end

function Stats.init(recordCallback: (name: string, time: number) -> (), firstTrack: string?)
	onRecord = recordCallback
	trackId = firstTrack or trackId
	loadRecord(trackId)
	Players.PlayerAdded:Connect(load)
	for _, p in Players:GetPlayers() do
		task.spawn(load, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player)
		data[player] = nil
	end)
	game:BindToClose(function()
		for _, p in Players:GetPlayers() do
			save(p)
		end
	end)
end

-- Saves now (before a teleport: the next server loads what was saved). Yields.
function Stats.saveNow(player: Player)
	save(player)
end

-- Loads the records of these circuits too (the lobby shows them all).
function Stats.loadRecords(ids: { string })
	for _, id in ids do
		loadRecord(id)
		publishRecordOf(id)
	end
end

-- The circuit in use changed: show its record and everyone's best lap on it.
function Stats.setTrack(id: string)
	trackId = id
	loadRecord(id)
	publishRecord()
	for p in data do
		showBest(p)
	end
end

-- A player changed a setting (from the SETTINGS menu). Saved a little later
-- (several clicks in a row become one write) and when they leave.
function Stats.setSetting(player: Player, key: unknown, value: unknown)
	local d = data[player]
	local v = cleanSetting(key, value)
	if not d or v == nil then
		return
	end
	d.settings[key :: string] = v
	player:SetAttribute("S_" .. (key :: string), v)
	if not d.dirty then
		d.dirty = true
		task.delay(8, function()
			if data[player] == d and d.dirty then
				d.dirty = false
				save(player)
			end
		end)
	end
end

function Stats.addWin(player: Player)
	local d = data[player]
	if not d then
		return
	end
	d.wins += 1
	local ls = player:FindFirstChild("leaderstats")
	local wins = ls and ls:FindFirstChild("Wins")
	if wins and wins:IsA("IntValue") then
		wins.Value = d.wins
	end
	task.spawn(save, player)
end

-- Records a completed lap on the circuit in use. Returns true if it was a
-- personal best there.
function Stats.recordLap(player: Player, t: number): boolean
	local d = data[player]
	if not d or t < 10 then -- a lap under 10 s cannot be real
		return false
	end
	local id = trackId
	local pb = false
	local best = d.bests[id]
	if not best or t < best then
		d.bests[id] = t
		pb = true
		showBest(player)
		task.spawn(save, player)
	end
	local r = recordOf(id)
	if not r.time or t < r.time then
		r.time = t
		r.name = player.DisplayName
		publishRecordOf(id)
		if onRecord then
			onRecord(player.DisplayName, t)
		end
		local ds = tryStore()
		if ds then
			task.spawn(function()
				pcall(function()
					ds:UpdateAsync(recordKey(id), function(old)
						if type(old) == "table" and tonumber(old.time) and old.time <= t then
							return nil -- someone on another server was faster
						end
						return { time = t, name = player.DisplayName, userId = player.UserId }
					end)
				end)
			end)
		end
	end
	return pb
end

return Stats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">TrackBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds every drivable surface of the circuit: the asphalt, kerbs,
-- painted run-off, gravel, turf verges, the lawn, painted lines, the start/
-- finish line and grid boxes. Each surface part carries a "Surface"
-- attribute (see Config.Surfaces) that sets the tyre grip on it.
-- Straight stretches are merged into long quads to keep the part count low.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TrackMath = require(Shared:WaitForChild("TrackMath"))
local TrackLayout = require(Shared:WaitForChild("TrackLayout"))
local Config = require(Shared:WaitForChild("Config"))
local Build = require(script.Parent:WaitForChild("Build"))

local TrackBuilder = {}

local v3 = Build.v3
local UPV = Vector3.new(0, 1, 0)

local COLORS = {
	road = Color3.fromRGB(56, 56, 60),
	kerbRed = Color3.fromRGB(200, 30, 34),
	kerbWhite = Color3.fromRGB(238, 238, 238),
	runRed = Color3.fromRGB(178, 40, 44),
	runBlue = Color3.fromRGB(34, 74, 160),
	gravel = Color3.fromRGB(214, 196, 150),
	turf = Color3.fromRGB(46, 128, 60),
	lawnA = Color3.fromRGB(84, 150, 70),
	lawnB = Color3.fromRGB(74, 138, 62),
	slope = Color3.fromRGB(80, 142, 66),
	line = Color3.fromRGB(242, 242, 242),
	pitLane = Color3.fromRGB(66, 66, 72),
}

local function surface(p: Instance, name: string)
	p:SetAttribute("Surface", name)
end

-- Quads between consecutive samples along a band. `inner(i)`/`outer(i)` give
-- the band's two edge points at sample i (or nil to skip), `style(i)` returns
-- the props for the quad i..i+1 plus a merge key. Collinear quads with the
-- same key are merged into one. `tol`: how far (studs) a merged run's edges
-- may stray from the samples' edge points (default 0.03).
type Style = { key: string, props: { [string]: any }, surface: string?, height: number? }
local function ribbon(parent: Instance, n: number, inner: (number) -> Vector3?, outer: (number) -> Vector3?, style: (number) -> Style?, thickness: number, tol: number?)
	local straight = tol or 0.03
	local i = 1
	local done = 0
	local wrapI = function(k: number): number
		return TrackMath.wrap(k, n)
	end
	while done < n do
		local st = style(wrapI(i))
		local a0, b0 = inner(wrapI(i)), outer(wrapI(i))
		if not (st and a0 and b0) then
			i += 1
			done += 1
			continue
		end
		-- extend the run while the points stay on one straight line
		local j = i + 1
		local count = 1
		while done + count < n do
			local nxt = style(wrapI(j))
			local a2, b2 = inner(wrapI(j + 1)), outer(wrapI(j + 1))
			if not (nxt and nxt.key == st.key and a2 and b2) then
				break
			end
			local ok = true
			local la, lb = a2 - a0, b2 - b0
			local a1n, b1n = a2, b2
			for k = i + 1, j do
				local ak, bk = inner(wrapI(k)), outer(wrapI(k))
				if not (ak and bk) then
					ok = false
					break
				end
				local da = (ak - a0) - la * math.clamp((ak - a0):Dot(la) / math.max(la:Dot(la), 1e-9), 0, 1)
				local db = (bk - b0) - lb * math.clamp((bk - b0):Dot(lb) / math.max(lb:Dot(lb), 1e-9), 0, 1)
				if da.Magnitude > straight or db.Magnitude > straight then
					ok = false
					break
				end
				-- and flat: both edges straight is not enough where the road
				-- twists (banking winding on), the strip must not warp
				local mid = (ak + bk) / 2
				local normal = (b1n - a0):Cross(a1n - a0)
				if normal.Magnitude > 1e-6 and math.abs((mid - a0):Dot(normal.Unit)) > 0.002 then
					ok = false
					break
				end
			end
			if not ok then
				break
			end
			j += 1
			count += 1
		end
		local a1, b1 = inner(wrapI(j)), outer(wrapI(j))
		if a1 and b1 then
			local lift = Vector3.new(0, st.height or 0, 0)
			local w1, w2 = Build.triangle(parent, a0 + lift, b0 + lift, b1 + lift, thickness, UPV, st.props)
			local w3, w4 = Build.triangle(parent, a0 + lift, b1 + lift, a1 + lift, thickness, UPV, st.props)
			if st.surface then
				for _, w in { w1, w2, w3, w4 } do
					if w then
						surface(w, st.surface)
					end
				end
			end
		end
		done += count
		i = j
	end
end
TrackBuilder.ribbon = ribbon

function TrackBuilder.build(track: TrackMath.Track, zones: TrackLayout.Zones, parent: Instance): Folder
	local root = Build.folder(parent, "Track")
	local n = track.n
	local samples = track.samples

	local function edge(i: number, side: number, beyond: number): Vector3
		local smp = samples[i]
		local base = smp.pos + smp.right * (side * smp.width / 2)
		return v3(base + TrackLayout.outward(smp, side) * beyond)
	end

	-- on a raised road a crack between two neighbouring surfaces is a hole
	-- down to the lawn: merged runs keep to the sample edges much more tightly
	local raised = false
	for _, smp in samples do
		raised = raised or smp.pos.y > 0.3
	end
	local tol = if raised then 0.002 else nil

	-- Asphalt
	local road = Build.folder(root, "Road")
	local roadStyle: Style = {
		key = "road",
		props = { Material = Enum.Material.Asphalt, Color = COLORS.road, CastShadow = false },
		surface = "Asphalt",
	}
	-- twisted quads (a corner that climbs, banking winding on) are split into
	-- smaller pieces so the surface has no folds to rattle over; the rest go
	-- through the ribbon (straight runs merged)
	local split: { [number]: boolean } = {}
	for i = 1, n do
		local across, along = TrackLayout.roadSplit(track, i)
		if across * along > 1 then
			split[i] = true
			for _, t in TrackLayout.roadTriangles(track, i, across, along) do
				local w1, w2 = Build.triangle(road, v3(t[1]), v3(t[2]), v3(t[3]), TrackLayout.RoadThickness, UPV, roadStyle.props)
				for _, w in { w1, w2 } do
					if w then
						surface(w, "Asphalt")
					end
				end
			end
		end
	end
	ribbon(road, n, function(i)
		return edge(i, -1, 0)
	end, function(i)
		return edge(i, 1, 0)
	end, function(i)
		return if split[i] then nil else roadStyle
	end, TrackLayout.RoadThickness, tol)

	-- Bands beside the road on both sides
	local bands = Build.folder(root, "Bands")
	for _, side in { -1, 1 } do
		local function b(i: number): TrackLayout.Bands
			return if side < 0 then zones[i].left else zones[i].right
		end
		-- on a raised road, a turf base under all the bands, from the road edge
		-- out to the band end (where the embankment starts): the kerbs, run-off
		-- and gravel taper in and out between samples and leave thin slivers
		-- uncovered, harmless on the flat (the lawn is 0.1 below) but holes
		-- when the road is up on a hill
		-- (only where something tapers: a plain turf verge on both samples
		-- already covers the whole band, and the base would double the parts)
		local function plainTurf(i: number): boolean
			local bi = b(i)
			return bi.kerb <= 0 and bi.runoff <= bi.kerb + 0.5 and bi.gravelTo <= bi.gravelFrom and bi.turf > 0.3
		end
		if raised then
			ribbon(bands, n, function(i)
				return edge(i, side, 0)
			end, function(i)
				return edge(i, side, TrackLayout.bandEnd(b(i)))
			end, function(i)
				if plainTurf(i) and plainTurf(TrackMath.wrap(i + 1, n)) then
					return nil
				end
				return {
					key = "base",
					props = { Name = "TurfBase", Material = Enum.Material.Fabric, Color = COLORS.turf, CastShadow = false },
					surface = "Turf",
					-- well under the bands (no z-fighting from afar)
					height = -0.12,
				}
			end, 0.5, tol)
		end
		-- kerbs: a low crown, red/white per sample
		local kerbFolder = Build.folder(bands, if side < 0 then "KerbsLeft" else "KerbsRight")
		local kw, kh = TrackLayout.KerbWidth, TrackLayout.KerbHeight
		for i = 1, n do
			local j = TrackMath.wrap(i + 1, n)
			if b(i).kerb > 0 and b(j).kerb > 0 then
				local color = if i % 2 == 0 then COLORS.kerbRed else COLORS.kerbWhite
				local props = { Material = Enum.Material.SmoothPlastic, Color = color, CastShadow = false }
				local e0, e1 = edge(i, side, 0), edge(j, side, 0)
				local c0, c1 = edge(i, side, kw * 0.55) + Vector3.new(0, kh, 0), edge(j, side, kw * 0.55) + Vector3.new(0, kh, 0)
				local o0, o1 = edge(i, side, kw), edge(j, side, kw)
				for _, tri in { { e0, c0, c1 }, { e0, c1, e1 }, { c0, o0, o1 }, { c0, o1, c1 } } do
					local w1, w2 = Build.triangle(kerbFolder, tri[1], tri[2], tri[3], 0.5, UPV, props)
					for _, w in { w1, w2 } do
						if w then
							surface(w, "Kerb")
						end
					end
				end
			end
		end
		-- painted run-off: blue/red bands, alternating per sample
		ribbon(bands, n, function(i)
			local bi = b(i)
			return if bi.runoff > bi.kerb + 0.5 then edge(i, side, bi.kerb) else nil
		end, function(i)
			local bi = b(i)
			return if bi.runoff > bi.kerb + 0.5 then edge(i, side, bi.runoff) else nil
		end, function(i)
			return {
				key = "run" .. (i % 2),
				props = { Material = Enum.Material.Asphalt, Color = if i % 2 == 0 then COLORS.runRed else COLORS.runBlue, CastShadow = false },
				surface = "RunOff",
				height = -0.005,
			}
		end, 0.5, tol)
		-- gravel trap
		local gravelStyle: Style = {
			key = "gravel",
			props = { Material = Enum.Material.Sand, Color = COLORS.gravel, CastShadow = false },
			surface = "Gravel",
			height = -0.02,
		}
		ribbon(bands, n, function(i)
			local bi = b(i)
			return if bi.gravelTo > bi.gravelFrom then edge(i, side, bi.gravelFrom) else nil
		end, function(i)
			local bi = b(i)
			return if bi.gravelTo > bi.gravelFrom then edge(i, side, bi.gravelTo) else nil
		end, function()
			return gravelStyle
		end, 0.5, tol)
		-- turf verge where nothing else covers the first metres
		local turfStyle: Style = {
			key = "turf",
			props = { Material = Enum.Material.Fabric, Color = COLORS.turf, CastShadow = false },
			surface = "Turf",
			height = -0.01,
		}
		ribbon(bands, n, function(i)
			local bi = b(i)
			local from = math.max(bi.kerb, bi.runoff, bi.gravelTo)
			return if bi.turf > from + 0.3 then edge(i, side, from) else nil
		end, function(i)
			local bi = b(i)
			local from = math.max(bi.kerb, bi.runoff, bi.gravelTo)
			return if bi.turf > from + 0.3 then edge(i, side, bi.turf) else nil
		end, function()
			return turfStyle
		end, 0.5, tol)
	end

	-- White edge lines, inset from the edge
	local paint = Build.folder(root, "Paint")
	for i = 1, n do
		local s0 = samples[i]
		local s1 = samples[TrackMath.wrap(i + 1, n)]
		for _, side in { -1, 1 } do
			local inset = 1.0
			local a = s0.pos + s0.right * (side * (s0.width / 2 - inset))
			local c = s1.pos + s1.right * (side * (s1.width / 2 - inset))
			-- lie in the (possibly banked) road surface
			Build.strip(paint, v3(a), v3(c), v3(s0.up), 0.7, { Color = COLORS.line, Material = Enum.Material.SmoothPlastic })
		end
	end

	-- Start/finish: two rows of chequered squares across the road at sample 1
	do
		local s = samples[1]
		local cells = math.floor(s.width / 2)
		local size = s.width / cells
		local finish = Build.folder(root, "StartFinish")
		for row = 0, 1 do
			for c = 0, cells - 1 do
				local lateral = -s.width / 2 + (c + 0.5) * size
				local along = (row - 0.5) * size
				local pos = s.pos + s.right * lateral + s.fwd * along + s.up * 0.035
				local p = Build.decor(finish, {
					Size = Vector3.new(size, 0.05, size),
					CFrame = CFrame.fromMatrix(v3(pos), v3(s.right), v3(s.up), v3(-s.fwd)),
					Color = if (row + c) % 2 == 0 then Color3.new(0.05, 0.05, 0.05) else COLORS.line,
					Material = Enum.Material.SmoothPlastic,
					CastShadow = false,
				})
				p.Name = "Check"
			end
		end
	end

	-- Grid boxes: a white bar in front of each slot and short side ticks
	do
		local gridFolder = Build.folder(root, "Grid")
		for slot = 1, Config.Race.MaxRacers do
			local pos, fwd, up = TrackLayout.gridSlot(track, slot, Config.Race)
			local right = vector.cross(fwd, up)
			local front = pos + fwd * 3.8
			Build.strip(gridFolder, v3(front - right * 3.2), v3(front + right * 3.2), UPV, 0.5, { Color = COLORS.line, Material = Enum.Material.SmoothPlastic })
			for _, side in { -1, 1 } do
				local a = front + right * (side * 3.2)
				Build.strip(gridFolder, v3(a), v3(a - fwd * 2.5), UPV, 0.5, { Color = COLORS.line, Material = Enum.Material.SmoothPlastic })
			end
		end
	end

	return root
end

-- Grassy embankments under the raised parts of a circuit with hills
-- (TrackLayout.skirts): from the outer edge of the bands down to the lawn.
-- Drivable (grass grip), so they live in the Track folder.
function TrackBuilder.embankments(track: TrackMath.Track, ground: TrackLayout.Ground, root: Instance): Folder?
	if not ground.raised then
		return nil
	end
	local folder = Build.folder(root, "Embankments")
	local skirts = TrackLayout.skirts(ground)
	local style: Style = {
		key = "bank",
		props = { Material = Enum.Material.Grass, Color = COLORS.slope, CastShadow = false },
		surface = "Grass",
		height = -0.04,
	}
	-- inside tight corners a fan to one hub replaces the converging strips
	local pockets = TrackLayout.pockets(ground, skirts)
	for _, side in { -1, 1 } do
		local function get(i: number): TrackLayout.Skirt?
			return if side < 0 then skirts[i].left else skirts[i].right
		end
		local skip = if side < 0 then pockets.skipLeft else pockets.skipRight
		ribbon(folder, track.n, function(i)
			local k = get(i)
			return if k then v3(k.top) else nil
		end, function(i)
			local k = get(i)
			return if k then v3(k.toe) else nil
		end, function(i)
			return if get(i) and get(TrackMath.wrap(i + 1, track.n)) and not skip[i] then style else nil
		end, 1)
	end
	local lift = Vector3.new(0, style.height or 0, 0)
	for _, tri in pockets.tris do
		local w1, w2 = Build.triangle(folder, v3(tri[1]) + lift, v3(tri[2]) + lift, v3(tri[3]) + lift, 1, UPV, style.props)
		for _, w in { w1, w2 } do
			if w then
				surface(w, "Grass")
			end
		end
	end
	return folder
end

-- Where the circuit crosses itself (TrackLayout.crossings): a concrete girder
-- under the bridge span with parapets along both sides, and retaining walls
-- along the road that passes underneath. Solid, so they live in the Track
-- folder with the rest of what the karts touch.
function TrackBuilder.crossings(track: TrackMath.Track, ground: TrackLayout.Ground, root: Instance): Folder?
	local list = TrackLayout.crossings(ground)
	if #list == 0 then
		return nil
	end
	local folder = Build.folder(root, "Crossings")
	local samples = track.samples
	local n = track.n
	local concrete = { Material = Enum.Material.Concrete, Color = Color3.fromRGB(176, 172, 164) }
	local girderColor = Color3.fromRGB(70, 92, 128)
	for _, c in list do
		local bridge = Build.folder(folder, "Bridge")
		-- the span plus a few samples either side for the parapets
		local first, last = c.deck[1], c.deck[#c.deck]
		local PAD = 3
		for k = -PAD, (last - first) % n + PAD - 1 do
			local i = TrackMath.wrap(first + k, n)
			local j = TrackMath.wrap(i + 1, n)
			local a, b = samples[i], samples[j]
			local onDeck = c.deckSet[i] or c.deckSet[j]
			local dir = v3(b.pos - a.pos)
			local look = Vector3.new(dir.X, 0, dir.Z).Unit
			local right = look:Cross(UPV)
			local len = dir.Magnitude + 0.3
			local el = math.max(ground.edges[i].left.foot, ground.edges[j].left.foot)
			local er = math.max(ground.edges[i].right.foot, ground.edges[j].right.foot)
			local mid = v3((a.pos + b.pos) / 2)
			local roadY = math.min(a.pos.y, b.pos.y)
			local under = roadY - TrackLayout.RoadThickness - TrackLayout.GirderDepth
			local cf = CFrame.fromMatrix(Vector3.new(mid.X, 0, mid.Z), right, UPV, -look)
			if onDeck then
				local w = el + er + 2.4
				Build.part(bridge, {
					Name = "Girder",
					Size = Vector3.new(w, TrackLayout.GirderDepth, len),
					CFrame = cf * CFrame.new((er - el) / 2, under + TrackLayout.GirderDepth / 2, 0),
					Color = girderColor,
					Material = Enum.Material.Concrete,
					CastShadow = true,
				})
			end
			-- parapets: over the span they run down the girder's side too
			local top = math.max(a.pos.y, b.pos.y) + TrackLayout.ParapetHeight
			local bottom = if onDeck then under else roadY - 1
			for _, side in { -1, 1 } do
				local off = if side < 0 then -(el + 0.6) else er + 0.6
				local p = Build.part(bridge, {
					Name = "Parapet",
					Size = Vector3.new(1.2, top - bottom, len),
					CFrame = cf * CFrame.new(off, (top + bottom) / 2, 0),
					Color = concrete.Color,
					Material = concrete.Material,
				})
				p:SetAttribute("Surface", "Concrete")
			end
		end
		-- retaining walls: one sloped-top panel between each pair of neighbours
		local trench = Build.folder(folder, "Trench")
		local at: { [number]: { [number]: TrackLayout.Wall } } = { [-1] = {}, [1] = {} }
		for _, w in c.walls do
			at[w.side][w.i] = w
		end
		for _, side in { -1, 1 } do
			for i, w in at[side] do
				local nx = at[side][TrackMath.wrap(i + 1, n)]
				if not nx then
					continue
				end
				local a0 = Vector3.new(w.p.x, w.bottom, w.p.z)
				local a1 = Vector3.new(w.p.x, w.top, w.p.z)
				local b0 = Vector3.new(nx.p.x, nx.bottom, nx.p.z)
				local b1 = Vector3.new(nx.p.x, nx.top, nx.p.z)
				local toRoad = -v3(w.dir)
				Build.triangle(trench, a0, a1, b1, TrackLayout.TrenchWall, toRoad, { Name = "Wall", Material = concrete.Material, Color = concrete.Color })
				Build.triangle(trench, a0, b1, b0, TrackLayout.TrenchWall, toRoad, { Name = "Wall", Material = concrete.Material, Color = concrete.Color })
			end
		end
	end
	return folder
end

-- Striped lawn over the whole facility, the pit lane and the paddock floor.
-- Lives in the Track folder so the wheels find grip on it too.
function TrackBuilder.ground(track: TrackMath.Track, root: Instance)
	local folder = Build.folder(root, "Ground")
	local f = TrackLayout.facility(track)
	local stripe = 40
	local z = f.minZ
	local k = 0
	while z < f.maxZ do
		local w = math.min(stripe, f.maxZ - z)
		local p = Build.part(folder, {
			Name = "Lawn",
			Size = Vector3.new(f.maxX - f.minX, 1, w),
			CFrame = CFrame.new((f.minX + f.maxX) / 2, TrackLayout.LawnY - 0.5, z + w / 2),
			Color = if k % 2 == 0 then COLORS.lawnA else COLORS.lawnB,
			Material = Enum.Material.Grass,
			CastShadow = false,
		})
		surface(p, "Grass")
		z += w
		k += 1
	end
	local P = TrackLayout.paddock(track)
	local lane = P.pitLane
	local pl = Build.part(folder, {
		Name = "PitLane",
		Size = Vector3.new(lane.maxX - lane.minX, 1, lane.maxZ - lane.minZ),
		CFrame = CFrame.new((lane.minX + lane.maxX) / 2, -0.5, (lane.minZ + lane.maxZ) / 2),
		Color = COLORS.pitLane,
		Material = Enum.Material.Asphalt,
		CastShadow = false,
	})
	surface(pl, "PitLane")
	local plaza = P.plaza
	local pz = Build.part(folder, {
		Name = "Paddock",
		Size = Vector3.new(plaza.maxX - plaza.minX, 1, plaza.maxZ - plaza.minZ),
		CFrame = CFrame.new((plaza.minX + plaza.maxX) / 2, -0.5, (plaza.minZ + plaza.maxZ) / 2),
		Color = Color3.fromRGB(150, 150, 152),
		Material = Enum.Material.Concrete,
		CastShadow = false,
	})
	surface(pz, "Concrete")
	-- pit lane markings: speed-limit line along the wall side and a box per garage
	local paint = folder
	local lineProps = { Color = COLORS.line, Material = Enum.Material.SmoothPlastic }
	-- (the garage side of the lane: its far edge from the main straight)
	local back = if P.side < 0 then lane.minZ else lane.maxZ
	local inward = -P.side
	local zLine = back + inward * 1.2
	Build.strip(paint, Vector3.new(lane.minX + 2, 0, zLine), Vector3.new(lane.maxX - 2, 0, zLine), UPV, 0.5, lineProps)
	local g = P.garages
	local bays = math.max(1, math.floor((g.maxX - g.minX) / 28))
	local bayW = (g.maxX - g.minX) / bays
	for b = 0, bays do
		local x = g.minX + b * bayW
		Build.strip(paint, Vector3.new(x, 0, back + inward * 1.5), Vector3.new(x, 0, back + inward * 9), UPV, 0.4, lineProps)
	end
	return folder
end

return TrackBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="28">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="29">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">120</float>
      <float name="CharacterJumpHeight">7.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="30">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="31">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Client entry point.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remotes = ReplicatedStorage:WaitForChild("Remotes") :: Folder
-- wait until the server has built the circuit (rays and the minimap need it)
if not workspace:GetAttribute("TrackReady") then
	workspace:GetAttributeChangedSignal("TrackReady"):Wait()
end

local Settings = require(script:WaitForChild("Settings"))
local Sfx = require(script:WaitForChild("Sfx"))
local SettingsMenu = require(script:WaitForChild("SettingsMenu"))
local Input = require(script:WaitForChild("Input"))
local KartController = require(script:WaitForChild("KartController"))
local KartVisuals = require(script:WaitForChild("KartVisuals"))
local ChaseCamera = require(script:WaitForChild("ChaseCamera"))
local Hud = require(script:WaitForChild("Hud"))
local Menu = require(script:WaitForChild("Menu"))

Settings.init(remotes)
Sfx.init()
Input.init()
KartController.init(remotes)
KartVisuals.init()
ChaseCamera.init()
Hud.init(remotes)
SettingsMenu.init()
Menu.init(remotes)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ChaseCamera</string>
            <string name="Source"><![CDATA[--!strict
-- The driving camera.
--
--   zoom     mouse wheel, pinch, or D-pad up/down moves the camera from far
--            behind the kart all the way in; past the closest chase distance
--            it drops into the cockpit (first person, like a sim racer)
--   presets  C (gamepad X, CAM button) cycles cockpit / near / far
--   orbit    behind the kart: hold the right mouse button and drag (or the
--            right stick, or drag a finger on an empty part of the screen) to
--            swing the camera anywhere around the kart; it stays there and
--            keeps following the kart. V (gamepad R3) puts it back behind.
--   look     in the cockpit the same controls turn your head; the view
--            recentres when you let go
--
-- The cockpit view comes from CockpitRig (smoothed tilt, head sway and
-- glance, no bounce-back). The avatar's own head and arms are hidden there and
-- KartVisuals draws arms with gloves on the wheel instead. When not driving
-- the normal Roblox camera is used (optionally following another racer).
-- After a race everyone looks at the podium for a few seconds. The view you
-- start in is a setting (Cockpit / Near / Far).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CockpitRig = require(Shared:WaitForChild("CockpitRig"))
local KartController = require(script.Parent:WaitForChild("KartController"))
local KartVisuals = require(script.Parent:WaitForChild("KartVisuals"))
local Input = require(script.Parent:WaitForChild("Input"))
local Settings = require(script.Parent:WaitForChild("Settings"))

local ChaseCamera = {}

local player = Players.LocalPlayer
local C = Config.Camera
local CP = C.Cockpit

-- zoom: 0 means cockpit, otherwise the chase distance
local zoomTarget = C.Distance
local zoom = C.Distance
local yawDir: Vector3? = nil
local fov = C.FovMin
local active = false
local spectateTarget: BasePart? = nil

-- behind the kart: orbit angles that stay put (radians)
local orbitYaw, orbitPitch = 0, 0
local recentering = false
local sinceOrbit = 0
-- in the cockpit: head look that springs back (radians)
local lookYaw, lookPitch = 0, 0

-- who is dragging the view right now
local mouseDragging = false
local touchDrag: InputObject? = nil
local stick = Vector2.zero

local rig = CockpitRig.new()

-- smooth cut between cockpit and chase
local blendFrom: CFrame? = nil
local blendFov = 70
local blendT = 1
local BLEND_TIME = 0.22

-- parts of our avatar hidden in the cockpit
local hidden: { [BasePart]: boolean } = {}
local lastHideScan = 0

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function refreshFilter()
	local list: { Instance } = { workspace.Terrain }
	local circuit = workspace:FindFirstChild("Circuit")
	if circuit then
		table.insert(list, circuit)
	end
	rayParams.FilterDescendantsInstances = list
end

function ChaseCamera.isCockpit(): boolean
	return zoomTarget == 0
end

function ChaseCamera.zoom(): number
	return zoomTarget
end

function ChaseCamera.mode(): string
	return if zoomTarget == 0 then "Cockpit" else "Chase"
end

-- Orbit angles behind the kart (radians), for tests and the HUD.
function ChaseCamera.orbit(): (number, number)
	return orbitYaw, orbitPitch
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-3 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

local function vec(v: Vector3): vector
	return (v :: any) :: vector
end
local function v3(v: vector): Vector3
	return (v :: any) :: Vector3
end

local function startBlend()
	local camera = workspace.CurrentCamera
	if camera and active then
		blendFrom = camera.CFrame
		blendFov = camera.FieldOfView
		blendT = 0
	end
end

local function setZoom(target: number)
	local wasCockpit = zoomTarget == 0
	if target < C.MinDistance - 1e-6 then
		target = 0
	else
		target = math.clamp(target, C.MinDistance, C.MaxDistance)
	end
	zoomTarget = target
	if (target == 0) ~= wasCockpit then
		if target ~= 0 then
			zoom = target -- leave the cockpit straight at the chosen distance
		else
			rig = CockpitRig.new()
		end
		lookYaw, lookPitch = 0, 0
		startBlend()
	end
end

-- One step in (negative) or out (positive), as a mouse-wheel notch.
function ChaseCamera.zoomStep(notches: number)
	if notches == 0 then
		return
	end
	if zoomTarget == 0 then
		if notches > 0 then
			setZoom(C.MinDistance)
		end
		return
	end
	local target = zoomTarget * C.ZoomStep ^ notches
	if notches < 0 and zoomTarget <= C.MinDistance + 1e-6 then
		target = 0
	end
	setZoom(target)
end

function ChaseCamera.cycle()
	local presets = C.Presets
	local nextIndex = 1
	for i, z in presets do
		if math.abs(z - zoomTarget) < 0.5 or (zoomTarget > 0 and z > zoomTarget) then
			nextIndex = if math.abs(z - zoomTarget) < 0.5 then i % #presets + 1 else i
			break
		end
	end
	setZoom(presets[nextIndex])
end

-- Swing the camera back behind the kart (smoothly).
function ChaseCamera.recenter()
	recentering = true
end

-- Camera elevation behind the kart before any orbit (radians).
local function baseElevation(): number
	local d = math.max(zoomTarget, C.MinDistance)
	return math.atan2(C.HeightBase + C.HeightPerStud * d, d)
end

local function clampOrbitPitch(p: number): number
	local base = baseElevation()
	return math.clamp(p, math.rad(C.OrbitPitchMin) - base, math.rad(C.OrbitPitchMax) - base)
end

-- Turn the view by a drag of (dx, dy) pixels at `sens` degrees per pixel.
local function drag(dx: number, dy: number, sens: number)
	local s = math.rad(sens)
	if zoomTarget == 0 then
		lookYaw = math.clamp(lookYaw - dx * s, math.rad(-130), math.rad(130))
		lookPitch = math.clamp(lookPitch - dy * s, math.rad(-50), math.rad(60))
	else
		recentering = false
		sinceOrbit = 0
		orbitYaw = (orbitYaw - dx * s + math.pi) % (2 * math.pi) - math.pi
		orbitPitch = clampOrbitPitch(orbitPitch + dy * s)
	end
end
ChaseCamera.drag = drag

-- Hides (or shows again) our avatar's head, accessories and arms.
local ARM_PARTS = {
	LeftUpperArm = true,
	LeftLowerArm = true,
	LeftHand = true,
	RightUpperArm = true,
	RightLowerArm = true,
	RightHand = true,
	["Left Arm"] = true,
	["Right Arm"] = true,
	Head = true,
}
local function setAvatarHidden(on: boolean)
	if not on then
		for part in hidden do
			if part.Parent then
				part.LocalTransparencyModifier = 0
			end
		end
		table.clear(hidden)
		return
	end
	local character = player.Character
	if not character then
		return
	end
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			local parent = d.Parent
			if ARM_PARTS[d.Name] or (parent and parent:IsA("Accessory")) then
				d.LocalTransparencyModifier = 1
				hidden[d] = true
			end
		end
	end
end

local function stopDragging()
	if mouseDragging then
		mouseDragging = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	touchDrag = nil
end

local function restoreDefault(camera: Camera)
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	camera.CameraSubject = spectateTarget or humanoid
	setAvatarHidden(false)
	KartVisuals.setCockpit(false)
	stopDragging()
end

local function cockpitCFrame(chassis: BasePart, dt: number): CFrame
	local cf = chassis.CFrame
	local pose: CockpitRig.Pose = {
		pos = vec(cf.Position),
		right = vec(cf.RightVector),
		up = vec(cf.UpVector),
		look = vec(cf.LookVector),
		vel = vec(chassis.AssemblyLinearVelocity),
		angVel = vec(chassis.AssemblyAngularVelocity),
	}
	local eye, look, up = CockpitRig.step(CP :: any, rig, pose, Config.Kart.RideHeight, Config.Kart.Gravity, lookYaw, lookPitch, dt)
	local e, l, u = v3(eye), v3(look), v3(up)
	return CFrame.lookAt(e, e + l, u)
end

local function chaseCFrame(chassis: BasePart, dt: number): CFrame
	local cf = chassis.CFrame
	local vel = chassis.AssemblyLinearVelocity
	local speed = vel.Magnitude
	local heading = flat(cf.LookVector)
	-- follow the direction of travel when moving forwards fast (shows drifts),
	-- the nose otherwise
	local travel = flat(vel)
	local forwardMotion = vel:Dot(cf.LookVector) > 3
	local blend = if forwardMotion then math.clamp((speed - 10) / 30, 0, 0.6) else 0
	local desired = (heading * (1 - blend) + travel * blend).Unit
	local current = yawDir or desired
	local k = 1 - math.exp(-C.Stiffness * dt)
	current = (current + (desired - current) * k).Unit
	yawDir = current

	zoom += (zoomTarget - zoom) * (1 - math.exp(-C.ZoomSpeed * dt))
	local dist = zoom
	local height = C.HeightBase + C.HeightPerStud * dist
	local reach = math.sqrt(dist * dist + height * height)
	-- the orbit swings the camera around the kart; it keeps following the
	-- kart's heading, so a side view stays a side view through the corners
	local dir = CFrame.Angles(0, orbitYaw, 0):VectorToWorldSpace(current)
	local elev = math.clamp(math.atan2(height, dist) + orbitPitch, math.rad(C.OrbitPitchMin), math.rad(C.OrbitPitchMax))
	local ahead = C.LookAhead * math.max(math.cos(orbitYaw), 0) * math.cos(elev)
	local focus = chassis.Position + Vector3.new(0, 1.6, 0) + dir * ahead
	local want = chassis.Position - dir * (reach * math.cos(elev)) + Vector3.new(0, reach * math.sin(elev), 0)
	-- keep the camera out of walls, stands and the floor
	local from = chassis.Position + Vector3.new(0, 2, 0)
	local hit = workspace:Raycast(from, want - from, rayParams)
	if hit then
		want = hit.Position + hit.Normal * 0.8
	end
	return CFrame.lookAt(want, focus)
end

-- The podium camera (Scenery puts a "Camera" part by the podium), while the
-- results are shown and the top three stand on it.
local podiumOn = false
local podiumTime = 0
local function podiumCamera(): BasePart?
	if workspace:GetAttribute("RaceState") ~= "Results" or not workspace:GetAttribute("Podium") then
		return nil
	end
	local circuit = workspace:FindFirstChild("Circuit")
	local pits = circuit and circuit:FindFirstChild("Pits")
	local podium = pits and pits:FindFirstChild("Podium")
	local cam = podium and podium:FindFirstChild("Camera")
	if cam and cam:IsA("BasePart") then
		return cam
	end
	return nil
end

function ChaseCamera.isPodium(): boolean
	return podiumOn
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local podiumCam = podiumCamera()
	if podiumCam then
		if not podiumOn then
			podiumOn = true
			podiumTime = 0
			active = false
			setAvatarHidden(false)
			KartVisuals.setCockpit(false)
			stopDragging()
		end
		-- a slow push towards the steps
		podiumTime += dt
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = podiumCam.CFrame * CFrame.new(0, 0, -math.min(podiumTime, 10) * 0.5)
		camera.FieldOfView = 55
		return
	elseif podiumOn then
		podiumOn = false
		restoreDefault(camera)
	end
	local chassis = KartController.chassis()
	if not (KartController.isDriving() and chassis) then
		if active then
			active = false
			restoreDefault(camera)
		end
		return
	end
	if not active then
		active = true
		yawDir = nil
		rig = CockpitRig.new()
		blendT = 1
		camera.CameraType = Enum.CameraType.Scriptable
	end

	local cockpit = zoomTarget == 0
	local back = 1 - math.exp(-C.FreeLookReturn * dt)
	-- a look-around finger whose end we never heard about (it lifted over a
	-- button, or the app lost focus): let go of it, or the next touch that
	-- reuses the object would swing the camera
	local td = touchDrag
	if td and (td.UserInputState == Enum.UserInputState.End or td.UserInputState == Enum.UserInputState.Cancel) then
		touchDrag = nil
	end
	local looking = mouseDragging or touchDrag ~= nil
	if cockpit then
		-- the right stick turns the head directly; everything springs back
		if stick.Magnitude > 0 then
			lookYaw += (-stick.X * math.rad(100) - lookYaw) * back
			lookPitch += (stick.Y * math.rad(45) - lookPitch) * back
		elseif not looking then
			lookYaw -= lookYaw * back
			lookPitch -= lookPitch * back
		end
	else
		-- the right stick swings the orbit and it stays
		if stick.Magnitude > 0 then
			recentering = false
			sinceOrbit = 0
			local rate = math.rad(C.StickOrbitSpeed) * dt
			orbitYaw = (orbitYaw - stick.X * rate + math.pi) % (2 * math.pi) - math.pi
			orbitPitch = clampOrbitPitch(orbitPitch - stick.Y * rate * 0.6)
		end
		if C.AutoRecenter > 0 and not looking and stick.Magnitude == 0 and (orbitYaw ~= 0 or orbitPitch ~= 0) then
			sinceOrbit += dt
			if sinceOrbit > C.AutoRecenter and chassis.AssemblyLinearVelocity.Magnitude > 10 then
				recentering = true
			end
		end
		if recentering then
			orbitYaw -= orbitYaw * back
			orbitPitch -= orbitPitch * back
			if math.abs(orbitYaw) < 1e-3 and math.abs(orbitPitch) < 1e-3 then
				orbitYaw, orbitPitch = 0, 0
				recentering = false
			end
		end
	end

	local speedFrac = math.clamp(chassis.AssemblyLinearVelocity.Magnitude / Config.Kart.TopSpeed, 0, 1)
	local target: CFrame
	if cockpit then
		target = cockpitCFrame(chassis, dt)
		fov = CP.Fov + CP.FovSpeedGain * speedFrac
	else
		target = chaseCFrame(chassis, dt)
		local targetFov = C.FovMin + (C.FovMax - C.FovMin) * speedFrac
		fov += (targetFov - fov) * (1 - math.exp(-4 * dt))
	end

	-- avatar parts and the cockpit arms
	KartVisuals.setCockpit(cockpit)
	if cockpit then
		if next(hidden) == nil or os.clock() - lastHideScan > 0.5 then
			lastHideScan = os.clock()
			setAvatarHidden(true) -- also catches accessories that load late
		end
	elseif next(hidden) ~= nil then
		setAvatarHidden(false)
	end

	if blendT < 1 and blendFrom then
		blendT = math.min(blendT + dt / BLEND_TIME, 1)
		local a = blendT * blendT * (3 - 2 * blendT)
		camera.CFrame = blendFrom:Lerp(target, a)
		camera.FieldOfView = blendFov + (fov - blendFov) * a
	else
		camera.CFrame = target
		camera.FieldOfView = fov
	end
end

-- Spectating (not driving): follow another kart with the normal camera.
function ChaseCamera.spectate(target: BasePart?)
	spectateTarget = target
	if not KartController.isDriving() then
		local camera = workspace.CurrentCamera
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = target or humanoid
	end
end

local function driving(): boolean
	return active and KartController.isDriving()
end

-- zoom for the "Camera" setting
local function startingZoom(): number
	local choice = Settings.get("Camera")
	if choice == "Cockpit" then
		return 0
	elseif choice == "Far" then
		return C.Presets[3] or C.MaxDistance
	end
	return C.Presets[2] or C.Distance
end

function ChaseCamera.init()
	refreshFilter()
	zoomTarget = startingZoom()
	zoom = math.max(zoomTarget, C.MinDistance)
	Settings.onChange(function(key)
		if key == "Camera" then
			setZoom(startingZoom())
		end
	end)
	workspace:GetAttributeChangedSignal("TrackReady"):Connect(refreshFilter)
	workspace:GetAttributeChangedSignal("Track"):Connect(refreshFilter)
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "Circuit" then
			task.defer(refreshFilter)
		end
	end)
	Input.onAction("Camera", function()
		ChaseCamera.cycle()
	end)

	UserInputService.InputBegan:Connect(function(io: InputObject, processed: boolean)
		if not driving() then
			return
		end
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton2 and not processed then
			mouseDragging = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		elseif t == Enum.UserInputType.Touch and not processed and touchDrag == nil then
			touchDrag = io -- a finger on an empty part of the screen
		elseif io.KeyCode == Enum.KeyCode.DPadUp then
			ChaseCamera.zoomStep(-1)
		elseif io.KeyCode == Enum.KeyCode.DPadDown then
			ChaseCamera.zoomStep(1)
		elseif (io.KeyCode == Enum.KeyCode.V and not processed) or io.KeyCode == Enum.KeyCode.ButtonR3 then
			ChaseCamera.recenter()
		end
	end)
	UserInputService.InputEnded:Connect(function(io: InputObject)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton2 and mouseDragging then
			mouseDragging = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		elseif t == Enum.UserInputType.Touch and touchDrag == io then
			touchDrag = nil
		elseif io.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.zero
		end
	end)
	UserInputService.InputChanged:Connect(function(io: InputObject, processed: boolean)
		if not driving() then
			return
		end
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseWheel then
			if not processed then
				ChaseCamera.zoomStep(if io.Position.Z > 0 then -1 else 1)
			end
		elseif t == Enum.UserInputType.MouseMovement and mouseDragging then
			drag(io.Delta.X, io.Delta.Y, C.FreeLookSensitivity)
		elseif t == Enum.UserInputType.Touch and touchDrag == io then
			drag(io.Delta.X, io.Delta.Y, C.TouchSensitivity)
		elseif io.KeyCode == Enum.KeyCode.Thumbstick2 then
			local v = Vector2.new(io.Position.X, io.Position.Y)
			stick = if v.Magnitude > 0.2 then v else Vector2.zero
		end
	end)

	UserInputService.TouchEnded:Connect(function(io: InputObject)
		if touchDrag == io then
			touchDrag = nil
		end
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		touchDrag = nil
		stick = Vector2.zero
		if mouseDragging then
			mouseDragging = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)

	-- pinch to zoom on touch screens (two fingers: no orbit while pinching)
	local pinchStart = zoomTarget
	UserInputService.TouchPinch:Connect(function(_positions, scale, _velocity, state, processed)
		if not driving() or processed then
			return
		end
		touchDrag = nil
		if state == Enum.UserInputState.Begin then
			pinchStart = if zoomTarget == 0 then C.MinDistance * 0.9 else zoomTarget
		elseif state == Enum.UserInputState.Change and scale > 0 then
			setZoom(pinchStart / scale)
		end
	end)

	RunService:BindToRenderStep("KartCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return ChaseCamera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- Race HUD: position and lap, lap timing with sector splits and a live
-- delta to your best lap, speed and slipstream, minimap, live standings
-- (race order, or best laps in qualifying), start lights (on screen and on
-- the gantry), track-limit warnings, toasts, results, and the track panel
-- (switch track in practice; vote track and race length and press READY
-- before a race; in a private room the host picks both and presses START).
-- Hidden in the lobby (Menu). All text is ASCII so it renders in every font.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local TrackMath = require(Shared:WaitForChild("TrackMath"))
local TrackData = require(Shared:WaitForChild("TrackData"))
local KartController = require(script.Parent:WaitForChild("KartController"))
local ChaseCamera = require(script.Parent:WaitForChild("ChaseCamera"))
local Input = require(script.Parent:WaitForChild("Input"))
local Settings = require(script.Parent:WaitForChild("Settings"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))
local TrackOutline = require(script.Parent:WaitForChild("TrackOutline"))

local Hud = {}

local player = Players.LocalPlayer
local ACCENT = Color3.fromRGB(255, 196, 0)
local PANEL = Color3.fromRGB(14, 15, 20)
local WHITE = Color3.new(1, 1, 1)
local MUTED = Color3.fromRGB(170, 175, 190)
local PURPLE = Color3.fromRGB(200, 135, 255)
local GREEN = Color3.fromRGB(70, 220, 120)
local RED = Color3.fromRGB(235, 50, 50)
local ORANGE = Color3.fromRGB(255, 140, 30)
local CARD = Color3.fromRGB(30, 32, 40)
local CHOSEN = Color3.fromRGB(78, 62, 8)
local SECTOR_COLOURS: { [string]: Color3 } = {
	purple = PURPLE,
	green = GREEN,
	yellow = ACCENT,
	invalid = Color3.fromRGB(110, 112, 122),
}
-- Times are drawn in bold Roboto Mono at fixed sizes: every digit has the
-- same width (the clock does not jitter) and the strokes are thick enough
-- to stay sharp over the track. TextScaled made the regular-weight font pick
-- a smaller size whenever a line got longer, and it went thin and faint.
local MONO_BOLD = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
local LIGHT = Color3.fromRGB(225, 228, 236)
local LENGTHS = { "Short", "Normal", "Long" }
local MAP_SIZES: { [string]: number } = { Off = 0, Small = 150, Normal = 210, Large = 280 }

local gui: ScreenGui
local track: TrackMath.Track
local trackId = ""
local requestRemote: RemoteEvent

-- timing state
local lapStart: number? = nil
local lastLap: number? = nil
local sessionBest: number? = nil
local lapInvalid = false
local standings: { any } = {}
local standingsMode = "race"
local spectateIndex = 0

-- live delta: the lap time reached at every DELTA_STEP studs of the current
-- lap, and the same for the best clean lap of the session
local DELTA_STEP = 15
local curProfile: { [number]: number } = {}
local bestProfile: { [number]: number }? = nil
local deltaHint: number? = nil

----------------------------------------------------------------------------
-- small UI helpers
----------------------------------------------------------------------------
local function corner(p: Instance, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = p
end

local function stroke(p: Instance, color: Color3?, thickness: number?, transparency: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or WHITE
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.8
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
end

local function textStroke(p: Instance, thickness: number)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Transparency = 0.3
	s.Parent = p
end

local function panel(parent: Instance, name: string, size: UDim2, pos: UDim2, anchor: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor or Vector2.zero
	f.BackgroundColor3 = PANEL
	f.BackgroundTransparency = 0.25
	f.BorderSizePixel = 0
	corner(f)
	stroke(f)
	f.Parent = parent
	return f
end

local function text(parent: Instance, name: string, str: string, size: UDim2, pos: UDim2, font: Enum.Font?, color: Color3?, align: Enum.TextXAlignment?): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.Text = str
	t.Size = size
	t.Position = pos
	t.BackgroundTransparency = 1
	t.Font = font or Enum.Font.GothamBold
	t.TextColor3 = color or WHITE
	t.TextScaled = true
	t.TextXAlignment = align or Enum.TextXAlignment.Left
	t.Parent = parent
	return t
end

-- A label at a fixed text size (no TextScaled). `mono` = bold Roboto Mono.
local function fixed(parent: Instance, name: string, str: string, size: UDim2, pos: UDim2, textSize: number, mono: boolean, color: Color3?, align: Enum.TextXAlignment?): TextLabel
	local t = text(parent, name, str, size, pos, Enum.Font.GothamBold, color, align)
	t.TextScaled = false
	t.TextSize = textSize
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.TextTruncate = Enum.TextTruncate.AtEnd
	if mono then
		t.FontFace = MONO_BOLD
	end
	return t
end

-- Elements centred on the screen are placed from the left edge on a whole
-- pixel (AnchorPoint 0.5 on an odd-width screen lands on half a pixel).
type Centred = { obj: GuiObject, width: number, y: UDim }
local centred: { Centred } = {}
local uiScale: UIScale
local function centre(obj: GuiObject)
	obj.AnchorPoint = Vector2.new(0, obj.AnchorPoint.Y)
	table.insert(centred, { obj = obj, width = obj.Size.X.Offset, y = obj.Position.Y })
end
local function placeCentred()
	local vp = workspace.CurrentCamera.ViewportSize
	local s = uiScale.Scale
	for _, c in centred do
		local x = math.floor((vp.X / s - c.width) / 2)
		c.obj.Position = UDim2.new(0, x, c.y.Scale, c.y.Offset)
	end
end

local function bigButton(parent: Instance, name: string, str: string, size: UDim2, pos: UDim2, bg: Color3, padding: number?): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = bg
	b.TextColor3 = PANEL
	b.Font = Enum.Font.GothamBlack
	b.TextScaled = true
	b.Text = str
	corner(b, 8)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, padding or 9)
	pad.PaddingBottom = UDim.new(0, padding or 9)
	pad.Parent = b
	b.Parent = parent
	return b
end

local function fmt(t: number?): string
	if not t or t ~= t or t < 0 then
		return "--:--.---"
	end
	local m = math.floor(t / 60)
	local s = t - m * 60
	return string.format("%d:%06.3f", m, s)
end

local function fmtShort(t: number): string
	if t >= 60 then
		return fmt(t)
	end
	return string.format("%.3f", t)
end

local function ordinal(n: number): string
	local suffix = "th"
	if n % 100 < 11 or n % 100 > 13 then
		local d = n % 10
		suffix = if d == 1 then "st" elseif d == 2 then "nd" elseif d == 3 then "rd" else "th"
	end
	return tostring(n) .. suffix
end

local function now(): number
	return workspace:GetServerTimeNow()
end

