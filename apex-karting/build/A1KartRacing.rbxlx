local MAP_PAD = 12

local function mapPoint(x: number, z: number): Vector2
	return Vector2.new((x - mapMin.X) * mapScale + MAP_PAD, (z - mapMin.Y) * mapScale + MAP_PAD)
end

-- The sampled track for a circuit id, and outlines (TrackOutline).
local function trackFor(id: string): TrackMath.Track
	return TrackOutline.track(id)
end

local function drawOutline(frame: GuiObject, t: TrackMath.Track, size: number, pad: number, every: number, thick: number): (number, Vector2)
	return TrackOutline.draw(frame, t, size, pad, every, thick)
end

-- the standings sit under the minimap (or in its place when it is off)
local function placeStandings()
	if standingsPanel then
		local top = if mapSize > 0 then 16 + mapSize + 10 else 16
		standingsPanel.Position = UDim2.new(1, -16, 0, top)
		standingsPanel.Size = UDim2.fromOffset(math.max(mapSize, 230), 30)
	end
end

local function drawMinimap()
	for _, c in mapFrame:GetChildren() do
		if c.Name == "Outline" then
			c:Destroy()
		end
	end
	mapSize = MAP_SIZES[Settings.get("Minimap") :: string] or 210
	mapFrame.Visible = mapSize > 0
	placeStandings()
	if mapSize <= 0 then
		return
	end
	mapFrame.Size = UDim2.fromOffset(mapSize, mapSize)
	-- longer circuits get a finer outline step so corners stay round
	local every = if track.n > 600 then 3 else 2
	mapScale, mapMin = drawOutline(mapFrame, track, mapSize, MAP_PAD, every, if mapSize < 180 then 3 else 4)
	mapName.Text = string.upper(TrackData.get(trackId).Name)
end

local function buildMinimap()
	mapFrame = panel(gui, "Minimap", UDim2.fromOffset(mapSize, mapSize), UDim2.new(1, -16, 0, 16), Vector2.new(1, 0))
	mapFrame.ClipsDescendants = true
	mapName = text(mapFrame, "TrackName", "", UDim2.new(1, -16, 0, 14), UDim2.new(0, 8, 1, -18), Enum.Font.GothamBold, MUTED, Enum.TextXAlignment.Right)
	mapName.ZIndex = 4
	drawMinimap()
end

local function mapDot(model: Model): Frame
	local existing = mapDots[model]
	if existing then
		return existing
	end
	local mine = model:GetAttribute("Owner") == player.UserId
	local d = Instance.new("Frame")
	d.AnchorPoint = Vector2.new(0.5, 0.5)
	d.Size = UDim2.fromOffset(if mine then 13 else 10, if mine then 13 else 10)
	d.BackgroundColor3 = (model:GetAttribute("Color") :: Color3?) or WHITE
	d.BorderSizePixel = 0
	d.ZIndex = if mine then 6 else 5
	corner(d, 7)
	stroke(d, if mine then WHITE else Color3.new(0, 0, 0), 2, 0)
	d.Parent = mapFrame
	mapDots[model] = d
	return d
end

local function buildStandings()
	standingsPanel = panel(gui, "Standings", UDim2.fromOffset(230, 30), UDim2.new(1, -16, 0, 236), Vector2.new(1, 0))
	standingsPanel.AutomaticSize = Enum.AutomaticSize.Y
	standingsPanel.Visible = false
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = standingsPanel
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = standingsPanel
	for i = 1, Config.Race.MaxRacers do
		local row = Instance.new("Frame")
		row.Name = "Row" .. i
		row.LayoutOrder = i
		row.Size = UDim2.new(1, 0, 0, 20)
		row.BackgroundTransparency = 1
		row.Visible = false
		row.Parent = standingsPanel
		text(row, "Pos", tostring(i), UDim2.new(0, 22, 1, 0), UDim2.fromOffset(0, 0), Enum.Font.GothamBlack, ACCENT, Enum.TextXAlignment.Center)
		local chip = Instance.new("Frame")
		chip.Name = "Chip"
		chip.Size = UDim2.fromOffset(6, 16)
		chip.Position = UDim2.fromOffset(26, 2)
		chip.BorderSizePixel = 0
		chip.Parent = row
		text(row, "Name", "", UDim2.new(1, -124, 1, -2), UDim2.fromOffset(38, 1), Enum.Font.GothamMedium, WHITE)
		fixed(row, "Gap", "", UDim2.new(0, 82, 1, 0), UDim2.new(1, -82, 0, 0), 14, true, LIGHT, Enum.TextXAlignment.Right)
		standingsRows[i] = row
	end
	placeStandings()
end

local function buildResults()
	-- left of centre, so the podium behind it stays in view
	resultsPanel = panel(gui, "Results", UDim2.fromOffset(460, 80), UDim2.fromOffset(16, 150))
	resultsPanel.AutomaticSize = Enum.AutomaticSize.Y
	resultsPanel.Visible = false
	resultsPanel.BackgroundTransparency = 0.1
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 14)
	pad.PaddingBottom = UDim.new(0, 16)
	pad.PaddingLeft = UDim.new(0, 18)
	pad.PaddingRight = UDim.new(0, 18)
	pad.Parent = resultsPanel
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 4)
	layout.Parent = resultsPanel
	local title = text(resultsPanel, "Title", "RACE RESULTS", UDim2.new(1, 0, 0, 34), UDim2.new(), Enum.Font.GothamBlack, ACCENT)
	title.LayoutOrder = 0
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.LayoutOrder = 1
	header.Size = UDim2.new(1, 0, 0, 16)
	header.BackgroundTransparency = 1
	header.Parent = resultsPanel
	text(header, "A", "POS   DRIVER", UDim2.new(0.5, 0, 1, 0), UDim2.new(), Enum.Font.GothamBold, MUTED)
	text(header, "B", "TIME", UDim2.new(0.25, 0, 1, 0), UDim2.fromScale(0.5, 0), Enum.Font.GothamBold, MUTED, Enum.TextXAlignment.Right)
	text(header, "C", "BEST LAP", UDim2.new(0.25, 0, 1, 0), UDim2.fromScale(0.75, 0), Enum.Font.GothamBold, MUTED, Enum.TextXAlignment.Right)
	resultsList = Instance.new("Frame")
	resultsList.Name = "List"
	resultsList.LayoutOrder = 2
	resultsList.Size = UDim2.new(1, 0, 0, 0)
	resultsList.AutomaticSize = Enum.AutomaticSize.Y
	resultsList.BackgroundTransparency = 1
	resultsList.Parent = resultsPanel
	local l2 = Instance.new("UIListLayout")
	l2.SortOrder = Enum.SortOrder.LayoutOrder
	l2.Padding = UDim.new(0, 3)
	l2.Parent = resultsList
end

local function showResults(list: { any })
	for _, c in resultsList:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, e in list do
		local row = Instance.new("Frame")
		row.LayoutOrder = i
		row.Size = UDim2.new(1, 0, 0, 26)
		row.BackgroundColor3 = if e.userId == player.UserId then Color3.fromRGB(60, 50, 10) else CARD
		row.BackgroundTransparency = 0.2
		row.BorderSizePixel = 0
		corner(row, 6)
		row.Parent = resultsList
		local chip = Instance.new("Frame")
		chip.Size = UDim2.fromOffset(6, 18)
		chip.Position = UDim2.fromOffset(40, 4)
		chip.BackgroundColor3 = e.color or WHITE
		chip.BorderSizePixel = 0
		chip.Parent = row
		text(row, "Pos", tostring(i), UDim2.fromOffset(32, 20), UDim2.fromOffset(4, 3), Enum.Font.GothamBlack, if i == 1 then ACCENT else WHITE, Enum.TextXAlignment.Center)
		text(row, "Name", string.format("#%d %s", e.number or 0, e.name or "?"), UDim2.new(0.5, -54, 0, 18), UDim2.fromOffset(52, 4), Enum.Font.GothamMedium, WHITE)
		local timeStr = if e.finished then fmt(e.time) else "DNF"
		if e.finished and e.penalty and e.penalty > 0 then
			-- the time already includes it
			timeStr = string.format("%s (+%ds)", fmt(e.time), e.penalty)
		end
		fixed(row, "Time", timeStr, UDim2.new(0.25, -4, 0, 20), UDim2.new(0.5, 0, 0, 3), 15, true, if e.finished then WHITE else RED, Enum.TextXAlignment.Right)
		fixed(row, "Best", fmt(e.best), UDim2.new(0.25, -8, 0, 20), UDim2.new(0.75, 0, 0, 3), 15, true, LIGHT, Enum.TextXAlignment.Right)
	end
	resultsPanel.Visible = true
	task.delay(Config.Race.ResultsTime - 0.3, function()
		resultsPanel.Visible = false
	end)
end

local toastToken = 0
local toastStroke: UIStroke
local toastFade: { Tween } = {}
local function showToast(str: string, color: Color3?, seconds: number?)
	toastToken += 1
	local my = toastToken
	-- a fade still running from the last message would wash this one out
	for _, tw in toastFade do
		tw:Cancel()
	end
	table.clear(toastFade)
	toast.Text = str
	toast.TextColor3 = color or WHITE
	toast.TextTransparency = 0
	toastStroke.Transparency = 0.3
	toast.Visible = true
	task.delay(seconds or 3, function()
		if my == toastToken then
			-- the outline fades with the letters (left alone it lingers as a blur)
			local info = TweenInfo.new(0.6)
			toastFade = {
				TweenService:Create(toast, info, { TextTransparency = 1 }),
				TweenService:Create(toastStroke, info, { Transparency = 1 }),
			}
			for _, tw in toastFade do
				tw:Play()
			end
		end
	end)
end

local bigToken = 0
local function showBig(str: string, color: Color3?, seconds: number?)
	bigToken += 1
	local my = bigToken
	bigText.Text = str
	bigText.TextColor3 = color or WHITE
	bigText.Visible = true
	task.delay(seconds or 1.5, function()
		if my == bigToken then
			bigText.Visible = false
		end
	end)
end

----------------------------------------------------------------------------
-- Sector boxes and the live delta
----------------------------------------------------------------------------
local function clearSectors(from: number)
	for i = from, #sectorBoxes do
		local b = sectorBoxes[i]
		b.Text = string.format("S%d", i)
		b.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
		b.TextColor3 = MUTED
	end
end

local function setSector(index: number, t: number, colour: string)
	local b = sectorBoxes[index]
	if not b then
		return
	end
	if index == 1 then
		clearSectors(2)
	end
	b.Text = fmtShort(t)
	b.BackgroundColor3 = SECTOR_COLOURS[colour] or MUTED
	b.TextColor3 = PANEL
end

local function resetLap()
	lapStart = nil
	lastLap = nil
	lapInvalid = false
	curProfile = {}
	deltaHint = nil
	clearSectors(1)
end

local function resetSession()
	resetLap()
	sessionBest = nil
	bestProfile = nil
end

local function updateDelta(chassis: BasePart?, t: number)
	deltaText.Text = ""
	local start = lapStart
	if not (chassis and start) then
		return
	end
	local elapsed = t - start
	if elapsed < 0 then
		return
	end
	local idx, _, s = TrackMath.nearest(track, (chassis.Position :: any) :: vector, deltaHint, 6, 30)
	deltaHint = idx
	-- just after the line the nearest point can still be the end of the lap
	if elapsed < 4 and s > track.length * 0.5 then
		return
	end
	local k = math.floor(s / DELTA_STEP)
	if curProfile[k] == nil then
		curProfile[k] = elapsed
	end
	local ref = bestProfile
	if not ref or lapInvalid or Settings.get("Delta") == false then
		return
	end
	local a, b = ref[k], ref[k + 1]
	if not a then
		return
	end
	local refT = if b then a + (b - a) * ((s - k * DELTA_STEP) / DELTA_STEP) else a
	local d = elapsed - refT
	deltaText.Text = string.format("%+.2f", d)
	deltaText.TextColor3 = if d <= 0 then GREEN else RED
end

----------------------------------------------------------------------------
-- Track panel: in practice a click changes the track; in the intermission it
-- is a vote for the next race (the server counts them), with the race length
-- and the READY button
----------------------------------------------------------------------------
-- cards sit two to a row (five circuits and counting)
local CARD_W, CARD_H, CARD_GAP = 228, 62, 6
local PANEL_W = CARD_W * 2 + CARD_GAP
local cardGrid: Frame

local function trackIds(): { string }
	local list = {}
	local attr = workspace:GetAttribute("Tracks") :: string?
	for id in string.gmatch(attr or "", "[^,]+") do
		if TrackData.Tracks[id] then
			table.insert(list, id)
		end
	end
	return list
end

local function serverMode(): string
	return (workspace:GetAttribute("ServerMode") :: string?) or "race"
end

local function pickTrack(id: string)
	Sfx.play("Click")
	requestRemote:FireServer("Vote", id)
end

local function lengthsOf(spec: any): { number }
	local laps = spec.Laps or 3
	return spec.Lengths or { laps, laps, laps }
end

local function buildTrackCard(id: string): TextButton
	local spec = TrackData.get(id)
	local t = trackFor(id)
	local card = Instance.new("TextButton")
	card.Name = "Card_" .. id
	card.Text = ""
	card.AutoButtonColor = true
	card.Size = UDim2.fromOffset(CARD_W, CARD_H)
	card.BackgroundColor3 = CARD
	card.BackgroundTransparency = 0.15
	card.BorderSizePixel = 0
	corner(card, 8)
	local ring = Instance.new("UIStroke")
	ring.Name = "Ring"
	ring.Color = ACCENT
	ring.Thickness = 2
	ring.Transparency = 1
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Parent = card
	local thumb = Instance.new("Frame")
	thumb.Name = "Thumb"
	thumb.Size = UDim2.fromOffset(50, 50)
	thumb.Position = UDim2.fromOffset(6, 6)
	thumb.BackgroundTransparency = 1
	thumb.Parent = card
	drawOutline(thumb, t, 50, 4, math.max(2, t.n // 120), 2)
	local km = t.length * Config.StudMeters / 1000
	local l = lengthsOf(spec)
	fixed(card, "Name", string.upper(spec.Name), UDim2.fromOffset(CARD_W - 104, 18), UDim2.fromOffset(62, 5), 13, false, WHITE).Font = Enum.Font.GothamBlack
	fixed(card, "Blurb", spec.Blurb or "", UDim2.fromOffset(CARD_W - 104, 14), UDim2.fromOffset(62, 24), 11, false, MUTED).Font = Enum.Font.GothamMedium
	fixed(card, "Info", string.format("%.2f km - %d/%d/%d laps", km, l[1], l[2], l[3]), UDim2.fromOffset(CARD_W - 104, 14), UDim2.fromOffset(62, 41), 11, true, MUTED)
	fixed(card, "Key", "", UDim2.fromOffset(14, 14), UDim2.new(1, -40, 0, 4), 11, false, MUTED, Enum.TextXAlignment.Right)
	fixed(card, "Votes", "", UDim2.fromOffset(36, 28), UDim2.new(1, -40, 0, 26), 24, false, ACCENT, Enum.TextXAlignment.Center).Font = Enum.Font.GothamBlack
	fixed(card, "Tag", "", UDim2.fromOffset(36, 14), UDim2.new(1, -40, 0, 4), 11, false, GREEN, Enum.TextXAlignment.Center)
	card.Parent = cardGrid
	card.Activated:Connect(function()
		pickTrack(id)
	end)
	trackCards[id] = card :: any
	return card
end

local function buildTrackPanel()
	trackPanel = panel(gui, "Tracks", UDim2.fromOffset(PANEL_W + 16, 40), UDim2.fromOffset(16, 274))
	trackPanel.AutomaticSize = Enum.AutomaticSize.Y
	trackPanel.Visible = false
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = trackPanel
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = trackPanel
	trackTitle = text(trackPanel, "Title", "TRACK", UDim2.fromOffset(PANEL_W, 18), UDim2.new(), Enum.Font.GothamBlack, ACCENT)
	trackTitle.LayoutOrder = 0
	cardGrid = Instance.new("Frame")
	cardGrid.Name = "Cards"
	cardGrid.LayoutOrder = 1
	cardGrid.Size = UDim2.fromOffset(PANEL_W, 0)
	cardGrid.AutomaticSize = Enum.AutomaticSize.Y
	cardGrid.BackgroundTransparency = 1
	cardGrid.Parent = trackPanel
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromOffset(CARD_W, CARD_H)
	gridLayout.CellPadding = UDim2.fromOffset(CARD_GAP, CARD_GAP)
	gridLayout.FillDirectionMaxCells = 2
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = cardGrid
	-- race length: three buttons with the vote counts
	lengthRow = Instance.new("Frame")
	lengthRow.Name = "Length"
	lengthRow.LayoutOrder = 100
	lengthRow.Size = UDim2.fromOffset(PANEL_W, 34)
	lengthRow.BackgroundTransparency = 1
	lengthRow.Visible = false
	lengthRow.Parent = trackPanel
	local w = math.floor((PANEL_W - 12) / 3)
	for i, len in LENGTHS do
		local b = bigButton(lengthRow, len, string.upper(len), UDim2.fromOffset(w, 34), UDim2.fromOffset((i - 1) * (w + 6), 0), CARD, 9)
		b.TextColor3 = WHITE
		b.Font = Enum.Font.GothamBold
		b.Activated:Connect(function()
			Sfx.play("Click")
			requestRemote:FireServer("Length", len)
		end)
		lengthButtons[len] = b
	end
	readyButton = bigButton(trackPanel, "Ready", "READY", UDim2.fromOffset(PANEL_W, 42), UDim2.new(), GREEN)
	readyButton.LayoutOrder = 101
	readyButton.Visible = false
	readyButton.Activated:Connect(function()
		Sfx.play("Click")
		requestRemote:FireServer("Ready", player:GetAttribute("Ready") ~= true)
	end)
end

local function updateTrackPanel(state: string?, remaining: number)
	local ids = trackIds()
	local voting = state == "Intermission"
	local practice = state == "Practice"
	local several = #ids > 1
	trackButton.Visible = (several and practice) or voting
	trackButton.Text = if voting then "VOTE  [M]" else "TRACK  [M]"
	local show = (voting and not trackPanelClosed) or (several and practice and trackPanelOpen)
	trackPanel.Visible = show
	if not show then
		return
	end
	if voting then
		local readyCount = (workspace:GetAttribute("ReadyCount") :: number?) or 0
		local count = (workspace:GetAttribute("PlayerCount") :: number?) or 1
		trackTitle.Text = string.format("NEXT RACE  -  %d s  -  %d/%d READY", remaining, readyCount, count)
	else
		trackTitle.Text = "CHANGE TRACK (CLICK OR NUMBER KEY)"
	end
	local myVote = player:GetAttribute("Vote") :: string?
	for i, id in ids do
		local card = trackCards[id] or buildTrackCard(id)
		card.LayoutOrder = i
		local here = id == trackId
		local mine = voting and myVote == id
		card.BackgroundColor3 = if mine then CHOSEN else CARD
		local ring = card:FindFirstChild("Ring") :: UIStroke
		ring.Transparency = if mine or (not voting and here) then 0 else 1
		local votesL = card:FindFirstChild("Votes") :: TextLabel
		votesL.Text = if voting then tostring((workspace:GetAttribute("Votes_" .. id) :: number?) or 0) else ""
		local tag = card:FindFirstChild("Tag") :: TextLabel
		tag.Text = if here then "NOW" else ""
		local key = card:FindFirstChild("Key") :: TextLabel
		key.Text = if UserInputService.KeyboardEnabled and i <= 9 then tostring(i) else ""
	end
	for id, card in trackCards do
		-- with one circuit there is nothing to pick, only the length and READY
		card.Visible = several and table.find(ids, id) ~= nil
	end
	lengthRow.Visible = voting
	readyButton.Visible = voting
	if voting then
		local myLen = player:GetAttribute("LengthVote") :: string?
		local laps = lengthsOf(TrackData.get(myVote or trackId))
		for i, len in LENGTHS do
			local b = lengthButtons[len]
			local n = (workspace:GetAttribute("LenVotes_" .. len) :: number?) or 0
			b.Text = string.format("%s %d  (%d)", string.upper(len), laps[i], n)
			b.BackgroundColor3 = if myLen == len then CHOSEN else CARD
		end
		local isReady = player:GetAttribute("Ready") == true
		readyButton.Text = if isReady then "READY!  (CLICK TO UNDO)" else "READY"
		readyButton.BackgroundColor3 = if isReady then ACCENT else GREEN
	end
end

local function onTracksKey()
	local state = workspace:GetAttribute("RaceState")
	if state == "Intermission" then
		trackPanelClosed = not trackPanelClosed
	elseif state == "Practice" then
		trackPanelOpen = not trackPanelOpen
	end
	Sfx.play("Click")
end

local function onTrackNumber(n: number)
	if not trackPanel.Visible then
		return
	end
	local id = trackIds()[n]
	if id then
		pickTrack(id)
	end
end

-- gamepad: B steps to the next track (practice: switches; intermission: votes)
local function onTrackNext()
	local state = workspace:GetAttribute("RaceState")
	if state ~= "Practice" and state ~= "Intermission" then
		return
	end
	local ids = trackIds()
	if #ids < 2 then
		return
	end
	local from = if state == "Intermission" then (player:GetAttribute("Vote") :: string?) or trackId else trackId
	local i = table.find(ids, from) or 0
	if state == "Practice" then
		trackPanelOpen = true
	else
		trackPanelClosed = false
	end
	pickTrack(ids[i % #ids + 1])
end

----------------------------------------------------------------------------
-- Gantry lights in the world
----------------------------------------------------------------------------
local gantryLights: { BasePart } = {}
local function findGantry()
	local circuit = workspace:FindFirstChild("Circuit")
	local trk = circuit and circuit:FindFirstChild("Track")
	local gantry = trk and trk:FindFirstChild("Gantry")
	local lights = gantry and gantry:FindFirstChild("Lights")
	if lights then
		gantryLights = {}
		for _, l in lights:GetChildren() do
			if l:IsA("BasePart") then
				local idx = l:GetAttribute("Index") :: number?
				if idx then
					gantryLights[idx] = l
				end
			end
		end
	end
end

local function setLights(count: number)
	for i = 1, 5 do
		local on = i <= count
		local dot = lightDots[i]
		if dot then
			dot.BackgroundColor3 = if on then RED else Color3.fromRGB(40, 12, 12)
		end
		local l = gantryLights[i]
		if l then
			l.Color = if on then Color3.fromRGB(255, 40, 30) else Color3.fromRGB(40, 8, 8)
			l.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
end

----------------------------------------------------------------------------
-- per-frame update
----------------------------------------------------------------------------
local function bannerMessage(state: string?, t: number, remaining: number, inRace: boolean, laps: number): string
	local mode = serverMode()
	if state == "Practice" then
		if mode == "practice" then
			return "PRACTICE  -  " .. string.upper((workspace:GetAttribute("TrackName") :: string?) or "")
		end
		local count = (workspace:GetAttribute("PlayerCount") :: number?) or 1
		local need = (workspace:GetAttribute("MinPlayers") :: number?) or 2
		return string.format("WAITING FOR DRIVERS (%d/%d)  -  PRACTISE MEANWHILE", count, need)
	elseif state == "Intermission" then
		local readyCount = (workspace:GetAttribute("ReadyCount") :: number?) or 0
		local count = (workspace:GetAttribute("PlayerCount") :: number?) or 1
		return string.format("QUALIFYING IN %d  -  VOTE, THEN PRESS READY (%d/%d)", remaining, readyCount, count)
	elseif state == "Qualifying" then
		if workspace:GetAttribute("QualiClosing") then
			return "CHEQUERED FLAG  -  FINISH YOUR LAP"
		end
		local clock = string.format("%d:%02d", remaining // 60, remaining % 60)
		if player:GetAttribute("QualiDone") then
			return "QUALIFYING DONE  -  WAITING FOR THE OTHERS  " .. clock
		elseif not lapStart then
			return "QUALIFYING  -  ONE LAP  -  THE CLOCK STARTS AT THE LINE  " .. clock
		end
		return "QUALIFYING  -  ONE TIMED LAP  -  GHOSTS ON  " .. clock
	elseif state == "Grid" then
		return if inRace then string.format("GET READY  -  %d LAP%s", laps, if laps == 1 then "" else "S") else "RACE STARTING - SPECTATING"
	elseif state == "Racing" then
		local deadline = workspace:GetAttribute("FinishDeadline") :: number?
		if not inRace then
			return "RACE IN PROGRESS - SPECTATING (Q / E)"
		elseif deadline and deadline > t then
			return string.format("WINNER IS IN!  %d s LEFT TO FINISH", math.ceil(deadline - t))
		end
	elseif state == "Results" then
		return (if mode == "room" then "PODIUM  -  BACK TO THE ROOM IN " else "PODIUM  -  NEXT ROUND IN ") .. remaining
	end
	return ""
end

local wasLightsCount = -1
local function update(_dt: number)
	local t = now()
	local state = workspace:GetAttribute("RaceState") :: string?
	local stateEnd = (workspace:GetAttribute("StateEnd") :: number?) or 0
	local laps = (workspace:GetAttribute("Laps") :: number?) or TrackData.get(trackId).Laps
	local inRace = player:GetAttribute("InRace") == true
	local driving = KartController.isDriving()
	local remaining = math.max(0, math.ceil(stateEnd - t))

	-- the lobby menu and a private room's waiting room cover the screen
	gui.Enabled = serverMode() ~= "lobby" and not (serverMode() == "room" and state == "Lobby")
	local msg = bannerMessage(state, t, remaining, inRace, laps)
	bannerText.Text = msg
	banner.Visible = msg ~= ""

	-- position and lap (race), or position by best lap (qualifying)
	local qualifying = state == "Qualifying"
	local racing = state == "Racing" and inRace
	posPanel.Visible = inRace and (racing or state == "Grid" or qualifying)
	if posPanel.Visible then
		local pos = (player:GetAttribute("Position") :: number?) or (player:GetAttribute("GridSlot") :: number?) or 1
		local field = math.max(#standings, 1)
		posText.Text = "P" .. pos
		posOf.Text = "/" .. field
		if qualifying then
			lapText.Text = "QUALIFYING"
		else
			local lap = (player:GetAttribute("Lap") :: number?) or 1
			local pen = (player:GetAttribute("Penalty") :: number?) or 0
			local base = if player:GetAttribute("Finished") then "FINISHED" else string.format("LAP %d/%d", lap, laps)
			lapText.Text = if pen > 0 then string.format("%s   +%ds", base, pen) else base
		end
	end

	-- timing
	local chassis = KartController.chassis()
	timePanel.Visible = driving or racing
	if timePanel.Visible then
		local cur = if lapStart and not player:GetAttribute("Finished") then t - lapStart else nil
		curLapText.Text = fmt(cur)
		curLapText.TextColor3 = if lapInvalid then RED else WHITE
		lastLapText.Text = fmt(lastLap)
		bestLapText.Text = fmt(sessionBest)
		local rec = workspace:GetAttribute("TrackRecord") :: number?
		local holder = workspace:GetAttribute("TrackRecordHolder") :: string?
		recordText.Text = fmt(rec)
		recordHolder.Text = if rec then holder or "" else ""
		updateDelta(if driving and not player:GetAttribute("Finished") then chassis else nil, t)
		if lapInvalid then
			deltaText.Text = "DELETED"
			deltaText.TextColor3 = RED
		end
	end

	-- speed and slipstream
	speedPanel.Visible = driving and chassis ~= nil
	if speedPanel.Visible and chassis then
		local tele = KartController.telemetry()
		local v = chassis.AssemblyLinearVelocity:Dot(chassis.CFrame.LookVector)
		local kmh = math.abs(v) * Config.KmhPerStudPerSecond
		local mph = Settings.get("Units") == "MPH"
		speedText.Text = string.format("%d", math.floor((if mph then kmh * 0.621371 else kmh) + 0.5))
		unitText.Text = if mph then "MPH" else "KM/H"
		local revs = math.clamp(math.abs(v) / Config.Kart.TopSpeed, 0, 1)
		if tele then
			for _, w in tele.wheels do
				if w.spinning then
					revs = math.min(revs + 0.25, 1)
					break
				end
			end
		end
		revBar.Size = UDim2.new(revs, 0, 1, 0)
		revBar.BackgroundColor3 = if revs > 0.92 then RED elseif revs > 0.75 then ACCENT else GREEN
		gearText.Text = if tele and tele.reverse then "R" else "D"
		slipText.Visible = tele ~= nil and tele.draft > 0.25
	end

	-- warnings
	local warn = ""
	if driving and state ~= "Grid" and state ~= "Results" then
		if player:GetAttribute("OffCourse") then
			warn = "OFF TRACK  -  PRESS R TO RETURN"
		elseif player:GetAttribute("WrongWay") then
			warn = "WRONG WAY"
		end
	end
	warnText.Text = warn
	warnText.Visible = warn ~= ""

	-- start lights, with a beep for each one
	local lightsStart = workspace:GetAttribute("LightsStart") :: number?
	local count = 0
	lightsFrame.Visible = false
	if state == "Grid" and lightsStart then
		lightsFrame.Visible = true
		count = math.clamp(math.floor(t - lightsStart) + 1, 0, 5)
	end
	if count ~= wasLightsCount then
		if count > wasLightsCount and count > 0 then
			Sfx.play("Beep")
		end
		wasLightsCount = count
		setLights(count)
	end

	-- minimap dots
	local karts = workspace:FindFirstChild("Karts")
	if karts and mapSize > 0 then
		for _, m in karts:GetChildren() do
			if m:IsA("Model") and m.PrimaryPart then
				local d = mapDot(m)
				local p = mapPoint(m.PrimaryPart.Position.X, m.PrimaryPart.Position.Z)
				d.Position = UDim2.fromOffset(p.X, p.Y)
			end
		end
	end
	for m, d in mapDots do
		if not m.Parent then
			d:Destroy()
			mapDots[m] = nil
		end
	end

	-- drive / walk button (practice only)
	local practicing = state == "Practice" or state == "Intermission"
	driveButton.Visible = practicing and not UserInputService.GamepadEnabled
	driveButton.Text = if KartController.kart() then "WALK  [K]" else "DRIVE  [K]"
	updateTrackPanel(state, remaining)
	spectateBar.Visible = state == "Racing" and not inRace and #standings > 0
	hintText.Visible = driving and not UserInputService.TouchEnabled
	standingsPanel.Visible = #standings > 0 and (state == "Racing" or qualifying)
end

local function updateStandings(list: { any }, mode: string)
	standings = list
	standingsMode = mode
	for i, row in standingsRows do
		local e = list[i]
		row.Visible = e ~= nil
		if e then
			local chip = row:FindFirstChild("Chip") :: Frame
			local nameL = row:FindFirstChild("Name") :: TextLabel
			local gapL = row:FindFirstChild("Gap") :: TextLabel
			chip.BackgroundColor3 = e.color or WHITE
			nameL.Text = string.format("#%d %s", e.number or 0, e.name or "?")
			nameL.TextColor3 = if e.userId == player.UserId then ACCENT else WHITE
			local gap = ""
			if mode == "quali" then
				if not e.best then
					gap = "NO TIME"
				elseif i == 1 then
					gap = fmt(e.best)
				else
					gap = string.format("+%.3f", e.gap or 0)
				end
			elseif e.finished then
				gap = fmt(e.time)
			elseif e.dnf then
				gap = "DNF"
			elseif i == 1 then
				gap = "LAP " .. tostring(e.lap)
			elseif e.gap then
				-- studs to seconds at a typical race pace (about 70 studs/s)
				gap = string.format("+%.1fs", e.gap / 70)
			end
			if mode ~= "quali" and not e.finished and e.penalty and e.penalty > 0 then
				gap ..= string.format(" P%d", e.penalty)
			end
			gapL.Text = gap
		end
	end
end

local function spectateStep(dir: number)
	if #standings == 0 or standingsMode ~= "race" then
		return
	end
	spectateIndex = (spectateIndex + dir - 1) % #standings + 1
	local e = standings[spectateIndex]
	local karts = workspace:FindFirstChild("Karts")
	local model = karts and karts:FindFirstChild("Kart_" .. tostring(e.userId))
	local chassis = model and (model :: Model).PrimaryPart
	ChaseCamera.spectate(chassis)
	spectateText.Text = string.format("WATCHING  #%d %s", e.number or 0, e.name or "?")
end

----------------------------------------------------------------------------
-- messages from the server
----------------------------------------------------------------------------
local function onLap(data: any)
	lastLap = data.time
	local clean = data.time ~= nil and not data.invalid
	if clean and (not sessionBest or data.time <= sessionBest) then
		sessionBest = data.time
		bestProfile = curProfile
	end
	-- a personal best or the fastest lap of the session gets its own chime
	if not ((data.pb or data.colour == "purple") and not data.invalid and Sfx.play("Best")) then
		Sfx.play("Lap")
	end
	local label = if data.final then "FINAL LAP" else string.format("LAP %d", data.lap or 0)
	if data.invalid then
		showToast(string.format("%s   %s   DELETED - TRACK LIMITS", label, fmt(data.time)), RED, 3.5)
	elseif data.time then
		local purple = data.colour == "purple"
		local tag = if purple then "   FASTEST" elseif data.pb then "   PERSONAL BEST" else ""
		showToast(string.format("%s   %s%s", label, fmt(data.time), tag), if purple or data.pb then PURPLE else WHITE, 3.5)
	end
end

local function onTrackLimits(data: any)
	local punished = data.deleted or (data.added or 0) > 0
	if not Sfx.play(if punished then "Penalty" else "Warning") then
		Sfx.play("Beep")
	end
	if data.deleted then
		lapInvalid = true
		showToast("TRACK LIMITS  -  LAP DELETED", RED, 3)
	elseif (data.added or 0) > 0 then
		showToast(string.format("TRACK LIMITS  -  +%d s PENALTY  (TOTAL +%d s)", data.added, data.penalty or data.added), RED, 3.5)
	else
		showToast(string.format("TRACK LIMITS  -  WARNING %d/%d", data.warnings or 1, data.max or 3), ORANGE, 3)
	end
end

local function onRaceEvent(kind: string, data: any)
	if kind == "LapStart" then
		lapStart = data.time
		lapInvalid = false
		curProfile = {}
		deltaHint = nil
	elseif kind == "Sector" then
		setSector(data.index, data.time, data.colour)
	elseif kind == "Lap" then
		onLap(data)
	elseif kind == "TrackLimits" then
		onTrackLimits(data)
	elseif kind == "Qualifying" then
		Sfx.play("Flag")
		resetSession()
		showBig("QUALIFYING", ACCENT, 2)
		showToast("ONE TIMED LAP  -  GHOSTS ON  -  THE CLOCK STARTS AT THE LINE", WHITE, 4)
	elseif kind == "Chequered" then
		Sfx.play("Flag")
		showToast("CHEQUERED FLAG  -  FINISH YOUR LAP", WHITE, 3)
	elseif kind == "QualiDone" then
		if data.best then
			local place = if data.place then string.format("  -  P%d SO FAR", data.place) else ""
			showToast(string.format("QUALIFYING LAP  %s%s", fmt(data.best), place), ACCENT, 4)
		else
			showToast("NO TIME  -  YOU START AT THE BACK", RED, 4)
		end
	elseif kind == "QualiResult" then
		local pole = data.list and data.list[1]
		if pole and pole.best then
			showBig("POLE: " .. string.upper(pole.name or "?"), PURPLE, 2.5)
			showToast(string.format("POLE POSITION  %s  %s", pole.name or "?", fmt(pole.best)), PURPLE, 4)
		end
		standings = {}
		resetSession()
	elseif kind == "AllReady" then
		showToast("EVERYONE IS READY  -  STARTING", GREEN, 2.5)
	elseif kind == "Go" then
		setLights(0)
		wasLightsCount = 0
		Sfx.play("Go")
		showBig("GO!", GREEN, 1.2)
		resetSession()
	elseif kind == "Finish" then
		if data.userId == player.UserId then
			Sfx.play("Finish")
			showBig(string.format("FINISHED %s", ordinal(data.position)), if data.position == 1 then ACCENT else WHITE, 4)
		elseif data.position == 1 then
			showToast(string.format("%s WINS!  %s", data.name, fmt(data.time)), ACCENT, 4)
		end
	elseif kind == "Results" then
		Sfx.play("Podium")
		standingsPanel.Visible = false
		standings = {}
		showResults(data.list or {})
		lapStart = nil
	elseif kind == "Standings" then
		updateStandings(data.list or {}, data.mode or "race")
	elseif kind == "Record" then
		-- your own record lap already chimed as a personal best
		if data.name ~= player.DisplayName then
			Sfx.play("Best")
		end
		showToast(string.format("NEW TRACK RECORD  %s  %s", data.name, fmt(data.time)), PURPLE, 5)
	elseif kind == "Reset" then
		KartController.onTeleported()
	elseif kind == "Track" then
		resetSession()
		trackPanelOpen = false
		showToast(string.format("TRACK: %s  -  %d LAPS", string.upper(data.name or "?"), data.laps or 3), ACCENT, 4)
	end
end

-- the circuit in use changed (or the HUD starts): redraw what depends on it
local function onTrackChanged()
	local id = (workspace:GetAttribute("Track") :: string?) or TrackData.Default
	if id == trackId then
		return
	end
	trackId = id
	track = trackFor(id)
	deltaHint = nil
	drawMinimap()
	task.defer(findGantry)
end

----------------------------------------------------------------------------
-- build
----------------------------------------------------------------------------
local function buildTiming()
	timePanel = panel(gui, "Timing", UDim2.fromOffset(292, 150), UDim2.fromOffset(16, 112))
	timePanel.BackgroundTransparency = 0.12
	local function caption(name: string, str: string, y: number)
		fixed(timePanel, name, str, UDim2.fromOffset(40, 16), UDim2.fromOffset(12, y), 12, false, MUTED)
	end
	-- current lap (big) and the delta to the best lap
	caption("LapLabel", "LAP", 13)
	curLapText = fixed(timePanel, "Cur", "", UDim2.fromOffset(136, 30), UDim2.fromOffset(52, 6), 26, true, WHITE)
	deltaText = fixed(timePanel, "Delta", "", UDim2.fromOffset(96, 30), UDim2.fromOffset(184, 6), 20, true, GREEN, Enum.TextXAlignment.Right)
	-- sector boxes
	local boxW = math.floor((292 - 24 - 8) / 3)
	for i = 1, 3 do
		local b = fixed(timePanel, "S" .. i, "S" .. i, UDim2.fromOffset(boxW, 22), UDim2.fromOffset(12 + (i - 1) * (boxW + 4), 42), 15, true, MUTED, Enum.TextXAlignment.Center)
		b.BackgroundTransparency = 0
		b.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
		corner(b, 4)
		sectorBoxes[i] = b
	end
	-- last, best and the track record
	caption("LastLabel", "LAST", 75)
	lastLapText = fixed(timePanel, "Last", "", UDim2.fromOffset(120, 22), UDim2.fromOffset(52, 72), 18, true, LIGHT)
	caption("BestLabel", "BEST", 99)
	bestLapText = fixed(timePanel, "Best", "", UDim2.fromOffset(120, 22), UDim2.fromOffset(52, 96), 18, true, PURPLE)
	caption("RecLabel", "REC", 123)
	recordText = fixed(timePanel, "Rec", "", UDim2.fromOffset(96, 20), UDim2.fromOffset(52, 121), 15, true, ACCENT)
	recordHolder = fixed(timePanel, "RecHolder", "", UDim2.fromOffset(130, 20), UDim2.fromOffset(150, 121), 13, false, MUTED)
end

local function buildSpeed()
	-- bottom right, or bottom centre on touch screens where the buttons sit
	local touchScreen = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	speedPanel = panel(gui, "Speed", UDim2.fromOffset(190, 92), if touchScreen then UDim2.new(0.5, 0, 1, -16) else UDim2.new(1, -16, 1, -16), if touchScreen then Vector2.new(0.5, 1) else Vector2.new(1, 1))
	speedText = text(speedPanel, "Value", "0", UDim2.fromOffset(120, 54), UDim2.fromOffset(12, 6), Enum.Font.GothamBlack, WHITE, Enum.TextXAlignment.Right)
	unitText = text(speedPanel, "Unit", "KM/H", UDim2.fromOffset(46, 18), UDim2.fromOffset(136, 34), Enum.Font.GothamBold, MUTED)
	gearText = text(speedPanel, "Gear", "D", UDim2.fromOffset(30, 26), UDim2.fromOffset(142, 6), Enum.Font.GothamBlack, ACCENT, Enum.TextXAlignment.Center)
	local revBack = Instance.new("Frame")
	revBack.Size = UDim2.new(1, -24, 0, 10)
	revBack.Position = UDim2.new(0, 12, 1, -20)
	revBack.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
	revBack.BorderSizePixel = 0
	corner(revBack, 4)
	revBack.Parent = speedPanel
	revBar = Instance.new("Frame")
	revBar.Size = UDim2.fromScale(0, 1)
	revBar.BackgroundColor3 = GREEN
	revBar.BorderSizePixel = 0
	corner(revBar, 4)
	revBar.Parent = revBack
	slipText = text(speedPanel, "Slipstream", "SLIPSTREAM", UDim2.fromOffset(160, 20), UDim2.new(0.5, -80, 0, -26), Enum.Font.GothamBlack, Color3.fromRGB(120, 200, 255), Enum.TextXAlignment.Center)
	slipText.Visible = false
	textStroke(slipText, 2)
end

function Hud.init(remotes: Folder)
	requestRemote = remotes:WaitForChild("Request") :: RemoteEvent
	trackId = (workspace:GetAttribute("Track") :: string?) or TrackData.Default
	track = trackFor(trackId)
	gui = Instance.new("ScreenGui")
	gui.Name = "RaceHud"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	uiScale = Instance.new("UIScale")
	uiScale.Parent = gui

	-- banner
	banner = panel(gui, "Banner", UDim2.fromOffset(660, 40), UDim2.new(0.5, 0, 0, 12), Vector2.new(0.5, 0))
	bannerText = text(banner, "Text", "", UDim2.new(1, -24, 1, -14), UDim2.fromOffset(12, 7), Enum.Font.GothamBold, WHITE, Enum.TextXAlignment.Center)

	-- position
	posPanel = panel(gui, "Position", UDim2.fromOffset(200, 86), UDim2.fromOffset(16, 16))
	posText = text(posPanel, "Pos", "P1", UDim2.fromOffset(100, 56), UDim2.fromOffset(12, 6), Enum.Font.GothamBlack, ACCENT)
	posOf = text(posPanel, "Of", "/1", UDim2.fromOffset(60, 28), UDim2.fromOffset(112, 28), Enum.Font.GothamBold, MUTED)
	lapText = text(posPanel, "Lap", "LAP 1/3", UDim2.fromOffset(176, 20), UDim2.fromOffset(12, 60), Enum.Font.GothamBold, WHITE)

	buildTiming()
	buildSpeed()

	-- centre texts
	warnText = text(gui, "Warning", "", UDim2.fromOffset(700, 44), UDim2.new(0.5, -350, 0, 216), Enum.Font.GothamBlack, RED, Enum.TextXAlignment.Center)
	textStroke(warnText, 2)
	bigText = text(gui, "Big", "", UDim2.fromOffset(700, 90), UDim2.new(0.5, -350, 0, 158), Enum.Font.GothamBlack, WHITE, Enum.TextXAlignment.Center)
	bigText.Visible = false
	textStroke(bigText, 3)
	toast = text(gui, "Toast", "", UDim2.fromOffset(760, 34), UDim2.new(0.5, -380, 0, 64), Enum.Font.GothamBlack, WHITE, Enum.TextXAlignment.Center)
	toast.Visible = false
	textStroke(toast, 2)
	toastStroke = toast:FindFirstChildOfClass("UIStroke") :: UIStroke

	-- start lights
	lightsFrame = panel(gui, "Lights", UDim2.fromOffset(330, 78), UDim2.new(0.5, 0, 0, 104), Vector2.new(0.5, 0))
	lightsFrame.Visible = false
	for i = 1, 5 do
		local d = Instance.new("Frame")
		d.Size = UDim2.fromOffset(50, 50)
		d.Position = UDim2.fromOffset(14 + (i - 1) * 62, 14)
		d.BackgroundColor3 = Color3.fromRGB(40, 12, 12)
		d.BorderSizePixel = 0
		corner(d, 25)
		stroke(d, Color3.new(0, 0, 0), 3, 0)
		d.Parent = lightsFrame
		lightDots[i] = d
	end

	buildMinimap()
	buildStandings()
	buildResults()
	buildTrackPanel()

	-- drive / walk and track buttons (the SETTINGS button sits after them)
	driveButton = bigButton(gui, "Drive", "DRIVE", UDim2.fromOffset(150, 40), UDim2.new(0, 16, 1, -16), ACCENT)
	driveButton.AnchorPoint = Vector2.new(0, 1)
	driveButton.Activated:Connect(function()
		Sfx.play("Click")
		requestRemote:FireServer("Kart")
	end)
	trackButton = bigButton(gui, "TrackButton", "TRACK  [M]", UDim2.fromOffset(180, 40), UDim2.new(0, 176, 1, -16), Color3.fromRGB(230, 232, 240))
	trackButton.AnchorPoint = Vector2.new(0, 1)
	trackButton.Visible = false
	trackButton.Activated:Connect(onTracksKey)
	if UserInputService.TouchEnabled then
		-- keep clear of the steering buttons
		driveButton.Position = UDim2.new(0, 16, 0, 240)
		driveButton.AnchorPoint = Vector2.zero
		trackButton.Position = UDim2.new(0, 16, 0, 288)
		trackButton.AnchorPoint = Vector2.zero
		-- the track / vote / room panel at the top in the middle, under the
		-- banner: down the left it covered the steering buttons
		trackPanel.Position = UDim2.fromOffset(0, 58)
	else
		-- in the middle under the banner too: nine cards in two columns are
		-- too tall for the space under the lap times
		trackPanel.Position = UDim2.fromOffset(0, 118)
	end

	-- spectate bar
	spectateBar = panel(gui, "Spectate", UDim2.fromOffset(360, 44), UDim2.new(0.5, 0, 1, -16), Vector2.new(0.5, 1))
	spectateBar.Visible = false
	spectateText = text(spectateBar, "Who", "WATCHING", UDim2.new(1, -110, 1, -16), UDim2.fromOffset(55, 8), Enum.Font.GothamBold, WHITE, Enum.TextXAlignment.Center)
	type ArrowSpec = { label: string, dir: number, pos: UDim2 }
	local arrows: { ArrowSpec } = {
		{ label = "<", dir = -1, pos = UDim2.fromOffset(6, 6) },
		{ label = ">", dir = 1, pos = UDim2.new(1, -46, 0, 6) },
	}
	for _, spec in arrows do
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromOffset(40, 32)
		b.Position = spec.pos
		b.Text = spec.label
		b.Font = Enum.Font.GothamBlack
		b.TextScaled = true
		b.TextColor3 = PANEL
		b.BackgroundColor3 = ACCENT
		corner(b, 6)
		b.Parent = spectateBar
		b.Activated:Connect(function()
			spectateStep(spec.dir)
		end)
	end

	-- keyboard hint while driving
	hintText = text(gui, "Hint", "W/S gas-brake   A/D steer   R reset   wheel/C camera   right-drag rotate   V reset view   M track", UDim2.fromOffset(640, 18), UDim2.new(0.5, 0, 1, -10), Enum.Font.GothamMedium, MUTED, Enum.TextXAlignment.Center)
	hintText.AnchorPoint = Vector2.new(0.5, 1)

	-- whole-pixel scale, and centred elements snapped to whole pixels
	local toCentre: { GuiObject } = { banner, warnText, bigText, toast, lightsFrame, spectateBar, hintText, trackPanel }
	for _, obj in toCentre do
		centre(obj)
	end
	if speedPanel.AnchorPoint.X == 0.5 then
		centre(speedPanel)
	end
	local function rescale()
		uiScale.Scale = Settings.pixelScale(workspace.CurrentCamera.ViewportSize)
		placeCentred()
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	hintText.TextTransparency = 0.2

	Input.onAction("SpectateNext", function()
		spectateStep(1)
	end)
	Input.onAction("SpectatePrev", function()
		spectateStep(-1)
	end)
	Input.onAction("Tracks", onTracksKey)
	Input.onAction("TrackNext", onTrackNext)
	for n = 1, 9 do
		Input.onAction("Track" .. n, function()
			onTrackNumber(n)
		end)
	end

	Settings.onChange(function(key)
		if key == "Minimap" then
			drawMinimap()
		end
	end)

	findGantry()
	workspace:GetAttributeChangedSignal("TrackReady"):Connect(findGantry)
	workspace:GetAttributeChangedSignal("Track"):Connect(onTrackChanged)
	workspace:GetAttributeChangedSignal("RaceState"):Connect(function()
		local s = workspace:GetAttribute("RaceState")
		if s ~= "Racing" then
			ChaseCamera.spectate(nil)
		end
		if s == "Grid" then
			resetLap()
			findGantry()
		elseif s == "Intermission" then
			trackPanelClosed = false
			standings = {}
		elseif s == "Practice" then
			standings = {}
			trackPanelClosed = false
		end
	end)
	local raceEvent = remotes:WaitForChild("RaceEvent") :: RemoteEvent
	raceEvent.OnClientEvent:Connect(onRaceEvent)
	RunService.RenderStepped:Connect(update)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--!strict
-- Driver input from keyboard, gamepad and on-screen touch buttons, merged
-- into one Controls table for KartPhysics. Also raises one-shot actions
-- (reset, camera) through callbacks.

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local PEDALS = Config.Pedals

local Input = {}

-- `steer` is the raw request; `digital` says it came from keys or touch
-- buttons (KartController smooths those, see SteerFilter).
export type Controls = { throttle: number, brake: number, steer: number, digital: boolean }

local controls: Controls = { throttle = 0, brake = 0, steer = 0, digital = true }
local touch = { left = false, right = false, gas = false, brake = false }
-- the touches (or clicks) holding each on-screen button. A button's own
-- InputEnded does not fire when the finger slides off it before lifting, and
-- with a press counter that left the button held for good (the kart kept
-- steering in circles with no finger on the screen). So a touch is dropped
-- when UserInputService says it ended, and every frame once its state is End.
local holders: { [string]: { [InputObject]: boolean } } = { left = {}, right = {}, gas = {}, brake = {} }
local buttons: { [string]: GuiObject } = {}
local actions: { [string]: () -> () } = {}
local touchGui: ScreenGui? = nil
local enabled = false
local kbThrottle, kbBrake = 0, 0

local DEADZONE = 0.12

local function fireAction(name: string)
	local f = actions[name]
	if f then
		f()
	end
end

function Input.onAction(name: string, callback: () -> ())
	actions[name] = callback
end

local function axis(v: number): number
	if math.abs(v) < DEADZONE then
		return 0
	end
	return (v - math.sign(v) * DEADZONE) / (1 - DEADZONE)
end

local function ended(io: InputObject): boolean
	local st = io.UserInputState
	return st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel
end

-- touch.<key> from the touches still holding each button
local function refreshTouch()
	for key, set in holders do
		for io in set do
			if ended(io) then
				set[io] = nil
			end
		end
		local on = next(set) ~= nil
		(touch :: any)[key] = on
		local b = buttons[key]
		if b then
			b.BackgroundTransparency = if on then 0.1 else 0.35
		end
	end
end

local function releaseInput(io: InputObject)
	for _, set in holders do
		set[io] = nil
	end
	refreshTouch()
end

local function releaseAll()
	for _, set in holders do
		table.clear(set)
	end
	refreshTouch()
end

-- Call once per frame while driving.
function Input.update(dt: number): Controls
	if not enabled then
		controls.throttle, controls.brake, controls.steer = 0, 0, 0
		return controls
	end
	refreshTouch()
	local typing = UserInputService:GetFocusedTextBox() ~= nil
	local function down(...: Enum.KeyCode): boolean
		if typing then
			return false
		end
		for _, k in { ... } do
			if UserInputService:IsKeyDown(k) then
				return true
			end
		end
		return false
	end
	-- keys and touch buttons are on/off: throttle and brake ramp in (Config.Pedals)
	local wantGas = down(Enum.KeyCode.W, Enum.KeyCode.Up) or touch.gas
	local wantBrake = down(Enum.KeyCode.S, Enum.KeyCode.Down) or touch.brake
	kbThrottle = if wantGas then math.min(kbThrottle + dt * PEDALS.ThrottleRise, 1) else 0
	kbBrake = if wantBrake then math.min(kbBrake + dt * PEDALS.BrakeRise, 1) else 0
	local kbSteer = (if down(Enum.KeyCode.D, Enum.KeyCode.Right) then 1 else 0) - (if down(Enum.KeyCode.A, Enum.KeyCode.Left) then 1 else 0)

	-- gamepad: analog triggers and stick
	local padThrottle, padBrake, padSteer = 0, 0, 0
	if UserInputService:GetGamepadConnected(Enum.UserInputType.Gamepad1) then
		for _, obj in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
			if obj.KeyCode == Enum.KeyCode.ButtonR2 then
				padThrottle = obj.Position.Z
			elseif obj.KeyCode == Enum.KeyCode.ButtonL2 then
				padBrake = obj.Position.Z
			elseif obj.KeyCode == Enum.KeyCode.Thumbstick1 then
				padSteer = axis(obj.Position.X)
			end
		end
	end

	-- touch buttons
	local tSteer = (if touch.right then 1 else 0) - (if touch.left then 1 else 0)

	controls.throttle = math.clamp(math.max(kbThrottle, padThrottle), 0, 1)
	controls.brake = math.clamp(math.max(kbBrake, padBrake), 0, 1)
	controls.steer = math.clamp(kbSteer + padSteer + tSteer, -1, 1)
	controls.digital = padSteer == 0
	return controls
end

function Input.get(): Controls
	return controls
end

----------------------------------------------------------------------------
-- Touch controls
----------------------------------------------------------------------------
local function makeButton(parent: Instance, name: string, text: string, pos: UDim2, size: UDim2, color: Color3): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = text
	b.Font = Enum.Font.GothamBlack
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.BackgroundColor3 = color
	b.BackgroundTransparency = 0.35
	b.AutoButtonColor = false
	b.Position = pos
	b.Size = size
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Transparency = 0.5
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.28, 0)
	pad.PaddingBottom = UDim.new(0.28, 0)
	pad.Parent = b
	local ratio = Instance.new("UIAspectRatioConstraint")
	ratio.Parent = b
	b.Parent = parent
	return b
end

local function hold(button: TextButton, key: string)
	buttons[key] = button
	button.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			holders[key][io] = true
			refreshTouch()
		end
	end)
	button.InputEnded:Connect(function(io)
		if holders[key][io] then
			holders[key][io] = nil
			refreshTouch()
		end
	end)
end

local function buildTouch()
	if touchGui then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "TouchDrive"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local s = UDim2.fromScale(0, 0.2)
	local left = makeButton(gui, "Left", "<", UDim2.fromScale(0.09, 0.8), s, Color3.fromRGB(40, 40, 46))
	local right = makeButton(gui, "Right", ">", UDim2.fromScale(0.23, 0.8), s, Color3.fromRGB(40, 40, 46))
	local gas = makeButton(gui, "Gas", "GAS", UDim2.fromScale(0.9, 0.74), UDim2.fromScale(0, 0.24), Color3.fromRGB(30, 150, 70))
	local brake = makeButton(gui, "Brake", "BRK", UDim2.fromScale(0.76, 0.84), UDim2.fromScale(0, 0.17), Color3.fromRGB(190, 40, 40))
	-- small buttons near the pedals, clear of the minimap/standings (top right)
	-- and the speedometer (bottom centre on touch screens)
	local reset = makeButton(gui, "Reset", "R", UDim2.fromScale(0.765, 0.62), UDim2.fromScale(0, 0.1), Color3.fromRGB(60, 60, 70))
	local cam = makeButton(gui, "Camera", "CAM", UDim2.fromScale(0.645, 0.86), UDim2.fromScale(0, 0.1), Color3.fromRGB(60, 60, 70))
	for _, b in { left, right, gas, brake, reset, cam } do
		-- sizes are a fraction of screen height, kept square
		b.SizeConstraint = Enum.SizeConstraint.RelativeYY
		b.Size = UDim2.fromScale(b.Size.Y.Scale, b.Size.Y.Scale)
	end
	hold(left, "left")
	hold(right, "right")
	hold(gas, "gas")
	hold(brake, "brake")
	reset.Activated:Connect(function()
		fireAction("Reset")
	end)
	cam.Activated:Connect(function()
		fireAction("Camera")
	end)
	touchGui = gui
end

function Input.setEnabled(on: boolean)
	enabled = on
	if not on then
		releaseAll()
		kbThrottle, kbBrake = 0, 0
	end
	if touchGui then
		touchGui.Enabled = on and UserInputService.TouchEnabled
	end
end

function Input.init()
	if UserInputService.TouchEnabled then
		buildTouch()
	end
	-- a touch can end anywhere on the screen, not only over its button
	UserInputService.InputEnded:Connect(releaseInput)
	UserInputService.TouchEnded:Connect(function(io)
		releaseInput(io)
	end)
	-- switching apps mid-press never sends the ends
	UserInputService.WindowFocusReleased:Connect(releaseAll)
	UserInputService.InputBegan:Connect(function(io, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		local k = io.KeyCode
		if k == Enum.KeyCode.R or k == Enum.KeyCode.ButtonY then
			if enabled then
				fireAction("Reset")
			end
		elseif k == Enum.KeyCode.C or k == Enum.KeyCode.ButtonX then
			fireAction("Camera")
		elseif k == Enum.KeyCode.K or k == Enum.KeyCode.ButtonSelect then
			fireAction("Kart")
		elseif k == Enum.KeyCode.Q or k == Enum.KeyCode.DPadLeft then
			fireAction("SpectatePrev")
		elseif k == Enum.KeyCode.E or k == Enum.KeyCode.DPadRight then
			fireAction("SpectateNext")
		elseif k == Enum.KeyCode.M then
			fireAction("Tracks")
		elseif k == Enum.KeyCode.ButtonB then
			fireAction("TrackNext")
		else
			-- number keys pick a track on the track panel
			local digits = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine }
			local n = table.find(digits, k)
			if n then
				fireAction("Track" .. n)
			end
		end
	end)
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">KartController</string>
            <string name="Source"><![CDATA[--!strict
-- Drives the local player's kart. Every physics frame it runs KartPhysics
-- (the same code the headless tests drive) and writes the result into the
-- chassis' VectorForce and Torque. The client owns the kart's physics, so
-- this is what moves it; the server only places and watches.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local KartPhysics = require(Shared:WaitForChild("KartPhysics"))
local SteerFilter = require(Shared:WaitForChild("SteerFilter"))
local Input = require(script.Parent:WaitForChild("Input"))
local Settings = require(script.Parent:WaitForChild("Settings"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local KartController = {}

local player = Players.LocalPlayer
-- per-player copies: the steering assist and the key steering speed are settings
local cfg = table.clone(Config.Kart)
local steerCfg = table.clone(Config.Steering)
local SCALED_STEERING = { "RiseLow", "RiseHigh", "ReturnLow", "ReturnHigh", "Counter" }

local function applySettings()
	cfg.SteerAssist = Settings.get("SteerAssist") ~= false
	local k = (Settings.get("SteerSpeed") :: number?) or 1
	for _, key in SCALED_STEERING do
		(steerCfg :: any)[key] = (Config.Steering :: any)[key] * k
	end
end

local kart: Model? = nil
local chassis: BasePart? = nil
local seat: Seat? = nil
local driveForce: VectorForce? = nil
local spinTorque: Torque? = nil
local state = KartPhysics.newState(cfg)
local steerState = SteerFilter.new()
local physControls: KartPhysics.Controls = { throttle = 0, brake = 0, steer = 0 }
local telemetry: KartPhysics.Result? = nil
local wasContact = false
local driving = false
local flipTimer = 0
local lastResetRequest = 0
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.IgnoreWater = true

local listeners: { (boolean) -> () } = {}
local requestRemote: RemoteEvent? = nil
local controlsModule: any = nil

local function vec(v: Vector3): vector
	return (v :: any) :: vector
end
local function v3(v: vector): Vector3
	return (v :: any) :: Vector3
end

-- Grip per surface: the part's "Surface" attribute names a Config.Surfaces
-- entry (the circuit builder sets it); otherwise the material name is used.
local surfaceCache: { [Instance]: { grip: number, roll: number } } = setmetatable({}, { __mode = "k" }) :: any
local function surfaceOf(inst: Instance, material: Enum.Material): { grip: number, roll: number }
	local s = surfaceCache[inst]
	if not s then
		local surfaces = Config.Surfaces :: any
		local name = inst:GetAttribute("Surface")
		s = (if type(name) == "string" then surfaces[name] else nil) or surfaces[material.Name] or surfaces.Default
		if inst:IsA("BasePart") and not inst:IsA("Terrain") then
			surfaceCache[inst] = s :: any
		end
	end
	return s :: any
end

-- Two rays a few centimetres apart per wheel, keeping the nearer hit: a single
-- ray can slip through the hairline seam between two road pieces and read the
-- ground as lower than it is for one frame, which felt like a bump.
local SEAM_OFFSET = Vector3.new(0.09, 0, 0.07)
local function raycast(origin: vector, dir: vector): KartPhysics.Hit?
	local o = v3(origin)
	local d = v3(dir)
	local r = workspace:Raycast(o, d, rayParams)
	local r2 = workspace:Raycast(o + SEAM_OFFSET, d, rayParams)
	if r2 and (not r or r2.Distance < r.Distance) then
		r = r2
	end
	if not r then
		return nil
	end
	local s = surfaceOf(r.Instance, r.Material)
	return { dist = r.Distance, normal = vec(r.Normal), grip = s.grip, roll = s.roll }
end

local function refreshRayFilter()
	local list: { Instance } = { workspace.Terrain }
	local circuit = workspace:FindFirstChild("Circuit")
	local track = circuit and circuit:FindFirstChild("Track")
	if track then
		table.insert(list, track)
	end
	rayParams.FilterDescendantsInstances = list
end

local function setControls(on: boolean)
	if not controlsModule then
		local ok, pm = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		end)
		if ok and pm then
			controlsModule = pm:GetControls()
		end
	end
	if controlsModule then
		if on then
			controlsModule:Enable()
		else
			controlsModule:Disable()
		end
	end
end

local function setJump(humanoid: Humanoid?, allowed: boolean)
	if not humanoid then
		return
	end
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, allowed)
	humanoid.JumpHeight = if allowed then 7.2 else 0
end

local function setDriving(on: boolean)
	if driving == on then
		return
	end
	driving = on
	local character = player.Character
	setJump(character and character:FindFirstChildOfClass("Humanoid"), not on)
	setControls(not on)
	Input.setEnabled(on)
	state = KartPhysics.newState(cfg)
	steerState = SteerFilter.new()
	flipTimer = 0
	for _, f in listeners do
		task.spawn(f, on)
	end
end

function KartController.onDrivingChanged(f: (boolean) -> ())
	table.insert(listeners, f)
end

function KartController.isDriving(): boolean
	return driving
end

function KartController.kart(): Model?
	return kart
end

function KartController.chassis(): BasePart?
	return chassis
end

function KartController.telemetry(): KartPhysics.Result?
	return telemetry
end

function KartController.requestReset()
	if not driving or not requestRemote then
		return
	end
	if os.clock() - lastResetRequest < Config.Race.ResetCooldown then
		return
	end
	lastResetRequest = os.clock()
	requestRemote:FireServer("Reset")
end

-- called by the server's "Reset" message: the kart was teleported
function KartController.onTeleported()
	state = KartPhysics.newState(cfg)
	flipTimer = 0
end

local function attach(model: Model)
	kart = model
	chassis = model:WaitForChild("Chassis", 5) :: BasePart?
	seat = model:WaitForChild("DriverSeat", 5) :: Seat?
	local c = chassis
	if c then
		driveForce = c:WaitForChild("Drive", 5) :: VectorForce?
		spinTorque = c:WaitForChild("Spin", 5) :: Torque?
	end
	refreshRayFilter()
end

local function detach()
	kart, chassis, seat, driveForce, spinTorque, telemetry = nil, nil, nil, nil, nil, nil
	setDriving(false)
end

local function isMine(model: Instance): boolean
	return model:IsA("Model") and model:GetAttribute("Owner") == player.UserId
end

-- Other karts near ours, for the bumpers. Their positions arrive late (their
-- driver -> server -> us), so each is moved ahead along its velocity by
-- about that delay (Config.Collision), and our own recent bumper pushes are
-- mirrored onto it (KartPhysics.echoApply: it got the opposite push, which
-- its late snapshot does not show yet).
local CC = Config.Collision
local kartsFolder: Instance? = nil
local myPing, pingAge = 0.1, math.huge
local others: { KartPhysics.Obstacle } = {}
local otherKarts: { Model } = {} -- same order as `others`
local echo: KartPhysics.Echo = setmetatable(KartPhysics.newEcho(), { __mode = "k" }) :: any
local function nearbyKarts(dt: number, here: Vector3, t: number): { KartPhysics.Obstacle }
	table.clear(others)
	table.clear(otherKarts)
	local folder = kartsFolder
	-- ghosts (qualifying, or our kart just reset onto another): nothing to
	-- bump into or draft behind
	if not folder or workspace:GetAttribute("Ghost") or (kart and kart:GetAttribute("Ghost")) then
		return others
	end
	pingAge += dt
	if pingAge > 1 then
		pingAge = 0
		myPing = player:GetNetworkPing()
	end
	for _, m in folder:GetChildren() do
		if m == kart or not m:IsA("Model") or m:GetAttribute("Ghost") then
			continue
		end
		local c = m.PrimaryPart
		if not c then
			continue
		end
		local d = c.Position - here
		-- (and not on the other level of a crossing: KartPhysics ignores those)
		if d.X * d.X + d.Z * d.Z > CC.Range * CC.Range or math.abs(d.Y) > 8 then
			continue
		end
		local vel = c.AssemblyLinearVelocity
		local lead = 0
		if not c.Anchored then
			local owner = Players:GetPlayerByUserId((m:GetAttribute("Owner") :: number?) or 0)
			local theirPing = (owner and owner:GetAttribute("Ping") :: number?) or myPing
			lead = math.clamp(CC.Lead + CC.PingShare * (myPing + theirPing), 0, CC.LeadMax)
		end
		local o: KartPhysics.Obstacle = {
			pos = vec(c.Position + vel * lead),
			look = vec(c.CFrame.LookVector),
			vel = vec(vel),
			angVel = vec(c.AssemblyAngularVelocity),
		}
		if lead > 0 then
			o = KartPhysics.echoApply(echo, m, o, t, lead + dt)
		end
		table.insert(others, o)
		table.insert(otherKarts, m)
	end
	return others
end

local function physicsStep(dt: number)
	local c, vf, tq = chassis, driveForce, spinTorque
	if not (kart and c and vf and tq and c.Parent) then
		if kart and not (kart.Parent) then
			detach()
		end
		return
	end
	-- driving = our humanoid sits in this kart's seat
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seated = humanoid ~= nil and seat ~= nil and humanoid.SeatPart == seat
	setDriving(seated)
	local ctrl = Input.update(dt)
	if not seated or c.Anchored then
		vf.Force = Vector3.zero
		tq.Torque = Vector3.zero
		telemetry = nil
		steerState = SteerFilter.new()
		return
	end
	local cf = c.CFrame
	-- keys ramp the steering in (speed-sensitive), the stick stays analog
	local forwardSpeed = c.AssemblyLinearVelocity:Dot(cf.LookVector)
	physControls.throttle = ctrl.throttle
	physControls.brake = ctrl.brake
	physControls.steer = SteerFilter.step(steerCfg, steerState, ctrl.steer, ctrl.digital, forwardSpeed, dt)
	local mass = c.AssemblyMass
	local body: KartPhysics.Body = {
		pos = vec(c.Position),
		right = vec(cf.RightVector),
		up = vec(cf.UpVector),
		look = vec(cf.LookVector),
		vel = vec(c.AssemblyLinearVelocity),
		angVel = vec(c.AssemblyAngularVelocity),
		mass = mass,
	}
	local t = os.clock()
	local res = KartPhysics.step(cfg, state, body, physControls, dt, raycast, nearbyKarts(dt, c.Position, t))
	telemetry = res
	for i, m in otherKarts do
		KartPhysics.echoAdd(echo, m, res.bumps[i], t)
	end
	-- a knock as the bumpers meet (not while they keep rubbing)
	local touching = res.contact > 0
	if touching and not wasContact then
		Sfx.play("Bump", math.clamp(res.contactSpeed / 25, 0.2, 1))
	end
	wasContact = touching
	-- Roblox gravity is stronger than the kart's real-world gravity: cancel the
	-- difference on the kart only.
	local lift = mass * (workspace.Gravity - cfg.Gravity)
	vf.Force = v3(res.force) + Vector3.new(0, lift, 0)
	tq.Torque = v3(res.torque)

	-- automatic recovery: upside down for a while, or fell off the world
	if cf.UpVector.Y < 0.25 and res.speed < 10 then
		flipTimer += dt
	else
		flipTimer = 0
	end
	if flipTimer > cfg.FlipResetTime or c.Position.Y < cfg.FallY then
		flipTimer = 0
		KartController.requestReset()
	end
end

function KartController.init(remotes: Folder)
	requestRemote = remotes:WaitForChild("Request") :: RemoteEvent
	applySettings()
	Settings.onChange(function(key)
		if key == "SteerAssist" or key == "SteerSpeed" then
			applySettings()
		end
	end)
	local folder = workspace:WaitForChild("Karts")
	kartsFolder = folder
	local function consider(child: Instance)
		if isMine(child) then
			attach(child :: Model)
		end
	end
	folder.ChildAdded:Connect(consider)
	folder.ChildRemoved:Connect(function(child)
		if child == kart then
			detach()
		end
	end)
	for _, child in folder:GetChildren() do
		consider(child)
	end
	-- the circuit folder is swapped when the track changes
	workspace:GetAttributeChangedSignal("TrackReady"):Connect(refreshRayFilter)
	workspace:GetAttributeChangedSignal("Track"):Connect(refreshRayFilter)
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "Circuit" then
			task.defer(refreshRayFilter)
		end
	end)
	RunService.PreSimulation:Connect(physicsStep)
	Input.onAction("Reset", KartController.requestReset)
	Input.onAction("Kart", function()
		if requestRemote then
			requestRemote:FireServer("Kart")
		end
	end)
end

return KartController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">KartVisuals</string>
            <string name="Source"><![CDATA[--!strict
-- Draws the moving parts of every kart on this client: wheels that follow
-- the suspension, steer and spin, the steering wheel, tyre smoke and skid
-- marks, and (own kart, cockpit view only) the driver's arms and gloves on
-- the wheel. In ghost qualifying the other karts and their drivers are
-- see-through. Purely visual and local, so nothing here touches physics.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local KartPhysics = require(Shared:WaitForChild("KartPhysics"))
local KartController = require(script.Parent:WaitForChild("KartController"))
local Input = require(script.Parent:WaitForChild("Input"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local KartVisuals = {}

local cfg = Config.Kart
local geo = KartPhysics.geometry(cfg)
local player = Players.LocalPlayer

type Wheel = { tyre: BasePart, shoulder: BasePart, rim: BasePart, hub: BasePart, smoke: Smoke?, spin: number, lastMark: Vector3?, spec: KartPhysics.WheelSpec }
type Piece = { part: BasePart, offset: CFrame }
type Arm = { sleeve: BasePart, glove: BasePart, shoulder: Vector3, angle: number }
type Visual = {
	model: Model,
	chassis: BasePart,
	folder: Folder,
	wheels: { Wheel },
	steering: { Piece },
	arms: { Arm }?,
	display: TextLabel?,
	displayAt: number,
	ghost: boolean?, -- drawn see-through (KartVisuals ghosts)
	steer: number,
	engine: Sound?,
	skid: Sound?,
	offroad: Sound?,
	kerb: Sound?,
	rpm: number,
}

local SW = cfg.SteeringWheel
local COCKPIT = Config.Camera.Cockpit
local cockpitOn = false

-- The camera tells us when the local player looks from the cockpit; then the
-- avatar's own arms are hidden and these arms hold the wheel instead.
function KartVisuals.setCockpit(on: boolean)
	cockpitOn = on
end

local AUDIO = Config.Audio

-- engines play in the Engine sound group, skids in Effects (settings volumes)
local function loopSound(parent: Instance, name: string, id: string?, volume: number, group: string): Sound?
	if id == nil or id == "" then
		return nil
	end
	local snd = Instance.new("Sound")
	snd.Name = name
	snd.SoundId = id
	snd.Looped = true
	snd.Volume = volume
	snd.RollOffMinDistance = 12
	snd.RollOffMaxDistance = 220
	snd.SoundGroup = Sfx.group(group)
	snd.Parent = parent
	snd:Play()
	return snd
end

-- what a wheel on this part sounds like: "kerb", or how loud the off-road
-- rumble is on it (gravel full, water and grass less), or nil on the road
local SURFACE_SOUND: { [string]: any } = { Kerb = "kerb", Gravel = 1, Water = 0.8, Grass = 0.6, Turf = 0.6 }
local surfaceSounds: { [Instance]: any } = setmetatable({}, { __mode = "k" }) :: any
local function surfaceSound(inst: Instance): any
	local s = surfaceSounds[inst]
	if s == nil then
		local name = inst:GetAttribute("Surface")
		s = (if type(name) == "string" then SURFACE_SOUND[name] else nil) or false
		surfaceSounds[inst] = s
	end
	return if s == false then nil else s
end
-- road speed (studs/s) at which kerb_loop.ogg's 12 blocks a second match
-- the kerb's red/white blocks (one per ~6 stud track sample)
local KERB_RATE = 72

local visuals: { [Model]: Visual } = {}
local root: Folder
local marks: Folder
local markPool: { BasePart } = {}
local markIndex = 0
local MAX_MARKS = 450

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.IgnoreWater = true

local function decor(parent: Instance, props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function build(model: Model)
	local chassis = model:WaitForChild("Chassis", 5) :: BasePart?
	if not chassis or visuals[model] then
		return
	end
	local color = (model:GetAttribute("Color") :: Color3?) or Color3.new(1, 1, 1)
	local folder = Instance.new("Folder")
	folder.Name = model.Name
	folder.Parent = root
	local wheels: { Wheel } = {}
	for _, spec in cfg.Wheels do
		local width = spec.width
		-- slick tyre: a full-radius tread plus a slightly smaller, full-width
		-- body so the shoulders look rounded; magnesium rim and hub
		local tyre = decor(folder, {
			Name = "Tyre",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(width - 0.14, spec.radius * 2, spec.radius * 2),
			Color = Color3.fromRGB(26, 26, 28),
			Material = Enum.Material.Rubber,
		})
		local shoulder = decor(folder, {
			Name = "TyreShoulder",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(width, spec.radius * 2 - 0.12, spec.radius * 2 - 0.12),
			Color = Color3.fromRGB(32, 32, 35),
			Material = Enum.Material.Rubber,
		})
		local rim = decor(folder, {
			Name = "Rim",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(width + 0.02, spec.radius * 1.12, spec.radius * 1.12),
			Color = Color3.fromRGB(196, 176, 118),
			Material = Enum.Material.Metal,
			CastShadow = false,
		})
		local hub = decor(folder, {
			Name = "Hub",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(width + 0.12, spec.radius * 0.42, spec.radius * 0.42),
			Color = Color3.fromRGB(150, 154, 162),
			Material = Enum.Material.Metal,
			CastShadow = false,
		})
		local smoke: Smoke? = nil
		if not spec.front then
			local s = Instance.new("Smoke")
			s.Color = Color3.fromRGB(225, 225, 225)
			s.Opacity = 0.12
			s.Size = 1.6
			s.RiseVelocity = 1.2
			s.TimeScale = 1
			s.Enabled = false
			s.Parent = tyre
			smoke = s
		end
		table.insert(wheels, { tyre = tyre, shoulder = shoulder, rim = rim, hub = hub, smoke = smoke, spin = 0, lastMark = nil, spec = spec })
	end
	-- Steering wheel: a rim of short tubes with three spokes and a hub, in a
	-- frame whose X axis is the column (pointing at the driver), Y is "up"
	-- on the wheel and Z points to the driver's left.
	local steering: { Piece } = {}
	local r = SW.Radius
	local segments = 12
	local segLen = 2 * r * math.sin(math.pi / segments) * 1.12
	for k = 0, segments - 1 do
		local a = (k + 0.5) / segments * 2 * math.pi
		local at = Vector3.new(0, r * math.cos(a), r * math.sin(a))
		local tangent = Vector3.new(0, -math.sin(a), math.cos(a))
		-- padded grips where the hands go (left and right of the rim)
		local grip = math.abs(math.cos(a)) < 0.6
		local part = decor(folder, {
			Name = "WheelRim",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(segLen, if grip then 0.19 else 0.14, if grip then 0.19 else 0.14),
			Color = Color3.fromRGB(22, 22, 24),
			Material = Enum.Material.SmoothPlastic,
			CastShadow = false,
		})
		table.insert(steering, { part = part, offset = CFrame.fromMatrix(at, tangent, Vector3.xAxis) })
	end
	for _, a in { math.pi / 2, -math.pi / 2, math.pi } do
		local dir = Vector3.new(0, math.cos(a), math.sin(a))
		local part = decor(folder, {
			Name = "WheelSpoke",
			Size = Vector3.new(0.05, r, 0.12),
			Color = Color3.fromRGB(150, 154, 162),
			Material = Enum.Material.Metal,
			CastShadow = false,
		})
		table.insert(steering, { part = part, offset = CFrame.fromMatrix(dir * (r / 2), Vector3.xAxis, dir) })
	end
	local hubPart = decor(folder, {
		Name = "WheelHub",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.16, 0.42, 0.42),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
	})
	table.insert(steering, { part = hubPart, offset = CFrame.new(0.04, 0, 0) })
	-- data logger on the hub, facing the driver (speed readout)
	local displayPart = decor(folder, {
		Name = "WheelDisplay",
		Size = Vector3.new(0.08, 0.26, 0.46),
		Color = Color3.fromRGB(18, 18, 20),
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
	})
	table.insert(steering, { part = displayPart, offset = CFrame.new(0.12, 0.1, 0) })
	local screen = Instance.new("SurfaceGui")
	screen.Face = Enum.NormalId.Right
	screen.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	screen.PixelsPerStud = 120
	screen.LightInfluence = 0
	screen.Parent = displayPart
	local readout = Instance.new("TextLabel")
	readout.Size = UDim2.fromScale(0.86, 0.72)
	readout.Position = UDim2.fromScale(0.07, 0.14)
	readout.BackgroundColor3 = Color3.fromRGB(30, 46, 40)
	readout.TextColor3 = Color3.fromRGB(150, 255, 170)
	readout.Font = Enum.Font.Code
	readout.TextScaled = true
	readout.Text = "0"
	readout.Parent = screen

	-- cockpit arms for our own kart (hidden until the camera is in the cockpit)
	local arms: { Arm }? = nil
	if model:GetAttribute("Owner") == player.UserId then
		local list: { Arm } = {}
		arms = list
		local sh = COCKPIT.Shoulders
		for _, side in { -1, 1 } do
			local sleeve = decor(folder, {
				Name = "CockpitSleeve",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1, 0.3, 0.3),
				Color = color,
				Material = Enum.Material.Fabric,
				Transparency = 1,
				CastShadow = false,
			})
			local glove = decor(folder, {
				Name = "CockpitGlove",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.34, 0.34, 0.34),
				Color = Color3.fromRGB(28, 28, 32),
				Material = Enum.Material.Fabric,
				Transparency = 1,
				CastShadow = false,
			})
			table.insert(list, {
				sleeve = sleeve,
				glove = glove,
				shoulder = Vector3.new(side * sh[1], sh[2] - cfg.RideHeight, -sh[3]),
				-- hands at ten-to-two; +angle is the driver's left on the rim
				angle = -side * math.rad(52),
			})
		end
	end
	-- our own name tag would only clutter the chase camera
	if model:GetAttribute("Owner") == player.UserId then
		local tag = chassis:FindFirstChild("NameTag")
		if tag and tag:IsA("BillboardGui") then
			tag.Enabled = false
		end
	end
	visuals[model] = {
		model = model,
		chassis = chassis,
		folder = folder,
		wheels = wheels,
		steering = steering,
		arms = arms,
		display = readout,
		displayAt = 0,
		steer = 0,
		engine = loopSound(chassis, "EngineSound", AUDIO.EngineSoundId, AUDIO.EngineVolume, "Engine"),
		skid = loopSound(chassis, "SkidSound", AUDIO.SkidSoundId, 0, "Effects"),
		offroad = loopSound(chassis, "OffroadSound", AUDIO.OffroadSoundId, 0, "Effects"),
		kerb = loopSound(chassis, "KerbSound", AUDIO.KerbSoundId, 0, "Effects"),
		rpm = AUDIO.EngineRpmIdle,
	}
end

local function unbuild(model: Model)
	local v = visuals[model]
	if v then
		if v.engine then
			v.engine:Destroy()
		end
		for _, snd in { v.skid, v.offroad, v.kerb } do
			if snd then
				snd:Destroy()
			end
		end
		v.folder:Destroy()
		visuals[model] = nil
	end
end

local function skidMark(a: Vector3, b: Vector3, up: Vector3)
	local len = (b - a).Magnitude
	if len < 0.2 or len > 6 then
		return
	end
	markIndex = markIndex % MAX_MARKS + 1
	local p = markPool[markIndex]
	if not p then
		p = decor(marks, {
			Name = "Skid",
			Color = Color3.fromRGB(18, 18, 18),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.45,
			CastShadow = false,
		})
		markPool[markIndex] = p
	end
	local look = (b - a).Unit
	local right = look:Cross(up).Unit
	local realUp = right:Cross(look)
	p.Size = Vector3.new(0.55, 0.02, len + 0.1)
	p.CFrame = CFrame.fromMatrix((a + b) / 2 + realUp * 0.025, right, realUp, -look)
end

-- Ghosts: the other karts (body, wheels and driver) see-through while the
-- server says so: workspace attribute Ghost (qualifying, every kart) or a
-- kart's own Ghost attribute (just reset onto another kart).
local ghostAt = 0
local ghostOn = false
local function fade(root: Instance?, amount: number)
	if not root then
		return
	end
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = amount
		end
	end
end

local function setGhost(model: Model, v: Visual, amount: number)
	fade(model, amount)
	fade(v.folder, amount)
	local owner = Players:GetPlayerByUserId((model:GetAttribute("Owner") :: number?) or 0)
	fade(owner and owner.Character, amount)
end

local function updateGhosts()
	local all = workspace:GetAttribute("Ghost") == true
	-- new karts and new characters turn up: refresh twice a second
	if all == ghostOn and os.clock() - ghostAt < 0.5 then
		return
	end
	ghostAt = os.clock()
	local mine = KartController.kart()
	local amount = Config.Race.GhostTransparency
	for model, v in visuals do
		if model ~= mine then
			local on = all or model:GetAttribute("Ghost") == true
			if on then
				setGhost(model, v, amount)
			elseif v.ghost then
				setGhost(model, v, 0)
			end
			v.ghost = on
		end
	end
	if ghostOn and not all then
		-- the drivers outlive their qualifying karts (new karts on the grid)
		for _, p in Players:GetPlayers() do
			if p ~= Players.LocalPlayer then
				fade(p.Character, 0)
			end
		end
	end
	ghostOn = all
end

local function update(dt: number)
	updateGhosts()
	local mine = KartController.kart()
	local tele = KartController.telemetry()
	for model, v in visuals do
		local c = v.chassis
		if not c.Parent then
			continue
		end
		local cf = c.CFrame
		local right, up, look = cf.RightVector, cf.UpVector, cf.LookVector
		local vel = c.AssemblyLinearVelocity
		local fwdSpeed = vel:Dot(look)
		local ownTele = if model == mine then tele else nil

		-- steering angle: own kart from the model, others estimated from yaw rate
		local steer: number
		if ownTele then
			steer = ownTele.steerAngle
		else
			local yaw = c.AssemblyAngularVelocity:Dot(up)
			local target = if math.abs(fwdSpeed) > 2 then math.atan(-yaw * geo.wheelbase / fwdSpeed) else 0
			target = math.clamp(target, -math.rad(cfg.SteerLock), math.rad(cfg.SteerLock))
			steer = v.steer + (target - v.steer) * math.min(dt * 10, 1)
		end
		v.steer = steer

		-- body slip for smoke on other karts
		local slipAngle = 0
		if vel.Magnitude > 12 then
			slipAngle = math.deg(math.acos(math.clamp(vel.Unit:Dot(look), -1, 1)))
		end

		local anySliding = false
		-- wheels on the kerbs, and how much of the kart is off the road
		local hearSurface = v.offroad ~= nil or v.kerb ~= nil
		local onKerb, offRoad = 0, 0
		for i, w in v.wheels do
			local spec = w.spec
			local mount = cf.Position + right * spec.x + look * spec.f
			local dist: number
			local sliding = false
			local r: RaycastResult? = nil
			if ownTele then
				local wt = ownTele.wheels[i]
				dist = wt.hitDist
				sliding = wt.contact and (wt.usage > 1.03 or wt.spinning or wt.locked)
				if hearSurface and wt.contact then
					r = workspace:Raycast(mount, -up * geo.rayLength, rayParams)
				end
			else
				r = workspace:Raycast(mount, -up * geo.rayLength, rayParams)
				dist = if r then r.Distance else geo.rayLength
				sliding = r ~= nil and slipAngle > 9 and not spec.front
			end
			if hearSurface and r then
				local kind = surfaceSound(r.Instance)
				if kind == "kerb" then
					onKerb += 1
				elseif kind then
					offRoad += kind
				end
			end
			dist = math.clamp(dist, spec.radius * 0.6, geo.rayLength)
			local center = mount - up * (dist - spec.radius)
			local wheelSteer = 0
			if spec.front then
				wheelSteer = if ownTele then ownTele.wheels[i].steer else steer
			end
			-- axle direction: chassis right, turned by the steering angle
			local axle = (right * math.cos(wheelSteer) - look * math.sin(wheelSteer))
			local spinRate = (if ownTele then ownTele.wheels[i].longSpeed else fwdSpeed) / spec.radius
			if ownTele and ownTele.wheels[i].spinning then
				spinRate = math.max(spinRate, 60)
			end
			w.spin = (w.spin + spinRate * dt) % (2 * math.pi)
			local side = if spec.x < 0 then -1 else 1
			local base = CFrame.fromMatrix(center, axle, up)
			w.tyre.CFrame = base * CFrame.Angles(-w.spin, 0, 0)
			w.shoulder.CFrame = w.tyre.CFrame
			w.rim.CFrame = base * CFrame.Angles(-w.spin, 0, 0)
			w.hub.CFrame = base * CFrame.new(side * 0.04, 0, 0)
			if w.smoke then
				w.smoke.Enabled = sliding and math.abs(fwdSpeed) > 6
			end
			anySliding = anySliding or (sliding and math.abs(fwdSpeed) > 6)
			-- skid marks where the tyre slides on the ground
			local contact = center - up * spec.radius
			if sliding and dist < geo.rayLength - 0.01 then
				if w.lastMark then
					local d = (contact - w.lastMark).Magnitude
					if d > 1.2 then
						skidMark(w.lastMark, contact, up)
						w.lastMark = contact
					end
				else
					w.lastMark = contact
				end
			else
				w.lastMark = nil
			end
		end

		-- engine revs: a rental kart's one gear and centrifugal clutch. On the
		-- throttle the clutch slips at EngineRpmClutch until the road speed
		-- takes the revs higher; off it the revs stay with the road until the
		-- clutch lets go (EngineRpmRelease), then it idles. A little higher when
		-- the rear wheels spin. Other karts: on the throttle whenever they move.
		local speed = math.abs(fwdSpeed)
		if v.engine then
			local roadRpm = AUDIO.EngineRpmMax * math.clamp(speed / cfg.TopSpeed, 0, 1.1)
			local throttle = if ownTele then Input.get().throttle elseif speed > 2 then 1 else 0
			local rpm: number
			if throttle > 0.05 then
				local slip = AUDIO.EngineRpmIdle + (AUDIO.EngineRpmClutch - AUDIO.EngineRpmIdle) * math.min(throttle * 1.5, 1)
				rpm = math.max(roadRpm, slip)
			else
				rpm = if roadRpm > AUDIO.EngineRpmRelease then roadRpm else AUDIO.EngineRpmIdle
			end
			if ownTele then
				for _, wt in ownTele.wheels do
					if wt.spinning then
						rpm += 500
						break
					end
				end
			end
			v.rpm += (rpm - v.rpm) * math.min(dt * 8, 1)
			v.engine.PlaybackSpeed = v.rpm / AUDIO.EngineRpmLoop
			v.engine.Volume = AUDIO.EngineVolume * (if ownTele then 0.55 + 0.45 * throttle else 0.8)
		end
		-- off the road: a rumble and gravel crunch that grows with speed
		if v.offroad then
			local target = AUDIO.OffroadVolume * math.clamp(offRoad / 4, 0, 1) * math.clamp(speed / 30, 0, 1)
			v.offroad.Volume += (target - v.offroad.Volume) * math.min(dt * 10, 1)
			v.offroad.PlaybackSpeed = 0.75 + 0.5 * math.clamp(speed / cfg.TopSpeed, 0, 1)
		end
		-- on the kerbs: the loop drums 12 blocks a second at KERB_RATE studs/s
		if v.kerb then
			local target = AUDIO.KerbVolume * math.clamp(onKerb / 2, 0, 1) * math.clamp(speed / 15, 0, 1)
			v.kerb.Volume += (target - v.kerb.Volume) * math.min(dt * 14, 1)
			v.kerb.PlaybackSpeed = math.clamp(speed / KERB_RATE, 0.4, 1.6)
		end
		if v.skid then
			local target = if anySliding then AUDIO.SkidVolume else 0
			v.skid.Volume += (target - v.skid.Volume) * math.min(dt * 12, 1)
		end

		-- steering wheel in front of the seat; its face points back and up at
		-- the driver and it turns with the front wheels
		local tilt = math.rad(SW.Tilt)
		local pos = cf:PointToWorldSpace(Vector3.new(0, SW.Height - cfg.RideHeight, -SW.Forward))
		local normal = cf:VectorToWorldSpace(Vector3.new(0, math.sin(tilt), math.cos(tilt)))
		local upward = cf:VectorToWorldSpace(Vector3.new(0, math.cos(tilt), -math.sin(tilt)))
		local wheelCF = CFrame.fromMatrix(pos, normal, upward) * CFrame.Angles(-steer * SW.Ratio, 0, 0)
		for _, piece in v.steering do
			piece.part.CFrame = wheelCF * piece.offset
		end
		-- the logger shows our speed (ten times a second is plenty)
		local display = v.display
		if display and model == mine and os.clock() - v.displayAt > 0.1 then
			v.displayAt = os.clock()
			display.Text = string.format("%d", math.floor(math.abs(fwdSpeed) * Config.KmhPerStudPerSecond + 0.5))
		end
		local arms = v.arms
		if arms then
			local show = cockpitOn and model == mine
			for _, arm in arms do
				local want = if show then 0 else 1
				if arm.glove.Transparency ~= want then
					arm.glove.Transparency = want
					arm.sleeve.Transparency = want
				end
				if show then
					local hand = wheelCF * Vector3.new(0.1, SW.Radius * math.cos(arm.angle), SW.Radius * math.sin(arm.angle))
					local shoulder = cf:PointToWorldSpace(arm.shoulder)
					local reach = hand - shoulder
					arm.glove.CFrame = CFrame.new(hand)
					arm.sleeve.Size = Vector3.new(math.max(reach.Magnitude - 0.1, 0.2), 0.3, 0.3)
					arm.sleeve.CFrame = CFrame.lookAt((hand + shoulder) / 2, hand) * CFrame.Angles(0, math.rad(90), 0)
				end
			end
		end
	end
end

function KartVisuals.init()
	root = Instance.new("Folder")
	root.Name = "KartVisuals"
	root.Parent = workspace
	marks = Instance.new("Folder")
	marks.Name = "SkidMarks"
	marks.Parent = root
	local function filter()
		local list: { Instance } = { workspace.Terrain }
		local circuit = workspace:FindFirstChild("Circuit")
		local track = circuit and circuit:FindFirstChild("Track")
		if track then
			table.insert(list, track)
		end
		rayParams.FilterDescendantsInstances = list
	end
	filter()
	workspace:GetAttributeChangedSignal("TrackReady"):Connect(filter)
	workspace:GetAttributeChangedSignal("Track"):Connect(function()
		filter()
		-- skid marks belong to the old circuit
		for _, p in markPool do
			p:Destroy()
		end
		table.clear(markPool)
		markIndex = 0
	end)
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "Circuit" then
			task.defer(filter)
		end
	end)
	local folder = workspace:WaitForChild("Karts")
	folder.ChildAdded:Connect(function(m)
		if m:IsA("Model") then
			task.spawn(build, m)
		end
	end)
	folder.ChildRemoved:Connect(function(m)
		if m:IsA("Model") then
			unbuild(m)
		end
	end)
	for _, m in folder:GetChildren() do
		if m:IsA("Model") then
			task.spawn(build, m)
		end
	end
	RunService:BindToRenderStep("KartVisuals", Enum.RenderPriority.Camera.Value + 2, update)
	local _ = player
end

return KartVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Menu</string>
            <string name="Source"><![CDATA[--!strict
-- The lobby menu (every public server): RACE (quick race with other
-- players), PRACTICE (pick a track, drive alone), PRIVATE ROOM (make one or
-- join with a code), RECORDS and SETTINGS, over a slow camera fly-by of the
-- circuit behind it. Off to another server, it puts up the loading screen
-- (the same one ReplicatedFirst shows) and hands it to the teleport.
-- A private room's server opens on its waiting room (like a custom-game
-- lobby): the code, twelve player slots (HOST / READY / NOT READY / OPEN;
-- the host can KICK, tap twice), the host's track and length, READY for the
-- guests, START RACE for the host once everyone is ready, and LEAVE.
-- On every other server it adds a LOBBY button (press twice) to go back.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local TrackData = require(Shared:WaitForChild("TrackData"))
local TrackMath = require(Shared:WaitForChild("TrackMath"))
local Settings = require(script.Parent:WaitForChild("Settings"))
local SettingsMenu = require(script.Parent:WaitForChild("SettingsMenu"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))
local TrackOutline = require(script.Parent:WaitForChild("TrackOutline"))

local Menu = {}

local player = Players.LocalPlayer
local L = Config.Lobby
local ACCENT = Color3.fromRGB(255, 196, 0)
local PANEL = Color3.fromRGB(14, 15, 20)
local CARD = Color3.fromRGB(30, 32, 40)
local WHITE = Color3.new(1, 1, 1)
local MUTED = Color3.fromRGB(170, 175, 190)
local RED = Color3.fromRGB(235, 70, 60)
local GREEN = Color3.fromRGB(70, 220, 120)
local CHOSEN = Color3.fromRGB(90, 70, 10)
local LENGTHS = { "Short", "Normal", "Long" }

type Screen = "home" | "practice" | "queue" | "room" | "records"

local gui: ScreenGui
local uiScale: UIScale
local requestRemote: RemoteEvent
local screen: Screen = "home"
local panels: { [string]: Frame } = {}
local selected = TrackData.Default
local cards: { [string]: TextButton } = {}
local recordRows: { [string]: Frame } = {}
local errorText: TextLabel
local errorUntil = 0
local queueTitle: TextLabel
local queueElapsed: TextLabel
local queueStatus: TextLabel
local queuedAt: number? = nil
local codeBox: TextBox
local lobbyButton: TextButton
local lobbyArmed = 0
local nowShowing: TextLabel
local loading: ScreenGui? = nil
local loadingSince = 0
local leaving = false
local wasMenu: boolean? = nil
local lastMode: string? = nil

-- the private room's waiting room
type Slot = { frame: Frame, name: TextLabel, status: TextLabel, kick: TextButton, me: UIStroke }
local slots: { Slot } = {}
local slotUser: { [number]: number } = {} -- slot -> UserId
local kickArmed: { [number]: number } = {} -- UserId -> until
local roomCodeL: TextLabel
local playersTitle: TextLabel
local roomTrackThumb: Frame
local roomTrackName: TextLabel
local roomTrackInfo: TextLabel
local roomChange: TextButton
local hostPicks: TextLabel
local roomPicking = false -- the host has the track cards open
local roomCards: { [string]: TextButton } = {}
local roomLengths: { [string]: TextButton } = {}
local roomAction: TextButton
local roomStatus: TextLabel
local drawnTrack = ""

----------------------------------------------------------------------------
-- small UI helpers
----------------------------------------------------------------------------
local function corner(p: Instance, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = p
end

local function stroke(p: Instance, color: Color3?, transparency: number?)
	local s = Instance.new("UIStroke")
	s.Name = "Ring"
	s.Color = color or WHITE
	s.Thickness = if color then 2 else 1
	s.Transparency = transparency or 0.8
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
	return s
end

local function label(parent: Instance, name: string, text: string, size: UDim2, pos: UDim2, textSize: number, font: Enum.Font?, color: Color3?, align: Enum.TextXAlignment?): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.Text = text
	t.Size = size
	t.Position = pos
	t.BackgroundTransparency = 1
	t.Font = font or Enum.Font.GothamBold
	t.TextSize = textSize
	t.TextColor3 = color or WHITE
	t.TextXAlignment = align or Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.TextTruncate = Enum.TextTruncate.AtEnd
	t.Parent = parent
	return t
end

local function panel(name: string, w: number, h: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = UDim2.fromOffset(w, h)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.BackgroundColor3 = PANEL
	f.BackgroundTransparency = 0.08
	f.BorderSizePixel = 0
	f.Visible = false
	corner(f, 14)
	stroke(f)
	f.Parent = gui
	panels[name] = f
	return f
end

-- A big menu button: a title and a line under it.
local function menuButton(parent: Instance, name: string, title: string, sub: string?, size: UDim2, pos: UDim2, primary: boolean): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = ""
	b.AutoButtonColor = true
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = if primary then ACCENT else CARD
	b.BackgroundTransparency = if primary then 0 else 0.1
	b.BorderSizePixel = 0
	corner(b, 10)
	if not primary then
		stroke(b)
	end
	local fg = if primary then PANEL else WHITE
	local h = size.Y.Offset
	if sub then
		label(b, "Title", title, UDim2.new(1, -36, 0, 26), UDim2.fromOffset(18, math.floor(h / 2) - 24), 24, Enum.Font.GothamBlack, fg)
		label(b, "Sub", sub, UDim2.new(1, -36, 0, 18), UDim2.fromOffset(18, math.floor(h / 2) + 3), 15, Enum.Font.GothamMedium, if primary then Color3.fromRGB(70, 55, 0) else MUTED)
	else
		label(b, "Title", title, UDim2.new(1, -16, 1, 0), UDim2.fromOffset(8, 0), 18, Enum.Font.GothamBlack, fg, Enum.TextXAlignment.Center)
	end
	b.Parent = parent
	return b
end

local function fmt(t: number?): string
	if not t then
		return "--:--.---"
	end
	local m = math.floor(t / 60)
	return string.format("%d:%06.3f", m, t - m * 60)
end

local function trackIds(): { string }
	local list = {}
	for _, id in TrackData.Order do
		if TrackData.Tracks[id] then
			table.insert(list, id)
		end
	end
	return list
end

local function isLobby(): boolean
	return workspace:GetAttribute("ServerMode") == "lobby"
end

-- a private room between races: its waiting room
local function roomWaiting(): boolean
	return workspace:GetAttribute("ServerMode") == "room" and workspace:GetAttribute("RaceState") == "Lobby"
end

local function showError(message: string, seconds: number?)
	errorText.Text = message
	errorText.Visible = true
	errorUntil = os.clock() + (seconds or 4)
	Sfx.play("Penalty")
end

local function show(s: Screen)
	screen = s
end

----------------------------------------------------------------------------
-- leaving for another server: the loading screen
----------------------------------------------------------------------------
local LoadingGui: any = nil
local function loadingModule(): any
	if not LoadingGui then
		local ok, m = pcall(function()
			local folder = ReplicatedFirst:WaitForChild("Loading", 5)
			local mod: any = (folder :: Instance):WaitForChild("LoadingGui", 5)
			return (require :: any)(mod)
		end)
		if ok then
			LoadingGui = m
		end
	end
	return LoadingGui
end

local function hideLoading()
	local g = loading
	loading = nil
	if g then
		g:Destroy()
	end
end

local function onTeleport(info: any)
	leaving = true
	queuedAt = nil
	hideLoading()
	local LG = loadingModule()
	if not LG then
		return
	end
	local g = LG.create(LG.describe(info)) :: ScreenGui
	LG.set(g, 0.1)
	g.Parent = player:WaitForChild("PlayerGui")
	loading = g
	loadingSince = os.clock()
	-- it stays up through the teleport; the next server's Loading script
	-- picks it up (GetArrivingTeleportGui)
	pcall(function()
		TeleportService:SetTeleportGui(g :: any)
	end)
end

----------------------------------------------------------------------------
-- build
----------------------------------------------------------------------------
local function buildHome()
	local home = Instance.new("Frame")
	home.Name = "Home"
	home.Size = UDim2.fromOffset(360, 480)
	home.AnchorPoint = Vector2.new(0, 0.5)
	home.Position = UDim2.new(0, 48, 0.5, 0)
	home.BackgroundTransparency = 1
	home.Visible = false
	home.Parent = gui
	panels.Home = home
	local logo = label(home, "Logo", "A1", UDim2.fromOffset(360, 84), UDim2.fromOffset(0, 0), 84, Enum.Font.GothamBlack, ACCENT)
	logo.TextStrokeTransparency = 0.6
	local name = label(home, "Name", "K A R T   R A C I N G", UDim2.fromOffset(360, 28), UDim2.fromOffset(4, 84), 22, Enum.Font.GothamBlack, WHITE)
	name.TextStrokeTransparency = 0.6
	local race = menuButton(home, "Race", "RACE", "Race other players: qualify, then race", UDim2.fromOffset(340, 74), UDim2.fromOffset(0, 136), true)
	local practice = menuButton(home, "Practice", "PRACTICE", "Pick a track, drive on your own", UDim2.fromOffset(340, 66), UDim2.fromOffset(0, 222), false)
	local room = menuButton(home, "Room", "PRIVATE ROOM", "Race your friends with a code", UDim2.fromOffset(340, 66), UDim2.fromOffset(0, 300), false)
	local records = menuButton(home, "Records", "RECORDS", nil, UDim2.fromOffset(164, 46), UDim2.fromOffset(0, 380), false)
	local settings = menuButton(home, "Settings", "SETTINGS", nil, UDim2.fromOffset(164, 46), UDim2.fromOffset(176, 380), false)
	race.Activated:Connect(function()
		if leaving then
			return
		end
		Sfx.play("Click")
		requestRemote:FireServer("Queue", true)
		queuedAt = os.clock()
		show("queue")
	end)
	practice.Activated:Connect(function()
		Sfx.play("Click")
		show("practice")
	end)
	room.Activated:Connect(function()
		Sfx.play("Click")
		show("room")
	end)
	records.Activated:Connect(function()
		Sfx.play("Click")
		show("records")
	end)
	settings.Activated:Connect(function()
		SettingsMenu.toggle()
	end)

	nowShowing = label(gui, "NowShowing", "", UDim2.fromOffset(420, 20), UDim2.new(1, -24, 1, -18), 14, Enum.Font.GothamBold, MUTED, Enum.TextXAlignment.Right)
	nowShowing.AnchorPoint = Vector2.new(1, 1)
	nowShowing.TextStrokeTransparency = 0.5
end

-- three rows of three: room for nine tracks in the panel
local CARD_W, CARD_H = 238, 100
-- `registry`: where the card is kept by id; `onPick`: what a click does
local function buildCard(parent: Instance, id: string, registry: { [string]: TextButton }, onPick: (string) -> ()): TextButton
	local spec = TrackData.get(id)
	local t = TrackOutline.track(id)
	local card = Instance.new("TextButton")
	card.Name = "Card_" .. id
	card.Text = ""
	card.AutoButtonColor = true
	card.BackgroundColor3 = CARD
	card.BackgroundTransparency = 0.1
	card.BorderSizePixel = 0
	corner(card, 10)
	local ring = stroke(card, ACCENT, 1)
	ring.Name = "Ring"
	local thumb = Instance.new("Frame")
	thumb.Name = "Thumb"
	thumb.Size = UDim2.fromOffset(84, 84)
	thumb.Position = UDim2.fromOffset(8, 8)
	thumb.BackgroundTransparency = 1
	thumb.Parent = card
	TrackOutline.draw(thumb, t, 84, 6, math.max(2, t.n // 120), 2)
	-- two lines for the longer names ("LAKESIDE / INTERNATIONAL")
	local nameL = label(card, "Name", string.upper(spec.Name), UDim2.fromOffset(CARD_W - 108, 32), UDim2.fromOffset(100, 7), 13, Enum.Font.GothamBlack, WHITE)
	nameL.TextWrapped = true
	nameL.TextTruncate = Enum.TextTruncate.None
	nameL.TextYAlignment = Enum.TextYAlignment.Top
	local km = t.length * Config.StudMeters / 1000
	label(card, "Info", string.format("%.2f km", km), UDim2.fromOffset(CARD_W - 108, 14), UDim2.fromOffset(100, 41), 12, Enum.Font.GothamMedium, MUTED)
	label(card, "Best", "", UDim2.fromOffset(CARD_W - 108, 16), UDim2.fromOffset(100, 59), 12, Enum.Font.GothamBold, WHITE)
	local recL = label(card, "Record", "", UDim2.fromOffset(CARD_W - 108, 14), UDim2.fromOffset(100, 78), 11, Enum.Font.GothamMedium, MUTED)
	recL.TextTruncate = Enum.TextTruncate.AtEnd
	card.Parent = parent
	card.Activated:Connect(function()
		Sfx.play("Click")
		onPick(id)
	end)
	registry[id] = card
	return card
end

-- a 3 x 3 grid of track cards in panel `p` (the practice and room pickers)
local function cardGrid(p: Frame, registry: { [string]: TextButton }, onPick: (string) -> ())
	local grid = Instance.new("Frame")
	grid.Name = "Cards"
	grid.Size = UDim2.fromOffset(746, 320) -- three cards a row (742) and a little spare
	grid.Position = UDim2.fromOffset(24, 60)
	grid.BackgroundTransparency = 1
	grid.Parent = p
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(CARD_W, CARD_H)
	layout.CellPadding = UDim2.fromOffset(14, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for i, id in trackIds() do
		buildCard(grid, id, registry, onPick).LayoutOrder = i
	end
end

-- best and record lines on the cards; the ring on `chosen`
local function updateCards(registry: { [string]: TextButton }, chosen: string)
	for id, card in registry do
		local ring = card:FindFirstChild("Ring") :: UIStroke
		ring.Transparency = if id == chosen then 0 else 1
		local best = player:GetAttribute("Best_" .. id) :: number?
		local rec = workspace:GetAttribute("Record_" .. id) :: number?
		local by = workspace:GetAttribute("RecordBy_" .. id) :: string?
		local bestL = card:FindFirstChild("Best") :: TextLabel
		local recL = card:FindFirstChild("Record") :: TextLabel
		bestL.Text = if best then "BEST  " .. fmt(best) else "NO TIME YET"
		recL.Text = if rec then string.format("REC  %s  %s", fmt(rec), by or "") else ""
	end
end

