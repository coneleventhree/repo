      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CockpitRig</string>
          <string name="Source"><![CDATA[--!strict
-- The cockpit (first-person) camera, as pure maths so it can be tested.
--
-- A camera bolted rigidly to the chassis shows every twitch of the body, and
-- extra effects that react instantly (head sway, look-into-turn) add their
-- own jolt. Racing sims soften this, and so does this rig:
--
--   yaw     follows the kart exactly (you are sitting in it)
--   tilt    only a share of the kart's pitch and roll reaches the view
--           (horizon stabilisation), through a critically damped spring
--   head    sways a little with g-forces (outward in corners, forward under
--           braking); filtered acceleration drives a critically damped spring
--           so it eases in and out and never bounces back past centre
--   glance  the view turns a few degrees into the corner, eased the same way
--
-- Critically damped springs reach their target without overshoot, which is
-- what removes the "kick back" when the steering is released.

local CockpitRig = {}

export type Settings = {
	Eye: { number }, -- x, height above ground, forward (kart frame)
	Pitch: number, -- degrees
	HeadG: number, -- studs of sway per g, sideways
	HeadGForward: number, -- studs per g, fore/aft
	HeadMax: number, -- studs
	HeadResponse: number, -- 1/s, how quickly the sway follows
	AccelFilter: number, -- 1/s, low-pass on the measured acceleration
	TiltFollow: number, -- share of the kart's pitch/roll shown (0 = level horizon)
	TiltResponse: number, -- 1/s
	LookIntoTurn: number, -- degrees per degree/s of yaw rate
	MaxLookIntoTurn: number, -- degrees
	LookResponse: number, -- 1/s
}

export type Pose = {
	pos: vector,
	right: vector,
	up: vector,
	look: vector,
	vel: vector,
	angVel: vector,
}

export type State = {
	lastVel: vector?,
	accel: vector, -- filtered, kart frame (x right, y up, z forward)
	head: vector, -- sway offset, kart frame
	headVel: vector,
	tiltUp: vector, -- smoothed "up" of the view, world
	tiltVel: vector,
	glance: number, -- degrees
	glanceVel: number,
}

local WORLD_UP = vector.create(0, 1, 0)

function CockpitRig.new(): State
	return {
		lastVel = nil,
		accel = vector.zero,
		head = vector.zero,
		headVel = vector.zero,
		tiltUp = WORLD_UP,
		tiltVel = vector.zero,
		glance = 0,
		glanceVel = 0,
	}
end

-- Critically damped spring towards `target` (exact for constant target).
local function spring(x: number, v: number, target: number, omega: number, dt: number): (number, number)
	local e = math.exp(-omega * dt)
	local d = x - target
	local t = (v + omega * d) * dt
	return target + (d + t) * e, (v - omega * t) * e
end
CockpitRig.spring = spring

local function springV(x: vector, v: vector, target: vector, omega: number, dt: number): (vector, vector)
	local e = math.exp(-omega * dt)
	local d = x - target
	local t = (v + d * omega) * dt
	return target + (d + t) * e, (v - t * omega) * e
end

local function rotate(v: vector, axis: vector, angle: number): vector
	local c, s = math.cos(angle), math.sin(angle)
	return v * c + vector.cross(axis, v) * s + axis * (vector.dot(axis, v) * (1 - c))
end

-- Returns the eye position and the view's look and up vectors (world).
-- `lookYaw` / `lookPitch` (radians) are the player's free-look offsets.
function CockpitRig.step(s: Settings, st: State, pose: Pose, rideHeight: number, gravity: number, lookYaw: number, lookPitch: number, dt: number): (vector, vector, vector)
	dt = math.max(dt, 1e-4)
	local right, up, look = pose.right, pose.up, pose.look

	-- acceleration in the kart frame, low-pass filtered (raw per-frame
	-- velocity differences are noisy)
	local raw = vector.zero
	if st.lastVel then
		local a = (pose.vel - st.lastVel :: vector) / dt
		raw = vector.create(vector.dot(a, right), vector.dot(a, up), vector.dot(a, look))
	end
	st.lastVel = pose.vel
	local ka = 1 - math.exp(-s.AccelFilter * dt)
	st.accel += (raw - st.accel) * ka

	-- head sway: thrown outward in corners, forward under braking
	local want = vector.create(-st.accel.x / gravity * s.HeadG, 0, -st.accel.z / gravity * s.HeadGForward)
	local m = vector.magnitude(want)
	if m > s.HeadMax then
		want = want * (s.HeadMax / m)
	end
	st.head, st.headVel = springV(st.head, st.headVel, want, s.HeadResponse, dt)

	-- glance into the turn (yaw rate about the kart's up axis, degrees/s;
	-- positive = turning left, and a positive glance looks left)
	local yawRate = math.deg(vector.dot(pose.angVel, up))
	local wantGlance = math.clamp(yawRate * s.LookIntoTurn, -s.MaxLookIntoTurn, s.MaxLookIntoTurn)
	st.glance, st.glanceVel = spring(st.glance, st.glanceVel, wantGlance, s.LookResponse, dt)

	-- view "up": mostly level, a share of the kart's tilt, smoothed
	local wantUp = vector.normalize(WORLD_UP + (up - WORLD_UP) * s.TiltFollow)
	st.tiltUp, st.tiltVel = springV(st.tiltUp, st.tiltVel, wantUp, s.TiltResponse, dt)
	local viewUp = vector.normalize(st.tiltUp)

	-- heading straight from the kart, made perpendicular to the view up
	local fwd = look - viewUp * vector.dot(look, viewUp)
	if vector.magnitude(fwd) < 1e-4 then
		fwd = look
	end
	fwd = vector.normalize(fwd)
	local side = vector.normalize(vector.cross(fwd, viewUp))

	-- eye: fixed seat position plus the sway (in the kart frame)
	local e = s.Eye
	local localEye = vector.create(e[1], e[2] - rideHeight, e[3]) + st.head
	local eye = pose.pos + right * localEye.x + up * localEye.y + look * localEye.z

	-- turn the view: glance + free look about up, pitch about the side axis
	local yaw = math.rad(st.glance) + lookYaw
	local pitch = math.rad(s.Pitch) + lookPitch
	local viewLook = rotate(fwd, viewUp, yaw)
	local viewSide = rotate(side, viewUp, yaw)
	viewLook = rotate(viewLook, viewSide, pitch)
	local finalUp = rotate(viewUp, viewSide, pitch)
	return eye, viewLook, finalUp
end

return CockpitRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Every tunable number lives here. Units are studs and seconds.
-- Scale: 1 stud = 0.28 m (Roblox's own guidance), so studs/s is almost km/h
-- (1 stud/s = 1.008 km/h).

local Config = {}

Config.StudMeters = 0.28
Config.KmhPerStudPerSecond = 0.28 * 3.6

Config.Kart = {
	-- The kart feels real-world gravity (9.81 m/s^2 = 35 studs/s^2). Roblox's
	-- default world gravity is much stronger, so the client cancels the
	-- difference on the kart only. Characters keep normal gravity.
	Gravity = 35,

	-- The chassis root is a compact invisible block that carries all the mass;
	-- its size sets the inertia, sized so yaw inertia per kilo matches a real
	-- kart with driver (a big box made the kart lazy to turn). A separate
	-- massless hitbox covers the whole kart for collisions.
	-- Forward is the chassis LookVector. Wheel positions are relative to the
	-- core centre (= centre of mass), which sits 0.3 studs behind the axle
	-- midpoint for a 42/58 front/rear split.
	CoreSize = { 2.8, 0.6, 4.0 }, -- x (width), y (height), z (length)
	BoxSize = { 6.6, 0.8, 6.75 }, -- collision hitbox (massless) round the wraparound bumpers
	BoxOffsetY = 0.15, -- hitbox centre above the core centre (keeps its floor off the kerbs)
	BoxOffsetZ = 0.375, -- hitbox centre ahead of the core (the front bumper reaches further)
	-- Slipstream (see KartPhysics): within Length studs behind another kart
	-- (centre to centre, fading out to Width studs sideways) drag drops by up
	-- to DragCut and the top speed rises by up to TopGain studs/s.
	Slipstream = {
		Gap = 7,
		Length = 34,
		Width = 4.5,
		MinSpeed = 40,
		DragCut = 0.45,
		TopGain = 5,
		Rise = 2.5,
		Fall = 4,
	},
	-- Kart-to-kart contact (see KartPhysics): the wraparound bumper as a
	-- rounded rectangle round the centre of mass. Overlap pushes back at
	-- Stiffness studs/s^2 per stud (at most SpringMax) plus Damping per stud/s
	-- of closing speed, at most MaxAccel in total; Friction is the rubbing
	-- grip between bumpers. Roblox's own collisions between karts are off:
	-- over the network they launch karts.
	Bumper = {
		HalfWidth = 3.3,
		Front = 3.75,
		Rear = 3.0,
		Corner = 0.7,
		Stiffness = 160,
		SpringMax = 160,
		Damping = 10,
		Friction = 0.25,
		MaxAccel = 500,
	},
	Density = 8,
	RideHeight = 0.62, -- core centre (centre of mass) above flat ground at rest; karts sit low
	-- Order matters: front pair then rear pair (anti-roll uses the pairs).
	-- grip: the wide rear slicks grip a little more than the narrow fronts.
	-- radius/width are what you see (the physics only uses the contact point).
	Wheels = {
		{ name = "FL", x = -2.15, f = 2.2, radius = 0.62, width = 0.66, front = true, grip = 1.0 },
		{ name = "FR", x = 2.15, f = 2.2, radius = 0.62, width = 0.66, front = true, grip = 1.0 },
		-- stiffness: the wide rear slicks build grip at smaller slip angles,
		-- which damps the kart's yaw (no overshoot on turn-in, no snap on release)
		{ name = "RL", x = -2.35, f = -1.6, radius = 0.7, width = 1.05, front = false, grip = 1.04, stiffness = 1.6 },
		{ name = "RR", x = 2.35, f = -1.6, radius = 0.7, width = 1.05, front = false, grip = 1.04, stiffness = 1.6 },
	},

	-- Suspension (real karts flex instead; a stiff spring stands in for it)
	SpringHz = 2.8, -- natural frequency of each corner
	DampingRatio = 0.45,
	Travel = 0.32, -- compression before the bump stop
	BumpStopRate = 6, -- bump stop stiffness as a multiple of the spring
	-- Anti-roll as a fraction of the spring rate. A stiffer front takes more of
	-- the load transfer, which keeps the inside rear planted (less snap oversteer).
	AntiRollFront = 0.35,
	AntiRollRear = 0.05,

	-- Tyres: simplified Pacejka "magic formula" on slip angle, combined with
	-- longitudinal force inside a friction circle.
	Mu = 2.0, -- peak friction on dry asphalt (sticky kart slicks pull ~2 g)
	LoadSensitivity = 0.15, -- grip per load falls as load rises
	-- Lateral grip curve: peaks at about 7 degrees of slip, then falls off
	-- (~84% at 20 degrees). Turning the wheels further than the peak makes the
	-- front push wide instead of turning more: understeer, as on a real kart.
	PacejkaB = 12.3,
	PacejkaC = 1.6,
	RollingResistance = 0.015, -- times normal load
	LowSpeedBlend = 4, -- studs/s; below this lateral grip uses a stick model

	-- Engine and brakes (accelerations, so the numbers do not depend on mass).
	-- Modelled on an outdoor rental kart: a single-cylinder 4-stroke of about
	-- 15 hp (Honda GX390 class) with one fixed gear, kart + driver about
	-- 250 kg. Out of a slow corner the pull is limited by engine torque through
	-- the gearing, about 0.24 g (26-30 Nm x ~3.1 / 0.14 m wheel); from about
	-- 60 km/h the engine's power is the limit (~10 kW at the wheels, so the
	-- pull falls as speed rises), and near the top air drag eats almost all of
	-- it. 0-50 km/h takes ~6.5 s and the last 10 km/h come slowly, so a
	-- better corner exit is still worth something at the end of a straight.
	-- (Before: 19 / 860, a ~23 hp kart that hit the governor on every straight.)
	DriveAccel = 8.5, -- torque-limited pull, studs/s^2 (~0.24 g, traction permitting)
	PowerPerMass = 520, -- constant power region: accel = PowerPerMass / speed (~41 W/kg)
	-- Off the throttle the kart coasts: about 0.17 g at 90 km/h (mostly air
	-- drag), 0.07 g at 50 km/h.
	EngineBraking = 0.9, -- decel from the engine when off the throttle
	TopSpeed = 100, -- soft governor (rev limit), studs/s; drag holds a lone kart to ~95, a tow lets it reach this
	DragCoef = 0.00055, -- aero drag accel = DragCoef * v^2
	BrakeAccel = 42, -- total braking demand at full brake (~1.3 g peak)
	BrakeRearBias = 0.25, -- fraction of braking on the rear axle (front brakes, like a KZ kart)
	ReverseAccel = 9,
	ReverseSpeed = 16,
	ReverseDelay = 0.3, -- hold brake while stopped this long to reverse

	-- Steering
	SteerLock = 28, -- degrees at the wheels
	-- How fast the front wheels can physically follow the command (degrees
	-- per second at the wheels, x3 at the steering wheel). The keyboard ramp
	-- in Config.Steering is what you normally feel; this only caps very
	-- quick counter-steer corrections.
	SteerRate = 240,
	SteerReturnRate = 300,
	Ackermann = 1.0, -- 0 = parallel steer, 1 = full Ackermann
	-- Steering assist (on by default, for keyboard/touch): at speed the input
	-- sets the front slip angle relative to the direction of travel, so the
	-- wheels counter-steer by themselves when the rear slides. Physics unchanged.
	SteerAssist = true,
	-- Slide catching: when the rear tyres slip past their peak, the assist
	-- eases the front back towards counter-steer even if the key is held
	-- (per radian of excess rear slip; 0 = off).
	AssistCatch = 1.5,
	SteerAssistSlip = 8, -- front slip angle at full input, degrees (just past the tyre's peak)

	-- Steering wheel (drawn by each client): centre height and forward position,
	-- tilt of its face from vertical, rim radius, wheel turns per road-wheel turn
	SteeringWheel = { Height = 2.0, Forward = 0.75, Tilt = 45, Radius = 0.62, Ratio = 3 },

	-- Recovery
	FlipResetTime = 2.0, -- upside down for this long -> automatic reset
	FallY = -60,
}

-- Keyboard / touch pedals: how fast the throttle and brake reach full when
-- the key is pressed (per second). Analog triggers are used as they are.
-- A brake that bites in over a quarter second is easier to dose with a key.
Config.Pedals = {
	ThrottleRise = 7,
	BrakeRise = 4,
}

-- Steering input smoothing (see SteerFilter). Keys and touch buttons ramp
-- the steering in; the ramp gets slower with speed, like a keyboard in a
-- racing game. Rates are in "full lock per second".
Config.Steering = {
	RiseLow = 6.5, -- 0 -> full in ~0.2 s at parking speed
	RiseHigh = 3.2, -- ... ~0.33 s at RiseSpeed and above
	ReturnLow = 8,
	ReturnHigh = 4.5,
	Counter = 10, -- through centre when switching left <-> right
	RiseSpeed = 70, -- studs/s (about 70 km/h)
	Smoothing = 20,
	StickRate = 8, -- gamepad stick: light rate limit only
	StickCurve = 1.25,
}

-- Other karts reach this client late (their driver -> server -> here), so
-- they are moved ahead along their velocity before bumping into them:
-- Lead seconds plus PingShare of both players' round-trip ping, at most
-- LeadMax. Only karts within Range studs are checked (bumpers and slipstream).
Config.Collision = {
	Range = 40, -- also how far ahead the slipstream looks
	Lead = 0.05,
	PingShare = 0.5,
	LeadMax = 0.25,
}

-- Surface grip. Parts carry a "Surface" attribute naming an entry here
-- (falls back to the material name). `grip` scales Mu, `roll` scales rolling
-- resistance (grass and gravel slow you down hard).
Config.Surfaces = {
	Asphalt = { grip = 1.0, roll = 1 }, -- the racing surface
	Kerb = { grip = 0.9, roll = 1.3 },
	RunOff = { grip = 0.8, roll = 2.5 }, -- painted asphalt run-off
	PitLane = { grip = 0.95, roll = 1 },
	Concrete = { grip = 0.9, roll = 1.2 },
	Turf = { grip = 0.55, roll = 6 }, -- artificial-turf verge
	Grass = { grip = 0.35, roll = 14 },
	Gravel = { grip = 0.4, roll = 30 }, -- gravel trap
	Water = { grip = 0.3, roll = 45 }, -- the lake (a kart wades out at a crawl)
	Default = { grip = 0.8, roll = 2 },
}

Config.Race = {
	MinPlayers = 2, -- fewer than this -> free practice
	MaxRacers = 12,
	IntermissionTime = 20, -- track and length vote; READY from everyone cuts it short
	ReadyCountdown = 3, -- seconds left once everyone is ready
	QualifyingTime = 120, -- default; tracks set their own (TrackData Qualifying)
	QualiOvertime = 90, -- at most this long to finish the lap after the flag
	-- Qualifying is one timed lap with ghosts (user's choice): everyone starts
	-- together this far before the line, picks up speed, and the lap is timed
	-- from the line round to the line. Karts pass through each other (no
	-- bumpers, no slipstream) and the others are see-through.
	QualiRunUp = 70, -- studs
	GhostTransparency = 0.6,
	CountdownTime = 5, -- five red lights, one per second
	FinishGrace = 30, -- after the winner finishes, others get this long
	MaxRaceTime = 600,
	ResultsTime = 8, -- podium, then straight on to the next round
	-- Track limits (all four tyres beyond the kerb): practice and qualifying
	-- strike the lap off; in the race the first TrackLimitWarnings are
	-- warnings, then each one adds TrackLimitPenalty seconds to the result.
	TrackLimitWarnings = 3,
	TrackLimitPenalty = 2,
	GridRowSpacing = 14,
	GridLateral = 8,
	GridStagger = 7,
	GridFirstRowBack = 12, -- studs behind the start line
	ResetCooldown = 3,
	-- A reset puts the kart on a clear spot of the centre line (beside or a
	-- little behind the reset point if another kart is there). If it still
	-- overlaps a kart (both reset at once), it is a see-through ghost with no
	-- bumpers until it is ResetClear studs (centre to centre) from every kart
	-- and at least ResetGhostTime has passed: bumpers that start deep inside
	-- each other lock the two karts together.
	ResetClear = 10.5,
	ResetGhostTime = 1.0,
	TrackChangeCooldown = 3, -- practice: seconds between track changes
	TrackLoadTime = 3, -- seconds before practice karts return after a track change
	OffTrackAllowance = 60, -- studs beyond the road edge that still count as on course
}

-- The lobby, quick races and private rooms. Every public server is a lobby
-- (the menu over a slow fly-by of a circuit); PRACTICE, RACE and PRIVATE ROOM
-- send players to reserved servers of the same place. In Studio teleports do
-- not work, so the one server switches to the chosen mode in place.
Config.Lobby = {
	QueueMin = 2, -- a quick race needs this many drivers...
	QueueWait = 7, -- ...and starts this many seconds after the QueueMin-th one joined
	QueueMax = 12, -- this many waiting: straight away (Config.Race.MaxRacers)
	QueuePoll = 1.5, -- seconds between reads of the shared queue (each lobby server)
	TicketTtl = 45, -- a ticket left by a server that went away expires after this
	RoomDigits = 4,
	RoomTtl = 6 * 3600,
	RoomRefresh = 600, -- the room server renews its code this often
	ServerTtl = 2 * 3600, -- how long a reserved server's role is kept for it to read
	StudioSolo = true, -- Studio only: a quick race starts with one driver
	FlybySpeed = 24, -- the lobby camera, studs per second along the track
	FlybyHeight = 16,
	FlybySide = 26,
	TeleportDelay = 0.4, -- seconds between "teleporting" on the client and the teleport
	LobbyConfirm = 3, -- the LOBBY button asks to be pressed again within this
	KickConfirm = 3, -- the room's KICK asks to be pressed again within this
}

-- Player settings (the SETTINGS menu), saved with each player's data. Each
-- item: label, default, and either a numeric range (min, max, step; shown as
-- a percentage when `percent`) or a list of options; true/false otherwise.
Config.Settings = {
	Order = { "MasterVolume", "EngineVolume", "EffectsVolume", "SteerSpeed", "SteerAssist", "Camera", "Units", "Minimap", "Delta" },
	Items = {
		MasterVolume = { label = "Master volume", default = 1, min = 0, max = 1, step = 0.1, percent = true },
		EngineVolume = { label = "Engine volume", default = 0.8, min = 0, max = 1, step = 0.1, percent = true },
		EffectsVolume = { label = "Effects volume", default = 0.8, min = 0, max = 1, step = 0.1, percent = true },
		SteerSpeed = { label = "Steering speed (keys)", default = 1, min = 0.6, max = 1.6, step = 0.1, percent = true },
		SteerAssist = { label = "Steering assist", default = true },
		Camera = { label = "Starting camera", default = "Near", options = { "Cockpit", "Near", "Far" } },
		Units = { label = "Speed units", default = "KMH", options = { "KMH", "MPH" } },
		Minimap = { label = "Minimap", default = "Normal", options = { "Off", "Small", "Normal", "Large" } },
		Delta = { label = "Live lap delta", default = true },
	} :: { [string]: any },
}

-- Sounds: audio asset ids ("rbxassetid://123..."). The sounds/ folder of the
-- project has the original set made for this game; these ids are the user's
-- uploads of it (Oct 2026). A new upload gets a new id: paste it here. An
-- empty id is silent. Loops: the engine (pitched from the engine rpm), the
-- skid (fades with tyre slip), off-track (gravel / grass / water) and kerbs
-- (both fade in with speed); the crowd loops at every grandstand. One-shots:
-- bump = kart contact, beep = each start light, go = lights out, lap = a lap
-- completed, best = personal best / fastest lap / track record, warning =
-- track-limits warning, penalty = lap deleted or a time penalty, flag =
-- qualifying starts / chequered flag, finish = your chequered flag in the
-- race, podium = the results, click = buttons. Volumes are scaled by the
-- player's settings.
-- Volumes were set with a mix simulation (sounds/mix_levels.py: Roblox's volume
-- model, inverse roll-off from the chase camera, phone / laptop / headphone
-- speakers, A-weighting): the engine at full throttle is the loudest steady
-- sound, the slide ~6 dB under it, kerbs and gravel ~4-5 dB under, a nearby
-- grandstand ~15 dB under, the race chimes 0-3 dB over. Before that, on a
-- phone the tyres were 22 dB and the crowd 19 dB louder than the engine.
Config.Audio = {
	EngineSoundId = "rbxassetid://91449674300903",
	EngineVolume = 1.1,
	-- the engine loop (sounds/engine_loop.ogg) is recorded at EngineRpmLoop.
	-- A rental kart: idles, the centrifugal clutch slips at EngineRpmClutch
	-- until the kart is fast enough, then the revs follow the road speed (one
	-- gear) up to EngineRpmMax at top speed. Off the throttle the clutch
	-- holds (engine braking) until the road speed is below EngineRpmRelease.
	EngineRpmLoop = 3000,
	EngineRpmIdle = 1600,
	EngineRpmClutch = 2600,
	EngineRpmRelease = 2000,
	EngineRpmMax = 4200,
	SkidSoundId = "rbxassetid://117100105483453",
	SkidVolume = 0.31,
	OffroadSoundId = "rbxassetid://83887645728236",
	OffroadVolume = 0.52,
	KerbSoundId = "rbxassetid://89095407744124",
	KerbVolume = 0.63,
	BumpSoundId = "rbxassetid://96414496985286",
	BumpVolume = 1.15,
	BeepSoundId = "rbxassetid://106467681472548",
	BeepVolume = 0.22,
	GoSoundId = "rbxassetid://115374666219082",
	GoVolume = 0.31,
	LapSoundId = "rbxassetid://103923634271916",
	LapVolume = 0.3,
	BestSoundId = "rbxassetid://79479200280451",
	BestVolume = 0.54,
	WarningSoundId = "rbxassetid://108778334873385",
	WarningVolume = 0.3,
	PenaltySoundId = "rbxassetid://139070978914964",
	PenaltyVolume = 0.66,
	FlagSoundId = "rbxassetid://80495713260197",
	FlagVolume = 0.27,
	FinishSoundId = "rbxassetid://74463771278347",
	FinishVolume = 0.31,
	PodiumSoundId = "rbxassetid://108771531659515",
	PodiumVolume = 0.71,
	ClickSoundId = "rbxassetid://79417620837900",
	ClickVolume = 1.16,
	CrowdSoundId = "rbxassetid://77498018095928",
	CrowdVolume = 0.33,
	CrowdRollOffMin = 20, -- studs from a grandstand roof at which the crowd is at full volume
}

-- Driving camera. Mouse wheel / pinch / D-pad zoom from far behind the kart
-- all the way into the cockpit (first person); C cycles the presets.
-- Behind the kart, right-drag (or the right stick / a finger drag) swings the
-- camera around the kart and it stays where you put it; V (or R3) puts it
-- back behind. In the cockpit the same controls look around and the view
-- recentres when you let go.
Config.Camera = {
	Distance = 13, -- default chase distance (studs)
	MinDistance = 6, -- zooming in past this switches to the cockpit view
	MaxDistance = 40,
	ZoomStep = 1.18, -- factor per mouse-wheel notch
	ZoomSpeed = 12, -- how fast the camera follows a zoom change
	HeightBase = 1.3, -- chase camera height above the kart = HeightBase + HeightPerStud * distance
	HeightPerStud = 0.24,
	LookAhead = 6,
	FovMin = 70,
	FovMax = 86,
	Stiffness = 9, -- how fast the chase camera swings behind the kart
	FreeLookSensitivity = 0.25, -- degrees per pixel of mouse movement
	TouchSensitivity = 0.35, -- degrees per pixel of finger movement
	StickOrbitSpeed = 160, -- degrees per second at full right stick (behind the kart)
	OrbitPitchMin = -8, -- degrees, camera elevation limits behind the kart
	OrbitPitchMax = 80,
	AutoRecenter = 0, -- seconds of driving before an orbited camera returns behind (0 = never)
	FreeLookReturn = 7, -- how fast the view recentres (cockpit look, V / R3 reset)
	Presets = { 0, 13, 22 }, -- C cycles these (0 = cockpit)
	Cockpit = {
		Eye = { 0, 3.25, -0.2 }, -- x, height above ground, forward, in the kart's frame
		Pitch = -9, -- degrees, looking slightly down the road
		Fov = 72,
		FovSpeedGain = 6, -- extra degrees at top speed
		-- Motion, all eased with critically damped springs (no bounce-back):
		HeadG = 0.045, -- studs the head sways sideways per g of cornering
		HeadGForward = 0.06, -- studs forward per g of braking
		HeadMax = 0.14,
		HeadResponse = 7, -- 1/s
		AccelFilter = 5, -- 1/s, smooths the measured g-forces
		TiltFollow = 0.3, -- share of the kart's roll/pitch you see (0 = horizon locked)
		TiltResponse = 10, -- 1/s
		LookIntoTurn = 0, -- degrees of glance per degree/s of yaw rate ("look to apex"; 0.1 is subtle). Off: it swings the view back when you straighten up
		MaxLookIntoTurn = 6,
		LookResponse = 5, -- 1/s
		Shoulders = { 0.9, 2.55, -0.55 }, -- +-x, height, forward (for the cockpit arms)
	},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">KartPhysics</string>
          <string name="Source"><![CDATA[--!strict
-- Kart vehicle model. Pure Luau (only the `vector` library) so the exact same
-- code drives the kart in Roblox and in the headless tests.
--
-- Once per frame it takes the chassis pose and velocity, casts one ray per
-- wheel (through a callback) and returns one world force and one world torque
-- about the centre of mass. The caller applies them (VectorForce + Torque in
-- Roblox, a rigid-body integrator in the tests). Gravity is not included.
--
--   suspension  raycast spring-damper per corner + anti-roll + bump stop
--   tyres       slip angle -> lateral force (Pacejka magic formula), combined
--               with drive/brake force inside a friction circle; load-sensitive
--   drivetrain  rear-wheel drive, traction-limited, constant power at speed,
--               engine braking, front/rear brake split, reverse after a pause
--   steering    rate-limited, Ackermann geometry, optional counter-steer assist
--   slipstream  close behind another kart the air drag drops and the top
--               speed creeps up a little (a tow down the straights)
--   bumpers     soft contact with other karts: each kart is a rounded
--               rectangle (its wraparound bumper); overlap pushes back with a
--               spring-damper plus some rubbing friction, horizontal only, so
--               karts shove and spin each other but never launch
--
-- Sub-stepping: tyres and springs are stiff, and Roblox only lets us set a
-- force once per frame (30-60 Hz on phones). Holding a stiff force for a whole
-- frame overshoots and can explode. So each frame the model predicts the
-- chassis motion internally at 240 Hz against the ground planes found by the
-- rays, sums the impulse, and hands back the average force and torque. The
-- engine then integrates that smooth average. Same physics, stable at any fps.

local KartPhysics = {}

export type Body = {
	pos: vector, -- chassis box centre (= centre of mass)
	right: vector,
	up: vector,
	look: vector,
	vel: vector,
	angVel: vector,
	mass: number,
}

export type Hit = {
	dist: number, -- distance along the ray (from the mount point)
	normal: vector,
	grip: number, -- surface multiplier on Mu
	roll: number, -- surface multiplier on rolling resistance
}

export type RaycastFn = (origin: vector, dir: vector) -> Hit?

export type Controls = {
	throttle: number, -- 0..1
	brake: number, -- 0..1
	steer: number, -- -1 (left) .. 1 (right)
}

export type State = {
	steerAngle: number, -- radians, + = right
	reverse: boolean,
	reverseTimer: number,
	-- static-friction anchors: where each tyre is "stuck" while parked (nil = free)
	anchors: { [number]: vector },
	draft: number, -- slipstream 0..1 (smoothed)
}

export type WheelOut = {
	contact: boolean,
	hitDist: number, -- ray length to the ground (or full length in the air)
	compression: number,
	steer: number, -- radians, + = right
	load: number, -- normal force
	usage: number, -- grip demand / grip available (> 1 means sliding)
	spinning: boolean, -- driven wheel overpowering its grip
	locked: boolean, -- braked wheel overpowering its grip
	longSpeed: number, -- contact patch speed along the wheel
}

export type Result = {
	force: vector,
	torque: vector,
	wheels: { WheelOut },
	forwardSpeed: number,
	speed: number,
	grounded: number,
	reverse: boolean,
	steerAngle: number,
	contact: number, -- deepest bumper overlap with another kart this frame (studs, 0 = none)
	contactSpeed: number, -- closing speed at the first touch this frame (studs/s)
	bumps: { vector }, -- per obstacle (same order as `others`): horizontal velocity change its bumper gave us this frame
	draft: number, -- slipstream 0..1
}

-- Slipstream: a kart between Gap and Length studs ahead (centre to centre)
-- and within Width studs sideways gives a tow that grows as you close in.
-- At full tow drag drops by DragCut and the governor allows TopGain more
-- studs/s. Rise/Fall: how fast the tow builds and fades (1/s).
export type SlipstreamConfig = {
	Gap: number,
	Length: number,
	Width: number,
	MinSpeed: number,
	DragCut: number,
	TopGain: number,
	Rise: number,
	Fall: number,
}

-- Another kart as seen by this one: its centre of mass, heading and motion
-- (the caller extrapolates network-delayed karts to "now").
export type Obstacle = {
	pos: vector,
	look: vector,
	vel: vector,
	angVel: vector,
}

-- Bumper outline (relative to the centre of mass) and contact response.
-- Stiffness: push per stud of overlap, capped at SpringMax (so karts that
-- end up deep inside each other, after a lag spike or a reset, ease apart
-- instead of exploding). Damping: push per stud/s of closing speed (and less
-- push while parting), faded in over the first quarter stud of overlap (no
-- jolt at the first touch); it is what stops a hard hit. MaxAccel caps the
-- total. All in studs/s^2.
export type BumperConfig = {
	HalfWidth: number,
	Front: number,
	Rear: number,
	Corner: number,
	Stiffness: number,
	SpringMax: number,
	Damping: number,
	Friction: number,
	MaxAccel: number,
}

export type WheelSpec = { name: string, x: number, f: number, radius: number, width: number, front: boolean, grip: number, stiffness: number? }

-- The fields of Config.Kart this module reads.
export type KartConfig = {
	Gravity: number,
	CoreSize: { number },
	RideHeight: number,
	Wheels: { WheelSpec },
	SpringHz: number,
	DampingRatio: number,
	Travel: number,
	BumpStopRate: number,
	AntiRollFront: number,
	AntiRollRear: number,
	Mu: number,
	LoadSensitivity: number,
	PacejkaB: number,
	PacejkaC: number,
	RollingResistance: number,
	LowSpeedBlend: number,
	DriveAccel: number,
	PowerPerMass: number,
	EngineBraking: number,
	TopSpeed: number,
	DragCoef: number,
	BrakeAccel: number,
	BrakeRearBias: number,
	ReverseAccel: number,
	ReverseSpeed: number,
	ReverseDelay: number,
	SteerLock: number,
	SteerRate: number,
	SteerReturnRate: number,
	Ackermann: number,
	SteerAssist: boolean,
	SteerAssistSlip: number,
	AssistCatch: number?,
	Bumper: BumperConfig?,
	Slipstream: SlipstreamConfig?,
}

local TWO_PI = 2 * math.pi
local SUBSTEP_HZ = 240
local ANCHOR_OMEGA = 2 * math.pi * 6 -- static-friction spring
local UP = vector.create(0, 1, 0)

local function tanh(x: number): number
	if x > 10 then
		return 1
	elseif x < -10 then
		return -1
	end
	local e = math.exp(2 * x)
	return (e - 1) / (e + 1)
end

local function rotate(v: vector, axis: vector, angle: number): vector
	local c, s = math.cos(angle), math.sin(angle)
	return v * c + vector.cross(axis, v) * s + axis * (vector.dot(axis, v) * (1 - c))
end

function KartPhysics.newState(cfg: KartConfig): State
	return { steerAngle = 0, reverse = false, reverseTimer = 0, anchors = {}, draft = 0 }
end

export type Geometry = {
	wheelbase: number,
	frontF: number,
	rearF: number,
	frontTrack: number,
	rearTrack: number,
	frontShare: number,
	rearShare: number,
	omega: number,
	staticCompression: number,
	rayLength: number,
	-- inertia of the chassis box per unit mass, local axes
	ix: number, -- pitch (about right)
	iy: number, -- yaw (about up)
	iz: number, -- roll (about look)
}

local geometryCache: { [any]: Geometry } = setmetatable({}, { __mode = "k" }) :: any

-- Derived constants that only depend on the config.
function KartPhysics.geometry(cfg: KartConfig): Geometry
	local cached = geometryCache[cfg]
	if cached then
		return cached
	end
	local frontF, rearF = -math.huge, math.huge
	local frontTrack, rearTrack = 0, 0
	for _, w in cfg.Wheels do
		if w.front then
			frontF = math.max(frontF, w.f)
			frontTrack = math.max(frontTrack, math.abs(w.x) * 2)
		else
			rearF = math.min(rearF, w.f)
			rearTrack = math.max(rearTrack, math.abs(w.x) * 2)
		end
	end
	local wheelbase = frontF - rearF
	local omega = TWO_PI * cfg.SpringHz
	local staticComp = cfg.Gravity / (omega * omega)
	local bw, bh, bl = cfg.CoreSize[1], cfg.CoreSize[2], cfg.CoreSize[3]
	local g: Geometry = {
		wheelbase = wheelbase,
		frontF = frontF,
		rearF = rearF,
		frontTrack = frontTrack,
		rearTrack = rearTrack,
		-- static share of the weight carried by one front / one rear wheel
		frontShare = (-rearF / wheelbase) / 2,
		rearShare = (frontF / wheelbase) / 2,
		omega = omega,
		staticCompression = staticComp,
		rayLength = cfg.RideHeight + staticComp, -- mount to ground at full droop
		ix = (bh * bh + bl * bl) / 12,
		iy = (bw * bw + bl * bl) / 12,
		iz = (bw * bw + bh * bh) / 12,
	}
	geometryCache[cfg] = g
	return g
end

-- How much the steering assist blends in at a given speed (0 = raw lock).
function KartPhysics.assistWeight(cfg: KartConfig, speed: number): number
	if not cfg.SteerAssist then
		return 0
	end
	return math.clamp((speed - 8) / 14, 0, 1)
end

-- Slip angle of the front axle's velocity relative to the chassis (radians,
-- + = moving to the right of where the nose points).
function KartPhysics.frontAxleSlip(cfg: KartConfig, body: Body): number
	local g = KartPhysics.geometry(cfg)
	local vf = body.vel + vector.cross(body.angVel, body.look * g.frontF)
	local vlong = vector.dot(vf, body.look)
	if vlong < 2 then
		return 0
	end
	return math.atan2(vector.dot(vf, body.right), vlong)
end

-- Front slip angle (radians) the assist asks for at input u in [0, 1].
-- The tyre's grip rises steeply at small slip angles and flattens towards the
-- peak, so mapping the input straight to a slip angle made the first half of
-- the key press do almost all the turning (and the last part of letting go
-- snap the kart straight). This inverts the grip curve instead: the input
-- asks for a share of the front grip, so the kart's turn builds and fades in
-- step with the input. Full input reaches SteerAssistSlip (just past peak).
function KartPhysics.assistSlip(cfg: KartConfig, u: number): number
	u = math.clamp(u, 0, 1)
	local B, C = cfg.PacejkaB, cfg.PacejkaC
	local peak = math.tan(math.pi / (2 * C)) / B
	local slip = math.tan(math.asin(u) / C) / B
	return slip * (math.rad(cfg.SteerAssistSlip) / peak)
end

-- Steering angle at the wheels for a given input (-1..1).
-- Without assist: input * lock. With assist (blended in with speed) the input
-- sets the front tyres' slip angle relative to where the front axle is going,
-- so full input means "use all the front grip" and letting go of the keys
-- points the wheels where the kart is travelling (natural counter-steer when
-- the rear steps out). The physics stays the same; only the steering column
-- is helped, which is what keyboard players need.
-- Rear axle slip angle (radians, + = rear axle moving to the right of the nose).
function KartPhysics.rearAxleSlip(cfg: KartConfig, body: Body): number
	local g = KartPhysics.geometry(cfg)
	local vr = body.vel + vector.cross(body.angVel, body.look * g.rearF)
	local vlong = vector.dot(vr, body.look)
	if math.abs(vlong) < 2 then
		return 0
	end
	return math.atan2(vector.dot(vr, body.right), math.abs(vlong))
end

-- Slip angle where the rear tyres peak (radians).
local function rearPeak(cfg: KartConfig): number
	local stiff = 1
	for _, w in cfg.Wheels do
		if not w.front then
			stiff = w.stiffness or 1
		end
	end
	return math.tan(math.pi / (2 * cfg.PacejkaC)) / (cfg.PacejkaB * stiff)
end

-- `beta` overrides the front axle direction (the lagged value from State).
-- Besides aiming the front tyres, the assist catches slides: once the rear
-- tyres slip past their peak (oversteer), the front slip it asks for is
-- pulled back towards counter-steer, even if the steering key is still held,
-- as a keyboard player cannot react as fast as a hand on a wheel.
function KartPhysics.steerTarget(cfg: KartConfig, input: number, body: Body, beta: number?): number
	local lock = math.rad(cfg.SteerLock)
	local w = KartPhysics.assistWeight(cfg, math.abs(vector.dot(body.vel, body.look)))
	local raw = input * lock
	if w <= 0 then
		return raw
	end
	local slip = math.sign(input) * KartPhysics.assistSlip(cfg, math.abs(input))
	local gain = cfg.AssistCatch or 0
	if gain > 0 then
		-- rear force direction: r > 0 means the rear is pushing the kart's tail
		-- out to the left (rotating right)
		local r = -KartPhysics.rearAxleSlip(cfg, body)
		local limit = rearPeak(cfg) * 1.15
		local excess = math.sign(r) * math.max(math.abs(r) - limit, 0)
		slip -= gain * excess
		local cap = math.rad(cfg.SteerAssistSlip)
		slip = math.clamp(slip, -cap, cap)
	end
	local assisted = (beta or KartPhysics.frontAxleSlip(cfg, body)) + slip
	return math.clamp(raw * (1 - w) + assisted * w, -lock, lock)
end

-- Inverse of steerTarget for a desired wheel angle (used by the test autopilot).
function KartPhysics.inputFor(cfg: KartConfig, delta: number, body: Body, beta: number?): number
	local lo, hi = -1, 1
	local function at(u: number): number
		return KartPhysics.steerTarget(cfg, u, body, beta)
	end
	if at(hi) <= delta then
		return 1
	elseif at(lo) >= delta then
		return -1
	end
	for _ = 1, 30 do
		local mid = (lo + hi) / 2
		if at(mid) < delta then
			lo = mid
		else
			hi = mid
		end
	end
	return (lo + hi) / 2
end

local function approach(current: number, target: number, rate: number): number
	if current < target then
		return math.min(current + rate, target)
	end
	return math.max(current - rate, target)
end

type Plane = { point: vector, normal: vector, grip: number, roll: number }

type Demands = {
	drive: number,
	brake: number,
	reverse: number,
	steerL: number,
	steerR: number,
}

-- Forces for one substep. `b` is the predicted body. Returns force (no
-- gravity), torque about the centre of mass, and fills `outs`.
local function wheelForces(
	cfg: KartConfig,
	g: Geometry,
	state: State,
	b: Body,
	planes: { [number]: Plane },
	d: Demands,
	h: number,
	outs: { WheelOut }
): (vector, vector, number)
	local m = b.mass
	local up, right, look = b.up, b.right, b.look
	local vel, angVel = b.vel, b.angVel
	local forwardSpeed = vector.dot(vel, look)
	local wheels = cfg.Wheels
	local nW = #wheels
	local omega2 = g.omega * g.omega

	-- suspension geometry against each wheel's ground plane
	local comp = table.create(nW, 0)
	local dist = table.create(nW, g.rayLength)
	local mounts: { vector } = table.create(nW)
	local grounded = 0
	for i, w in wheels do
		local mount = b.pos + right * w.x + look * w.f
		mounts[i] = mount
		local pl = planes[i]
		if pl then
			-- distance along the ray (-up) to the plane
			local denom = vector.dot(up, pl.normal)
			if denom > 0.2 then
				local dd = vector.dot(mount - pl.point, pl.normal) / denom
				if dd >= -0.5 and dd <= g.rayLength then
					dist[i] = math.max(dd, 0)
					comp[i] = g.rayLength - dist[i]
					grounded += 1
				end
			end
		end
		if comp[i] <= 0 then
			state.anchors[i] = nil
		end
	end

	-- anti-roll: wheels 1,2 are the front pair and 3,4 the rear pair
	local arb = table.create(nW, 0)
	for _, pair in { { 1, 2 }, { 3, 4 } } do
		local a, c = pair[1], pair[2]
		if wheels[a] and wheels[c] then
			local front = wheels[a].front
			local share = if front then g.frontShare else g.rearShare
			local k = m * share * omega2 * (if front then cfg.AntiRollFront else cfg.AntiRollRear)
			local diff = comp[a] - comp[c]
			arb[a] = k * diff
			arb[c] = -k * diff
		end
	end

	local force = vector.zero
	local torque = vector.zero
	for i, w in wheels do
		local share = if w.front then g.frontShare else g.rearShare
		local mi = m * share
		local k = mi * omega2
		local c = 2 * cfg.DampingRatio * mi * g.omega
		local wheelSteer = if w.front then (if w.x < 0 then d.steerL else d.steerR) else 0
		local out = outs[i]
		out.contact = comp[i] > 0
		out.hitDist = dist[i]
		out.compression = comp[i]
		out.steer = wheelSteer
		out.load, out.usage, out.spinning, out.locked, out.longSpeed = 0, 0, false, false, 0
		local pl = planes[i]
		if comp[i] > 0 and pl then
			local p = mounts[i] - up * dist[i] -- contact point
			local r = p - b.pos
			local vp = vel + vector.cross(angVel, r)
			local compRate = -vector.dot(vp, up)
			local x = comp[i]
			local fs = k * x + c * compRate + arb[i]
			local bump = g.staticCompression + cfg.Travel
			if x > bump then
				fs += k * cfg.BumpStopRate * (x - bump)
			end
			fs = math.max(fs, 0)
			local n = pl.normal
			local load = fs * math.max(vector.dot(up, n), 0.2)
			out.load = load

			-- contact frame
			local wfwd = look * math.cos(wheelSteer) + right * math.sin(wheelSteer)
			local lv = wfwd - n * vector.dot(wfwd, n)
			local lmag = vector.magnitude(lv)
			local tireF = vector.zero
			if lmag > 1e-4 and load > 0 then
				local l = lv / lmag
				local t = vector.cross(l, n)
				local vx = vector.dot(vp, l)
				local vy = vector.dot(vp, t)
				out.longSpeed = vx

				local staticLoad = m * share * cfg.Gravity
				local mu = cfg.Mu * w.grip * pl.grip * math.clamp(1 - cfg.LoadSensitivity * (load / staticLoad - 1), 0.6, 1.25)
				local fmax = mu * load

				-- lateral: magic formula on slip angle, stick model at low speed
				local alpha = math.atan2(vy, math.max(math.abs(vx), 0.5))
				local dyn = -math.sin(cfg.PacejkaC * math.atan(cfg.PacejkaB * (w.stiffness or 1) * alpha)) * fmax
				local stick = -vy * mi / h * 0.25
				local blend = math.clamp(math.abs(vx) / cfg.LowSpeedBlend, 0, 1)
				local fy = dyn * blend + stick * (1 - blend)
				local noOvershoot = 0.5 * mi * math.abs(vy) / h
				fy = math.clamp(fy, -noOvershoot, noOvershoot)

				-- longitudinal demand
				local fx = 0
				local driven = not w.front
				local sgn = tanh(vx / 0.6)
				if driven then
					local nDriven = 2
					if d.drive > 0 then
						local a = math.min(cfg.DriveAccel, cfg.PowerPerMass / math.max(math.abs(forwardSpeed), 1))
						local top = cfg.TopSpeed + (if cfg.Slipstream then cfg.Slipstream.TopGain * state.draft else 0)
						local governor = math.clamp((top + 4 - forwardSpeed) / 4, 0, 1)
						fx += m * a * d.drive * governor / nDriven
					elseif d.reverse > 0 then
						local governor = math.clamp((cfg.ReverseSpeed + forwardSpeed) / 2 + 0.2, 0, 1)
						fx -= m * cfg.ReverseAccel * d.reverse * governor / nDriven
					elseif d.brake <= 0 then
						fx -= m * cfg.EngineBraking * sgn / nDriven
					end
				end
				local bias = if w.front then (1 - cfg.BrakeRearBias) / 2 else cfg.BrakeRearBias / 2
				local brakeF = m * cfg.BrakeAccel * d.brake * bias
				if brakeF > 0 then
					if math.abs(vx) < 1.5 then
						-- hold still instead of jittering around zero
						fx += math.clamp(-vx * mi * 0.5 / h, -brakeF, brakeF)
					else
						fx -= brakeF * sgn
					end
				end
				fx -= cfg.RollingResistance * pl.roll * load * sgn

				-- friction circle
				local ux, uy = 0, 0
				if fmax > 1e-6 then
					ux, uy = fx / fmax, fy / fmax
				end
				local usage = math.sqrt(ux * ux + uy * uy)
				out.usage = usage
				if usage > 1 then
					ux /= usage
					uy /= usage
					if driven and d.drive > 0 and math.abs(ux) > 0.6 then
						out.spinning = true
					end
					if brakeF > 0 and math.abs(ux) > 0.6 then
						out.locked = true
					end
				end
				tireF = l * (ux * fmax) + t * (uy * fmax)

				-- Static friction while parked: pin the contact patch to an anchor
				-- with a stiff spring-damper. Velocity-based friction alone always
				-- creeps on slopes and banking.
				local holding = d.drive <= 0 and d.reverse <= 0
				local anchor: vector? = state.anchors[i]
				if not holding then
					state.anchors[i] = nil
					anchor = nil
				elseif not anchor and math.sqrt(vx * vx + vy * vy) < 0.25 and math.abs(forwardSpeed) < 0.5 then
					anchor = p
					state.anchors[i] = p
				end
				if anchor then
					local ka = mi * ANCHOR_OMEGA * ANCHOR_OMEGA
					local ca = 2 * 1.0 * mi * ANCHOR_OMEGA
					local dp = p - anchor
					dp -= n * vector.dot(dp, n)
					local vpl = vp - n * vector.dot(vp, n)
					local fa = dp * -ka - vpl * ca
					if vector.magnitude(fa) > fmax * 0.95 then
						state.anchors[i] = nil -- breaks loose: slide on the normal model
					else
						tireF = fa
						out.usage = vector.magnitude(fa) / math.max(fmax, 1e-6)
					end
				end
			else
				state.anchors[i] = nil
			end

			local f = up * fs + tireF
			force += f
			torque += vector.cross(r, f)
		end
	end

	-- aerodynamic drag at the centre of mass (less in another kart's wake)
	local dragCut = if cfg.Slipstream then cfg.Slipstream.DragCut * state.draft else 0
	force -= vel * (cfg.DragCoef * (1 - dragCut) * m * vector.magnitude(vel))
	return force, torque, grounded
end

----------------------------------------------------------------------------
-- Bumpers: kart-to-kart contact
----------------------------------------------------------------------------
-- Signed distance from a point (x right, f forward, relative to the centre of
-- mass) to the bumper outline, and the outward direction there.
local function bumperSdf(bm: BumperConfig, x: number, f: number): (number, number, number)
	local c = bm.Corner
	local fc = (bm.Front - bm.Rear) / 2
	local hl = (bm.Front + bm.Rear) / 2
	local lf = f - fc
	local sx = if x >= 0 then 1 else -1
	local sf = if lf >= 0 then 1 else -1
	local qx = math.abs(x) - (bm.HalfWidth - c)
	local qf = math.abs(lf) - (hl - c)
	if qx > 0 or qf > 0 then
		local ox, of = math.max(qx, 0), math.max(qf, 0)
		local len = math.sqrt(ox * ox + of * of)
		local inside = math.min(math.max(qx, qf), 0)
		if len < 1e-9 then
			return inside - c, sx, 0
		end
		return len + inside - c, sx * ox / len, sf * of / len
	end
	-- inside the straight-edged core: nearest edge
	if qx > qf then
		return qx - c, sx, 0
	end
	return qf - c, 0, sf
end
KartPhysics.bumperSdf = bumperSdf

-- Points around the outline (local x, f), every metre or so plus the corners.
type OutlinePoint = { x: number, f: number }
local outlineCache: { [any]: { OutlinePoint } } = setmetatable({}, { __mode = "k" }) :: any
local function outline(bm: BumperConfig): { OutlinePoint }
	local cached = outlineCache[bm]
	if cached then
		return cached
	end
	local pts: { OutlinePoint } = {}
	local c, W, F, R = bm.Corner, bm.HalfWidth, bm.Front, bm.Rear
	local function edge(x0: number, f0: number, x1: number, f1: number)
		local len = math.sqrt((x1 - x0) ^ 2 + (f1 - f0) ^ 2)
		local n = math.max(1, math.ceil(len / 1.0))
		for i = 0, n - 1 do
			local t = i / n
			table.insert(pts, { x = x0 + (x1 - x0) * t, f = f0 + (f1 - f0) * t })
		end
	end
	local function arc(cx: number, cf: number, a0: number)
		for k = 0, 3 do
			local a = a0 + (k / 4) * math.pi / 2
			table.insert(pts, { x = cx + math.cos(a) * c, f = cf + math.sin(a) * c })
		end
	end
	-- anticlockwise from the front right, as seen from above with x right, f up
	edge(W - c, F, -(W - c), F)
	arc(-(W - c), F - c, math.pi / 2)
	edge(-W, F - c, -W, -R + c)
	arc(-(W - c), -R + c, math.pi)
	edge(-(W - c), -R, W - c, -R)
	arc(W - c, -R + c, 3 * math.pi / 2)
	edge(W, -R + c, W, F - c)
	arc(W - c, F - c, 0)
	outlineCache[bm] = pts
	return pts
end
KartPhysics.bumperOutline = outline

local function flat(v: vector): vector
	return vector.create(v.x, 0, v.z)
end

-- Push on body `b` from obstacle `o` (advanced `t` seconds), applied at the
-- height of the centre of mass so it never rolls or pitches the kart.
-- Returns the force, the torque about the centre of mass, the overlap and
-- the closing speed.
-- Karts further apart in height than this are on the two levels of a
-- crossing (one on the bridge, one under it): they neither touch nor tow.
local OTHER_LEVEL = 5

local function bumperContact(bm: BumperConfig, b: Body, o: Obstacle, t: number): (vector, vector, number, number)
	local reach = math.sqrt(bm.HalfWidth ^ 2 + math.max(bm.Front, bm.Rear) ^ 2)
	local cA = b.pos
	local cB = o.pos + o.vel * t
	-- on the other level of a crossing (the bridge over the road): no contact
	if math.abs(cB.y - cA.y) > OTHER_LEVEL then
		return vector.zero, vector.zero, 0, 0
	end
	cB = vector.create(cB.x, cA.y, cB.z)
	local d = cB - cA
	if d.x * d.x + d.z * d.z > (2 * reach) ^ 2 then
		return vector.zero, vector.zero, 0, 0
	end
	local fA = vector.normalize(flat(b.look))
	local rA = vector.cross(fA, UP)
	local spin = o.angVel.y * t
	local fB = vector.normalize(flat(o.look))
	if math.abs(spin) > 1e-6 then
		fB = vector.normalize(flat(rotate(fB, UP, spin)))
	end
	local rB = vector.cross(fB, UP)
	local pts = outline(bm)
	local sumW, maxPen = 0, 0
	local sumN, sumP = vector.zero, vector.zero
	-- my outline inside theirs: push out along their surface normal
	for _, q in pts do
		local p = cA + rA * q.x + fA * q.f
		local rel = p - cB
		local dist, gx, gf = bumperSdf(bm, vector.dot(rel, rB), vector.dot(rel, fB))
		if dist < 0 then
			local w = -dist
			sumW += w
			sumN += (rB * gx + fB * gf) * w
			sumP += p * w
			maxPen = math.max(maxPen, w)
		end
	end
	-- their outline inside mine: push away from that point
	for _, q in pts do
		local p = cB + rB * q.x + fB * q.f
		local rel = p - cA
		local dist, gx, gf = bumperSdf(bm, vector.dot(rel, rA), vector.dot(rel, fA))
		if dist < 0 then
			local w = -dist
			sumW += w
			sumN -= (rA * gx + fA * gf) * w
			sumP += p * w
			maxPen = math.max(maxPen, w)
		end
	end
	if sumW <= 0 or vector.magnitude(sumN) < 1e-9 then
		return vector.zero, vector.zero, 0, 0
	end
	local n = vector.normalize(flat(sumN))
	local point = sumP / sumW
	-- relative velocity of the two surfaces at the contact
	local vA = b.vel + vector.cross(b.angVel, point - b.pos)
	local vB = o.vel + vector.cross(o.angVel, point - cB)
	local vrel = flat(vA - vB)
	local vn = vector.dot(vrel, n) -- < 0 while closing
	local closing = math.max(0, -vn)
	local spring = math.min(bm.Stiffness * maxPen, bm.SpringMax)
	-- damping resists both closing and parting (less bounce), but never pulls
	local damp = -bm.Damping * vn * math.min(maxPen / 0.25, 1)
	local accel = math.clamp(spring + damp, 0, bm.MaxAccel)
	local fn = b.mass * accel
	local vt = vrel - n * vn
	local vtMag = vector.magnitude(vt)
	local force = n * fn
	if vtMag > 1e-6 then
		-- rubbing bumpers: friction that fades in smoothly from standstill
		force -= vt * (bm.Friction * fn / (vtMag + 0.5))
	end
	local torque = vector.cross(point - b.pos, force)
	return force, torque, maxPen, closing
end
KartPhysics.bumperContact = bumperContact

-- Contact echo. Each client pushes only its own kart and sees the other one
-- as it was a network delay ago, so during a hit the other kart still looks
-- unpushed: both clients keep pushing and the karts fly apart faster than
-- they met (0.1 s delay: a 30 km/h kart rear-ended at 55 left at 56). All karts have the
-- same mass, so the other one got the opposite of our push: the echo keeps
-- our pushes from the last `window` seconds (what its snapshot cannot show
-- yet) and takes them off its velocity and position.
export type Echo = { [any]: { { dv: vector, t: number } } }

function KartPhysics.newEcho(): Echo
	return {}
end

-- Records the push `dv` (Result.bumps[i]) the kart `key` gave us at time `now`.
function KartPhysics.echoAdd(echo: Echo, key: any, dv: vector, now: number)
	if dv == vector.zero then
		return
	end
	local list = echo[key]
	if not list then
		list = {}
		echo[key] = list
	end
	table.insert(list, { dv = dv, t = now })
end

-- The obstacle `o` (key `key`, seen `window` seconds late) with our recent
-- pushes mirrored onto it. Drops entries older than the window.
function KartPhysics.echoApply(echo: Echo, key: any, o: Obstacle, now: number, window: number): Obstacle
	local list = echo[key]
	if not list then
		return o
	end
	local dvSum, disp = vector.zero, vector.zero
	local keep = 0
	for i = 1, #list do
		local e = list[i]
		local age = now - e.t
		if age < window then
			keep += 1
			list[keep] = e
			dvSum += e.dv
			disp += e.dv * age
		end
	end
	for i = #list, keep + 1, -1 do
		list[i] = nil
	end
	if keep == 0 then
		echo[key] = nil
		return o
	end
	return { pos = o.pos - disp, look = o.look, vel = o.vel - dvSum, angVel = o.angVel }
end

-- Rigid-body substep for the internal prediction (chassis box inertia).
local function integrate(b: Body, g: Geometry, force: vector, torque: vector, gravity: number, h: number)
	b.vel += (force / b.mass - UP * gravity) * h
	local back = -b.look
	local w = b.angVel
	local wl = vector.create(vector.dot(w, b.right), vector.dot(w, b.up), vector.dot(w, back))
	local tl = vector.create(vector.dot(torque, b.right), vector.dot(torque, b.up), vector.dot(torque, back))
	local m = b.mass
	local ix, iy, iz = g.ix * m, g.iy * m, g.iz * m
	local Iw = vector.create(ix * wl.x, iy * wl.y, iz * wl.z)
	local gyro = vector.cross(wl, Iw)
	wl += vector.create((tl.x - gyro.x) / ix, (tl.y - gyro.y) / iy, (tl.z - gyro.z) / iz) * h
	b.angVel = b.right * wl.x + b.up * wl.y + back * wl.z
	b.pos += b.vel * h
	local wmag = vector.magnitude(b.angVel)
	if wmag > 1e-9 then
		local axis = b.angVel / wmag
		local ang = wmag * h
		b.right = rotate(b.right, axis, ang)
		b.up = rotate(b.up, axis, ang)
		b.look = rotate(b.look, axis, ang)
	end
	b.look = vector.normalize(b.look)
	b.right = vector.normalize(vector.cross(b.look, b.up))
	b.up = vector.cross(b.right, b.look)
end

-- How much tow the karts ahead give right now (0..1, unsmoothed).
function KartPhysics.draftTarget(cfg: KartConfig, body: Body, others: { Obstacle }?): number
	local sl = cfg.Slipstream
	if not sl or not others then
		return 0
	end
	local f = flat(body.look)
	if vector.magnitude(f) < 1e-6 then
		return 0
	end
	f = vector.normalize(f)
	local r = vector.cross(f, UP)
	if vector.dot(body.vel, f) < sl.MinSpeed then
		return 0
	end
	local best = 0
	for _, o in others do
		if math.abs(o.pos.y - body.pos.y) > OTHER_LEVEL then
			continue
		end
		local rel = flat(o.pos - body.pos)
		local ahead = vector.dot(rel, f)
		local lat = math.abs(vector.dot(rel, r))
		if ahead > sl.Gap and ahead < sl.Length and lat < sl.Width and vector.dot(o.vel, f) > sl.MinSpeed * 0.7 then
			local near = 1 - (ahead - sl.Gap) / (sl.Length - sl.Gap)
			local centred = 1 - (lat / sl.Width) ^ 2
			best = math.max(best, near * centred)
		end
	end
	return math.clamp(best, 0, 1)
end

-- `others`: nearby karts to bump into and draft behind (optional).
function KartPhysics.step(cfg: KartConfig, state: State, body: Body, ctrl: Controls, dt: number, raycast: RaycastFn, others: { Obstacle }?): Result
	dt = math.clamp(dt, 1 / 480, 1 / 10)
	local g = KartPhysics.geometry(cfg)
	local up, right, look = body.up, body.right, body.look
	local vel = body.vel
	local forwardSpeed = vector.dot(vel, look)

	----------------------------------------------------------------------
	-- Controls: reverse logic and steering (once per frame)
	----------------------------------------------------------------------
	local throttle = math.clamp(ctrl.throttle, 0, 1)
	local brake = math.clamp(ctrl.brake, 0, 1)
	if state.reverse then
		if (throttle > 0.1 and forwardSpeed > -1) or forwardSpeed > 3 then
			state.reverse = false
			state.reverseTimer = 0
		end
	elseif brake > 0.1 and throttle < 0.1 and math.abs(forwardSpeed) < 1 then
		state.reverseTimer += dt
		if state.reverseTimer >= cfg.ReverseDelay then
			state.reverse = true
		end
	else
		state.reverseTimer = 0
	end
	local d: Demands = { drive = throttle, brake = brake, reverse = 0, steerL = 0, steerR = 0 }
	if state.reverse then
		d.drive, d.brake, d.reverse = 0, throttle, brake
	end

	local input = math.clamp(ctrl.steer, -1, 1)
	local target = KartPhysics.steerTarget(cfg, input, body)
	local returning = math.abs(input) < 0.05
	local rate = math.rad(if returning then cfg.SteerReturnRate else cfg.SteerRate) * dt
	state.steerAngle = approach(state.steerAngle, target, rate)
	local delta = state.steerAngle

	-- Ackermann: inner wheel turns tighter
	d.steerL, d.steerR = delta, delta
	if math.abs(delta) > 1e-4 then
		local R = g.wheelbase / math.tan(math.abs(delta))
		local half = g.frontTrack / 2
		local inner = math.atan(g.wheelbase / math.max(R - half, 0.1))
		local outer = math.atan(g.wheelbase / (R + half))
		local a = cfg.Ackermann
		inner = math.abs(delta) + (inner - math.abs(delta)) * a
		outer = math.abs(delta) + (outer - math.abs(delta)) * a
		if delta > 0 then -- turning right: right wheel is inner
			d.steerL, d.steerR = outer, inner
		else
			d.steerL, d.steerR = -inner, -outer
		end
	end

	----------------------------------------------------------------------
	-- Ground planes under each wheel (one ray each, a little longer than the
	-- suspension so a landing during this frame is seen)
	----------------------------------------------------------------------
	local wheels = cfg.Wheels
	local nW = #wheels
	local planes: { [number]: Plane } = {}
	-- and where each wheel will be at the end of the frame: the prediction
	-- blends from one plane to the other, so a wheel that crosses an edge
	-- between two road pieces during a long frame (20-30 fps) rolls over it
	-- instead of meeting it all at once at the next frame
	local planesEnd: { [number]: Plane } = {}
	local reach = g.rayLength + 0.6 + math.max(0, -vector.dot(vel, up)) * dt * 2
	for i, w in wheels do
		local mount = body.pos + right * w.x + look * w.f
		local hit = raycast(mount, -up * reach)
		if hit then
			planes[i] = { point = mount - up * hit.dist, normal = hit.normal, grip = hit.grip, roll = hit.roll }
			local ahead = mount + vel * dt
			local hit2 = raycast(ahead, -up * reach)
			if hit2 then
				planesEnd[i] = { point = ahead - up * hit2.dist, normal = hit2.normal, grip = hit2.grip, roll = hit2.roll }
			end
		else
			state.anchors[i] = nil
		end
	end
	-- the ground under each wheel part way (t) through the frame: heights
	-- along the suspension ray and normals blended between the two planes
	local function planesAt(bb: Body, t: number): { [number]: Plane }
		local out: { [number]: Plane } = {}
		for i, w in wheels do
			local a, e = planes[i], planesEnd[i]
			if a and e then
				local mount = bb.pos + bb.right * w.x + bb.look * w.f
				local da, de = vector.dot(bb.up, a.normal), vector.dot(bb.up, e.normal)
				if da > 0.2 and de > 0.2 then
					local hA = vector.dot(mount - a.point, a.normal) / da
					local hE = vector.dot(mount - e.point, e.normal) / de
					local n = vector.normalize(a.normal * (1 - t) + e.normal * t)
					local src = if t < 0.5 then a else e
					out[i] = { point = mount - bb.up * (hA + (hE - hA) * t), normal = n, grip = src.grip, roll = src.roll }
					continue
				end
			end
			out[i] = a
		end
		return out
	end

	-- slipstream from the karts ahead, eased in and out
	do
		local tow = KartPhysics.draftTarget(cfg, body, others)
		local sl = cfg.Slipstream
		if sl then
			local towRate = if tow > state.draft then sl.Rise else sl.Fall
			state.draft += (tow - state.draft) * math.min(towRate * dt, 1)
		else
			state.draft = 0
		end
	end

	----------------------------------------------------------------------
	-- Predict the frame at 240 Hz and average the impulse
	----------------------------------------------------------------------
	local outs: { WheelOut } = table.create(nW)
	for i = 1, nW do
		outs[i] = {
			contact = false,
			hitDist = g.rayLength,
			compression = 0,
			steer = 0,
			load = 0,
			usage = 0,
			spinning = false,
			locked = false,
			longSpeed = 0,
		}
	end
	local sub = math.max(1, math.ceil(dt * SUBSTEP_HZ - 1e-6))
	local h = dt / sub
	local b: Body = {
		pos = body.pos,
		right = right,
		up = up,
		look = look,
		vel = vel,
		angVel = body.angVel,
		mass = body.mass,
	}
	local impulse, angImpulse = vector.zero, vector.zero
	local grounded = 0
	local bm = cfg.Bumper
	local contact, contactSpeed = 0, 0
	-- per obstacle: the velocity change its bumper gave us this frame (the
	-- caller's contact echo mirrors it onto that kart, KartPhysics.echoApply)
	local bumps: { vector } = {}
	if others then
		for i = 1, #others do
			bumps[i] = vector.zero
		end
	end
	for k = 1, sub do
		local f, t, gnd = wheelForces(cfg, g, state, b, planesAt(b, (k - 0.5) / sub), d, h, outs)
		grounded = gnd
		if bm and others then
			local at = (k - 0.5) * h
			for i, o in others do
				local cf, ct, pen, closing = bumperContact(bm, b, o, at)
				if pen > 0 then
					f += cf
					t += ct
					bumps[i] += flat(cf) * (h / b.mass)
					if contact == 0 then
						contactSpeed = closing
					end
					contact = math.max(contact, pen)
				end
			end
		end
		impulse += f * h
		angImpulse += t * h
		integrate(b, g, f, t, cfg.Gravity, h)
	end

	return {
		force = impulse / dt,
		torque = angImpulse / dt,
		wheels = outs,
		forwardSpeed = forwardSpeed,
		speed = vector.magnitude(vel),
		grounded = grounded,
		reverse = state.reverse,
		steerAngle = delta,
		contact = contact,
		contactSpeed = contactSpeed,
		bumps = bumps,
		draft = state.draft,
	}
end

return KartPhysics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">RaceProgress</string>
          <string name="Source"><![CDATA[--!strict
-- Lap counting, positions and lap times. Pure Luau so it is unit-tested
-- headlessly; the server feeds it kart positions every frame.
--
-- Progress is the distance driven along the centre line, unwrapped across
-- laps: negative on the grid, 0 at the first crossing of the line, and
-- Laps * length at the finish. It only advances when
--   * the kart is within the road width plus an allowance of the centre line,
--   * the nearest sample is inside a window ahead of the last accepted one, and
--   * the gain is plausible for the distance actually driven since the last
--     accepted update (so cutting across the infield does not count).
-- A racer who leaves the course stays at their last valid point until they
-- come back (or press reset, which puts them there).
--
-- Also: sector splits (setSectors), laps struck off for track limits
-- (invalidateLap: the lap still counts for distance but not as a time) and
-- the chequered flag of a timed session (closeSession: everyone finishes
-- the lap they are on).

-- TrackMath is passed in (RaceProgress.new) so this module has no requires
-- and runs unchanged in Roblox and in the Luau CLI tests.
type Sample = {
	i: number,
	s: number,
	pos: vector,
	fwd: vector,
	right: vector,
	up: vector,
	width: number,
	bank: number,
	curv: number,
	segment: number,
}
type Track = {
	samples: { Sample },
	n: number,
	length: number,
	spacing: number,
	freeLengths: { number },
}
type TrackMath = {
	nearest: (Track, vector, number?, number?, number?) -> (number, number, number),
	arcDelta: (Track, number, number) -> number,
}

local RaceProgress = {}
RaceProgress.__index = RaceProgress

local WINDOW_BACK = 10
local WINDOW_AHEAD = 45
local GAIN_FACTOR = 1.35 -- allowed track distance per stud actually driven
local GAIN_SLACK = 10 -- plus this much per update (inside lines are shorter)

export type Racer = {
	id: any,
	idx: number, -- last accepted nearest sample
	s: number, -- last accepted arc position on the lap
	progress: number, -- unwrapped
	lastPos: vector?,
	lastTime: number,
	budget: number, -- distance driven since the last accepted update
	onCourse: boolean,
	wrongWayTime: number,
	wrongWay: boolean,
	lap: number, -- 1-based lap being driven (0 = not started)
	crossed: number, -- highest line crossing counted (k * length), -1 = none
	lapStart: number?,
	lapTimes: { number },
	bestLap: number?,
	finished: boolean,
	finishTime: number?,
	dnf: boolean,
	lapInvalid: boolean, -- the lap being driven is struck off (track limits)
	sector: number, -- sector splits passed on the current lap
	finishAt: number?, -- line crossing that ends this racer's session (closeSession)
}

-- kind: "start" (first crossing), "sector" (split `index`, `time` since the
-- lap started), "lap" (`time` = lap time, `invalid` if struck off),
-- "finish" (race: `time` since the start; timed session: the last lap).
export type Event = { kind: "lap" | "finish" | "start" | "sector", racer: Racer, time: number?, lap: number?, index: number?, invalid: boolean?, lapTime: number? }

export type Race = typeof(setmetatable(
	{} :: {
		tm: TrackMath,
		track: Track,
		laps: number,
		allowance: number,
		racers: { [any]: Racer },
		order: { any },
		startTime: number,
		finishCount: number,
		sectors: { number },
		closed: boolean,
	},
	RaceProgress
))

function RaceProgress.new(tm: TrackMath, track: Track, laps: number, allowance: number, startTime: number): Race
	return setmetatable({
		tm = tm,
		track = track,
		laps = laps,
		allowance = allowance,
		racers = {},
		order = {},
		startTime = startTime,
		finishCount = 0,
		sectors = {},
		closed = false,
	}, RaceProgress)
end

-- Sector split points as fractions of the lap, e.g. { 1/3, 2/3 }.
function RaceProgress.setSectors(self: Race, fractions: { number })
	self.sectors = table.clone(fractions)
	table.sort(self.sectors)
end

-- Strikes off the lap the racer is on (it will not count as a time).
function RaceProgress.invalidateLap(self: Race, id: any)
	local r = self.racers[id]
	if r and r.lap >= 1 then
		r.lapInvalid = true
	end
end

-- Chequered flag for a timed session: everyone finishes the lap they are
-- on; racers who have not started a lap are done straight away.
function RaceProgress.closeSession(self: Race)
	self.closed = true
	for _, id in self.order do
		local r = self.racers[id]
		if not r.finished then
			if r.lap >= 1 then
				r.finishAt = r.lap
			else
				r.finished = true
				self.finishCount += 1
			end
		end
	end
end

-- Registers a racer standing at `pos` (normally a grid slot behind the line).
function RaceProgress.addRacer(self: Race, id: any, pos: vector, now: number): Racer
	local track, TrackMath = self.track, self.tm
	local idx, _, s = TrackMath.nearest(track, pos)
	local racer: Racer = {
		id = id,
		idx = idx,
		s = s,
		progress = TrackMath.arcDelta(track, s, 0), -- e.g. -20 for 20 studs behind the line
		lastPos = pos,
		lastTime = now,
		budget = 0,
		onCourse = true,
		wrongWayTime = 0,
		wrongWay = false,
		lap = 0,
		crossed = -1,
		lapStart = nil,
		lapTimes = {},
		bestLap = nil,
		finished = self.closed,
		finishTime = nil,
		dnf = false,
		lapInvalid = false,
		sector = 0,
		finishAt = nil,
	}
	self.racers[id] = racer
	table.insert(self.order, id)
	return racer
end

function RaceProgress.removeRacer(self: Race, id: any)
	self.racers[id] = nil
	local i = table.find(self.order, id)
	if i then
		table.remove(self.order, i)
	end
end

local function crossTime(p0: number, p1: number, t0: number, t1: number, target: number): number
	if p1 == p0 then
		return t1
	end
	return t0 + (t1 - t0) * math.clamp((target - p0) / (p1 - p0), 0, 1)
end

-- Feed one position sample. `vel` is used for the wrong-way warning.
-- Returns a list of events (lap completed, finished).
function RaceProgress.update(self: Race, id: any, pos: vector, vel: vector, now: number): { Event }
	local events: { Event } = {}
	local r = self.racers[id]
	if not r or r.finished or r.dnf then
		return events
	end
	local track, TrackMath = self.track, self.tm
	local L = track.length
	local dt = math.max(now - r.lastTime, 1e-3)

	if r.lastPos then
		local moved = vector.magnitude(pos - r.lastPos)
		-- ignore teleports (resets) when budgeting
		r.budget += math.min(moved, 200 * dt + 5)
	end
	r.lastPos = pos
	r.lastTime = now

	local idx, lateral, s = TrackMath.nearest(track, pos, r.idx, WINDOW_BACK, WINDOW_AHEAD)
	local smp = track.samples[idx]
	local rel = pos - smp.pos
	local vertical = math.abs(vector.dot(rel, smp.up))
	local along = math.abs(vector.dot(rel, smp.fwd))
	-- the nearest sample in the window must really be near (not just level
	-- with the kart sideways while the kart is far past the window's end)
	r.onCourse = math.abs(lateral) <= smp.width / 2 + self.allowance and along <= 3 * track.spacing and vertical < 40

	-- wrong way: moving against the track direction for a while
	local speed = vector.magnitude(vel)
	if speed > 8 and vector.dot(vel, smp.fwd) < -0.4 * speed then
		r.wrongWayTime += dt
	else
		r.wrongWayTime = math.max(r.wrongWayTime - dt * 2, 0)
	end
	r.wrongWay = r.wrongWayTime > 1.2

	if not r.onCourse then
		return events
	end
	local delta = TrackMath.arcDelta(track, s, r.s)
	if delta > r.budget * GAIN_FACTOR + GAIN_SLACK then
		return events -- too far for the distance driven: a shortcut
	end
	local p0 = r.progress
	local p1 = p0 + delta
	r.idx, r.s, r.progress = idx, s, p1
	r.budget = 0

	-- sector splits on the lap being driven (before its line crossing)
	if delta > 0 and r.lapStart and #self.sectors > 0 and r.lap >= 1 then
		local lapBase = (r.lap - 1) * L
		for j = r.sector + 1, #self.sectors do
			local at = lapBase + self.sectors[j] * L
			if p0 < at and p1 >= at then
				r.sector = j
				local t = crossTime(p0, p1, now - dt, now, at)
				table.insert(events, { kind = "sector", racer = r, index = j, time = t - (r.lapStart :: number), lap = r.lap })
			elseif p1 < at then
				break
			end
		end
	end

	-- crossing lap boundaries (k * L for k = 0 .. laps)
	if delta > 0 then
		local limit = math.min(r.finishAt or self.laps, self.laps)
		local kFirst = math.floor(p0 / L) + 1
		local kLast = math.floor(p1 / L)
		for k = math.max(kFirst, r.crossed + 1, 0), math.min(kLast, limit) do
			r.crossed = k
			local t = crossTime(p0, p1, now - dt, now, k * L)
			if k == 0 then
				r.lap = 1
				r.lapStart = t
				r.sector = 0
				r.lapInvalid = false
				table.insert(events, { kind = "start", racer = r, time = t })
			else
				local lt: number? = nil
				local invalid = r.lapInvalid
				if r.lapStart then
					lt = t - (r.lapStart :: number)
					if not invalid then
						table.insert(r.lapTimes, lt :: number)
						if not r.bestLap or (lt :: number) < (r.bestLap :: number) then
							r.bestLap = lt
						end
					end
				end
				r.lapInvalid = false
				r.sector = 0
				if k >= limit then
					r.finished = true
					r.finishTime = t - self.startTime
					self.finishCount += 1
					table.insert(events, { kind = "finish", racer = r, time = r.finishTime, lap = k, lapTime = lt, invalid = invalid })
					break
				end
				r.lap = k + 1
				r.lapStart = t
				table.insert(events, { kind = "lap", racer = r, time = lt, lap = k, invalid = invalid })
			end
		end
	end
	return events
end

-- Pose to reset a racer to: the last accepted point on the centre line.
function RaceProgress.resetPose(self: Race, id: any): (vector?, vector?, vector?)
	local r = self.racers[id]
	if not r then
		return nil
	end
	local smp = self.track.samples[r.idx]
	r.lastPos = nil -- the teleport must not eat or add budget
	return smp.pos, smp.fwd, smp.up
end

-- Racers in race order: finishers by time, then by progress. DNFs last.
function RaceProgress.standings(self: Race): { Racer }
	local list: { Racer } = {}
	for _, id in self.order do
		table.insert(list, self.racers[id])
	end
	table.sort(list, function(a, b)
		if a.finished ~= b.finished then
			return a.finished
		end
		if a.finished and b.finished then
			return (a.finishTime :: number) < (b.finishTime :: number)
		end
		if a.dnf ~= b.dnf then
			return not a.dnf
		end
		return a.progress > b.progress
	end)
	return list
end

function RaceProgress.allDone(self: Race): boolean
	for _, id in self.order do
		local r = self.racers[id]
		if not r.finished and not r.dnf then
			return false
		end
	end
	return true
end

return RaceProgress
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">SteerFilter</string>
          <string name="Source"><![CDATA[--!strict
-- Turns raw steering input into a smooth steering command, the way racing
-- games treat a keyboard (Forza calls it input smoothing):
--
--   digital keys / touch buttons  the command rises towards full lock at a
--       limited rate that gets slower with speed (a quick flick at parking
--       speed, a gradual turn-in at racing speed), comes back to centre a
--       little quicker, and goes through centre fast when you switch
--       direction (a counter-steer should not be sluggish)
--   analog stick  passes through with a gentle response curve and only a
--       light rate limit, so fine corrections stay precise
--
-- A real driver cannot snap the wheel to full lock either, and if they did
-- the front tyres would go past their peak slip angle and the kart would push
-- wide (understeer). The ramp gives the weight time to transfer onto the
-- outside front tyre. Pure Luau, no Roblox APIs.

local SteerFilter = {}

export type Settings = {
	RiseLow: number, -- input units per second towards lock at low speed
	RiseHigh: number, -- ... at RiseSpeed and above
	ReturnLow: number, -- towards centre when released, low speed
	ReturnHigh: number,
	Counter: number, -- through centre when switching direction
	RiseSpeed: number, -- studs/s where the high-speed rates are reached
	Smoothing: number, -- 1/s, removes the corners of the ramp
	StickRate: number, -- rate limit for the analog stick
	StickCurve: number, -- exponent: >1 = finer control around centre
}

export type State = {
	ramp: number, -- rate-limited command
	out: number, -- smoothed command (what the kart gets)
}

function SteerFilter.new(): State
	return { ramp = 0, out = 0 }
end

local function approach(x: number, target: number, step: number): number
	if x < target then
		return math.min(x + step, target)
	end
	return math.max(x - step, target)
end

-- `target` in [-1, 1]; `digital` = it came from keys or touch buttons.
-- `speed` is the kart's forward speed (studs/s). Returns the command.
function SteerFilter.step(s: Settings, state: State, target: number, digital: boolean, speed: number, dt: number): number
	target = math.clamp(target, -1, 1)
	local x = state.ramp
	if digital then
		local f = math.clamp(math.abs(speed) / s.RiseSpeed, 0, 1)
		local rise = s.RiseLow + (s.RiseHigh - s.RiseLow) * f
		local back = s.ReturnLow + (s.ReturnHigh - s.ReturnLow) * f
		if target ~= 0 and x * target < 0 then
			-- switching direction: hurry back through centre first
			x = approach(x, 0, s.Counter * dt)
		elseif math.abs(target) > math.abs(x) then
			x = approach(x, target, rise * dt)
		else
			x = approach(x, target, back * dt)
		end
	else
		local shaped = math.sign(target) * math.abs(target) ^ s.StickCurve
		x = approach(x, shaped, s.StickRate * dt)
	end
	state.ramp = x
	-- light low-pass on top, so the wheel never jerks at the ends of the ramp
	local k = 1 - math.exp(-s.Smoothing * dt)
	state.out += (x - state.out) * k
	if math.abs(state.out) < 1e-4 and x == 0 then
		state.out = 0
	end
	return state.out
end

return SteerFilter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">TrackData</string>
          <string name="Source"><![CDATA[--!strict
-- Every circuit in the game. Each one is drawn like a real track plan:
-- straights (S) and constant-radius corners (A). Positive angles are
-- right-handers. Two straights are "free": their lengths are solved so the lap
-- closes exactly. The lap starts at the start/finish line heading +X; the last
-- segment is the straight that leads onto it (the grid sits there). Consecutive
-- arcs with the same name are one corner (stands and marshal posts go by corner).
-- Most circuits are dead flat (like most kart tracks); Hillside has hills and
-- banking:
--   y      road height at the end of the segment (blended along the lap)
--   bank   corner banking in degrees (applied towards the inside)
--   width  road width from this segment on
-- Per circuit: Name (shown in game), Blurb (one line on the vote card), Laps
-- (Normal race length), Lengths (laps for Short / Normal / Long), Qualifying
-- (session length in seconds), Sectors (split points as lap fractions,
-- default thirds),
-- Bridge (name of the straight the sponsor bridge spans; default: the longest),
-- Sky ("Sunny" / "Cloudy" / "Sunset" / "Night"), PitStyle ("Wing" = sweeping
-- roof over the pits), CornerBoards (name boards at every named corner),
-- Lake (a lake on the most open ground inside the fence), Trees (pines in the
-- open ground), TrackLights (lamp posts along the track, for night races).

local Tampines = {
	Id = "Tampines",
	Name = "Tampines Ring",
	Blurb = "Kart circuit - tight and technical",
	Laps = 3, -- the Normal length
	Lengths = { 2, 3, 5 }, -- laps for Short / Normal / Long
	Qualifying = 120, -- seconds
	Spacing = 6, -- studs between samples
	Smoothing = 10,
	BankSmoothing = 22,
	Segments = {
		{ kind = "S", length = 240, width = 42, name = "Main straight" },
